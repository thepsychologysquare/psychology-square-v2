---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
---
<Layout title="Book a session" description="Book an individual or couples therapy session with The Psychology Square.">
  <section class="book-hero">
    <div class="wrap">
      <span class="eyebrow">Get in touch</span>
      <h1>Book a session.</h1>
      <p class="book-hero-sub">Pick an available time, send payment, and attach your receipt — we'll confirm your slot by email.</p>
    </div>
  </section>

  <section class="book-section">
    <div class="wrap book-layout">
      <form id="bookingForm" class="booking-form" novalidate>

        <div class="form-block">
          <span class="form-step">01 — Online or in person?</span>
          <div class="service-options" role="radiogroup" aria-label="Session format" id="formatOptions">
            <label class="service-option">
              <input type="radio" name="mode" value="online" checked />
              <span class="service-option-body">
                <span class="service-option-title">Online session</span>
                <span class="service-option-price">Video call, from anywhere</span>
              </span>
            </label>
            <label class="service-option">
              <input type="radio" name="mode" value="in_person" />
              <span class="service-option-body">
                <span class="service-option-title">In-person session</span>
                <span class="service-option-price">At our Johar Town, Lahore office</span>
              </span>
            </label>
          </div>
          <p class="format-note" id="formatNote" hidden>In-person slots depend on the clinician's current availability and aren't guaranteed at the time of booking. If your preferred in-person slot isn't available, we're happy to reschedule you to the next available in-person time.</p>
        </div>

        <div class="form-block">
          <span class="form-step">02 — Choose a service</span>
          <div class="service-options" role="radiogroup" aria-label="Service type">
            <label class="service-option">
              <input type="radio" name="service" value="individual" checked />
              <span class="service-option-body">
                <span class="service-option-title">Individual Therapy</span>
                <span class="service-option-price">PKR 5,000 / session</span>
              </span>
            </label>
            <label class="service-option">
              <input type="radio" name="service" value="couples" />
              <span class="service-option-body">
                <span class="service-option-title">Couples Therapy</span>
                <span class="service-option-price">PKR 7,000 / session</span>
              </span>
            </label>
          </div>
        </div>

        <div class="form-block">
          <span class="form-step">03 — Choose a clinician</span>
          <div class="service-options" role="radiogroup" aria-label="Clinician" id="clinicianOptions">
            <label class="service-option">
              <input type="radio" name="clinician" value="sohail" checked />
              <span class="service-option-body">
                <span class="service-option-title">Muhammad Sohail</span>
              </span>
            </label>
            <label class="service-option">
              <input type="radio" name="clinician" value="sehar" />
              <span class="service-option-body">
                <span class="service-option-title">Sehar Waheed</span>
              </span>
            </label>
          </div>
        </div>

        <div class="form-block">
          <span class="form-step">04 — Pick a time</span>
          <p class="slot-status" id="slotStatus">Loading available times…</p>
          <div id="bookCalendar" class="book-calendar" hidden>
            <div class="cal-nav">
              <button id="bookCalPrev" class="cal-nav-btn" type="button">← Prev</button>
              <span id="bookCalMonthLabel" class="cal-month-label"></span>
              <button id="bookCalNext" class="cal-nav-btn" type="button">Next →</button>
            </div>
            <div class="cal-weekdays">
              <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
            </div>
            <div class="cal-grid" id="bookCalGrid"></div>
            <div id="bookDayPanel" class="book-day-panel" hidden>
              <p class="book-day-panel-title" id="bookDayPanelTitle"></p>
              <div id="bookSlotTimes" class="slot-times"></div>
            </div>
          </div>
        </div>

        <div class="form-block">
          <span class="form-step">05 — Your details</span>
          <div class="field-grid">
            <div class="field">
              <label for="client_name">Full name</label>
              <input type="text" id="client_name" name="client_name" required autocomplete="name" placeholder="Your Name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="name@example.com" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="03XX-XXXXXXX" />
            </div>
          </div>
          <div class="field">
            <label for="notes">Anything you'd like us to know <span class="optional">(optional)</span></label>
            <textarea id="notes" name="notes" rows="3"></textarea>
          </div>
        </div>

        <div class="form-block">
          <span class="form-step">06 — Send payment</span>
          <div class="payment-methods" role="radiogroup" aria-label="Payment method">
            <label class="payment-option">
              <input type="radio" name="payment_method" value="jazzcash" checked />
              <span>JazzCash</span>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment_method" value="bank_hbl" />
              <span>Bank transfer — HBL (Sehar Waheed)</span>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment_method" value="bank_ubl" />
              <span>Bank transfer — UBL (Muhammad Sohail)</span>
            </label>
          </div>

          <div class="payment-details">
            <p class="payment-amount">Amount to send: <strong id="amountDisplay">PKR 5,000</strong></p>
            <div class="payment-instructions" id="paymentInstructions"></div>
          </div>
        </div>

        <div class="form-block">
          <span class="form-step">07 — Attach your receipt</span>
          <div class="field">
            <label for="screenshot">Upload a screenshot of the payment</label>
            <input type="file" id="screenshot" name="screenshot" accept="image/*" required />
            <p class="field-hint">A clear screenshot of the transaction confirmation is all we need (under 5MB, images only).</p>
            <p class="upload-error" id="uploadError" role="alert" hidden></p>
            <div class="upload-preview" id="uploadPreview" hidden>
              <span id="uploadPreviewName"></span>
              <button type="button" id="uploadRemoveBtn" class="upload-remove-btn">Remove ✕</button>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn--primary submit-btn" id="submitBtn" disabled>Pick a time slot first</button>
        <p class="form-error" id="formError" role="alert" hidden></p>
      </form>

      <aside class="book-confirmation" id="confirmationPanel" hidden>
        <span class="eyebrow">Booking received</span>
        <h2>We've got it.</h2>
        <p>Your reference number is</p>
        <p class="confirmation-ref" id="confirmationRef"></p>
        <p>We'll confirm your slot by email once we've checked the payment — usually within a few hours.</p>
      </aside>
    </div>
  </section>
</Layout>

<style is:global>
  .book-hero{ background:var(--navy-950); color:var(--paper-0); padding:64px 0 48px; }
  .book-hero h1{ font-size:clamp(32px,4vw,44px); color:var(--paper-0); margin-top:10px; }
  .book-hero-sub{ color:rgba(248,249,246,0.72); font-size:16px; max-width:520px; margin-top:14px; }

  .book-section{ padding:56px 0 96px; }
  .book-layout{ display:grid; grid-template-columns:1fr 320px; gap:48px; align-items:start; min-width:0; }
  .book-layout > *{ min-width:0; }
  @media (max-width:900px){ .book-layout{ grid-template-columns:minmax(0,1fr); } }

  .booking-form{ display:flex; flex-direction:column; gap:36px; }
  .form-block{ display:flex; flex-direction:column; gap:14px; }
  .form-step{ font-family:var(--font-mono); font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-600); }

  .field{ display:flex; flex-direction:column; gap:6px; }
  .field-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:16px; }
  @media (max-width:700px){ .field-grid{ grid-template-columns:1fr 1fr; } }
  @media (max-width:520px){ .field-grid{ grid-template-columns:1fr; } }

  label{ font-size:14px; font-weight:500; color:var(--ink-900); }
  .optional{ font-weight:400; color:var(--ink-600); }

input[type="text"], 
input[type="email"], 
input[type="tel"], 
input[type="file"], 
select, 
textarea {
  font-family: var(--font-body); 
  font-size: 16px; /* Prevents mobile browser auto-zoom */
  padding: 12px 14px;
  border: 1px solid var(--line); 
  border-radius: 2px; 
  background: var(--paper-0); 
  color: var(--ink-900);
  width: 100%; /* Ensures consistent full width inside grid cells */
  box-sizing: border-box;
}
  input:focus-visible, select:focus-visible, textarea:focus-visible{ outline:2px solid var(--gold-500); outline-offset:1px; }
  textarea{ resize:vertical; font-family:var(--font-body); }
  .field-hint{ font-size:13px; color:var(--ink-600); }
  .upload-error{ font-size:13.5px; color:#B4432E; margin-top:8px; }
  .upload-preview{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    margin-top:10px; padding:10px 14px; background:var(--paper-50); border:1px solid var(--line); border-radius:2px;
    font-size:13.5px; color:var(--ink-900);
  }
  .upload-preview span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .upload-remove-btn{
    background:none; border:none; color:#B4432E; font-size:13px; font-weight:600; cursor:pointer; flex:none; padding:0;
  }

  .format-note{
    margin-top:2px; padding:12px 14px; background:rgba(199,164,74,0.08); border:1px solid rgba(199,164,74,0.35);
    border-radius:2px; font-size:13.5px; line-height:1.55; color:var(--ink-900);
  }

  .service-options, .payment-methods{ display:flex; flex-direction:column; gap:10px; }
  .service-option{ display:flex; min-width:0; border:1px solid var(--line); border-radius:2px; padding:16px; cursor:pointer; transition:border-color .2s var(--ease); }
  .service-option:has(input:checked){ border-color:var(--gold-500); background:rgba(199,164,74,0.06); }
  .service-option input{ margin-right:14px; margin-top:3px; accent-color:var(--gold-500); flex-shrink:0; }
  .service-option-body{ display:flex; flex-direction:column; gap:4px; min-width:0; }
  .service-option-title{ font-weight:600; }
  .service-option-price{ font-family:var(--font-mono); font-size:13px; color:var(--gold-500); }

  .payment-option{ display:flex; align-items:center; gap:10px; min-width:0; border:1px solid var(--line); border-radius:2px; padding:12px 16px; cursor:pointer; }
  .payment-option:has(input:checked){ border-color:var(--gold-500); background:rgba(199,164,74,0.06); }
  .payment-option input{ accent-color:var(--gold-500); flex-shrink:0; }
  .payment-option span{ min-width:0; }

  .payment-details{ margin-top:6px; padding:18px; background:var(--paper-50); border-radius:2px; }
  .payment-amount{ font-size:15px; margin-bottom:10px; }
  .payment-instructions{ font-family:var(--font-mono); font-size:14px; line-height:1.8; color:var(--ink-900); white-space:pre-line; }

  .slot-status{ color:var(--ink-600); font-size:14px; }

  .book-calendar{ max-width:420px; border:1px solid var(--line); border-radius:2px; padding:20px; }
  .cal-nav{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
  .cal-nav-btn{ font-family:var(--font-mono); font-size:12px; background:none; border:none; color:var(--ink-600); cursor:pointer; padding:4px; }
  .cal-nav-btn:hover:not(:disabled){ color:var(--ink-900); }
  .cal-nav-btn:disabled{ opacity:0.3; cursor:not-allowed; }
  .cal-month-label{ font-weight:600; font-size:15px; }
  .cal-weekdays{ display:grid; grid-template-columns:repeat(7,1fr); font-family:var(--font-mono); font-size:11px; color:var(--ink-600); text-align:center; margin-bottom:6px; }
  .cal-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:4px; }
  .cal-cell{
    position:relative; aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    border:1px solid var(--line); border-radius:2px; background:transparent; font-size:13px; color:var(--ink-900); padding:2px;
  }
  .cal-cell.is-bookable{ cursor:pointer; }
  .cal-cell.is-bookable:hover{ border-color:var(--gold-500); }
  .cal-cell.is-other-month{ visibility:hidden; }
  .cal-cell.is-past, .cal-cell.is-off{ opacity:0.3; cursor:default; color:var(--ink-600); }
  .cal-cell.is-selected{ border-color:var(--gold-500); border-width:2px; background:var(--gold-500); color:var(--navy-950); font-weight:700; }
  .cal-cell.is-selected .cal-dot{ background:var(--navy-950); }
  .cal-dot{ width:5px; height:5px; border-radius:50%; background:var(--gold-500); margin-top:3px; }

  .book-day-panel{ margin-top:18px; padding-top:16px; border-top:1px solid var(--line); }
  .book-day-panel-title{ font-weight:600; font-size:14.5px; margin-bottom:10px; }
  .slot-times{ display:flex; gap:8px; flex-wrap:wrap; }
  .slot-time-btn{
    font-family:var(--font-body); font-size:14px; padding:9px 16px;
    border:1px solid var(--line); border-radius:2px; background:var(--paper-0); cursor:pointer;
  }
  .slot-time-btn.is-selected{ border-color:var(--gold-500); background:var(--gold-500); color:var(--navy-950); font-weight:600; }

  .submit-btn{ align-self:flex-start; border:none; cursor:pointer; font-family:var(--font-body); }
  .submit-btn:disabled{ opacity:0.5; cursor:not-allowed; }
  .form-error{ color:#B4432E; font-size:14px; }

  .book-confirmation{ position:sticky; top:100px; border:1px solid var(--line); border-radius:2px; padding:28px; background:var(--paper-50); }
  .book-confirmation h2{ font-size:24px; margin-top:8px; margin-bottom:16px; }
  .confirmation-ref{ font-family:var(--font-mono); font-size:20px; color:var(--gold-500); letter-spacing:0.04em; margin-bottom:16px; }
</style>

<script>
  const PRICES: Record<string, number> = { individual: 5000, couples: 7000, group: 10000 };
  const PAYMENT_DETAILS: Record<string, string> = {
    jazzcash: `JazzCash\nAccount number: 0333-1597844\nName: Muhammad Sohail`,
    bank_hbl: `Habib Bank Limited (HBL)\nAccount title: Sehar Waheed\nAccount number: 23057904517003\nIBAN: PK64HABB0023057904517003`,
    bank_ubl: `United Bank Limited (UBL)\nAccount title: Muhammad Sohail\nAccount number: 1486274438499\nIBAN: PK93UNIL0109000274438499`,
  };
  const CLINICIAN_NAMES: Record<string, string> = { sohail: 'Muhammad Sohail', sehar: 'Sehar Waheed' };

  const form = document.getElementById('bookingForm') as HTMLFormElement;
  const amountDisplay = document.getElementById('amountDisplay')!;
  const paymentInstructions = document.getElementById('paymentInstructions')!;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const formError = document.getElementById('formError') as HTMLParagraphElement;
  const screenshotInput = document.getElementById('screenshot') as HTMLInputElement;
  const uploadError = document.getElementById('uploadError') as HTMLParagraphElement;
  const uploadPreview = document.getElementById('uploadPreview') as HTMLDivElement;
  const uploadPreviewName = document.getElementById('uploadPreviewName') as HTMLSpanElement;
  const uploadRemoveBtn = document.getElementById('uploadRemoveBtn') as HTMLButtonElement;

  const MAX_SCREENSHOT_BYTES = 5 * 1024 * 1024;

  function clearUpload() {
    screenshotInput.value = '';
    uploadPreview.hidden = true;
    uploadError.hidden = true;
  }

  screenshotInput.addEventListener('change', () => {
    const file = screenshotInput.files?.[0];
    uploadError.hidden = true;
    uploadPreview.hidden = true;
    if (!file) return;

    if (!file.type.startsWith('image/')) {
      uploadError.textContent = `"${file.name}" isn't an image file. Please attach a screenshot (JPG, PNG, etc.) — not a PDF or document.`;
      uploadError.hidden = false;
      screenshotInput.value = '';
      return;
    }
    if (file.size > MAX_SCREENSHOT_BYTES) {
      uploadError.textContent = `"${file.name}" is too large (${(file.size / (1024 * 1024)).toFixed(1)}MB). Please attach a screenshot under 5MB.`;
      uploadError.hidden = false;
      screenshotInput.value = '';
      return;
    }

    uploadPreviewName.textContent = file.name;
    uploadPreview.hidden = false;
  });

  uploadRemoveBtn.addEventListener('click', clearUpload);

  const formatOptions = document.getElementById('formatOptions') as HTMLElement;
  const formatNote = document.getElementById('formatNote') as HTMLParagraphElement;
  function updateFormatNote() {
    const mode = (formatOptions.querySelector('input[name="mode"]:checked') as HTMLInputElement)?.value ?? 'online';
    formatNote.hidden = mode !== 'in_person';
  }
  formatOptions.addEventListener('change', updateFormatNote);
  updateFormatNote();

  const confirmationPanel = document.getElementById('confirmationPanel')!;
  const confirmationRef = document.getElementById('confirmationRef')!;
  const clinicianOptions = document.getElementById('clinicianOptions') as HTMLElement;
  function currentClinician(): string {
    return (clinicianOptions.querySelector('input[name="clinician"]:checked') as HTMLInputElement)?.value ?? 'sohail';
  }
  const slotStatus = document.getElementById('slotStatus')!;
  const bookCalendar = document.getElementById('bookCalendar')!;
  const bookCalPrev = document.getElementById('bookCalPrev') as HTMLButtonElement;
  const bookCalNext = document.getElementById('bookCalNext') as HTMLButtonElement;
  const bookCalMonthLabel = document.getElementById('bookCalMonthLabel')!;
  const bookCalGrid = document.getElementById('bookCalGrid')!;
  const bookDayPanel = document.getElementById('bookDayPanel')!;
  const bookDayPanelTitle = document.getElementById('bookDayPanelTitle')!;
  const bookSlotTimes = document.getElementById('bookSlotTimes')!;

  let slots: { id: number; clinician: string; date: string; time: string }[] = [];
  let selectedSlotId: number | null = null;
  let selectedDate: string | null = null;
  let calMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);

  function todayStr() {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }
  function fmtDate(d: Date) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  function currentService(): string {
    return (form.querySelector('input[name="service"]:checked') as HTMLInputElement)?.value ?? 'individual';
  }
  function currentPaymentMethod(): string {
    return (form.querySelector('input[name="payment_method"]:checked') as HTMLInputElement)?.value ?? 'jazzcash';
  }
  function updateSummary() {
    const price = PRICES[currentService()] ?? 5000;
    amountDisplay.textContent = `PKR ${price.toLocaleString('en-US')}`;
    paymentInstructions.textContent = PAYMENT_DETAILS[currentPaymentMethod()];
  }
  form.querySelectorAll('input[name="service"], input[name="payment_method"]').forEach((el) => {
    el.addEventListener('change', updateSummary);
  });
  updateSummary();

  function renderCalendar() {
    const byDate: Record<string, typeof slots> = {};
    for (const s of slots) { (byDate[s.date] ||= []).push(s); }
    const availableDates = Object.keys(byDate).sort();

    const today = todayStr();
    const year = calMonth.getFullYear();
    const month = calMonth.getMonth();
    bookCalMonthLabel.textContent = calMonth.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

    const isCurrentMonth = year === new Date().getFullYear() && month === new Date().getMonth();
    bookCalPrev.disabled = isCurrentMonth;
    const lastAvailable = availableDates.length ? availableDates[availableDates.length - 1] : null;
    const lastAvailableMonth = lastAvailable ? new Date(lastAvailable + 'T00:00:00') : null;
    bookCalNext.disabled = !lastAvailableMonth
      || (year > lastAvailableMonth.getFullYear())
      || (year === lastAvailableMonth.getFullYear() && month >= lastAvailableMonth.getMonth());

    const firstWeekday = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    bookCalGrid.innerHTML = '';
    for (let i = 0; i < firstWeekday; i++) {
      const blank = document.createElement('div');
      blank.className = 'cal-cell is-other-month';
      bookCalGrid.appendChild(blank);
    }
    for (let day = 1; day <= daysInMonth; day++) {
      const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.className = 'cal-cell';
      const daySlots = byDate[dateStr] || [];
      const isPast = dateStr < today;
      const bookable = daySlots.length > 0 && !isPast;

      if (isPast) cell.classList.add('is-past');
      else if (!daySlots.length) cell.classList.add('is-off');
      else cell.classList.add('is-bookable');
      if (dateStr === selectedDate) cell.classList.add('is-selected');

      cell.innerHTML = `<span>${day}</span>`;
      if (bookable) {
        const dot = document.createElement('span');
        dot.className = 'cal-dot';
        cell.appendChild(dot);
      }
      cell.disabled = !bookable;
      if (bookable) {
        cell.addEventListener('click', () => {
          if (selectedDate === dateStr) {
            selectedDate = null;
            selectedSlotId = null;
            bookDayPanel.hidden = true;
          } else {
            selectedDate = dateStr;
            selectedSlotId = null;
            renderDayPanel(dateStr);
          }
          renderCalendar();
          updateSubmitState();
          updateSummary();
        });
      }
      bookCalGrid.appendChild(cell);
    }
  }

  function renderDayPanel(dateStr: string) {
    bookDayPanel.hidden = false;
    bookDayPanelTitle.textContent = new Date(dateStr + 'T00:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });

    const daySlots = (slots.filter((s) => s.date === dateStr)).sort((a, b) => a.time.localeCompare(b.time));
    bookSlotTimes.innerHTML = '';
    for (const slot of daySlots) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'slot-time-btn' + (slot.id === selectedSlotId ? ' is-selected' : '');
      const label = slot.time;
      btn.textContent = label;
      btn.addEventListener('click', () => {
        selectedSlotId = (selectedSlotId === slot.id) ? null : slot.id;
        renderDayPanel(dateStr);
        updateSubmitState();
        updateSummary();
      });
      bookSlotTimes.appendChild(btn);
    }
  }

  function renderSlots() {
    if (!slots.length) {
      slotStatus.textContent = 'No available times right now — please check back soon or email us.';
      slotStatus.hidden = false;
      bookCalendar.hidden = true;
      return;
    }
    slotStatus.hidden = true;
    bookCalendar.hidden = false;

    const availableDates = [...new Set(slots.map((s) => s.date))].sort();
    const firstAvailable = new Date(availableDates[0] + 'T00:00:00');
    const now = new Date();
    const currentlyShownIsEmpty = !availableDates.some((d) => {
      const dd = new Date(d + 'T00:00:00');
      return dd.getFullYear() === calMonth.getFullYear() && dd.getMonth() === calMonth.getMonth();
    });
    if (currentlyShownIsEmpty) {
      const currentMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);
      const target = firstAvailable >= currentMonthStart ? firstAvailable : currentMonthStart;
      calMonth = new Date(target.getFullYear(), target.getMonth(), 1);
    }
    if (selectedDate && !availableDates.includes(selectedDate)) {
      selectedDate = null;
      selectedSlotId = null;
      bookDayPanel.hidden = true;
    }
    renderCalendar();
    if (selectedDate) renderDayPanel(selectedDate);
  }

  bookCalPrev.addEventListener('click', () => {
    calMonth.setMonth(calMonth.getMonth() - 1);
    renderCalendar();
  });
  bookCalNext.addEventListener('click', () => {
    calMonth.setMonth(calMonth.getMonth() + 1);
    renderCalendar();
  });

  function updateSubmitState() {
    submitBtn.disabled = !selectedSlotId;
    submitBtn.textContent = selectedSlotId ? 'Submit booking' : 'Pick a time slot first';
  }

  async function loadSlots() {
    slotStatus.textContent = 'Loading available times…';
    selectedSlotId = null;
    selectedDate = null;
    const qs = `?clinician=${currentClinician()}`;
    const res = await fetch(`/api/availability${qs}`);
    const data = await res.json();
    slots = data.slots || [];
    renderSlots();
    updateSubmitState();
  }
  clinicianOptions.addEventListener('change', loadSlots);
  loadSlots();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectedSlotId) return;
    formError.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    try {
      const formData = new FormData(form);
      formData.set('slot_id', String(selectedSlotId));
      const res = await fetch('/api/bookings', { method: 'POST', body: formData });

      if (!res.ok) {
        const errBody = await res.json().catch(() => ({}));
        if (res.status === 409) await loadSlots();
        throw new Error(errBody.error || 'Something went wrong. Please try again.');
      }

      const data = await res.json();
      confirmationRef.textContent = data.reference;
      form.hidden = true;
      confirmationPanel.hidden = false;
      confirmationPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err: any) {
      formError.textContent = err.message || 'Something went wrong. Please try again.';
      formError.hidden = false;
      updateSubmitState();
    }
  });
</script>
