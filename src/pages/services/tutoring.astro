---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/services/*.jpg');

async function getServiceImage(imagePath: string) {
  const fullPath = `/src/assets/services/${imagePath}`;
  if (images[fullPath]) {
    const img = await images[fullPath]();
    return img.default;
  }
  return null;
}

const siteOrigin = 'https://thepsychologysquare.com';

const serviceJson = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Psychology Tutoring",
  "provider": { "@type": "Organization", "name": "The Psychology Square", "url": siteOrigin },
  "areaServed": "Pakistan",
  "url": `${siteOrigin}/services/tutoring`,
  "description": "One-to-one psychology tutoring for O Level, A Level, BS, MSc, MS and MPhil students across Pakistan — three classes a week per subject, evenings and weekends.",
  "offers": {
    "@type": "Offer",
    "name": "Psychology Tutoring — per subject, per month",
    "price": "35000",
    "priceCurrency": "PKR"
  }
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteOrigin}/services` },
    { "@type": "ListItem", "position": 3, "name": "Tutoring", "item": `${siteOrigin}/services/tutoring` }
  ]
};

const levels = [
  { name: 'O Level', tag: 'Cambridge / AKU-EB' },
  { name: 'A Level', tag: 'AS & A2' },
  { name: 'BS Psychology', tag: "Hons. / Applied" },
  { name: 'MSc · MS · MPhil', tag: 'Graduate & research' },
  { name: 'Any other degree', tag: 'With Psychology on the transcript' }
];

const subjects = [
  { name: 'Introduction to Psychology', category: 'core', image: 'tutoring-intro-psychology.jpg' },
  { name: 'Developmental Psychology', category: 'core', image: 'tutoring-developmental-psychology.jpg' },
  { name: 'Abnormal Psychology', category: 'clinical', image: 'tutoring-abnormal-psychology.jpg' },
  { name: 'Cognitive Psychology', category: 'core', image: 'tutoring-cognitive-psychology.jpg' },
  { name: 'Social Psychology', category: 'core', image: 'tutoring-social-psychology.jpg' },
  { name: 'Biopsychology & Neuropsychology', category: 'core', image: 'tutoring-biopsychology.jpg' },
  { name: 'Personality Theories', category: 'core', image: 'tutoring-personality-theories.jpg' },
  { name: 'Research Methods & Statistics', category: 'research', image: 'tutoring-research-methods.jpg' },
  { name: 'Psychological Testing & Assessment', category: 'clinical', image: 'tutoring-psychological-testing.jpg' },
  { name: 'Counseling & Clinical Psychology', category: 'clinical', image: 'tutoring-counseling-clinical.jpg' },
  { name: 'O/A Level Psychology (Cambridge)', category: 'school', image: 'tutoring-cambridge-psychology.jpg' },
  { name: 'Thesis & Research Supervision', category: 'research', image: 'tutoring-thesis-supervision.jpg' }
];

const subjectsWithImages = await Promise.all(
  subjects.map(async (s) => ({
    ...s,
    resolvedImage: await getServiceImage(s.image)
  }))
);

const coverImage = await getServiceImage('tutoring.jpg');

const approach = [
  {
    num: '01',
    title: 'Mapped to your actual syllabus',
    desc: "Whether it's a Cambridge O/A Level spec or a university course outline, classes follow what you're actually being examined on."
  },
  {
    num: '02',
    title: 'Taught by practicing psychologists',
    desc: "Not tutors reading off a textbook — taught by people who study, teach, and practice psychology day to day."
  },
  {
    num: '03',
    title: 'Built around your week',
    desc: 'Evening and weekend slots, so tutoring fits around school, university, or work — not the other way round.'
  },
  {
    num: '04',
    title: 'Clarity over rote learning',
    desc: 'We break down complex theoretical frameworks and statistical formulas until they completely click into place.'
  }
];
---
<Layout
  title="Psychology Tutoring"
  fullTitle="Psychology Tutoring for O Level, A Level, BS & MS Students | The Psychology Square"
  description="One-to-one psychology tutoring for O Level, A Level, BS, MSc, MS and MPhil students across Pakistan. Three classes a week per subject, evenings and weekends. PKR 35,000/month per subject."
  image={coverImage?.src}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <!-- HERO -->
  <section class="hero tut-hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="crumb-sep">/</span>
          <a href="/services">Services</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">Tutoring</span>
        </nav>
        <p class="eyebrow">Psychology Tutoring &middot; Pakistan-wide</p>
        <h1 class="hero-title">Psychology,<br>taught properly.</h1>
        <p class="hero-sub">One-to-one tutoring for O Level, A Level, BS, MSc, MS and MPhil students — every subject within psychology, taught by people who actually practice it.</p>
        <div class="hero-actions">
          <a href="#enroll" class="btn btn--primary">Request Tutoring</a>
        </div>

        <div class="trust-banner">
          <div class="trust-stat">
            <span class="trust-value">O Level &rarr; MPhil</span>
            <span class="trust-label">Every academic level covered</span>
          </div>
          <div class="trust-stat">
            <span class="trust-value">3 / week</span>
            <span class="trust-label">Classes per subject</span>
          </div>
          <div class="trust-stat">
            <span class="trust-value">PKR 35,000</span>
            <span class="trust-label">Per subject, per month</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LEVELS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head-2">
        <h2 class="section-title">We Cover All Subjects</h2>
      </div>
      <div class="level-row">
  {levels.map((l) => (
    <div class="level-pill" key={l.name}>
      <small>{l.tag}</small>
      <span>{l.name}</span>
    </div>
  ))}
</div>
    </div>
  </section>

  <!-- SUBJECTS SECTION WITH FILTERING -->
  <section class="section section--alt tut-subjects" id="subjects">
    <div class="wrap">
      <div class="section-head-2">
        <div class="subject-filters" role="tablist" aria-label="Subject categories">
          <button type="button" class="filter-btn active" data-filter="all">All Subjects</button>
          <button type="button" class="filter-btn" data-filter="core">Core Psychology</button>
          <button type="button" class="filter-btn" data-filter="clinical">Clinical &amp; Applied</button>
          <button type="button" class="filter-btn" data-filter="research">Research &amp; Stats</button>
          <button type="button" class="filter-btn" data-filter="school">O/A Level</button>
        </div>
      </div>

      <div class="subjects-grid" id="subjectsGrid">
        {subjectsWithImages.map((s) => (
          <div class="subject-card" data-category={s.category}>
            <div class="subject-card-img-wrap">
              {s.resolvedImage ? (
                <Image 
                  src={s.resolvedImage} 
                  alt={s.name} 
                  class="subject-card-img"
                  loading="lazy"
                />
              ) : (
                <div class="subject-card-fallback bg-placeholder-1"></div>
              )}
            </div>
            <div class="subject-card-content">
              <span class="subject-category-tag">{s.category}</span>
              <h3 class="subject-card-title">{s.name}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SCHEDULE + PRICING -->
  <section class="section">
    <div class="wrap">
      <div class="pricing-grid">
        <div class="pricing-card">
          <span class="article-meta">Class schedule</span>
          <h3>Three classes a week, every subject</h3>
          <ul class="pricing-list">
            <li>Weekdays — after 6 PM</li>
            <li>Weekends — any time, all day</li>
            <li>Times arranged around your own routine</li>
          </ul>
        </div>
        <div class="pricing-card pricing-card--dark">
          <span class="article-meta pricing-meta-light">Investment</span>
          <h3 class="pricing-figure">PKR 35,000<span>/month, per subject</span></h3>
          <p class="pricing-note">&asymp; PKR 2,917 per class, based on twelve classes a month.</p>
          <ul class="pricing-list pricing-list--light">
            <li>Covers 3 classes a week for that subject</li>
            <li>Add as many subjects as you need</li>
            <li>Combining subjects? Ask for a bundled quote</li>
          </ul>
          <a href="#enroll" class="btn btn--primary" style="margin-top:20px;">Request Tutoring</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head-2">
        <h2 class="section-title">Why students stick with it</h2>
      </div>
      <div class="approach-grid">
        {approach.map((a) => (
          <div class="approach-item">
            <span class="approach-num">{a.num}</span>
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENROLL / REQUEST FORM -->
  <section class="section" id="enroll">
    <div class="wrap" style="max-width: 640px;">
      <div class="section-head-2" style="display:block; margin-bottom: 28px;">
        <h2 class="section-title">Request tutoring</h2>
        <p class="section-sub">Tell us the level and subject(s) — we'll follow up to confirm a schedule.</p>
      </div>

      <form action="https://formspree.io/f/mdengkrv" method="POST" class="request-form">
        <input type="hidden" name="_subject" value="New Psychology Tutoring inquiry" />

        <div class="form-row">
          <label for="tut-name">
            Student's name
            <input type="text" id="tut-name" name="name" required />
          </label>
          <label for="tut-phone">
            WhatsApp / phone number
            <input type="tel" id="tut-phone" name="phone" required placeholder="03XX-XXXXXXX" />
          </label>
        </div>

        <label for="tut-email">
          Email
          <input type="email" id="tut-email" name="email" required />
        </label>

        <label for="tut-level">
          Academic level
          <select id="tut-level" name="level" required>
            <option value="" disabled selected>Select your level</option>
            <option value="O Level">O Level</option>
            <option value="A Level (AS & A2)">A Level (AS &amp; A2)</option>
            <option value="BS Psychology / BS Applied Psychology">BS Psychology / BS Applied Psychology</option>
            <option value="MSc / MS / MPhil Psychology">MSc / MS / MPhil Psychology</option>
            <option value="Other psychology program">Other psychology program</option>
          </select>
        </label>

        <label for="tut-subjects-text">
          Which subject(s)?
          <textarea id="tut-subjects-text" name="subjects" rows="3" placeholder="Write whatever subjects you want covered..." required></textarea>
        </label>

        <label for="tut-schedule">
          Preferred schedule
          <select id="tut-schedule" name="preferred_schedule">
            <option value="" disabled selected>Select a preference</option>
            <option value="Weekday evenings (after 6 PM)">Weekday evenings (after 6 PM)</option>
            <option value="Weekend mornings">Weekend mornings</option>
            <option value="Weekend afternoons">Weekend afternoons</option>
            <option value="Weekend evenings">Weekend evenings</option>
            <option value="Flexible / not sure yet">Flexible / not sure yet</option>
          </select>
        </label>

        <label for="tut-message">
          Anything else we should know? (optional)
          <textarea id="tut-message" name="message" rows="4"></textarea>
        </label>

        <button type="submit" class="btn btn--primary">Send request</button>
      </form>
      <p class="form-note">We typically respond within one business day to confirm a schedule.</p>
    </div>
  </section>

</Layout>

<style>
  .section-head-2{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:24px;
  flex-wrap:wrap;
}
  
  .breadcrumbs{
    font-family: var(--font-mono); font-size: 12px; color: rgba(248,249,246,0.6);
    margin-bottom: 20px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  }
  .breadcrumbs a:hover{ color: var(--gold-300); }
  .crumb-sep{ color: rgba(248,249,246,0.3); }
  .crumb-current{ color: rgba(248,249,246,0.85); }

  .tut-hero .hero-inner{ align-items:start; padding-top: 6px; }
  .section-sub{ color: var(--ink-600); font-size: 15px; max-width: 46ch; margin-top: 6px; }

  /* Trust banner (on dark hero) */
  .trust-banner{
    display:flex; flex-wrap:wrap; gap:32px;
    margin-top: 30px; padding-top: 24px;
    border-top: 1px solid var(--line-onDark);
  }
  .trust-stat{ display:flex; flex-direction:column; gap:4px; }
  .trust-value{
    font-family: var(--font-display); font-size: 22px; font-weight:600;
    color: var(--gold-300);
  }
  .trust-label{ font-size: 12.5px; color: rgba(248,249,246,0.68); max-width: 200px; }

  /* Levels row */
  .level-row {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.level-pill {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1px;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 6px 10px;
  background: var(--paper-0);
  transition: border-color .2s var(--ease), transform .2s var(--ease);
}

.level-pill:hover {
  border-color: var(--gold-500);
  transform: translateY(-1px);
}

.level-pill small {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.04em;
  color: var(--sage-500);
  text-transform: uppercase;
  font-weight: normal;
}

.level-pill span {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-900);
  line-height: 1.2;
}
  /* Subject filters */
  .subject-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .filter-btn {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-0);
    color: var(--ink-600);
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }
  .filter-btn:hover {
    border-color: var(--gold-500);
    color: var(--ink-900);
  }
  .filter-btn.active {
    background: var(--navy-950);
    color: var(--paper-0);
    border-color: var(--navy-950);
  }

  /* Two-column grid layout for subjects on desktop, one column on mobile */
  .subjects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 24px;
  }
  .subject-card {
    background: var(--paper-0);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    transition: all 0.25s var(--ease);
  }
  .subject-card:hover {
    border-color: var(--gold-500);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(19, 26, 34, 0.04);
  }
  .subject-card-img-wrap {
    width: 80px;
    height: 60px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper-50);
    flex-shrink: 0;
  }
  .subject-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }
  .subject-card:hover .subject-card-img {
    transform: scale(1.04);
  }
  .subject-card-fallback {
    width: 100%;
    height: 100%;
  }
  .subject-card-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
  }
  .subject-category-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sage-500);
  }
  .subject-card-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-900);
  }

  /* Pricing */
  .pricing-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:28px; align-items:stretch; margin-block: 24px; }
  .pricing-card{
    background: var(--paper-0); border:1px solid var(--line); border-radius:10px;
    padding:32px; display:flex; flex-direction:column;
  }
  .pricing-card h3{ font-size:20px; margin: 10px 0 16px; line-height:1.3; }
  .pricing-card--dark{ background: var(--navy-950); color: var(--paper-0); border-color: transparent; }
  .pricing-meta-light{ color: var(--gold-300) !important; }
  .pricing-figure{ font-size: 34px !important; display:flex; flex-direction:column; gap:2px; }
  .pricing-figure span{ font-family: var(--font-body); font-size:14px; font-weight:400; color: rgba(248,249,246,0.65); }
  .pricing-note{ font-size:13.5px; color: rgba(248,249,246,0.72); margin-bottom:18px; }
  .pricing-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
  .pricing-list li{ font-size:14px; color: var(--ink-900); padding-left:20px; position:relative; }
  .pricing-list li::before{ content:'\2013'; position:absolute; left:0; color: var(--gold-500); font-weight:600; }
  .pricing-list--light li{ color: rgba(248,249,246,0.9); }

  /* Approach */
  .approach-grid{ display:grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .approach-item{ display:flex; flex-direction:column; gap:10px; background: var(--paper-0); border: 1px solid var(--line); padding: 24px; border-radius: 10px; }
  .approach-num{ font-family: var(--font-mono); font-size: 13px; color: var(--gold-500); }
  .approach-item h3{ font-size: 17px; }
  .approach-item p{ color: var(--ink-600); font-size: 14px; line-height: 1.5; }

  /* Form */
  .form-row{ display:grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .request-form{ display:flex; flex-direction:column; gap:18px; }
  .request-form label{ display:flex; flex-direction:column; gap:6px; font-size: 14px; color: var(--ink-600); font-weight: 500; }
  .request-form input,
  .request-form select,
  .request-form textarea{
    font-family: var(--font-body); font-size: 15px; padding: 12px 14px;
    border: 1px solid var(--line); border-radius: 3px; background: var(--paper-0); color: var(--ink-900);
  }
  .request-form input:focus,
  .request-form select:focus,
  .request-form textarea:focus{ outline: 2px solid var(--gold-500); outline-offset: 1px; }
  .request-form button{ align-self: flex-start; border: none; cursor: pointer; }
  .form-note{ margin-top: 20px; color: var(--sage-500); font-size: 14px; }

  @media (max-width: 1024px){
    .approach-grid{ grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px){
    .pricing-grid{ grid-template-columns: 1fr; }
    .subjects-grid{ grid-template-columns: 1fr; }
  }
  @media (max-width: 600px){
    .form-row{ grid-template-columns: 1fr; }
    .approach-grid{ grid-template-columns: 1fr; }
    .trust-banner{ gap: 22px; }
    .subject-filters{ overflow-x: auto; padding-bottom: 14px; width: 100%; flex-wrap: nowrap; }
    .filter-btn{ flex-shrink: 0; }
  }
</style>

<script>
  // Subject filtering logic
  const filterButtons = document.querySelectorAll('.filter-btn');
  const subjectCards = document.querySelectorAll('.subject-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const filter = btn.getAttribute('data-filter');
      
      subjectCards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>