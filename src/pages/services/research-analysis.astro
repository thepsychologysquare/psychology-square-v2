---
import Layout from '../../layouts/Layout.astro';

const siteOrigin = 'https://www.thepsychologysquare.com';
const serviceJson = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Statistical & Psychometric Research Analysis",
  "provider": { "@type": "Organization", "name": "The Psychology Square", "url": siteOrigin },
  "areaServed": "Lahore, Pakistan",
  "url": `${siteOrigin}/services/research-analysis`,
  "description": "R and SPSS support for psychology students and researchers, from beginner data analysis to advanced psychometric scale validation.",
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteOrigin}/services` },
    { "@type": "ListItem", "position": 3, "name": "Research Analysis", "item": `${siteOrigin}/services/research-analysis` },
  ],
};
---
<Layout
  title="Research Analysis"
  fullTitle="R & SPSS Statistical Analysis Support for Psychology Research | The Psychology Square"
  description="Statistical and research analysis support for psychology students and researchers in Lahore — R, SPSS, psychometrics, and scale validation, beginner to advanced."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <section class="hero article-index-hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/services">Services</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Research Analysis</span>
      </nav>
      <p class="eyebrow">Services</p>
      <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px;">Research Analysis</h1>
      <p class="hero-sub">Statistical &amp; research support for psychology work — for students and researchers who need help with the numbers side, from a first thesis analysis to advanced psychometric work.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p style="color: var(--ink-600); max-width: 640px; margin-bottom: 40px;">Support in both R and SPSS, tailored to your level.</p>

      <div class="card-grid">
        <div class="article-card" style="cursor:default;">
          <span class="article-meta">Beginners</span>
          <h3>Getting started with analysis</h3>
          <p>Help setting up your dataset, choosing the right test, running it in R or SPSS, and understanding what the output actually means for your write-up.</p>
        </div>
        <div class="article-card" style="cursor:default;">
          <span class="article-meta">Psychometrics</span>
          <h3>Scale development &amp; validation</h3>
          <p>Reliability (Cronbach's alpha), factor analysis (EFA/CFA), and validity testing for researchers building or adapting a psychological scale.</p>
        </div>
        <div class="article-card" style="cursor:default;">
          <span class="article-meta">Advanced</span>
          <h3>R programming &amp; modeling</h3>
          <p>Regression, mediation/moderation analysis, mixed models, and general R scripting support for advanced thesis or publication-level work.</p>
        </div>
      </div>

      <div class="request-cta-banner" style="margin-top: 48px;">
        <p>Have a specific analysis or dataset in mind?</p>
        <a href="/contact" class="btn btn--primary">Get in touch →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .article-index-hero{ padding: 72px 0 56px; }

  .breadcrumbs{
    font-family: var(--font-mono); font-size: 12px; color: rgba(248,249,246,0.6);
    margin-bottom: 20px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  }
  .breadcrumbs a:hover{ color: var(--gold-300); }
  .crumb-sep{ color: rgba(248,249,246,0.3); }
  .crumb-current{ color: rgba(248,249,246,0.85); }
</style>
