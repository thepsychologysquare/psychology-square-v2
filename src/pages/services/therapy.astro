---
import Layout from '../../layouts/Layout.astro';

const siteOrigin = 'https://www.thepsychologysquare.com';
const serviceJson = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Individual and Couples Therapy",
  "provider": { "@type": "MedicalBusiness", "name": "The Psychology Square", "url": siteOrigin },
  "areaServed": "Lahore, Pakistan",
  "url": `${siteOrigin}/services/therapy`,
  "offers": [
    { "@type": "Offer", "name": "Individual Therapy", "price": "5000", "priceCurrency": "PKR" },
    { "@type": "Offer", "name": "Couples Therapy", "price": "7000", "priceCurrency": "PKR" },
  ],
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteOrigin}/services` },
    { "@type": "ListItem", "position": 3, "name": "Therapy", "item": `${siteOrigin}/services/therapy` },
  ],
};
---
<Layout
  title="Therapy"
  fullTitle="Individual & Couples Therapy in Lahore | The Psychology Square"
  description="Individual and couples therapy in Johar Town, Lahore — online or in person. Anxiety, depression, trauma, relationships, and more. Licensed clinical psychologists."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/services">Services</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Therapy</span>
      </nav>
      <p class="eyebrow">Services</p>
      <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px;">Therapy</h1>
      <p class="hero-sub">Two formats, one space — individual and couples sessions, online or in person in Johar Town, Lahore.</p>
      <div class="hero-actions" style="margin-top: 28px;">
        <a href="/book" class="btn btn--primary">Book Now</a>
        <a href="mailto:info@thepsychologysquare.com" class="btn btn--text">Email us →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card-grid" style="margin-bottom: 56px;">
  <div class="article-card" style="cursor:default;">
    <div style="margin-bottom: 12px; display: flex; gap: 6px; flex-wrap: wrap;">
      <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; background: var(--paper-1, #f4f4f0); border: 1px solid var(--line, #e2e2dc); color: var(--ink-700, #333); padding: 3px 8px; border-radius: 4px;">Online</span>
      <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; background: var(--paper-1, #f4f4f0); border: 1px solid var(--line, #e2e2dc); color: var(--ink-700, #333); padding: 3px 8px; border-radius: 4px;">In-Person</span>
    </div>
    <span class="article-meta">Individual Therapy</span>
    <h3>One-to-one sessions</h3>
    <p>Online or in person, for working through what's weighing on you — patterns, symptoms, or simply a season that feels heavier than it should.</p>
    <p style="font-family: var(--font-mono); font-size: 13px; color: var(--gold-500); margin-top: 8px;">PKR 5,000 / session</p>
  </div>

  <div class="article-card" style="cursor:default;">
    <div style="margin-bottom: 12px; display: flex; gap: 6px; flex-wrap: wrap;">
      <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; background: var(--paper-1, #f4f4f0); border: 1px solid var(--line, #e2e2dc); color: var(--ink-700, #333); padding: 3px 8px; border-radius: 4px;">Online</span>
      <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; background: var(--paper-1, #f4f4f0); border: 1px solid var(--line, #e2e2dc); color: var(--ink-700, #333); padding: 3px 8px; border-radius: 4px;">In-Person</span>
    </div>
    <span class="article-meta">Couples Therapy</span>
    <h3>Joint sessions</h3>
    <p>Online or in person, for partners working through communication, conflict, or disconnection — with both people's experience given equal room.</p>
    <p style="font-family: var(--font-mono); font-size: 13px; color: var(--gold-500); margin-top: 8px;">PKR 7,000 / session</p>
  </div>
</div>

      <h3 style="font-size: 18px; margin-bottom: 16px;">Commonly addressed</h3>
      <div class="category-pills" style="margin-bottom: 56px;">
        {['Anxiety', 'Depression', 'Addiction & Recovery', 'Trauma & Distress', 'Relationship Conflict', 'Stress & Burnout'].map((t) => (
          <span class="topic-pill">{t}</span>
        ))}
      </div>

      <div class="approach-grid" style="margin-bottom: 56px;">
        <div class="approach-item">
          <span class="approach-num">01</span>
          <h3>Structured, not clinical-cold</h3>
          <p>Sessions follow an evidence-based framework, but conversation comes first. You won't be handed a worksheet before you've been heard.</p>
        </div>
        <div class="approach-item">
          <span class="approach-num">02</span>
          <h3>Online or in person, your choice</h3>
          <p>Join over video call from anywhere, or come in person to the Johar Town, Lahore office. Either way — a quiet, confidential hour.</p>
        </div>
        <div class="approach-item">
          <span class="approach-num">03</span>
          <h3>Rooted in real training</h3>
          <p>Grounded in supervised clinical experience across hospital and addiction-treatment settings, not theory alone.</p>
        </div>
      </div>

      <div class="request-cta-banner">
        <p>Ready to get started?</p>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a href="/book" class="btn btn--primary">Book Now</a>
          <a href="mailto:info@thepsychologysquare.com" class="btn btn--text">Email us →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .breadcrumbs{
    font-family: var(--font-mono); font-size: 12px; color: rgba(248,249,246,0.6);
    margin-bottom: 20px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  }
  .breadcrumbs a:hover{ color: var(--gold-300); }
  .crumb-sep{ color: rgba(248,249,246,0.3); }
  .crumb-current{ color: rgba(248,249,246,0.85); }

  .category-pills{ display:flex; flex-wrap:wrap; gap:10px; }
  .topic-pill{
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--navy-700);
    border: 1px solid var(--line);
    padding: 9px 16px;
    border-radius: 999px;
  }

  .approach-grid{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .approach-item{ display:flex; flex-direction:column; gap:10px; }
  .approach-num{
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gold-500);
  }
  .approach-item h3{ font-size: 17px; }
  .approach-item p{ color: var(--ink-600); font-size: 14.5px; }

  @media (max-width: 860px){
    .approach-grid{ grid-template-columns: 1fr; }
  }
</style>
