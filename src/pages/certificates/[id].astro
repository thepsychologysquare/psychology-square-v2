---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { certificateQrSvg, certificateVerifyUrl } from '../../lib/certificateQr';

const { id } = Astro.params;

let certificate: {
  id: string; course_title: string; ce_hours: number; name: string;
  email: string; score_percent: number; issued_at: string; is_paid: number; kind: string;
} | null = null;

if (env?.DB && id) {
  certificate = await env.DB.prepare(
    `SELECT id, course_title, ce_hours, name, email, score_percent, issued_at, is_paid, kind FROM certificates WHERE id = ?`
  ).bind(id).first();
}

const formattedDate = certificate
  ? new Date(certificate.issued_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';

// Only paid-course certificates get the navy/gold design below; free-course
// certificates keep rendering the original design further down, completely
// unchanged. is_paid is recorded on the certificate row at issuance time
// (see src/pages/api/courses/submit.ts), not looked up live from the
// course, so this never changes for a certificate that's already been
// issued even if the course's price changes later.
const isPaidCert = !!certificate?.is_paid;
// 'workshop' certificates (issued from Dashboard > Workshop Signups) use the
// paid design with "workshop" wording; everything else says "course".
const kindWord = certificate?.kind === 'workshop' ? 'workshop' : 'course';
const kindWordCap = kindWord === 'workshop' ? 'Workshop' : 'Course';

// Real QR for the paid design's "Verify authenticity" box. It encodes this
// certificate's own public URL, so scanning lands on the live D1-backed
// record (same page you're looking at). Generated on the server per request
// from the ID -- no stored image, nothing to go stale.
const qrSvg = isPaidCert && certificate ? certificateQrSvg(certificate.id) : '';
const verifyUrl = certificate ? certificateVerifyUrl(certificate.id) : '';
---
<Layout
  title={certificate ? `Certificate — ${certificate.course_title}` : 'Certificate not found'}
  description="Verify a certificate issued by The Psychology Square."
>
  <section class="cert-page">
    <div class="wrap wrap--cert">
      {!certificate && (
        <div class="not-found">
          <h1>Certificate not found</h1>
          <p>We couldn't find a certificate with that ID. Double-check the link, or contact us if you believe this is an error.</p>
        </div>
      )}

      {certificate && (
        <>
          <div class="verified-badge">✓ Verified certificate — publicly viewable by anyone with this link</div>

          {!isPaidCert && (
            <div class="cert-fit cert-fit--free" data-w="960">
            <div class="certificate" id="certificateCard">
              <span class="certificate__corner certificate__corner--tl" aria-hidden="true"><span class="mini-mark"><i></i><i></i></span></span>
              <span class="certificate__corner certificate__corner--tr" aria-hidden="true"><span class="mini-mark"><i></i><i></i></span></span>
              <span class="certificate__corner certificate__corner--bl" aria-hidden="true"><span class="mini-mark"><i></i><i></i></span></span>
              <span class="certificate__corner certificate__corner--br" aria-hidden="true"><span class="mini-mark"><i></i><i></i></span></span>

              <div class="certificate__inner">
                <div class="certificate__mark" aria-hidden="true"><i></i><i></i></div>
                <div class="certificate__eyebrow">The Psychology Square</div>
                <div class="certificate__title">Certificate of Completion</div>
                <div class="certificate__rule" aria-hidden="true"></div>

                <p class="certificate__line">This certifies that</p>
                <div class="certificate__name">{certificate.name}</div>
                <p class="certificate__line">has successfully completed</p>
                <div class="certificate__course">{certificate.course_title}</div>
                <div class="certificate__date">Issued {formattedDate}</div>

                <div class="certificate__signatures">
                  <div class="certificate__sig-col">
                    <img class="certificate__sig-img" src="/images/certificates/sig-sohail.png" alt="Signature of Muhammad Sohail" width="480" height="279" />
                    <div class="certificate__sig-line"></div>
                    <div class="certificate__sig-name">Muhammad Sohail</div>
                    <div class="certificate__sig-role">CEO</div>
                  </div>
                  <div class="certificate__sig-col">
                    <img class="certificate__sig-img" src="/images/certificates/sig-sehar.png" alt="Signature of Sehar Waheed" width="480" height="190" />
                    <div class="certificate__sig-line"></div>
                    <div class="certificate__sig-name">Sehar Waheed</div>
                    <div class="certificate__sig-role">Co-CEO</div>
                  </div>
                </div>
              </div>

              <div class="certificate__footer">
                <span>Certificate ID: {certificate.id}</span>
                <span>thepsychologysquare.com/certificates/{certificate.id}</span>
              </div>
            </div>
            </div>
          )}

          {isPaidCert && (
            <div class="cert-fit cert-fit--paid" data-w="1080">
            <div class="certificate-paid" id="certificateCard">
              <div class="cp-left">
                <div class="cp-top">
                  <div class="cp-logo">
                    <svg class="cp-logo-mark" viewBox="0 0 22 22" aria-hidden="true">
                      <rect x="1" y="1" width="13" height="13"></rect>
                      <rect x="8" y="8" width="13" height="13"></rect>
                    </svg>
                    <span class="cp-wordmark">The Psychology Square</span>
                  </div>
                  <div class="cp-headline">Certificate</div>
                  <div class="cp-subhead">Of Completion</div>
                </div>

                <div class="cp-mid">
                  <p class="cp-presented">Presented to</p>
                  <div class="cp-recipient">{certificate.name}</div>
                  <p class="cp-desc">For successfully completing an online {kindWord}</p>
                  <div class="cp-course">{certificate.course_title}</div>
                  <div class="cp-date">{kindWordCap} completed on {formattedDate}</div>
                </div>

                <div class="cp-sigs">
                  <div class="cp-sig-col">
                    <img class="cp-sig-img" src="/images/certificates/sig-sohail.png" alt="Signature of Muhammad Sohail" width="480" height="279" />
                    <div class="cp-sig-name">Mr. Muhammad Sohail</div>
                    <div class="cp-sig-role">Founder and CEO</div>
                  </div>
                  <div class="cp-sig-col">
                    <img class="cp-sig-img" src="/images/certificates/sig-sehar.png" alt="Signature of Sehar Waheed" width="480" height="190" />
                    <div class="cp-sig-name">Ms. Sehar Waheed</div>
                    <div class="cp-sig-role">Co-CEO</div>
                  </div>
                </div>
              </div>

              <div class="cp-right">
                <svg class="cp-seal" viewBox="0 0 100 100" aria-hidden="true">
                  <circle cx="50" cy="50" r="47" fill="var(--gold-300)"></circle>
                  <circle cx="50" cy="50" r="47" fill="none" stroke="var(--gold-500)" stroke-width="1.5"></circle>
                  <circle cx="50" cy="50" r="33" fill="#FFFFFF"></circle>
                  <path id="cpArcTop" d="M10,50 A40,40 0 0 1 90,50" fill="none"></path>
                  <path id="cpArcBot" d="M10,50 A40,40 0 0 0 90,50" fill="none"></path>
                  <text font-family="IBM Plex Mono" font-weight="700" font-size="8" letter-spacing="1.5" fill="var(--navy-950)" dominant-baseline="central">
                    <textPath href="#cpArcTop" startOffset="50%" text-anchor="middle">VERIFIED</textPath>
                  </text>
                  <text font-family="IBM Plex Mono" font-weight="700" font-size="8" letter-spacing="1" fill="var(--navy-950)" dominant-baseline="central">
                    <textPath href="#cpArcBot" startOffset="50%" text-anchor="middle">CERTIFICATE</textPath>
                  </text>
                  <text x="90" y="50" font-size="11" text-anchor="middle" dominant-baseline="central" fill="var(--navy-800)">&#9733;</text>
                  <text x="10" y="50" font-size="11" text-anchor="middle" dominant-baseline="central" fill="var(--navy-800)">&#9733;</text>
                  <text x="87.6" y="36.3" font-size="6.5" text-anchor="middle" dominant-baseline="central" fill="var(--navy-800)">&#9733;</text>
                  <text x="12.4" y="36.3" font-size="6.5" text-anchor="middle" dominant-baseline="central" fill="var(--navy-800)">&#9733;</text>
                  <text x="12.4" y="63.7" font-size="6.5" text-anchor="middle" dominant-baseline="central" fill="var(--navy-800)">&#9733;</text>
                  <text x="87.6" y="63.7" font-size="6.5" text-anchor="middle" dominant-baseline="central" fill="var(--navy-800)">&#9733;</text>
                  <g transform="translate(50,50)">
                    <rect x="-10" y="-10" width="15" height="15" fill="none" stroke="var(--navy-800)" stroke-width="2.2"></rect>
                    <rect x="-5" y="-5" width="15" height="15" fill="none" stroke="var(--gold-500)" stroke-width="2.2"></rect>
                  </g>
                </svg>
                <div class="cp-bottom">
                  <div class="cp-verifybox">
                    <Fragment set:html={qrSvg} />
                    <div class="cp-verifytext">VERIFY<br />AUTHENTICITY</div>
                  </div>
                  <div class="cp-meta">
                    <div class="cp-certid">{certificate.id}</div>
                    <a class="cp-verifylink" href={verifyUrl} target="_blank" rel="noopener">thepsychologysquare.com/certificates/{certificate.id}</a>
                  </div>
                </div>
              </div>
            </div>
            </div>
          )}

          <!-- Scales the certificate to the available width BEFORE first paint
               (is:inline = not deferred like a bundled module script, so there is
               no flash of an unscaled, clipped card). Pure CSS can't do this on
               every browser yet: it needs unit division, calc(100cqw / 1080px). -->
          <script is:inline>
            (function () {
              var fit = document.querySelector('.cert-fit');
              if (!fit) return;
              var card = fit.firstElementChild;
              var W = parseFloat(fit.getAttribute('data-w'));
              function apply() {
                card.style.transform = 'scale(' + (fit.clientWidth / W) + ')';
                fit.setAttribute('data-ready', '');
              }
              apply();
              if ('ResizeObserver' in window) new ResizeObserver(apply).observe(fit);
              else window.addEventListener('resize', apply);
            })();
          </script>
          <noscript><style>.cert-fit{ overflow-x:auto; aspect-ratio:auto !important; } .cert-fit > *{ visibility:visible !important; transform:none !important; }</style></noscript>

          <div class="cert-actions">
            <button
              type="button"
              class="btn btn--primary"
              id="downloadPdfBtn"
              data-name={certificate.name}
              data-course-title={certificate.course_title}
              data-date={formattedDate}
              data-cert-id={certificate.id}
              data-is-paid={isPaidCert ? '1' : '0'}
              data-kind={kindWord}
            >Download PDF</button>
            <button type="button" class="btn btn--text" id="copyLinkBtn">Copy verification link</button>
            <a
              class="btn btn--text btn--linkedin"
              id="linkedinBtn"
              href={`https://www.linkedin.com/profile/add?startTask=CERTIFICATION_NAME&name=${encodeURIComponent(certificate.course_title)}&organizationName=${encodeURIComponent('The Psychology Square')}&issueYear=${new Date(certificate.issued_at).getFullYear()}&issueMonth=${new Date(certificate.issued_at).getMonth() + 1}&certUrl=${encodeURIComponent(`https://thepsychologysquare.com/certificates/${certificate.id}`)}&certId=${encodeURIComponent(certificate.id)}`}
              target="_blank"
              rel="noopener"
            >Add to LinkedIn &rarr;</a>
            <a href="/my-certificates" class="btn btn--text">View all my certificates &rarr;</a>
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

{certificate && (
  <script define:vars={{ certId: certificate.id }}>
    const copyBtn = document.getElementById('copyLinkBtn');
    copyBtn.addEventListener('click', async () => {
      const link = window.location.href;
      try {
        await navigator.clipboard.writeText(link);
      } catch {
        window.prompt('Copy this verification link:', link);
        return;
      }
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Link copied ✓';
      setTimeout(() => { copyBtn.textContent = original; }, 2000);
    });
  </script>
)}

{certificate && (
  <script>
    // A normal (bundled) script, deliberately NOT using define:vars — Astro
    // always inlines define:vars scripts as raw <script> tags, skipping the
    // Vite bundler entirely. That broke the dynamic import('jspdf') below,
    // since a bare package name only resolves through the bundler; the
    // browser had nothing to resolve "jspdf" against and the click silently
    // did nothing. Reading the certificate data from data-* attributes
    // instead lets this script go through Vite normally — which also means
    // it can import our own local modules the same way (see below).
    const btn = document.getElementById('downloadPdfBtn');
    btn?.addEventListener('click', async () => {
      const { name, courseTitle, date, certId, isPaid, kind } = btn.dataset;
      btn.disabled = true;
      btn.textContent = 'Preparing…';

      try {
        // Both loaded lazily so the (largish, signature-image-carrying)
        // layout module never ships in the initial page bundle — only on
        // click. isPaid picks which drawing function runs; free-course
        // certificates still go through the exact same drawCertificate()
        // as before, untouched.
        const [{ jsPDF }, layoutModule] = await Promise.all([
          import('jspdf'),
          isPaid === '1'
            ? import('../../lib/certificateLayoutPaid')
            : import('../../lib/certificateLayout'),
        ]);
        const mod = layoutModule as any;
        const draw = isPaid === '1' ? mod.drawCertificatePaid : mod.drawCertificate;
        const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
        draw(doc, { name, courseTitle, date, certId, kind });
        doc.save(`${certId}.pdf`);
      } catch (err) {
        console.error('Certificate PDF generation failed', err);
        alert('Sorry, the PDF could not be generated. Please try again or contact support.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Download PDF';
      }
    });
  </script>
)}

<style>
  .cert-page{ padding:64px 0 96px; }
  .wrap--cert{ max-width:980px; margin:0 auto; padding:0 24px; }

  @media (max-width: 600px){ .wrap--cert{ padding:0 10px; } .cert-page{ padding-bottom:64px; } }

  .not-found{ text-align:center; padding:80px 0; }
  .not-found h1{ font-family:var(--font-display); font-size:32px; margin-bottom:12px; }
  .not-found p{ color:var(--ink-600); }

  .verified-badge{
    display:inline-block; font-family:var(--font-mono); font-size:12px;
    color:#2E7D5B; background:rgba(46,125,91,0.1); padding:6px 14px; border-radius:20px;
    margin-bottom:24px; margin-top: 70px;
  }

  /* ---- Scaling frame -------------------------------------------------------
     A certificate is a fixed-size DESIGN (960px free / 1080px paid wide) that is
     scaled as one piece to the available width by the inline script above. It
     never reflows: a phone shows the same landscape certificate as a desktop,
     just smaller. The frame's height comes from the design's aspect ratio, so
     the page reserves the right space even before the script has run. */
  .cert-fit{
    position:relative; width:100%; overflow:hidden;
    -webkit-text-size-adjust:100%; text-size-adjust:100%; /* stop phones inflating the text */
  }
  .cert-fit > *{ transform-origin:0 0; }
  .cert-fit:not([data-ready]) > *{ visibility:hidden; }
  .cert-fit--free{ aspect-ratio:1.4142/1; }
  .cert-fit--paid{ aspect-ratio:1.55/1; box-shadow:0 20px 50px rgba(11,20,31,.18); }

  /* ---- Certificate card: A4-landscape proportioned, double frame + corner marks ---- */
  .certificate{
    position:relative;
    border:2px solid var(--gold-500);
    border-radius:2px;
    background:var(--paper-0);
    width:960px; /* design width; scaled by .cert-fit */
    aspect-ratio:1.4142/1; /* A4 landscape, same shape as the downloaded PDF */
    display:flex;
    flex-direction:column;
  }
  .certificate::before{
    content:'';
    position:absolute; inset:9px;
    border:1px solid var(--line);
    pointer-events:none;
  }
  .certificate__inner{
    position:relative; z-index:2;
    flex:1;
    display:flex; flex-direction:column; justify-content:flex-start;
    padding:40px 56px;
    text-align:center;
  }

  .mini-mark{ position:relative; display:block; width:14px; height:14px; }
  .mini-mark i{ position:absolute; display:block; border:1.5px solid var(--gold-500); }
  .mini-mark i:first-child{ inset:0 5px 5px 0; }
  .mini-mark i:last-child{ inset:5px 0 0 5px; border-color:var(--sage-500); }

  .certificate__corner{ position:absolute; z-index:2; opacity:0.6; }
  .certificate__corner--tl{ top:18px; left:18px; }
  .certificate__corner--tr{ top:18px; right:18px; }
  .certificate__corner--bl{ bottom:54px; left:18px; }
  .certificate__corner--br{ bottom:54px; right:18px; }

  .certificate__mark{ position:relative; width:26px; height:26px; margin:0 auto 16px; }
  .certificate__mark i{ position:absolute; display:block; border:2px solid var(--gold-500); }
  .certificate__mark i:first-child{ inset:0 9px 9px 0; }
  .certificate__mark i:last-child{ inset:9px 0 0 9px; border-color:var(--sage-500); }

  .certificate__eyebrow{ font-family:var(--font-mono); font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:var(--navy-700); margin-bottom:14px; }
  .certificate__title{ font-family:var(--font-display); font-size:32px; margin-bottom:18px; }
  .certificate__rule{ width:52px; height:1px; background:var(--gold-500); margin:0 auto 26px; }

  .certificate__line{ color:var(--ink-600); font-size:14px; margin:4px 0; }
  .certificate__name {
  font-family: var(--font-display);
  font-style: normal;
  font-weight: 600;
  font-size: 28px;
  margin: 8px 0;
  overflow-wrap: break-word;
}
  .certificate__course{
    font-family:var(--font-display); font-weight:600;
    font-size:22px; margin:8px 0 18px; overflow-wrap:break-word;
  }
  .certificate__date{
    font-family:var(--font-mono); font-size:13px; color:var(--ink-600);
    margin-bottom:34px;
  }

  .certificate__signatures{
    display:flex; justify-content:center; gap:64px; margin-bottom:20px; flex-wrap:wrap;
  }
  .certificate__sig-col{ display:flex; flex-direction:column; align-items:center; width:150px; }
  .certificate__sig-img{ height:38px; width:auto; max-width:150px; object-fit:contain; display:block; }
  .certificate__sig-line{ width:120px; border-top:1px solid var(--line); margin-top:6px; }
  .certificate__sig-name{ font-family:var(--font-body); font-weight:700; font-size:16px; color:var(--ink-900); margin-top:9px; }
  .certificate__sig-role{ font-family:var(--font-mono); font-weight:600; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--navy-700); margin-top:3px; }

  .certificate__footer{
    position:relative; z-index:2;
    display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:10.5px;
    color:var(--ink-600); border-top:1px solid var(--line); padding:10px 44px; margin-top:4px;
  }

  .cert-actions{ display:flex; align-items:center; justify-content:center; gap:20px; margin-top:32px; flex-wrap:wrap; }
  .btn{ font-family:var(--font-body); cursor:pointer; border:none; }
  .btn--primary{ background:var(--gold-500); color:var(--ink-900); padding:12px 26px; border-radius:2px; }
  .btn--primary:disabled{ opacity:0.6; cursor:default; }
  .btn--text{ background:none; color:var(--ink-900); text-decoration:underline; }


  /* ================================================================
     Paid-course certificate (navy/gold two-panel design).
     ZOOM / RESIZE SAFETY: the certificate is its own size container
     (container-type:inline-size) with a locked aspect ratio, and every
     measurement inside it is in cqw (1cqw = 1% of the certificate's own
     width) or a % of its parent. Nothing is a fixed px, so browser zoom,
     window resize and odd screen sizes all scale the WHOLE certificate as
     one piece instead of letting text and boxes drift apart.
     Reference design width = 1080px, so 1 design-px = 0.0926cqw.
     Phones no longer reflow: the whole 1080px design is scaled down by .cert-fit
     (transform), so it keeps exactly the same layout at every screen size.
     ================================================================ */
  .certificate-paid{
    /* Local tokens/reset so nothing from the site's global styles (body
       line-height:1.6, --line at .12, antialiased smoothing) can leak in and
       shift the design away from the approved replica. */
    --line:rgba(19,26,34,0.14);
    container-type:inline-size;
    width:1080px; /* design width; scaled by .cert-fit. cqw units below resolve against THIS, so 1cqw is always 10.8px */
    aspect-ratio:1.55/1;
    position:relative;
    overflow:hidden;
    display:grid;
    grid-template-columns:1fr 32%;
    background:var(--paper-0);
    color:var(--ink-900);
    text-align:left;
    font-family:var(--font-body);
    line-height:normal;
    -webkit-font-smoothing:auto;
  }
  .cp-left{ display:flex; flex-direction:column; justify-content:space-between; padding:4.5% 8% 4%; min-width:0; height:100%; }
  .cp-top{ flex:0 0 auto; }
  .cp-mid{ flex:0 0 auto; margin:auto 0; max-width:100%; }
  .cp-sigs{ flex:0 0 auto; }

  .cp-logo{ display:flex; align-items:center; gap:1.111cqw; }
  .cp-logo-mark{ width:3.148cqw; height:3.148cqw; flex:none; }
  .cp-logo-mark rect{ fill:none; stroke-width:2; }
  .cp-logo-mark rect:first-child{ stroke:var(--navy-800); }
  .cp-logo-mark rect:last-child{ stroke:var(--gold-500); }
  .cp-wordmark{ font-family:var(--font-mono); font-weight:600; font-size:1.482cqw; letter-spacing:.15em; text-transform:uppercase; color:var(--navy-800); }
  .cp-headline{ font-family:var(--font-display); font-weight:600; font-size:4.815cqw; line-height:1; color:var(--navy-800); margin-top:1.482cqw; }
  .cp-subhead{ font-size:1.204cqw; letter-spacing:.32em; text-transform:uppercase; color:var(--ink-600); margin-top:.833cqw; }

  .cp-presented, .cp-desc{ font-size:1.389cqw; color:var(--ink-600); margin:0; }
  .cp-recipient{ font-family:var(--font-display); font-size:3.148cqw; color:var(--gold-500); margin:.463cqw 0 1.482cqw; overflow-wrap:break-word; word-break:break-word; }
  .cp-course{ font-family:var(--font-body); font-weight:700; font-size:1.759cqw; color:var(--ink-900); margin-top:.556cqw; overflow-wrap:break-word; word-break:break-word; }
  .cp-date{ font-size:1.296cqw; color:var(--ink-600); margin-top:.556cqw; }

  .cp-sigs{ display:flex; gap:5.185cqw; }
  .cp-sig-col{ display:flex; flex-direction:column; min-width:0; }
  /* Real signature images stand in for the replica's placeholder scribbles;
     they sit in the same spot: directly above the name, left-aligned. */
  .cp-sig-img{ height:3.6cqw; width:auto; max-width:14cqw; object-fit:contain; object-position:left bottom; display:block; margin-top:-1.007cqw; margin-bottom:.185cqw; } /* net layout height = replica's 28px slot; the larger real signature overflows upward */
  /* Replica: name has NO rule above it; the rule sits between name and role. */
  .cp-sig-name{ font-family:var(--font-display); font-size:1.759cqw; color:var(--ink-900); border-top:none; padding-top:0; }
  .cp-sig-role{ font-family:var(--font-mono); font-size:1.065cqw; color:var(--ink-600); letter-spacing:.05em; text-transform:uppercase; margin-top:.463cqw; border-top:1px solid var(--line); padding-top:.556cqw; }

  .cp-right{
    position:relative; display:flex; flex-direction:column; align-items:center; justify-content:space-between;
    padding:7% 6%; min-width:0;
