---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';

const { id } = Astro.params;

let certificate: {
  id: string; course_title: string; ce_hours: number; name: string;
  email: string; score_percent: number; issued_at: string;
} | null = null;

if (env?.DB && id) {
  certificate = await env.DB.prepare(
    `SELECT id, course_title, ce_hours, name, email, score_percent, issued_at FROM certificates WHERE id = ?`
  ).bind(id).first();
}

const formattedDate = certificate
  ? new Date(certificate.issued_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---
<Layout
  title={certificate ? `Certificate — ${certificate.course_title}` : 'Certificate not found'}
  description="Verify a certificate issued by The Psychology Square."
>
  <section class="cert-page">
    <div class="wrap wrap--narrow">
      {!certificate && (
        <div class="not-found">
          <h1>Certificate not found</h1>
          <p>We couldn't find a certificate with that ID. Double-check the link, or contact us if you believe this is an error.</p>
        </div>
      )}

      {certificate && (
        <>
          <div class="verified-badge">✓ Verified certificate — publicly viewable by anyone with this link</div>

          <div class="certificate" id="certificateCard">
            <div class="certificate__eyebrow">The Psychology Square</div>
            <div class="certificate__title">Certificate of Completion</div>
            <p class="certificate__line">This certifies that</p>
            <div class="certificate__name">{certificate.name}</div>
            <p class="certificate__line">has successfully completed</p>
            <div class="certificate__course">{certificate.course_title}</div>
            <div class="certificate__details">
              <div><span>Score</span><strong>{certificate.score_percent}%</strong></div>
              <div><span>Hours</span><strong>{certificate.ce_hours}</strong></div>
              <div><span>Date</span><strong>{formattedDate}</strong></div>
            </div>
            <div class="certificate__footer">
              <span>Certificate ID: {certificate.id}</span>
              <span>thepsychologysquare.com/certificates/{certificate.id}</span>
            </div>
          </div>

          <div class="cert-actions">
            <button
              type="button"
              class="btn btn--primary"
              id="downloadPdfBtn"
              data-name={certificate.name}
              data-course-title={certificate.course_title}
              data-ce-hours={certificate.ce_hours}
              data-score-percent={certificate.score_percent}
              data-date={formattedDate}
              data-cert-id={certificate.id}
            >Download PDF</button>
            <button type="button" class="btn btn--text" id="copyLinkBtn">Copy verification link</button>
            <a href="/my-certificates" class="btn btn--text">View all my certificates &rarr;</a>
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

{certificate && (
  <script define:vars={{ certId: certificate.id }}>
    const copyBtn = document.getElementById('copyLinkBtn');
    copyBtn.addEventListener('click', async () => {
      const link = window.location.href;
      try {
        await navigator.clipboard.writeText(link);
      } catch {
        window.prompt('Copy this verification link:', link);
        return;
      }
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Link copied ✓';
      setTimeout(() => { copyBtn.textContent = original; }, 2000);
    });
  </script>
)}

{certificate && (
  <script>
    // A normal (bundled) script, deliberately NOT using define:vars — Astro
    // always inlines define:vars scripts as raw <script> tags, skipping the
    // Vite bundler entirely. That broke the dynamic import('jspdf') below,
    // since a bare package name only resolves through the bundler; the
    // browser had nothing to resolve "jspdf" against and the click silently
    // did nothing. Reading the certificate data from data-* attributes
    // instead lets this script go through Vite normally.
    const btn = document.getElementById('downloadPdfBtn');
    btn?.addEventListener('click', async () => {
      const { name, courseTitle, ceHours, scorePercent, date, certId } = btn.dataset;
      btn.disabled = true;
      btn.textContent = 'Preparing…';

      try {
        const { jsPDF } = await import('jspdf');
        const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const centerX = pageWidth / 2;

        const gold = [199, 164, 74];
        const ink = [19, 26, 34];
        const inkLight = [75, 87, 96];

        doc.setDrawColor(...gold);
        doc.setLineWidth(1.5);
        doc.rect(24, 24, pageWidth - 48, pageHeight - 48);

        doc.setTextColor(...gold);
        doc.setFont('times', 'bold');
        doc.setFontSize(13);
        doc.text('THE PSYCHOLOGY SQUARE', centerX, 80, { align: 'center' });

        doc.setTextColor(...ink);
        doc.setFont('times', 'bold');
        doc.setFontSize(32);
        doc.text('Certificate of Completion', centerX, 120, { align: 'center' });

        doc.setFont('times', 'normal');
        doc.setFontSize(14);
        doc.setTextColor(...inkLight);
        doc.text('This certifies that', centerX, 165, { align: 'center' });

        doc.setFont('times', 'bolditalic');
        doc.setFontSize(28);
        doc.setTextColor(...ink);
        doc.text(name, centerX, 200, { align: 'center' });

        doc.setFont('times', 'normal');
        doc.setFontSize(14);
        doc.setTextColor(...inkLight);
        doc.text('has successfully completed', centerX, 230, { align: 'center' });

        doc.setFont('times', 'bold');
        doc.setFontSize(20);
        doc.setTextColor(...ink);
        doc.text(courseTitle, centerX, 260, { align: 'center' });

        doc.setFont('times', 'normal');
        doc.setFontSize(12);
        doc.setTextColor(...inkLight);
        doc.text(`Score: ${scorePercent}%      Hours: ${ceHours}      Date: ${date}`, centerX, 300, { align: 'center' });

        doc.setFontSize(10);
        doc.text(`Certificate ID: ${certId}`, centerX, pageHeight - 50, { align: 'center' });
        doc.text(`thepsychologysquare.com/certificates/${certId}`, centerX, pageHeight - 36, { align: 'center' });

        doc.save(`${certId}.pdf`);
      } catch (err) {
        console.error('Certificate PDF generation failed', err);
        alert('Sorry, the PDF could not be generated. Please try again or contact support.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Download PDF';
      }
    });
  </script>
)}

<style>
  .cert-page{ padding:64px 0 96px; }
  .wrap--narrow{ max-width:760px; margin:0 auto; padding:0 24px; }

  .not-found{ text-align:center; padding:80px 0; }
  .not-found h1{ font-family:var(--font-display); font-size:32px; margin-bottom:12px; }
  .not-found p{ color:var(--ink-600); }

  .verified-badge{
    display:inline-block; font-family:var(--font-mono); font-size:12px;
    color:#2E7D5B; background:rgba(46,125,91,0.1); padding:6px 14px; border-radius:20px;
    margin-bottom:24px;
  }

  .certificate{
    border:2px solid var(--gold-500); border-radius:2px; padding:56px 40px; text-align:center;
    background:var(--paper-0);
  }
  .certificate__eyebrow{ font-family:var(--font-mono); font-size:12px; letter-spacing:0.1em; color:var(--gold-500); margin-bottom:14px; }
  .certificate__title{ font-family:var(--font-display); font-size:32px; margin-bottom:24px; }
  .certificate__line{ color:var(--ink-600); font-size:14px; margin:4px 0; }
  .certificate__name{ font-family:var(--font-display); font-style:italic; font-size:30px; margin:8px 0; }
  .certificate__course{ font-family:var(--font-display); font-size:22px; font-weight:600; margin:8px 0 28px; }
  .certificate__details{ display:flex; justify-content:center; gap:40px; margin-bottom:28px; }
  .certificate__details div{ display:flex; flex-direction:column; gap:4px; }
  .certificate__details span{ font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--ink-600); }
  .certificate__details strong{ font-size:16px; }
  .certificate__footer{
    display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:11px;
    color:var(--ink-600); border-top:1px solid var(--line); padding-top:16px; margin-top:8px;
  }

  .cert-actions{ display:flex; align-items:center; justify-content:center; gap:20px; margin-top:32px; }
  .btn{ font-family:var(--font-body); cursor:pointer; border:none; }
  .btn--primary{ background:var(--gold-500); color:var(--ink-900); padding:12px 26px; border-radius:2px; }
  .btn--primary:disabled{ opacity:0.6; cursor:default; }
  .btn--text{ background:none; color:var(--ink-900); text-decoration:underline; }

  @media (max-width: 600px) {
    .certificate__footer{ flex-direction:column; gap:4px; text-align:center; }
    .certificate__details{ gap:24px; flex-wrap:wrap; }
  }
</style>
