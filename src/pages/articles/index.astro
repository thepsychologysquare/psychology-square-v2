---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = allArticles.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const categoryMeta: Record<string, string> = {
  'anxiety': 'Anxiety',
  'depression': 'Depression',
  'adhd': 'ADHD',
  'addiction-recovery': 'Addiction & Recovery',
  'trauma': 'Trauma',
  'relationships': 'Relationships',
  'stress-burnout': 'Stress & Burnout',
};
// Fallback for categories not in the list above (e.g. one typed straight
// into an article's frontmatter) — Title Case instead of a raw slug.
function categoryLabel(slug: string) {
  return categoryMeta[slug] || slug.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

// Auto-derived from actual content — adding a category later needs zero page edits.
const categoriesPresent = [...new Set(sorted.map((a) => a.data.category))].sort();

const siteOrigin = 'https://thepsychologysquare.com';
const blogJson = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "The Psychology Square — Articles",
  "url": `${siteOrigin}/articles`,
  "description": "Clinically-reviewed articles on anxiety, depression, ADHD, trauma, relationships, and more.",
  "blogPost": sorted.slice(0, 20).map((a) => {
    const imgUrl = typeof a.data.image === 'string' ? a.data.image : a.data.image?.src;
    return {
      "@type": "BlogPosting",
      "headline": a.data.title,
      "description": a.data.description,
      "url": `${siteOrigin}/articles/${a.id}`,
      "datePublished": a.data.publishDate.toISOString(),
      "author": { "@type": "Person", "name": a.data.author },
      ...(imgUrl ? { "image": `${siteOrigin}${imgUrl}` } : {}),
    };
  }),
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Articles", "item": `${siteOrigin}/articles` },
  ],
};
---

<Layout
  title="Articles"
  fullTitle="Anxiety & Depression Articles | The Psychology Square"
  description="In-depth, clinically-reviewed articles on anxiety, depression, ADHD, trauma & more — written by licensed clinical psychologists in Lahore, Pakistan."
>
  <script type="application/ld+json" set:html={JSON.stringify(blogJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Articles</span>
      </nav>
      <p class="eyebrow">From the Practice</p>
      <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px;">Articles</h1>
      <p class="hero-sub">Grounded, clinically-reviewed writing on anxiety, depression, ADHD, trauma, relationships, and more — no generic advice.</p>
    </div>
  </section>

  <section class="section" style="padding-bottom: 0;">
    <div class="wrap">
      <p class="articles-intro">
        Every article here is written or reviewed by a clinical psychologist at The Psychology Square, drawing on real clinical training rather than generic wellness content. Below you'll find {sorted.length} article{sorted.length === 1 ? '' : 's'} across {categoriesPresent.length} topic areas — use the search and filters to find what's relevant, or browse by topic:
      </p>
      <div class="topic-link-row">
        {categoriesPresent.map((cat) => (
          <a href={`/articles/category/${cat}`} class="topic-pill">{categoryLabel(cat)}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="toolbar">
        <input type="text" id="search-input" class="search-input" placeholder="Search articles…" autocomplete="off" />

        <details class="filter-dropdown" id="filter-dropdown">
          <summary class="filter-toggle">
            Filters <span class="filter-badge" id="filter-badge" hidden>0</span>
          </summary>
          <div class="filter-panel">
            <div class="filter-group">
              <h3 class="filter-heading">Category</h3>
              <div class="checkbox-list" id="category-filters">
                {categoriesPresent.map((cat) => (
                  <label class="checkbox-row">
                    <input type="checkbox" value={cat} class="category-checkbox" data-label={categoryLabel(cat)} />
                    <span>{categoryLabel(cat)}</span>
                  </label>
                ))}
              </div>
            </div>



            <div class="filter-panel-actions">
              <button type="button" id="clear-filters" class="clear-filters-btn">Clear all</button>
              <button type="button" class="btn btn--primary filter-done-btn" id="filter-done">Show results</button>
            </div>
          </div>
        </details>
      </div>

      <div class="active-chips" id="active-chips"></div>

      <p class="results-count" id="results-count"></p>

      <div class="card-grid" id="article-grid">
        {sorted.map((article) => {
          const imgSrc = typeof article.data.image === 'string' ? article.data.image : article.data.image?.src;
          return (
            <a
              class="article-card"
              href={`/articles/${article.id}`}
              data-title={article.data.title.toLowerCase()}
              data-description={article.data.description.toLowerCase()}
              data-category={article.data.category}
            >
              {imgSrc && (
                <div class="card-image-wrap">
                  <img 
                    src={imgSrc} 
                    alt={article.data.imageAlt || article.data.title} 
                    loading="lazy"
                  />
                </div>
              )}
              <div class="card-body">
                <span class="article-meta">{categoryLabel(article.data.category)}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>

      <p class="no-results" id="no-results" hidden>No articles match your filters. Try clearing some, or search a different term.</p>
      <div class="pager" id="pager"></div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumbs{
    font-family: var(--font-mono); font-size: 12px; color: rgba(248,249,246,0.6);
    margin-bottom: 20px; display:flex; flex-wrap:wrap; gap:6px; align-items:center; 
  }
  .breadcrumbs a:hover{ color: var(--gold-300); }
  .crumb-sep{ color: rgba(248,249,246,0.3); }
  .crumb-current{ color: rgba(248,249,246,0.85); }

  .articles-intro{
    max-width: 680px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-600);
    margin-bottom: 20px;
  }
  .topic-link-row{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom: 48px; }
  .topic-link-row .topic-pill{
    font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--navy-700); border: 1px solid var(--line); padding: 9px 16px; border-radius: 999px;
    background: var(--paper-0); transition: border-color .2s var(--ease), color .2s var(--ease);
  }
  .topic-link-row .topic-pill:hover{ border-color: var(--gold-500); color: var(--gold-500); }

  .toolbar{
    display:flex;
    gap:12px;
    position: relative;
    z-index: 20;
  }
  .search-input{
    flex: 1;
    font-family: var(--font-body);
    font-size: 14.5px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper-0);
    color: var(--ink-900);
  }
  .search-input:focus{ outline: 2px solid var(--gold-500); outline-offset: 1px; }

  .filter-dropdown{ position: relative; }
  .filter-toggle{
    display:flex;
    align-items:center;
    gap:8px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--navy-950);
    background: var(--paper-0);
    border: 1px solid var(--line);
    padding: 12px 20px;
    border-radius: 3px;
    cursor: pointer;
    white-space: nowrap;
    list-style: none;
    user-select: none;
  }
  .filter-toggle::-webkit-details-marker{ display:none; }
  .filter-toggle:hover{ border-color: var(--gold-500); }
  .filter-dropdown[open] .filter-toggle{ border-color: var(--navy-950); background: var(--navy-950); color: var(--paper-0); }

  .filter-badge{
    background: var(--gold-500);
    color: var(--navy-950);
    font-size: 11px;
    font-weight: 700;
    border-radius: 999px;
    padding: 1px 7px;
    min-width: 18px;
    text-align: center;
  }

  .filter-panel{
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: min(360px, calc(100vw - 64px));
    max-height: 60vh;
    overflow-y: auto;
    background: var(--paper-0);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 12px 32px rgba(19,26,34,0.14);
    padding: 22px;
    display:flex;
    flex-direction: column;
    gap: 22px;
  }

  .filter-group{ display:flex; flex-direction:column; gap:10px; }
  .filter-heading{
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-600);
  }
  .checkbox-list{ display:flex; flex-direction:column; gap:10px; }
  .checkbox-row{
    display:flex;
    align-items:center;
    gap:9px;
    font-size: 14px;
    color: var(--ink-900);
    cursor: pointer;
  }
  .checkbox-row input{ accent-color: var(--gold-500); width:15px; height:15px; flex:none; }
  .checkbox-row.is-extra{ display: none; }
  .checkbox-row.is-extra.is-shown{ display: flex; }

  .show-more-btn{
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--sage-500);
    background: none;
    border: none;
    text-align: left;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .filter-panel-actions{
    display:flex;
    justify-content: space-between;
    align-items:center;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }
  .clear-filters-btn{
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-600);
    background: none;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    padding: 0;
  }
  .clear-filters-btn:hover{ color: var(--gold-500); }
  .filter-done-btn{ font-size: 13px; padding: 10px 20px; }

  .active-chips{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top: 18px;
  }
  .active-chips:empty{ margin-top: 0; }
  .active-chip{
    display:flex;
    align-items:center;
    gap:7px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--navy-950);
    background: var(--paper-50);
    border: 1px solid var(--line);
    padding: 6px 10px 6px 14px;
    border-radius: 999px;
  }
  .active-chip button{
    background: none;
    border: none;
    color: var(--ink-600);
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    padding: 2px;
  }
  .active-chip button:hover{ color: var(--gold-500); }

  .results-count{
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-600);
    margin: 24px 0;
  }
  .no-results{ color: var(--ink-600); padding: 40px 0; }
  
  /* Article Card Base & Image Styling */
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .card-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--paper-50);
    border-bottom: 1px solid var(--line);
  }
  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }
  .article-card:hover .card-image-wrap img {
    transform: scale(1.03);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .article-card.is-hidden{ display:none; }
  .article-card.is-paged-out{ display:none; }
  .pager{ display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-top:40px; }
  .pager-btn{
    font-family:var(--font-mono); font-size:13px; padding:8px 14px;
    border:1px solid var(--line); border-radius:2px; background:var(--paper-0); cursor:pointer;
  }
  .pager-btn:hover:not(:disabled){ border-color:var(--gold-500); }
  .pager-btn.is-current{ background:var(--gold-500); border-color:var(--gold-500); color:var(--navy-950); font-weight:600; }
  .pager-btn:disabled{ opacity:0.4; cursor:not-allowed; }

  @media (max-width: 600px){
    .toolbar{ flex-direction: column; }
    .filter-panel{ right: 0; left: 0; width: auto; }
  }
</style>

<script>
  import { createPaginator } from '../../lib/pagination';

  type FilterEntry = { type: 'category'; value: string; label: string };

  const paginator = createPaginator({ pagerEl: document.getElementById('pager')! });

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterDropdown = document.getElementById('filter-dropdown') as HTMLDetailsElement;
  const filterBadge = document.getElementById('filter-badge') as HTMLElement;
  const categoryCheckboxes = document.querySelectorAll<HTMLInputElement>('.category-checkbox');
  const clearBtn = document.getElementById('clear-filters');
  const doneBtn = document.getElementById('filter-done');
  const cards = document.querySelectorAll<HTMLElement>('#article-grid .article-card');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const activeChipsContainer = document.getElementById('active-chips');

  // Collapse long checkbox lists behind a "show more" toggle.
  function setupShowMore(containerId: string, threshold = 8) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const rows = [...container.querySelectorAll('.checkbox-row')];
    if (rows.length <= threshold) return;
    rows.slice(threshold).forEach((row) => row.classList.add('is-extra'));
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'show-more-btn';
    btn.textContent = `+ Show ${rows.length - threshold} more`;
    btn.addEventListener('click', () => {
      const nowShown = container.querySelectorAll('.checkbox-row.is-extra.is-shown').length === 0;
      rows.slice(threshold).forEach((row) => row.classList.toggle('is-shown', nowShown));
      btn.textContent = nowShown ? 'Show less' : `+ Show ${rows.length - threshold} more`;
    });
    container.after(btn);
  }
  setupShowMore('category-filters');

  function getActiveFilters(): FilterEntry[] {
    return [...categoryCheckboxes]
      .filter((c) => c.checked)
      .map((c) => ({ type: 'category' as const, value: c.value, label: c.dataset.label || c.value }));
  }

  function renderChips() {
    if (!activeChipsContainer) return;
    const active = getActiveFilters();
    activeChipsContainer.innerHTML = '';
    active.forEach((f) => {
      const chip = document.createElement('span');
      chip.className = 'active-chip';
      chip.innerHTML = `${f.label} <button type="button" aria-label="Remove filter">✕</button>`;
      chip.querySelector('button')?.addEventListener('click', () => {
        categoryCheckboxes.forEach((c) => { if (c.value === f.value) c.checked = false; });
        applyFilters();
      });
      activeChipsContainer.appendChild(chip);
    });

    if (filterBadge) {
      filterBadge.hidden = active.length === 0;
      filterBadge.textContent = String(active.length);
    }
  }

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    const activeCategories = [...categoryCheckboxes].filter((c) => c.checked).map((c) => c.value);

    let visibleCount = 0;

    cards.forEach((card) => {
      const title = card.dataset.title || '';
      const description = card.dataset.description || '';
      const category = card.dataset.category || '';

      const matchesSearch = !query || title.includes(query) || description.includes(query);
      const matchesCategory = activeCategories.length === 0 || activeCategories.includes(category);

      const show = matchesSearch && matchesCategory;
      card.classList.toggle('is-hidden', !show);
      if (show) visibleCount++;
    });

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} article${cards.length === 1 ? '' : 's'}`;
    }
    if (noResults) noResults.hidden = visibleCount !== 0;

    const eligible = [...cards].filter((c) => !c.classList.contains('is-hidden'));
    paginator.refresh(eligible);

    renderChips();
  }

  searchInput.addEventListener('input', applyFilters);
  categoryCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));

  clearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    categoryCheckboxes.forEach((cb) => (cb.checked = false));
    applyFilters();
  });

  doneBtn?.addEventListener('click', () => { filterDropdown.open = false; });

  document.addEventListener('click', (e) => {
    if (filterDropdown.open && !filterDropdown.contains(e.target as Node)) {
      filterDropdown.open = false;
    }
  });

  applyFilters();
</script>