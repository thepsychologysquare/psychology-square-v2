---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const categoryMeta: Record<string, string> = {
  'anxiety': 'Anxiety',
  'depression': 'Depression',
  'adhd': 'ADHD',
  'addiction-recovery': 'Addiction & Recovery',
  'trauma': 'Trauma',
  'relationships': 'Relationships',
  'stress-burnout': 'Stress & Burnout',
};

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const { Content } = await render(article);

const related = allArticles
  .filter((a) => a.id !== article.id)
  .map((a) => ({
    entry: a,
    score:
      a.data.tags.filter((t: string) => article.data.tags.includes(t)).length +
      (a.data.category === article.data.category ? 1 : 0),
  }))
  .filter((a) => a.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((a) => a.entry);

const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = article.data.publishDate.toISOString();
const canonicalPath = `/articles/${article.id}`;

const mainImgSrc = typeof article.data.image === 'string' ? article.data.image : article.data.image?.src;
---

<Layout
  title={article.data.title}
  description={article.data.description}
  fullTitle={`${article.data.title} — The Psychology Square`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": article.data.title,
    "description": article.data.description,
    "datePublished": isoDate,
    "dateModified": isoDate,
    "author": { "@type": "Person", "name": article.data.author },
    ...(article.data.reviewedBy ? { "reviewedBy": { "@type": "Person", "name": article.data.reviewedBy } } : {}),
    ...(mainImgSrc ? { "image": `https://www.thepsychologysquare.com${mainImgSrc}` } : {}),
    "publisher": {
      "@type": "Organization",
      "name": "The Psychology Square",
      "url": "https://www.thepsychologysquare.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://www.thepsychologysquare.com${canonicalPath}`
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.thepsychologysquare.com/" },
      { "@type": "ListItem", "position": 2, "name": "Articles", "item": "https://www.thepsychologysquare.com/articles" },
      { "@type": "ListItem", "position": 3, "name": categoryMeta[article.data.category] || article.data.category, "item": `https://www.thepsychologysquare.com/articles/category/${article.data.category}` },
      { "@type": "ListItem", "position": 4, "name": article.data.title, "item": `https://www.thepsychologysquare.com${canonicalPath}` }
    ]
  })} />
  <article class="article-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/articles">Articles</a>
        <span class="crumb-sep">/</span>
        <a href={`/articles/category/${article.data.category}`}>{categoryMeta[article.data.category] || article.data.category}</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">{article.data.title}</span>
      </nav>

      <span class="article-meta" style="display:block; margin-bottom: 14px;">
        {categoryMeta[article.data.category] || article.data.category}{article.data.subcategory && <> / {article.data.subcategory}</>}
      </span>
      <h1 class="article-title">{article.data.title}</h1>

      <div class="byline">
        <span>By {article.data.author}</span>
        {article.data.reviewedBy && <span> · Reviewed by {article.data.reviewedBy}</span>}
        <span> · <time datetime={isoDate}>{formattedDate}</time></span>
      </div>

      {mainImgSrc && (
        <figure class="article-hero-image">
          <img 
            src={mainImgSrc} 
            alt={article.data.imageAlt || article.data.title} 
            loading="eager" 
          />
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      {article.data.tags.length > 0 && (
        <div class="tag-row">
          {article.data.tags.map((tag: string) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="wrap">
        <div class="section-head">
          <h2 class="section-title">Related articles</h2>
        </div>
        <div class="card-grid">
          {related.map((a) => {
            const relImgSrc = typeof a.data.image === 'string' ? a.data.image : a.data.image?.src;
            return (
              <a class="article-card" href={`/articles/${a.id}`}>
                {relImgSrc && (
                  <div class="card-image-wrap">
                    <img 
                      src={relImgSrc} 
                      alt={a.data.imageAlt || a.data.title} 
                      loading="lazy" 
                    />
                  </div>
                )}
                <div class="card-body">
                  <span class="article-meta">{categoryMeta[a.data.category] || a.data.category}</span>
                  <h3>{a.data.title}</h3>
                  <p>{a.data.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .article-page{ padding: 56px 0 80px; max-width: 100%; }
  .article-page .wrap{ max-width: 760px; }

  .breadcrumbs{
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-600);
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    align-items:center;
    margin-top: 65px;
    margin-bottom: 10px;

  }
  .breadcrumbs a:hover{ color: var(--gold-500); }
  .crumb-sep{ color: var(--line); }
  .crumb-current{ color: var(--ink-900); }

  @media (max-width: 768px) {
  .breadcrumbs {
    margin-top: 50px; /* Mobile adjustment */
  }
}
  

  .article-title{
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .byline{
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-600);
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .article-hero-image {
    margin: 0 0 40px 0;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--paper-50);
  }
  .article-hero-image img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .prose{
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-900);
  }
  .prose :global(h2){
    font-size: 24px;
    margin: 40px 0 16px;
  }
  .prose :global(p){
    margin-bottom: 18px;
  }
  .prose :global(ul), .prose :global(ol){
    margin: 0 0 18px;
    padding-left: 22px;
  }
  .prose :global(li){ margin-bottom: 8px; }

  .tag-row{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .tag-pill{
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sage-500);
    border: 1px solid var(--line);
    padding: 6px 12px;
    border-radius: 999px;
  }

  /* Related Article Cards Image Layout */
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .card-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--paper-50);
    border-bottom: 1px solid var(--line);
  }
  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }
  .article-card:hover .card-image-wrap img {
    transform: scale(1.03);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
</style>