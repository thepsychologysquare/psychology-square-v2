---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const topicImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/topics/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getTopicImage(slug: string) {
  const entry = Object.entries(topicImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

// Friendly names for the categories we already know about (same list used
// elsewhere on the site). Anything not in here falls back to the name from
// the Decap "categories" collection if one exists, and finally to a
// Title-Cased version of the slug itself — so a category never shows up
// looking like a raw slug.
const categoryLabels: Record<string, string> = {
  'anxiety': 'Anxiety',
  'depression': 'Depression',
  'adhd': 'ADHD',
  'addiction-recovery': 'Addiction & Recovery',
  'trauma': 'Trauma',
  'relationships': 'Relationships',
  'stress-burnout': 'Stress & Burnout',
};
function titleCaseFromSlug(slug: string) {
  return slug
    .split('-')
    .map((w) => (w.length ? w.charAt(0).toUpperCase() + w.slice(1) : w))
    .join(' ');
}

// Decap-managed category entries (src/content/categories) give us nicer
// display names for anything added through the CMS's "Categories" tab.
const decapCategories = await getCollection('categories');
const decapNameBySlug = new Map(decapCategories.map((c) => [c.id, c.data.name]));

// The category list itself is derived straight from published articles —
// not from the Decap "categories" collection — because a category becomes
// "real" the moment an article uses it, whether it was picked from the
// Decap relation field or just typed directly into an article's frontmatter
// (e.g. a category the n8n pipeline invented on its own). This means a
// brand new category shows up here automatically on the next build, with
// no manual step required.
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const a of allArticles) {
  counts.set(a.data.category, (counts.get(a.data.category) || 0) + 1);
}

const categories = [...counts.entries()]
  .map(([slug, count], i) => ({
    slug,
    label: categoryLabels[slug] || decapNameBySlug.get(slug) || titleCaseFromSlug(slug),
    count,
    img: getTopicImage(slug),
    graphic: `bg-placeholder-${(i % 9) + 1}`,
  }))
  .sort((a, b) => a.label.localeCompare(b.label));

// A–Z index (mirrors the verywellmind.com/conditions-a-z layout): a full
// alphabet strip up top, then categories grouped under their first letter.
// Letters with no categories still render in the strip, just inactive.
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const lettersInUse = new Set(categories.map((c) => c.label[0].toUpperCase()));
const groupedByLetter = alphabet
  .map((letter) => ({
    letter,
    items: categories.filter((c) => c.label[0].toUpperCase() === letter),
  }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title="Categories A-Z"
  fullTitle="Mental Health Topics A-Z | The Psychology Square"
  description="Browse psychology topics — anxiety, depression, ADHD, trauma, relationships & neuroscience — with articles from a clinical psychology practice in Lahore."
>
  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/articles">Articles</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Categories</span>
      </nav>
      <p class="eyebrow">Browse by Topic</p>
      <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px;">Categories A-Z</h1>
      <p class="hero-sub">Every topic we've written about, organized alphabetically so you can find it fast.</p>
    </div>
  </section>

  <section class="section" style="padding-bottom: 0;">
    <div class="wrap">
      <p class="az-intro">
        The Psychology Square publishes clinically reviewed articles, neuroscience research summaries, therapy
        guides, and self-help worksheets across a growing set of topics — from specific mental health conditions
        to broader themes in psychology and wellbeing. This page groups everything we've written by category, so
        whether you already know what you're looking for or just want to browse, you can jump straight to a
        letter below or search by name to see every article we have on that topic in one place.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="az-search-wrap">
        <svg class="az-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input type="text" id="az-search" class="az-search-input" placeholder="Search categories…" autocomplete="off" />
      </div>

      <p class="az-label">Find a topic by its first letter:</p>
      <nav class="az-bar" aria-label="Jump to categories by letter" id="az-bar">
        {alphabet.map((letter) => (
          lettersInUse.has(letter)
            ? <a href={`#letter-${letter}`} class="az-letter az-letter--active" data-letter={letter}>{letter}</a>
            : <span class="az-letter" data-letter={letter}>{letter}</span>
        ))}
      </nav>

      <div id="az-groups">
        {groupedByLetter.map((group) => (
          <div class="az-group" id={`letter-${group.letter}`} data-letter={group.letter}>
            <span class="az-group-badge">{group.letter}</span>
            <div class="az-group-list">
              {group.items.map((cat) => (
                <a class="az-item" href={`/articles/category/${cat.slug}`} data-name={cat.label.toLowerCase()}>
                  <span class={`az-item-thumb ${cat.img ? '' : cat.graphic}`}>
                    {cat.img && <img src={cat.img.src} alt={cat.label} loading="lazy" />}
                  </span>
                  <span class="az-item-label">{cat.label}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <p class="az-no-results" id="az-no-results" hidden>No categories match "<span id="az-no-results-query"></span>".</p>
    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('az-search') as HTMLInputElement;
  const groups = [...document.querySelectorAll<HTMLElement>('#az-groups .az-group')];
  const letters = [...document.querySelectorAll<HTMLElement>('#az-bar .az-letter')];
  const noResults = document.getElementById('az-no-results');
  const noResultsQuery = document.getElementById('az-no-results-query');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    const lettersWithMatches = new Set<string>();
    let totalVisible = 0;

    groups.forEach((group) => {
      const items = [...group.querySelectorAll<HTMLElement>('.az-item')];
      let visibleInGroup = 0;
      items.forEach((item) => {
        const matches = !query || (item.dataset.name || '').includes(query);
        item.hidden = !matches;
        if (matches) visibleInGroup++;
      });
      group.hidden = visibleInGroup === 0;
      if (visibleInGroup > 0) {
        lettersWithMatches.add(group.dataset.letter || '');
        totalVisible += visibleInGroup;
      }
    });

    letters.forEach((letter) => {
      if (!query) {
        letter.classList.toggle('az-letter--dimmed', false);
        return;
      }
      letter.classList.toggle('az-letter--dimmed', !lettersWithMatches.has(letter.dataset.letter || ''));
    });

    if (noResults) noResults.hidden = totalVisible !== 0;
    if (noResultsQuery) noResultsQuery.textContent = searchInput.value.trim();
  });
</script>

<style>
  .breadcrumbs{
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(248,249,246,0.6);
    margin-bottom: 20px;
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    align-items:center;
  }
  .breadcrumbs a:hover{ color: var(--gold-300); }
  .crumb-sep{ color: rgba(248,249,246,0.3); }
  .crumb-current{ color: rgba(248,249,246,0.85); }

  .az-intro{
    max-width: 720px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-600);
  }

  .az-search-wrap{
    position: relative;
    max-width: 420px;
    margin-bottom: 32px;
  }
  .az-search-icon{
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-600);
    pointer-events: none;
  }
  .az-search-input{
    width: 100%;
    padding: 11px 14px 11px 38px;
    border: 1px solid var(--paper-50);
    border-radius: 6px;
    font-size: 15px;
    font-family: inherit;
    color: var(--ink-900);
    background: var(--paper-0);
    transition: border-color 0.2s var(--ease);
  }
  .az-search-input:focus{
    outline: none;
    border-color: var(--gold-500);
  }

  .az-no-results{
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--ink-600);
    padding: 24px 0;
  }

  .az-label{
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-600);
    margin-bottom: 12px;
  }
  .az-bar{
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 40px;
  }
  .az-letter{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--paper-50);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: rgba(19,26,34,0.25);
    text-decoration: none;
  }
  .az-letter--active{
    color: var(--ink-900);
    border-color: var(--ink-900);
    transition: all 0.2s var(--ease);
  }
  .az-letter--active:hover{
    background: var(--ink-900);
    color: var(--paper-0);
  }
  .az-letter--dimmed{
    opacity: 0.3;
  }

  .az-group{
    display: flex;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--paper-50);
    scroll-margin-top: 100px;
  }
  .az-group:last-child{ border-bottom: 1px solid var(--paper-50); }
  .az-group-badge{
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--ink-900);
    color: var(--paper-0);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    border-radius: 4px;
  }
  .az-group-list{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 16px;
    flex: 1;
  }
  .az-item{
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink-900);
    text-decoration: none;
    border: 1px solid var(--paper-50);
    border-radius: 10px;
    padding: 10px;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .az-item:hover{
    border-color: var(--gold-500);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(19,26,34,0.08);
  }
  .az-item-thumb{
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 7px;
    overflow: hidden;
    background-color: var(--paper-50);
    background-size: cover;
    background-position: center;
  }
  .az-item-thumb img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }
  .az-item:hover .az-item-thumb img{ transform: scale(1.06); }
  .az-item-label{
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 640px){
    .az-group-list{
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 12px;
    }
  }
</style>
