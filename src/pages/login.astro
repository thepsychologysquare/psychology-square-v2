---
// Dedicated client sign-in page — separate from /my-certificates.
// /my-certificates is about *viewing certificates* (requires a session);
// this page is about *signing in*, and sends you on to wherever you were
// headed (?redirect=) or to /my-certificates by default once you're in.
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getClientSession } from '../lib/clientAuth';

const cookieHeader = Astro.request.headers.get('cookie');
const session = env?.CLIENT_SESSION_SECRET
  ? await getClientSession(cookieHeader, env.CLIENT_SESSION_SECRET)
  : null;

const redirect = Astro.url.searchParams.get('redirect') || '/my-certificates';

// Already signed in? Don't show a login form — just send them on.
if (session) {
  return Astro.redirect(redirect);
}

const expired = Astro.url.searchParams.get('expired') === '1';
const oauthError = Astro.url.searchParams.get('error') === '1';
const googleStartUrl = `/api/auth/google/start?redirect=${encodeURIComponent(redirect)}`;
---
<Layout title="Sign in" description="Sign in to The Psychology Square." noindex>
  <section class="my-certs">
    <div class="wrap wrap--narrow">
      <div class="login-panel">
        <span class="eyebrow">Sign in</span>
        <h1>Sign in to your account</h1>
        <p class="lede">Sign in with Google — no password, no email link to wait for.</p>

        {expired && <p class="notice">Your sign-in attempt expired. Please try again below.</p>}
        {oauthError && <p class="notice">Something went wrong signing you in with Google. Please try again.</p>}

        <a href={googleStartUrl} class="btn btn--google">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.68-3.88 2.68-6.62Z"/>
            <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.95v2.33A9 9 0 0 0 9 18Z"/>
            <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.66 9c0-.59.1-1.17.29-1.7V4.97H.95A9 9 0 0 0 0 9c0 1.45.35 2.83.95 4.03l3-2.33Z"/>
            <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .95 4.97l3 2.33C4.66 5.17 6.65 3.58 9 3.58Z"/>
          </svg>
          Continue with Google
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .my-certs{ padding:120px 0 96px; }
  .wrap--narrow{ max-width:640px; margin:0 auto; padding:0 24px; }
  .eyebrow{ font-family:var(--font-mono); font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--gold-500); }

  .login-panel h1{ font-family:var(--font-display); font-size:32px; margin:8px 0 12px; }
  .lede{ color:var(--ink-600); font-size:16px; line-height:1.6; margin-bottom:28px; }
  .notice{ background:var(--paper-50); border:1px solid var(--line); padding:12px 16px; border-radius:2px; font-size:14px; margin-bottom:20px; }

  .btn{ font-family:var(--font-body); cursor:pointer; border:none; text-decoration:none; }
  .btn--google{
    display:inline-flex; align-items:center; gap:10px;
    background:#fff; color:#131A22; border:1px solid var(--line);
    padding:12px 20px; border-radius:2px; font-size:15px; font-weight:500;
    max-width:fit-content; transition:border-color .15s ease, box-shadow .15s ease;
  }
  .btn--google:hover{ border-color:var(--gold-500); box-shadow:0 1px 4px rgba(0,0,0,0.08); }
</style>
