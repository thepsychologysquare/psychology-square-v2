---
import Layout from '../layouts/Layout.astro';

const siteOrigin = 'https://thepsychologysquare.com';

// SEO Structured Data (JSON-LD) for Search Engines & Local Search
const contactPageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": `${siteOrigin}/contact#webpage`,
      "url": `${siteOrigin}/contact`,
      "name": "Contact The Psychology Square — Clinical Psychologists in Lahore",
      "description": "Get in touch with licensed clinical psychologists in Lahore. Contact us for therapy appointments, online consultations, and psychological research analysis support.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
          { "@type": "ListItem", "position": 2, "name": "Contact", "item": `${siteOrigin}/contact` }
        ]
      }
    },
    {
      "@type": "MedicalBusiness",
      "@id": `${siteOrigin}/#organization`,
      "name": "The Psychology Square",
      "url": siteOrigin,
      "email": "info@thepsychologysquare.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "addressCountry": "PK"
      },
      "areaServed": ["Lahore", "Pakistan", "Worldwide (Online Therapy)"],
      "medicalSpecialty": ["ClinicalPsychology", "Psychotherapy"]
    }
  ]
};
---

<Layout 
  title="Contact Clinical Psychologists in Lahore | The Psychology Square" 
  fullTitle="Contact Us — Book Therapy & Research Support | The Psychology Square Lahore"
  description="Contact licensed clinical psychologists at The Psychology Square in Lahore. Inquire about in-person therapy, online consultations, or research analysis support."
  image="/images/contact-cover.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Get In Touch</p>
      <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px;">
        Contact Us
      </h1>
      <p class="hero-sub">
        Connect with our licensed clinical psychologists in Lahore. Whether you have questions about in-person therapy, online therapy sessions, or psychological research analysis support, send a message and we'll get back to you. For therapy sessions specifically, booking directly is usually fastest.
      </p>
      <div class="hero-actions" style="margin-top: 28px;">
        <a href="/book" class="btn btn--primary">Book Therapy Session</a>
        <a href="mailto:info@thepsychologysquare.com" class="btn btn--text">Email us directly →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width: 560px;">
      <form action="https://formspree.io/f/xeajgoye" method="POST" class="request-form">
        <input type="hidden" name="_subject" value="New message from Contact page" />
        <label for="contact-name">
          Your name
          <input type="text" id="contact-name" name="name" required />
        </label>
        <label for="contact-email">
          Your email
          <input type="email" id="contact-email" name="email" required />
        </label>
        <label for="contact-topic">
          What's this about?
          <select id="contact-topic" name="topic">
            <option value="Therapy — general question">Therapy — General Questions & Consultation</option>
            <option value="Research Analysis enquiry">Psychological Research & Statistical Analysis</option>
            <option value="Online Therapy">Online Therapy (Worldwide)</option>
            <option value="Something else">Something else</option>
          </select>
        </label>
        <label for="contact-message">
          Message
          <textarea id="contact-message" name="message" rows="5" required></textarea>
        </label>
        <button type="submit" class="btn btn--primary">Send message</button>
      </form>
    </div>
  </section>

</Layout>

<style>
  .request-form{ display:flex; flex-direction:column; gap:18px; }
  .request-form label{ display:flex; flex-direction:column; gap:6px; font-size: 14px; color: var(--ink-600); font-weight: 500; }
  .request-form input,
  .request-form select,
  .request-form textarea{
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper-0);
    color: var(--ink-900);
  }
  .request-form input:focus,
  .request-form select:focus,
  .request-form textarea:focus{ outline: 2px solid var(--gold-500); outline-offset: 1px; }
  .request-form button{ align-self: flex-start; border: none; cursor: pointer; }
  .form-note{ margin-top: 20px; color: var(--sage-500); font-size: 14px; }

  @media (max-width: 600px){
    .hero-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
</style>