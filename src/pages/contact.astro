---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">

  <section class="contact-hero">
    <div class="wrap">
      <p class="eyebrow eyebrow--dark">Get in touch</p>
      <h1>Let's talk about what you're experiencing.</h1>
      <p class="hero-sub">Questions about therapy, our approach, or just not sure where to start? We're here to listen.</p>
    </div>
  </section>

  <section class="contact-content">
    <div class="wrap">
      <div class="contact-grid">
        <div class="contact-form-section">
          <h2>Send us a message</h2>
          <form id="contactForm" class="contact-form">
            <div class="form-group">
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" required>
            </div>

            <div class="form-group">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
              <label for="phone">Phone (optional)</label>
              <input type="tel" id="phone" name="phone">
            </div>

            <div class="form-group">
              <label for="subject">What's this about?</label>
              <select id="subject" name="subject" required>
                <option value="">Select a topic</option>
                <option value="booking">Booking a session</option>
                <option value="questions">Questions about therapy</option>
                <option value="research">Research analysis inquiry</option>
                <option value="general">General inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <button type="submit" class="btn btn--primary" style="width: 100%;">Send message</button>
            <p class="form-note">We typically respond within 24 hours.</p>
          </form>
        </div>

        <div class="contact-info-section">
          <h2>Other ways to reach us</h2>
          
          <div class="contact-block">
            <h3>Email</h3>
            <a href="mailto:thepsychologysquare@gmail.com" class="contact-link">thepsychologysquare@gmail.com</a>
          </div>

          <div class="contact-block">
            <h3>Book directly</h3>
            <p class="contact-text">Schedule with Muhammad Sohail or Sehar Waheed using Calendly:</p>
            <div class="cta-links">
              <a href="https://calendly.com/mohdsohail0399/online-session" target="_blank" rel="noopener" class="btn btn--secondary btn--small">Muhammad Sohail</a>
              <a href="https://calendly.com/shs-counseling1-umt/30min" target="_blank" rel="noopener" class="btn btn--secondary btn--small">Sehar Waheed</a>
            </div>
          </div>

          <div class="contact-block">
            <h3>Location</h3>
            <p class="contact-text">Available for both online (video call) and in-person sessions in Johar Town, Lahore, Pakistan.</p>
          </div>

          <div class="contact-block">
            <h3>Response time</h3>
            <p class="contact-text">We aim to respond to all inquiries within 24 hours during business days.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-faq">
    <div class="wrap">
      <h2>Frequently asked questions</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <h3>How much does a session cost?</h3>
          <p>Individual therapy is PKR 5,000 per session, and couples therapy is PKR 7,000 per session. Payment is arranged directly with us and confirmed before the session.</p>
        </div>
        <div class="faq-item">
          <h3>Can I do sessions online?</h3>
          <p>Yes, absolutely. All sessions are available over secure video call, as well as in person at our Johar Town office.</p>
        </div>
        <div class="faq-item">
          <h3>How long is each session?</h3>
          <p>Sessions are typically one hour. During your first session, we'll discuss what you're working through and outline an approach that fits your needs.</p>
        </div>
        <div class="faq-item">
          <h3>Is everything confidential?</h3>
          <p>Yes. What's shared in session is private and protected, with standard legal exceptions such as risk of serious harm to yourself or others.</p>
        </div>
        <div class="faq-item">
          <h3>How do I get started?</h3>
          <p>You can email us, book directly through Calendly with either clinician, or fill out the contact form above. There's no wrong way to reach out.</p>
        </div>
        <div class="faq-item">
          <h3>What if I have more questions?</h3>
          <p>Use the contact form, email us, or book a brief call to discuss whether therapy is right for you at this time. No pressure.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  document.getElementById('contactForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const email = document.getElementById('email').value;
    const phone = document.getElementById('phone').value;
    const subject = document.getElementById('subject').value;
    const message = document.getElementById('message').value;

    const mailtoLink = `mailto:thepsychologysquare@gmail.com?subject=Contact from ${encodeURIComponent(name)}: ${encodeURIComponent(subject)}&body=${encodeURIComponent(`Name: ${name}\nEmail: ${email}\nPhone: ${phone}\n\nMessage:\n${message}`)}`;
    window.location.href = mailtoLink;
  });
</script>

<style>
  .contact-hero {
    padding: 80px 0 60px;
    background: linear-gradient(135deg, var(--sage-50) 0%, transparent 100%);
  }

  .contact-hero p:first-child {
    color: var(--sage-500);
    margin-bottom: 16px;
  }

  .contact-hero h1 {
    font-size: 48px;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0 0 24px;
    line-height: 1.2;
  }

  .hero-sub {
    font-size: 18px;
    color: var(--ink-600);
    max-width: 600px;
    line-height: 1.6;
  }

  .contact-content {
    padding: 80px 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .contact-form-section h2,
  .contact-info-section h2 {
    font-size: 24px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 32px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-900);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 12px 16px;
    border: 1px solid var(--sage-300);
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--ink-900);
    transition: all 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--gold-500);
    box-shadow: 0 0 0 3px rgba(212, 163, 77, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-note {
    font-size: 13px;
    color: var(--ink-600);
    text-align: center;
    margin: 0;
  }

  .contact-info-section {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .contact-block {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--sage-200);
  }

  .contact-block:last-child {
    border-bottom: none;
  }

  .contact-block h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 12px;
  }

  .contact-link {
    color: var(--gold-600);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .contact-text {
    font-size: 14px;
    color: var(--ink-600);
    line-height: 1.6;
    margin: 0 0 12px;
  }

  .cta-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn--small {
    font-size: 13px;
    padding: 10px 14px;
  }

  .contact-faq {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--sage-50) 0%, transparent 100%);
  }

  .contact-faq h2 {
    font-size: 32px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 48px;
    text-align: center;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }

  .faq-item {
    background: white;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid var(--sage-200);
  }

  .faq-item h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 12px;
  }

  .faq-item p {
    font-size: 14px;
    color: var(--ink-600);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .contact-hero h1 {
      font-size: 36px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>