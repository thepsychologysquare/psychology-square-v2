---
export const prerender = false;
import { getCollection, render } from 'astro:content';
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getClientSession } from '../../lib/clientAuth';

const { slug } = Astro.params;
const courses = await getCollection('courses', ({ data }) => !data.draft);
const course = courses.find((c) => c.id === slug);
if (!course) return Astro.redirect('/courses', 302);

const session = env?.CLIENT_SESSION_SECRET
  ? await getClientSession(Astro.request.headers.get('cookie'), env.CLIENT_SESSION_SECRET)
  : null;

let enrollment: { name: string } | null = null;
if (session && env?.DB) {
  enrollment = await env.DB.prepare(
    `SELECT name FROM enrollments WHERE course_slug = ? AND email = ?`
  ).bind(course.id, session.email).first<{ name: string }>();
}
const isEnrolled = !!enrollment;

// Only rendered/sent to the browser at all once enrolled — an
// unenrolled visitor's page source never contains the lesson content or
// the quiz questions, not just a visually-hidden version of them.
const { Content } = isEnrolled ? await render(course) : { Content: null };
const clientQuiz = isEnrolled
  ? course.data.quiz.map((q) => ({ question: q.question, options: q.options }))
  : [];

// Modules are optional: a course with none falls back to the legacy
// single-page + quiz layout below, completely unchanged. A course with
// module files gets the sidebar/progress player instead.
const allModules = isEnrolled
  ? (await getCollection('courseModules', (d) => !d.data.draft && d.data.courseSlug === course.id))
      .sort((a, b) => a.data.order - b.data.order)
  : [];
const hasModules = allModules.length > 0;
const renderedModules = await Promise.all(
  allModules.map(async (m) => ({
    title: m.data.title,
    type: m.data.type,
    videoUrl: m.data.videoUrl || '',
    questions: m.data.questions || [],
    Content: (await render(m)).Content,
  }))
);
const moduleQuestionsForClient = renderedModules.map((m) =>
  m.questions.map((q) => ({ question: q.question, options: q.options, correctIndex: q.correctIndex }))
);
---
<Layout
  title={course.data.title}
  description={course.data.description}
  fullTitle={`${course.data.title} — The Psychology Square`}
>
  <article class="course-article">
    <div class="wrap wrap--narrow">
      <span class="eyebrow">Course &middot; {course.data.estimatedHours} {course.data.estimatedHours === 1 ? 'hour' : 'hours'}</span>
      <h1>{course.data.title}</h1>
      <p class="lede">{course.data.description}</p>

      {!isEnrolled ? (
        <section class="enroll-gate" id="enrollGate">
          <h2>Enroll to access this course</h2>
          <p class="enroll-copy">Enrolling is free and takes a few seconds — you'll get a sign-in link by email, no password needed. The lessons and quiz unlock right after.</p>

          {session ? (
            <div id="enrollNowPanel">
              <p class="signed-in-as">Signed in as <strong>{session.email}</strong></p>
              <button type="button" class="btn btn--primary" id="enrollNowBtn">Enroll now</button>
              <p class="enroll-error" id="enrollNowError" role="alert" hidden></p>
            </div>
          ) : (
            <form id="enrollForm" class="enroll-form">
              <div class="field-row">
                <div class="field">
                  <label for="enrollName">Full name</label>
                  <input type="text" id="enrollName" required autocomplete="name" placeholder="As it should appear on your certificate" />
                </div>
                <div class="field">
                  <label for="enrollEmail">Email</label>
                  <input type="email" id="enrollEmail" required autocomplete="email" placeholder="you@example.com" />
                </div>
              </div>
              <button type="submit" class="btn btn--primary" id="enrollBtn">Enroll &amp; email me a link</button>
              <p class="enroll-error" id="enrollError" role="alert" hidden></p>
            </form>
          )}

          <div id="enrollSent" class="enroll-sent" hidden>
            <h3>Check your email</h3>
            <p>Click the link we just sent to finish enrolling — it expires in 15 minutes.</p>
          </div>
        </section>
      ) : (
        <Fragment>
          {hasModules ? (
            <div class="course-player" id="coursePlayer">
              <aside class="module-sidebar">
                <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
                <p class="progress-label" id="progressLabel">0 of {renderedModules.length} modules complete</p>
                <ol class="module-list" id="moduleList">
                  {renderedModules.map((m, i) => (
                    <li class="module-list__item" data-module-index={i}>
                      <button type="button" class="module-list__btn">
                        <span class="module-list__check" aria-hidden="true">✓</span>
                        <span class="module-list__title">{i + 1}. {m.title}</span>
                      </button>
                    </li>
                  ))}
                </ol>
              </aside>

              <div class="module-main">
                {renderedModules.map((m, i) => (
                  <div class="module-pane" data-module-index={i} hidden={i !== 0}>
                    <h2 class="module-pane__title">{m.title}</h2>
                    {m.type === 'video' && m.videoUrl && (
                      <div class="module-video">
                        <iframe src={m.videoUrl} title={m.title} allowfullscreen loading="lazy"></iframe>
                      </div>
                    )}
                    <div class="course-content">
                      {m.Content && <m.Content />}
                    </div>

                    {m.questions.length > 0 && (
                      <div class="module-checkin" data-module-index={i}>
                        <h3>Quick check-in</h3>
                        <p class="module-checkin__hint">Just for your own review — this doesn't affect your certificate.</p>
                        <div class="module-checkin__questions"></div>
                      </div>
                    )}

                    <div class="module-pane__nav">
                      {i > 0 && <button type="button" class="btn btn--text module-prev">&larr; Previous</button>}
                      <button type="button" class="btn btn--primary module-complete-btn">
                        {i === renderedModules.length - 1 ? 'Mark complete' : 'Mark complete & continue'}
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <div class="course-content">
              <Content />
            </div>
          )}

          <section class="quiz-section" id="quizSection">
            <h2>Complete the quiz</h2>
            <p class="quiz-intro">Score {course.data.passScorePercent}% or higher to earn your certificate. You can retake the quiz if needed.</p>
            {hasModules && (
              <p class="quiz-locked-note" id="quizLockedNote">Complete all modules above to unlock the quiz.</p>
            )}

            <form id="quizForm" class="quiz-form" hidden={hasModules}>
              <input type="hidden" id="learnerName" value={enrollment?.name || ''} />
              <input type="hidden" id="learnerEmail" value={session?.email || ''} />

              <div id="quizQuestions"></div>

              <button type="submit" class="btn btn--primary" id="quizSubmitBtn">Submit quiz</button>
              <p class="quiz-error" id="quizError" role="alert" hidden></p>
            </form>

            <div id="quizResult" class="quiz-result" hidden></div>
          </section>
        </Fragment>
      )}
    </div>
  </article>
</Layout>

<script type="application/json" id="quizData" set:html={JSON.stringify(clientQuiz)}></script>
<script type="application/json" id="moduleQuestionsData" set:html={JSON.stringify(moduleQuestionsForClient)}></script>
<script define:vars={{ courseSlug: course.id, currentUrl: Astro.url.pathname, isEnrolled, hasModules, totalModules: renderedModules.length, learnerEmail: session?.email || '' }}>
  // ---------- Enroll gate ----------
  const enrollForm = document.getElementById('enrollForm');
  if (enrollForm) {
    const btn = document.getElementById('enrollBtn');
    const errorEl = document.getElementById('enrollError');
    const sentEl = document.getElementById('enrollSent');

    enrollForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';

      const name = document.getElementById('enrollName').value.trim();
      const email = document.getElementById('enrollEmail').value.trim();

      try {
        const res = await fetch('/api/certificates/request-link', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, redirect: currentUrl, enrollCourseSlug: courseSlug, enrollName: name }),
        });
        const data = await res.json();
        if (!res.ok) {
          errorEl.textContent = data.error || 'Something went wrong. Please try again.';
          errorEl.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Enroll & email me a link';
          return;
        }
        enrollForm.hidden = true;
        sentEl.hidden = false;
      } catch {
        errorEl.textContent = 'Could not reach the server. Please check your connection and try again.';
        errorEl.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Enroll & email me a link';
      }
    });
  }

  const enrollNowBtn = document.getElementById('enrollNowBtn');
  if (enrollNowBtn) {
    enrollNowBtn.addEventListener('click', async () => {
      const errorEl = document.getElementById('enrollNowError');
      errorEl.hidden = true;
      enrollNowBtn.disabled = true;
      enrollNowBtn.textContent = 'Enrolling…';
      try {
        const res = await fetch('/api/courses/enroll', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ courseSlug }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          errorEl.textContent = data.error || 'Something went wrong. Please try again.';
          errorEl.hidden = false;
          enrollNowBtn.disabled = false;
          enrollNowBtn.textContent = 'Enroll now';
          return;
        }
        window.location.reload();
      } catch {
        errorEl.textContent = 'Could not reach the server. Please check your connection and try again.';
        errorEl.hidden = false;
        enrollNowBtn.disabled = false;
        enrollNowBtn.textContent = 'Enroll now';
      }
    });
  }

  // ---------- Module player (sidebar navigation + progress) ----------
  if (isEnrolled && hasModules) {
    const progressKey = `courseProgress:${courseSlug}:${learnerEmail}`;
    const completed = new Set(JSON.parse(localStorage.getItem(progressKey) || '[]'));

    const paneList = Array.from(document.querySelectorAll('.module-pane'));
    const listItems = Array.from(document.querySelectorAll('.module-list__item'));
    const progressFill = document.getElementById('progressFill');
    const progressLabel = document.getElementById('progressLabel');
    const moduleQuestions = JSON.parse(document.getElementById('moduleQuestionsData').textContent);

    function showModule(index) {
      paneList.forEach((pane) => { pane.hidden = Number(pane.dataset.moduleIndex) !== index; });
      listItems.forEach((li) => li.querySelector('.module-list__btn').classList.toggle('is-active', Number(li.dataset.moduleIndex) === index));
      window.scrollTo({ top: document.getElementById('coursePlayer').offsetTop - 20, behavior: 'smooth' });
    }

    function updateProgressUI() {
      listItems.forEach((li) => {
        li.querySelector('.module-list__btn').classList.toggle('is-complete', completed.has(Number(li.dataset.moduleIndex)));
      });
      const pct = Math.round((completed.size / totalModules) * 100);
      progressFill.style.width = `${pct}%`;
      progressLabel.textContent = `${completed.size} of ${totalModules} modules complete`;

      const quizForm = document.getElementById('quizForm');
      const lockedNote = document.getElementById('quizLockedNote');
      if (completed.size >= totalModules) {
        quizForm.hidden = false;
        if (lockedNote) lockedNote.hidden = true;
      }
    }

    function markComplete(index) {
      completed.add(index);
      localStorage.setItem(progressKey, JSON.stringify([...completed]));
      updateProgressUI();
    }

    listItems.forEach((li) => {
      li.querySelector('.module-list__btn').addEventListener('click', () => showModule(Number(li.dataset.moduleIndex)));
    });

    paneList.forEach((pane) => {
      const index = Number(pane.dataset.moduleIndex);
      const prevBtn = pane.querySelector('.module-prev');
      if (prevBtn) prevBtn.addEventListener('click', () => showModule(index - 1));
      pane.querySelector('.module-complete-btn').addEventListener('click', () => {
        markComplete(index);
        if (index < totalModules - 1) showModule(index + 1);
      });

      // Render this module's optional check-in question(s), if any.
      const questions = moduleQuestions[index] || [];
      const checkinEl = pane.querySelector('.module-checkin__questions');
      if (checkinEl && questions.length > 0) {
        questions.forEach((q, qi) => {
          const wrap = document.createElement('div');
          wrap.className = 'checkin-question';
          const p = document.createElement('p');
          p.className = 'checkin-question__text';
          p.textContent = q.question;
          wrap.appendChild(p);
          q.options.forEach((opt, oi) => {
            const optBtn = document.createElement('button');
            optBtn.type = 'button';
            optBtn.className = 'checkin-option';
            optBtn.textContent = opt;
            optBtn.addEventListener('click', () => {
              wrap.querySelectorAll('.checkin-option').forEach((b) => (b.disabled = true));
              optBtn.classList.add(oi === q.correctIndex ? 'is-correct' : 'is-incorrect');
              if (oi !== q.correctIndex) {
                wrap.querySelectorAll('.checkin-option')[q.correctIndex].classList.add('is-correct');
              }
            });
            wrap.appendChild(optBtn);
          });
          checkinEl.appendChild(wrap);
        });
      }
    });

    updateProgressUI();
  }

  // ---------- Quiz (only present in the DOM once enrolled) ----------
  if (isEnrolled) {
    const quiz = JSON.parse(document.getElementById('quizData').textContent);
    const questionsEl = document.getElementById('quizQuestions');

    quiz.forEach((q, qIndex) => {
      const fieldset = document.createElement('fieldset');
      fieldset.className = 'quiz-question';
      const legend = document.createElement('legend');
      legend.textContent = `${qIndex + 1}. ${q.question}`;
      fieldset.appendChild(legend);
      q.options.forEach((option, oIndex) => {
        const label = document.createElement('label');
        label.className = 'quiz-option';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = `q${qIndex}`;
        input.value = String(oIndex);
        input.required = true;
        label.appendChild(input);
        label.appendChild(document.createTextNode(' ' + option));
        fieldset.appendChild(label);
      });
      questionsEl.appendChild(fieldset);
    });

    const form = document.getElementById('quizForm');
    const submitBtn = document.getElementById('quizSubmitBtn');
    const errorEl = document.getElementById('quizError');
    const resultEl = document.getElementById('quizResult');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      const name = document.getElementById('learnerName').value.trim();
      const email = document.getElementById('learnerEmail').value.trim();
      const answers = quiz.map((_, qIndex) => {
        const selected = form.querySelector(`input[name="q${qIndex}"]:checked`);
        return selected ? Number(selected.value) : -1;
      });

      if (answers.includes(-1)) {
        errorEl.textContent = 'Please answer every question.';
        errorEl.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';

      try {
        const res = await fetch('/api/courses/submit', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ courseSlug, name, email, answers }),
        });
        const data = await res.json();

        if (!res.ok) {
          errorEl.textContent = data.error || 'Something went wrong. Please try again.';
          errorEl.hidden = false;
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit quiz';
          return;
        }

        form.hidden = true;
        resultEl.hidden = false;

        if (data.passed) {
          resultEl.innerHTML = `
            <div class="result result--pass">
              <h3>You passed — ${data.scorePercent}%</h3>
              <p>Your certificate has been generated${data.emailSent ? ' and emailed to you' : ''}.</p>
              <a href="/certificates/${data.certificateId}" class="btn btn--primary">View your certificate</a>
            </div>`;
        } else {
          resultEl.innerHTML = `
            <div class="result result--fail">
              <h3>Score: ${data.scorePercent}%</h3>
              <p>You need ${data.passScorePercent}% or higher to pass. Review the material above and try again.</p>
              <button type="button" class="btn btn--text" id="retryBtn">Retake the quiz</button>
            </div>`;
          document.getElementById('retryBtn').addEventListener('click', () => {
            form.hidden = false;
            resultEl.hidden = true;
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit quiz';
            form.querySelectorAll('input[type="radio"]').forEach((r) => (r.checked = false));
          });
        }
      } catch {
        errorEl.textContent = 'Could not reach the server. Please check your connection and try again.';
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit quiz';
      }
    });
  }
</script>

<style>
  .course-article{ padding:64px 0 96px; }
  .wrap--narrow{ max-width:720px; margin:0 auto; padding:0 24px; }
  .eyebrow{ font-family:var(--font-mono); font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--gold-500); }
  .course-article h1{ font-family:var(--font-display); font-size:clamp(30px,4vw,42px); margin:8px 0 12px; }
  .lede{ color:var(--ink-600); font-size:17px; line-height:1.6; margin-bottom:36px; }

  .enroll-gate{ margin-top:20px; padding:32px; border:1px solid var(--line); border-radius:2px; background:var(--paper-50); }
  .enroll-gate h2{ font-family:var(--font-display); font-size:22px; margin-bottom:8px; }
  .enroll-copy{ color:var(--ink-600); margin-bottom:24px; }
  .signed-in-as{ font-size:14px; margin-bottom:16px; }
  .enroll-error{ color:#B4432E; font-size:14px; margin-top:12px; }
  .enroll-sent h3{ font-family:var(--font-display); font-size:20px; margin-bottom:8px; }
  .enroll-sent p{ color:var(--ink-600); }

  .course-content{ font-size:16px; line-height:1.75; }
  .course-content :global(h2){ font-family:var(--font-display); font-size:24px; margin:40px 0 14px; }
  .course-content :global(p){ margin-bottom:16px; }
  .course-content :global(ul), .course-content :global(ol){ margin:0 0 16px 22px; }
  .course-content :global(li){ margin-bottom:6px; }

  /* ---------- Module player ---------- */
  .course-player{ display:grid; grid-template-columns:260px 1fr; gap:36px; margin-top:24px; align-items:start; }
  @media (max-width: 760px){ .course-player{ grid-template-columns:1fr; } }

  .module-sidebar{ position:sticky; top:24px; border:1px solid var(--line); border-radius:2px; padding:20px; background:var(--paper-50); max-height:calc(100vh - 48px); overflow-y:auto; }
  .progress-track{ height:6px; border-radius:4px; background:var(--line); overflow:hidden; margin-bottom:8px; }
  .progress-fill{ height:100%; background:var(--gold-500); width:0%; transition:width 0.3s ease; }
  .progress-label{ font-size:12px; color:var(--ink-600); margin-bottom:16px; }
  .module-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:4px; }
  .module-list__btn{
    display:flex; align-items:center; gap:8px; width:100%; text-align:left;
    background:none; border:none; cursor:pointer; padding:9px 10px; border-radius:2px;
    font-family:var(--font-body); font-size:14px; color:var(--ink-900);
  }
  .module-list__btn:hover{ background:rgba(0,0,0,0.04); }
  .module-list__btn.is-active{ background:rgba(199,164,74,0.15); font-weight:600; }
  .module-list__check{
    display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px;
    border-radius:50%; border:1.5px solid var(--line); font-size:11px; color:transparent; flex-shrink:0;
  }
  .module-list__btn.is-complete .module-list__check{ background:var(--gold-500); border-color:var(--gold-500); color:#fff; }

  .module-main{ min-width:0; }
  .module-pane__title{ font-family:var(--font-display); font-size:24px; margin-bottom:18px; }
  .module-video{ position:relative; padding-top:56.25%; margin-bottom:24px; background:#000; border-radius:2px; overflow:hidden; }
  .module-video iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }
  .module-pane__nav{ display:flex; gap:16px; align-items:center; margin-top:32px; padding-top:24px; border-top:1px solid var(--line); }

  .module-checkin{ margin-top:32px; padding:22px; border:1px solid var(--line); border-radius:2px; background:var(--paper-50); }
  .module-checkin h3{ font-family:var(--font-display); font-size:17px; margin-bottom:4px; }
  .module-checkin__hint{ font-size:13px; color:var(--ink-600); margin-bottom:16px; }
  .checkin-question{ margin-bottom:18px; }
  .checkin-question__text{ font-weight:600; font-size:14px; margin-bottom:10px; }
  .checkin-option{
    display:block; width:100%; text-align:left; font-family:var(--font-body); font-size:14px;
    padding:9px 12px; margin-bottom:6px; border:1px solid var(--line); border-radius:2px;
    background:var(--paper-0); cursor:pointer;
  }
  .checkin-option:disabled{ cursor:default; }
  .checkin-option.is-correct{ border-color:#2E7D5B; background:rgba(46,125,91,0.1); }
  .checkin-option.is-incorrect{ border-color:#B4432E; background:rgba(180,67,46,0.1); }

  .quiz-locked-note{ font-size:14px; color:var(--ink-600); font-style:italic; margin-bottom:8px; }

  .quiz-section{ margin-top:56px; padding-top:40px; border-top:1px solid var(--line); }
  .quiz-section h2{ font-family:var(--font-display); font-size:26px; margin-bottom:6px; }
  .quiz-intro{ color:var(--ink-600); margin-bottom:28px; }

  .field-row{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px; }
  .field{ display:flex; flex-direction:column; gap:6px; }
  label{ font-size:14px; font-weight:500; }
  input[type="text"], input[type="email"]{
    font-family:var(--font-body); font-size:15px; padding:12px 14px;
    border:1px solid var(--line); border-radius:2px;
  }
  input:focus-visible{ outline:2px solid var(--gold-500); outline-offset:1px; }

  .quiz-question{ border:none; padding:0; margin:0 0 26px; }
  .quiz-question legend{ font-weight:600; margin-bottom:10px; padding:0; }
  .quiz-option{ display:flex; align-items:center; gap:10px; padding:8px 0; font-size:15px; cursor:pointer; }
  .quiz-option input{ margin:0; }

  .btn{ font-family:var(--font-body); cursor:pointer; border:none; }
  .btn--primary{ background:var(--gold-500); color:var(--navy-950, var(--ink-900)); padding:12px 26px; border-radius:2px; margin-top:6px; }
  .btn--primary:disabled{ opacity:0.6; cursor:default; }
  .btn--text{ background:none; color:var(--ink-900); text-decoration:underline; padding:0; }
  .quiz-error{ color:#B4432E; font-size:14px; margin-top:12px; }

  .quiz-result{ margin-top:8px; }
  .result{ padding:28px; border:1px solid var(--line); border-radius:2px; }
  .result--pass{ background:var(--paper-50); }
  .result h3{ font-family:var(--font-display); font-size:22px; margin-bottom:8px; }
  .result p{ color:var(--ink-600); margin-bottom:18px; }
</style>
