---
export const prerender = false;
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getClientSession } from '../../../../lib/clientAuth';
import { getCourseOutline, getCompletedStepIds, textToHtml } from '../../../../lib/courseBuilder';
import { getCourseBySlug } from '../../../../lib/courses';

const { slug, stepId } = Astro.params;
const course = await getCourseBySlug(env, slug!);
if (!course || course.data.draft || !env?.DB) return Astro.redirect(`/courses/${slug}`, 302);

const session = env?.CLIENT_SESSION_SECRET
  ? await getClientSession(Astro.request.headers.get('cookie'), env.CLIENT_SESSION_SECRET)
  : null;
if (!session) return Astro.redirect(`/courses/${slug}`, 302);

const enrollment = await env.DB.prepare(
  `SELECT name FROM enrollments WHERE course_slug = ? AND email = ? AND status = 'active'`
).bind(course.id, session.email).first<{ name: string }>();
if (!enrollment) return Astro.redirect(`/courses/${slug}`, 302);

const outline = await getCourseOutline(env.DB, course.id);
const flatSteps = outline.flatMap((m) => m.steps.map((s) => ({ ...s, moduleTitle: m.title })));
const stepIndex = flatSteps.findIndex((s) => s.id === stepId);
if (stepIndex === -1) return Astro.redirect(`/courses/${slug}/learn`, 302);

const step = flatSteps[stepIndex];
const prevStep = flatSteps[stepIndex - 1];
const nextStep = flatSteps[stepIndex + 1];
const isLastStep = stepIndex === flatSteps.length - 1;

const completed = await getCompletedStepIds(env.DB, course.id, session.email);
const options: string[] = step.question_options ? JSON.parse(step.question_options) : [];
---
<Layout title={`${step.title} — ${course.data.title}`} description={course.data.description}>
  <div class="learn-layout wrap">
    <aside class="learn-sidebar">
      <input type="checkbox" id="sidebarToggle" class="sidebar-checkbox" />
      <label for="sidebarToggle" class="learn-sidebar__toggle">
        <span>Course contents</span>
        <span class="learn-sidebar__toggle-meta">
          {completed.size}/{flatSteps.length}
          <svg class="chevron" width="11" height="7" viewBox="0 0 11 7" fill="none"><path d="M1 1L5.5 5.5L10 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </label>

      <!-- Pinned header wrapper -->
      <div class="learn-sidebar__pinned">
        <a href={`/courses/${course.id}`} class="learn-sidebar__back">&larr; {course.data.title}</a>
        <div class="progress-track"><div class="progress-fill" id="progressFill" style={`width:${(completed.size / flatSteps.length) * 100}%`}></div></div>
        <p class="progress-label" id="progressLabel">{completed.size} of {flatSteps.length} steps complete</p>
      </div>

      <!-- Scrollable steps list area -->
      <div class="learn-sidebar__scroll" id="sidebarScrollArea">
        {outline.map((m) => (
          <div class="learn-sidebar__module">
            <p class="learn-sidebar__module-title">{m.title}</p>
            <ul>
              {m.steps.map((s) => (
                <li>
                  <a href={`/courses/${course.id}/learn/${s.id}`} class={s.id === step.id ? 'is-active' : ''} data-sidebar-link={s.id}>
                    <span class="learn-check" data-step-check={s.id} data-done={completed.has(s.id)}>{completed.has(s.id) ? '✓' : ''}</span>
                    {s.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>

    <main class="learn-main">
      <header class="learn-header">
        <span class="eyebrow">{step.moduleTitle}</span>
        <h1>{step.title}</h1>
      </header>

      <div class="lesson-card-wrapper">
        <div class="lesson-card">
          {step.content_type === 'video' && step.video_url && (
            <div class="module-video"><iframe src={step.video_url} title={step.title} allowfullscreen loading="lazy"></iframe></div>
          )}

          {step.content_body && <div class="course-content" set:html={textToHtml(step.content_body)} />}

          {step.question && (
            <div class="module-checkin">
              <h3>Quick check-in</h3>
              <p class="module-checkin__hint">Just for your own review — this doesn't affect your certificate.</p>
              <p class="module-checkin__question">{step.question}</p>
              <div class="checkin-options">
                {options.map((opt, i) => (
                  <button type="button" class="checkin-opt" data-correct={i === step.question_correct_index}>{opt}</button>
                ))}
              </div>
              <p class="checkin-feedback" id="checkinFeedback" hidden></p>
            </div>
          )}
        </div>
      </div>

      <div class="learn-nav">
        {prevStep ? <a href={`/courses/${course.id}/learn/${prevStep.id}`} class="btn btn--text">&larr; Previous</a> : <span />}
        {isLastStep ? (
          <button type="button" id="completeBtn" class="btn btn--primary">Mark complete &amp; go to quiz</button>
        ) : (
          <button type="button" id="completeBtn" class="btn btn--primary">Mark complete &amp; continue</button>
        )}
      </div>

      <section class="qa-section">
        <h3>Questions &amp; answers</h3>
        <p class="qa-hint">Ask us anything about this course — we review and answer questions personally rather than running an open comment thread.</p>
        <div id="qaList" class="qa-list"></div>
        <p id="qaEmpty" class="qa-hint" hidden>No published questions yet for this course.</p>

        <form id="qaForm" class="qa-form">
          <textarea id="qaQuestion" required maxlength="2000" placeholder="Ask a question about this course…" rows="3"></textarea>
          <button type="submit" class="btn btn--text" id="qaSubmitBtn">Submit question</button>
          <p class="qa-error" id="qaError" role="alert" hidden></p>
          <p class="qa-sent" id="qaSent" hidden>Thanks — we'll review it and publish an answer here.</p>
        </form>
      </section>
    </main>
  </div>
</Layout>

<style>
  /* ---------------------------------------------------------------
     Layout: Proper top spacing (at least 120px to clear nav menu)
  --------------------------------------------------------------- */
  .learn-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 40px;
    padding: 120px 20px 64px;
    align-items: start;
    max-width: 1320px;
    margin: 0 auto;
  }

  /* ---------------------------------------------------------------
     Sidebar styling with fixed pinned course title & scrollable list
  --------------------------------------------------------------- */
  .learn-sidebar {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 140px);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper-0);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(13, 18, 24, 0.04);
  }
  .sidebar-checkbox { display: none; }
  .learn-sidebar__toggle { display: none; }

  /* This section stays completely pinned at the top */
  .learn-sidebar__pinned {
    padding: 22px 20px 16px;
    background: var(--paper-0);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
    z-index: 2;
  }

  /* Only this section containing the modules/steps scrolls */
  .learn-sidebar__scroll {
    padding: 16px 20px 24px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    flex-grow: 1;
  }
  .learn-sidebar__scroll::-webkit-scrollbar { width: 8px; }
  .learn-sidebar__scroll::-webkit-scrollbar-thumb { background: var(--line); border-radius: 4px; }
  .learn-sidebar__scroll::-webkit-scrollbar-track { background: transparent; }

  .learn-sidebar__back {
    display: block;
    margin-bottom: 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--navy-700);
  }
  .learn-sidebar__back:hover { color: var(--gold-500); }

  .progress-track { height: 5px; background: var(--paper-50); border-radius: 999px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--gold-500); border-radius: 999px; }
  .progress-label { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--ink-600); margin: 8px 0 0; }

  .learn-sidebar__module + .learn-sidebar__module { margin-top: 20px; }
  .learn-sidebar__module-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sage-500);
    margin: 0 0 8px;
  }
  .learn-sidebar ul { list-style: none; margin: 0; padding: 0; }
  .learn-sidebar li + li { margin-top: 2px; }
  .learn-sidebar a {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 7px 10px;
    border-radius: 2px;
    text-decoration: none;
    color: var(--ink-600);
    font-size: 13.5px;
    line-height: 1.4;
    transition: background 0.15s var(--ease), color 0.15s var(--ease);
  }
  .learn-sidebar a:hover { background: var(--paper-50); color: var(--ink-900); }
  .learn-sidebar a.is-active { background: var(--navy-950); color: #fff; font-weight: 600; }
  .learn-sidebar a.is-active .learn-check { color: var(--gold-300); }

  .learn-check {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    color: transparent;
  }
  .learn-check[data-done="true"] { border-color: #2E7D5B; background: rgba(46,125,91,0.12); color: #2E7D5B; }
  .learn-sidebar a.is-active .learn-check[data-done="true"] { border-color: var(--gold-300); background: transparent; color: var(--gold-300); }

  /* ---------------------------------------------------------------
     Main column & Internal text area scrolling setup
  --------------------------------------------------------------- */
  .learn-header { margin-bottom: 24px; }
  .learn-header h1 {
    font-size: clamp(26px, 3.2vw, 36px);
    line-height: 1.2;
    margin-top: 8px;
  }

  .lesson-card-wrapper {
    width: 100%;
  }

  .lesson-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(19, 26, 34, 0.06);
    padding: 40px 44px;
    max-height: 65vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .lesson-card::-webkit-scrollbar { width: 8px; }
  .lesson-card::-webkit-scrollbar-thumb { background: var(--line); border-radius: 4px; }
  .lesson-card::-webkit-scrollbar-track { background: transparent; }

  .module-video { margin-bottom: 28px; }
  .module-video iframe { width: 100%; aspect-ratio: 16/9; border: none; border-radius: 2px; }

  .course-content {
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-900);
    max-width: 68ch;
    overflow-wrap: anywhere;
  }
  .course-content :global(h3) {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
    margin: 36px 0 14px;
  }
  .course-content :global(h3:first-child) { margin-top: 0; }
  .course-content :global(h4) {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    margin: 28px 0 10px;
  }
  .course-content :global(p) { margin: 0 0 20px; }
  .course-content :global(p:last-child) { margin-bottom: 0; }
  .course-content :global(ul), .course-content :global(ol) { margin: 0 0 20px; padding-left: 22px; }
  .course-content :global(li) { margin-bottom: 8px; }
  .course-content :global(li:last-child) { margin-bottom: 0; }
  .course-content :global(em) { font-style: italic; }
  .course-content :global(strong), .course-content :global(b) { font-weight: 700; }
  .course-content :global(blockquote) {
    margin: 24px 0;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--gold-500);
    color: var(--ink-600);
    font-style: italic;
  }

  .module-checkin {
    margin-top: 40px;
    padding: 24px 26px;
    background: var(--paper-50);
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .module-checkin h3 { font-family: var(--font-display); font-size: 16px; margin-bottom: 4px; }
  .module-checkin__hint { font-size: 12.5px; color: var(--ink-600); margin-bottom: 16px; }
  .module-checkin__question { font-weight: 600; font-size: 15px; margin-bottom: 12px; }
  .checkin-options { display: grid; gap: 8px; }
  .checkin-opt {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    font-size: 14px;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .checkin-opt:hover:not(:disabled) { border-color: var(--gold-500); }
  .checkin-opt:disabled { cursor: default; }
  .checkin-opt.is-correct { border-color: #2E7D5B; background: rgba(46,125,91,0.1); }
  .checkin-opt.is-incorrect { border-color: #B4432E; background: rgba(180,67,46,0.1); }
  .checkin-feedback { margin-top: 12px; font-size: 13.5px; font-weight: 600; }

  .learn-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 32px; }

  .qa-section { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
  .qa-section h3 { font-family: var(--font-display); font-size: 20px; margin-bottom: 8px; }
  .qa-hint { font-size: 13.5px; color: var(--ink-600); line-height: 1.6; }
  .qa-list { display: grid; gap: 12px; margin: 20px 0; }
  .qa-item { padding: 16px 18px; border: 1px solid var(--line); border-radius: 2px; background: var(--paper-0); }
  .qa-item .qa-q { font-weight: 600; margin: 0 0 6px; font-size: 14.5px; }
  .qa-item .qa-a { margin: 0; color: var(--ink-600); font-size: 14.5px; }
  .qa-form { margin-top: 20px; display: grid; gap: 10px; max-width: 560px; }
  .qa-form textarea { font: inherit; font-size: 14.5px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 2px; resize: vertical; }
  .qa-form textarea:focus-visible { outline: 2px solid var(--gold-500); outline-offset: 1px; }
  .qa-error { color: #B4432E; font-size: 13.5px; }
  .qa-sent { color: #2E7D5B; font-size: 13.5px; }

  /* ---------------------------------------------------------------
     Mobile Optimization
  --------------------------------------------------------------- */
  @media (max-width: 860px) {
    .learn-layout { grid-template-columns: 1fr; gap: 20px; padding: 100px 16px 48px; }

    .learn-sidebar {
      position: static;
      max-height: none;
      z-index: 1;
    }
    .learn-sidebar__toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      cursor: pointer;
      font-weight: 600;
      font-size: 14.5px;
      color: var(--ink-900);
      background: var(--paper-0);
      border-bottom: 1px solid var(--line);
    }
    .learn-sidebar__toggle-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 12.5px;
      color: var(--ink-600);
    }
    .chevron { transition: transform 0.2s var(--ease); flex: none; }
    .sidebar-checkbox:checked ~ .learn-sidebar__toggle .chevron { transform: rotate(180deg); }

    .learn-sidebar__pinned {
      display: none;
    }

    .sidebar-checkbox:checked ~ .learn-sidebar__pinned {
      display: block;
    }

    .learn-sidebar__scroll {
      display: none;
      border-top: none;
      max-height: 60vh;
    }
    .sidebar-checkbox:checked ~ .learn-sidebar__scroll { display: block; }

    .lesson-card { padding: 28px 22px; max-height: none; overflow-y: visible; }
    .learn-header h1 { font-size: 26px; }
  }
</style>

<script define:vars={{ courseSlug: course.id, stepId: step.id, stepTitle: step.title, learnerName: enrollment.name, nextStepUrl: nextStep ? `/courses/${course.id}/learn/${nextStep.id}` : null, quizUrl: `/courses/${course.id}#quizSection` }}>
  // Automatically scroll the active link into view inside the sidebar
  window.addEventListener('DOMContentLoaded', () => {
    const activeLink = document.querySelector('.learn-sidebar a.is-active');
    if (activeLink) {
      activeLink.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  });

  document.getElementById('completeBtn')?.addEventListener('click', async (e) => {
    const btn = e.target;
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      await fetch('/api/courses/complete-step', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ courseSlug, stepId }),
      });
    } catch {}
    window.location.href = nextStepUrl || quizUrl;
  });

  document.querySelectorAll('.checkin-opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const feedback = document.getElementById('checkinFeedback');
      feedback.hidden = false;
      feedback.textContent = btn.dataset.correct === 'true' ? 'Correct!' : 'Not quite — take another look above.';
    });
  });

  // ---------- Moderated Q&A ----------
  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  (async () => {
    const list = document.getElementById('qaList');
    const empty = document.getElementById('qaEmpty');
    try {
      const res = await fetch(`/api/courses/questions?course=${encodeURIComponent(courseSlug)}`);
      const data = await res.json();
      const items = data.questions || [];
      empty.hidden = items.length > 0;
      list.innerHTML = items.map((q) => `
        <div class="qa-item">
          <p class="qa-q">Q: ${escapeHtml(q.question)}</p>
          <p class="qa-a">A: ${escapeHtml(q.answer)}</p>
        </div>
      `).join('');
    } catch {
      empty.hidden = false;
    }
  })();

  const qaForm = document.getElementById('qaForm');
  qaForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorEl = document.getElementById('qaError');
    const sentEl = document.getElementById('qaSent');
    const btn = document.getElementById('qaSubmitBtn');
    const textarea = document.getElementById('qaQuestion');
    errorEl.hidden = true;
    btn.disabled = true;
    btn.textContent = 'Submitting…';
    try {
      const res = await fetch('/api/courses/questions', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          courseSlug, stepId, stepTitle,
          name: learnerName, question: textarea.value.trim(),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        errorEl.textContent = data.error || 'Something went wrong. Please try again.';
        errorEl.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Submit question';
        return;
      }
      qaForm.hidden = true;
      sentEl.hidden = false;
    } catch {
      errorEl.textContent = 'Could not reach the server. Please check your connection and try again.';
      errorEl.hidden = false;
      btn.disabled = false;
      btn.textContent = 'Submit question';
    }
  });
</script>