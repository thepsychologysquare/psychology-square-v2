---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { listCourses } from '../../lib/courses';
import { getClientSession } from '../../lib/clientAuth';
import Layout from '../../layouts/Layout.astro';
import { courseCategoryLabelMap } from '../../lib/courseCategories';

const allCourses = await listCourses(env, { includeDrafts: false });
const sorted = allCourses.sort((a, b) => a.data.order - b.data.order);

const categoryMeta = await courseCategoryLabelMap(env);

const session = env?.CLIENT_SESSION_SECRET
  ? await getClientSession(Astro.request.headers.get('cookie'), env.CLIENT_SESSION_SECRET)
  : null;

let enrolledSlugs = new Set<string>();
let completedSlugs = new Set<string>();
if (session && env?.DB) {
  const { results } = await env.DB.prepare(
    `SELECT course_slug AS courseSlug FROM enrollments WHERE email = ? AND status = 'active'`
  ).bind(session.email).all<{ courseSlug: string }>();
  enrolledSlugs = new Set((results || []).map((r) => r.courseSlug));

  const { results: certResults } = await env.DB.prepare(
    `SELECT course_slug AS courseSlug FROM certificates WHERE email = ?`
  ).bind(session.email).all<{ courseSlug: string }>();
  completedSlugs = new Set((certResults || []).map((r) => r.courseSlug));
}

let newSystemSlugs = new Set<string>();
if (env?.DB) {
  const { results } = await env.DB.prepare(
    `SELECT DISTINCT course_slug AS courseSlug FROM course_modules`
  ).all<{ courseSlug: string }>();
  newSystemSlugs = new Set((results || []).map((r) => r.courseSlug));
}

function cardHrefAndLabel(courseId: string): { href: string; label: string } {
  if (completedSlugs.has(courseId)) {
    return {
      href: newSystemSlugs.has(courseId) ? `/courses/${courseId}/learn` : `/courses/${courseId}`,
      label: 'Review',
    };
  }
  if (enrolledSlugs.has(courseId)) {
    return {
      href: newSystemSlugs.has(courseId) ? `/courses/${courseId}/learn` : `/courses/${courseId}`,
      label: 'Continue',
    };
  }
  return { href: `/courses/${courseId}`, label: 'Enroll' };
}

const categoriesInUse = [...new Set(sorted.map((c) => c.data.category))];

const placeholderClasses = [
  'bg-placeholder-1', 'bg-placeholder-2', 'bg-placeholder-3', 'bg-placeholder-4',
  'bg-placeholder-5', 'bg-placeholder-6', 'bg-placeholder-7', 'bg-placeholder-8', 'bg-placeholder-9',
];
function placeholderFor(id: string) {
  let hash = 0;
  for (let i = 0; i < id.length; i++) hash = (hash * 31 + id.charCodeAt(i)) >>> 0;
  return placeholderClasses[hash % placeholderClasses.length];
}

const siteOrigin = 'https://thepsychologysquare.com';

const coursesJson = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Psychology Courses — The Psychology Square',
  description: 'Self-paced psychology courses with a verifiable certificate on completion.',
  numberOfItems: sorted.length,
  itemListElement: sorted.map((course, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Course',
      name: course.data.title,
      description: course.data.description,
      url: `${siteOrigin}/courses/${course.id}`,
      ...(course.data.image ? { image: course.data.image } : {}),
      provider: {
        '@type': 'Organization',
        name: 'The Psychology Square',
        sameAs: siteOrigin,
      },
      ...(course.data.author ? { author: { '@type': 'Person', name: course.data.author } } : {}),
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'Online',
        courseWorkload: `PT${course.data.estimatedHours}H`,
      },
      offers: {
        '@type': 'Offer',
        price: course.data.isPaid ? course.data.pricePkr ?? 0 : 0,
        priceCurrency: 'PKR',
        category: course.data.isPaid ? 'Paid' : 'Free',
      },
    },
  })),
};
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Courses', item: `${siteOrigin}/courses` },
  ],
};

const paidCount = sorted.filter((c) => c.data.isPaid).length;
const freeCount = sorted.length - paidCount;

const coursesFaqs = [
  {
    question: 'Is the certificate really free?',
    answer: "Yes. Every course — free or paid — includes a digital certificate the moment you pass the quiz. It comes with a unique certificate ID and a public verification link, so anyone can confirm it's real. The certificate itself never costs extra, and it's emailed to you immediately.",
  },
  {
    question: 'Do I need an account to browse courses?',
    answer: "No — you can browse the full catalog and read what each course covers without signing in. You'll only need an email to sign in once you're ready to enroll.",
  },
  {
    question: "What if I don't pass the quiz on my first try?",
    answer: 'You can retake it as many times as you need. Review the lesson material and try again — there\'s no penalty and no extra cost.',
  },
  {
    question: 'How are free and paid courses different?',
    answer: "Paid courses go deeper on their topic and unlock after a quick payment review (usually within 24 hours). Free courses unlock instantly. Both include the full lessons and the same free certificate.",
  },
  {
    question: 'Who writes and reviews the courses?',
    answer: 'Courses are written by practicing clinical psychologists at The Psychology Square, drawing on established, peer-reviewed psychological research and clinical practice.',
  },
];
const coursesFaqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: coursesFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<Layout
  title="Courses"
  fullTitle="Free Psychology Courses and Certifications | The Psychology Square"
  description="Free psychology courses and certifications with verifiable digital certificates. Learn about therapy, mental health, research methods, and clinical skills from professional psychologists."
>
  <script type="application/ld+json" set:html={JSON.stringify(coursesJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(coursesFaqJson)} />

  <section class="courses-hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Courses</span>
      </nav>

      <div class="hero-title-area">
        <span class="eyebrow">Self-Paced &amp; Free To Try</span>
        <h1>Pakistan's First Psychology Courses with Verifiable Certificates</h1>
      </div>

      <p class="lede">Self-paced online psychology courses covering anxiety, CBT, ADHD, trauma, and more — written by clinical psychologists. Pass the short quiz at the end and get your certificate by email, free or paid.</p>
      {sorted.length > 0 && (
        <p class="course-count">
          {sorted.length} {sorted.length === 1 ? 'course' : 'courses'} available
          {freeCount > 0 && <> &middot; {freeCount} free</>}
          {paidCount > 0 && <> &middot; {paidCount} paid</>}
        </p>
      )}

      <ul class="trust-bar">
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M8.7 13.3 7 22l5-3 5 3-1.7-8.7"/></svg>
          </span>
          <div>
            <strong>Verifiable certificate, free</strong>
            <span>Unique ID + public verify link, emailed instantly</span>
          </div>
        </li>
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          </span>
          <div>
            <strong>Self-paced</strong>
            <span>Start, stop, and pick up again anytime</span>
          </div>
        </li>
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 7l9 4 9-4-9-4Z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/></svg>
          </span>
          <div>
            <strong>Written by clinical psychologists</strong>
            <span>Grounded in established, peer-reviewed research</span>
          </div>
        </li>
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <div>
            <strong>Browse without an account</strong>
            <span>See the full catalog — sign in only when you enroll</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="courses-grid-section">
    <div class="wrap">
      {sorted.length === 0 && (
        <p class="empty-state">No courses are available yet — check back soon.</p>
      )}

      {/* Full Width Session Panel Card placed directly above filters */}
      <div class="hero-auth-area">
        {session ? (
          <div class="session-card">
            <div class="session-card__user">
              <span class="session-status__dot" aria-hidden="true"></span>
              <span class="session-email" title={session.email}>{session.email}</span>
            </div>
            <div class="session-card__actions">
              <a href="/my-certificates" class="session-link">My certificates</a>
              <span class="sep" aria-hidden="true">·</span>
              <button type="button" id="logoutBtn" class="btn-logout-text">Log out</button>
            </div>
          </div>
        ) : (
          <div class="session-card session-card--guest">
            <div class="session-card__user">
              <span class="session-status__dot session-status__dot--guest" aria-hidden="true"></span>
              <span class="session-email">Not signed in</span>
            </div>
            <div class="session-card__actions">
              <a href="/login?redirect=/courses" class="session-link session-login-btn" aria-label="Log in">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="login-icon"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                <span>Log in</span>
              </a>
            </div>
          </div>
        )}
      </div>

      {sorted.length > 0 && (
        <>
          <div class="toolbar">
            <input type="text" id="search-input" class="search-input" placeholder="Search courses…" autocomplete="off" aria-label="Search courses" />

            <details class="filter-dropdown" id="filter-dropdown">
              <summary class="filter-toggle">
                Filters <span class="filter-badge" id="filter-badge" hidden>0</span>
              </summary>
              <div class="filter-panel">
                <div class="filter-group">
                  <h3 class="filter-heading">Price</h3>
                  <div class="checkbox-list" id="tier-filters">
                    <label class="checkbox-row">
                      <input type="checkbox" value="free" class="tier-checkbox" data-label="Free" />
                      <span>Free</span>
                    </label>
                    <label class="checkbox-row">
                      <input type="checkbox" value="paid" class="tier-checkbox" data-label="Paid" />
                      <span>Paid</span>
                    </label>
                  </div>
                </div>

                <div class="filter-group">
                  <h3 class="filter-heading">Topic</h3>
                  <div class="checkbox-list" id="category-filters">
                    {categoriesInUse.map((cat) => (
                      <label class="checkbox-row">
                        <input type="checkbox" value={cat} class="category-checkbox" data-label={categoryMeta[cat] ?? cat} />
                        <span>{categoryMeta[cat] ?? cat}</span>
                      </label>
                    ))}
                  </div>
                </div>

                {enrolledSlugs.size > 0 && (
                  <div class="filter-group">
                    <h3 class="filter-heading">My courses</h3>
                    <div class="checkbox-list">
                      <label class="checkbox-row">
                        <input type="checkbox" value="enrolled" id="enrolled-checkbox" data-label="My enrolled courses" />
                        <span>My enrolled courses</span>
                      </label>
                    </div>
                  </div>
                )}

                <div class="filter-panel-actions">
                  <button type="button" id="clear-filters" class="clear-filters-btn">Clear all</button>
                  <button type="button" class="btn btn--primary filter-done-btn" id="filter-done">Show results</button>
                </div>
              </div>
            </details>
          </div>

          <div class="active-chips" id="active-chips"></div>
          <p class="results-count" id="results-count"></p>
        </>
      )}

      <div class="courses-grid" id="coursesGrid">
        {sorted.map((course) => {
          const { href: cardHref, label: cardLabel } = cardHrefAndLabel(course.id);
          return (
          <a
            href={cardHref}
            class="course-card"
            data-tier={course.data.isPaid ? 'paid' : 'free'}
            data-category={course.data.category}
            data-title={course.data.title.toLowerCase()}
            data-description={(course.data.description || '').toLowerCase()}
            data-topic={(categoryMeta[course.data.category] ?? course.data.category).toLowerCase()}
            data-enrolled={enrolledSlugs.has(course.id) ? 'true' : 'false'}
          >
            <div class={`course-card__media ${course.data.image ? '' : placeholderFor(course.id)}`}>
              {course.data.image ? (
                <img
                  src={course.data.image}
                  alt={course.data.imageAlt || course.data.title}
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="225"
                />
              ) : (
                <span class="course-card__media-fallback" aria-hidden="true">
                  {(categoryMeta[course.data.category] ?? course.data.category).charAt(0)}
                </span>
              )}
              {completedSlugs.has(course.id) ? (
                <span class="enrolled-badge">Completed</span>
              ) : enrolledSlugs.has(course.id) && (
                <span class="enrolled-badge">Enrolled</span>
              )}
              <span class={`tier-badge ${course.data.isPaid ? 'tier-badge--paid' : 'tier-badge--free'}`}>
                {course.data.isPaid ? `Rs. ${course.data.pricePkr?.toLocaleString('en-US') ?? '—'}` : 'Free'}
              </span>
            </div>
            <div class="course-card__body">
              <span class="course-card__category">{categoryMeta[course.data.category] ?? course.data.category}</span>
              <h2>{course.data.title}</h2>
              <p>{course.data.description}</p>
              <div class="course-card__footer">
                <span class="btn btn--primary course-enroll-btn">{cardLabel}</span>
              </div>
            </div>
          </a>
          );
        })}
      </div>
      <p class="filter-empty" id="filterEmptyMsg" hidden>No courses match your search or filters. Try clearing some, or search a different term.</p>
    </div>
  </section>

  <section class="courses-faq-section">
    <div class="wrap">
      <div class="faq-inner">
        <span class="eyebrow">FAQ</span>
        <h2>Questions about our courses</h2>
        <div class="faq-columns faq-columns--single">
          {coursesFaqs.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.question}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const logoutBtn = document.getElementById('logoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      await fetch('/api/certificates/logout', { method: 'POST' });
      window.location.reload();
    });
  }

  type FilterEntry = { kind: 'tier' | 'category' | 'enrolled'; value: string; label: string };

  const grid = document.getElementById('coursesGrid');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.course-card')) : [];

  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const filterDropdown = document.getElementById('filter-dropdown') as HTMLDetailsElement | null;
  const filterBadge = document.getElementById('filter-badge');
  const tierCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.tier-checkbox'));
  const categoryCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.category-checkbox'));
  const enrolledCheckbox = document.getElementById('enrolled-checkbox') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-filters');
  const doneBtn = document.getElementById('filter-done');
  const resultsCount = document.getElementById('results-count');
  const emptyMsg = document.getElementById('filterEmptyMsg');
  const activeChipsContainer = document.getElementById('active-chips');

  // Collapse long topic lists behind a "show more" toggle (same as Articles).
  function setupShowMore(containerId: string, threshold = 8) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const rows = Array.from(container.querySelectorAll('.checkbox-row'));
    if (rows.length <= threshold) return;
    rows.slice(threshold).forEach((row) => row.classList.add('is-extra'));
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'show-more-btn';
    btn.textContent = `+ Show ${rows.length - threshold} more`;
    btn.addEventListener('click', () => {
      const nowShown = container.querySelectorAll('.checkbox-row.is-extra.is-shown').length === 0;
      rows.slice(threshold).forEach((row) => row.classList.toggle('is-shown', nowShown));
      btn.textContent = nowShown ? 'Show less' : `+ Show ${rows.length - threshold} more`;
    });
    container.after(btn);
  }
  setupShowMore('category-filters');

  function getActiveFilters(): FilterEntry[] {
    const out: FilterEntry[] = [];
    tierCheckboxes.filter((c) => c.checked).forEach((c) => out.push({ kind: 'tier', value: c.value, label: c.dataset.label || c.value }));
    categoryCheckboxes.filter((c) => c.checked).forEach((c) => out.push({ kind: 'category', value: c.value, label: c.dataset.label || c.value }));
    if (enrolledCheckbox?.checked) out.push({ kind: 'enrolled', value: 'enrolled', label: enrolledCheckbox.dataset.label || 'My enrolled courses' });
    return out;
  }

  function uncheck(f: FilterEntry) {
    if (f.kind === 'tier') tierCheckboxes.forEach((c) => { if (c.value === f.value) c.checked = false; });
    else if (f.kind === 'category') categoryCheckboxes.forEach((c) => { if (c.value === f.value) c.checked = false; });
    else if (enrolledCheckbox) enrolledCheckbox.checked = false;
  }

  function renderChips() {
    const active = getActiveFilters();
    if (activeChipsContainer) {
      activeChipsContainer.innerHTML = '';
      active.forEach((f) => {
        const chip = document.createElement('span');
        chip.className = 'active-chip';
        chip.append(document.createTextNode(`${f.label} `));
        const x = document.createElement('button');
        x.type = 'button';
        x.setAttribute('aria-label', `Remove filter: ${f.label}`);
        x.textContent = '✕';
        x.addEventListener('click', () => { uncheck(f); applyFilters(); });
        chip.appendChild(x);
        activeChipsContainer.appendChild(chip);
      });
    }
    if (filterBadge) {
      filterBadge.hidden = active.length === 0;
      filterBadge.textContent = String(active.length);
    }
  }

  function applyFilters() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    const tiers = tierCheckboxes.filter((c) => c.checked).map((c) => c.value);
    const categories = categoryCheckboxes.filter((c) => c.checked).map((c) => c.value);
    const enrolledOnly = !!enrolledCheckbox?.checked;

    let visibleCount = 0;
    for (const card of cards) {
      const haystack = `${card.dataset.title || ''} ${card.dataset.description || ''} ${card.dataset.topic || ''}`;
      const matchesSearch = !query || haystack.includes(query);
      const matchesTier = tiers.length === 0 || tiers.includes(card.dataset.tier || '');
      const matchesCategory = categories.length === 0 || categories.includes(card.dataset.category || '');
      const matchesEnrollment = !enrolledOnly || card.dataset.enrolled === 'true';
      const show = matchesSearch && matchesTier && matchesCategory && matchesEnrollment;
      card.classList.toggle('is-hidden', !show);
      if (show) visibleCount++;
    }

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} course${cards.length === 1 ? '' : 's'}`;
    }
    if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
    renderChips();
  }

  searchInput?.addEventListener('input', applyFilters);
  tierCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));
  categoryCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));
  enrolledCheckbox?.addEventListener('change', applyFilters);

  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    tierCheckboxes.forEach((cb) => (cb.checked = false));
    categoryCheckboxes.forEach((cb) => (cb.checked = false));
    if (enrolledCheckbox) enrolledCheckbox.checked = false;
    applyFilters();
  });

  doneBtn?.addEventListener('click', () => { if (filterDropdown) filterDropdown.open = false; });

  document.addEventListener('click', (e) => {
    if (filterDropdown?.open && !filterDropdown.contains(e.target as Node)) {
      filterDropdown.open = false;
    }
  });

  // Deep link from the nav menu: /courses/?category=anxiety pre-selects that topic.
  const presetCategory = new URLSearchParams(window.location.search).get('category');
  if (presetCategory) {
    categoryCheckboxes.forEach((cb) => { if (cb.value === presetCategory) cb.checked = true; });
  }

  applyFilters();
</script>

<style>
  .courses-hero{
    background: var(--navy-950);
    color: var(--paper-0);
    padding: 96px 0 40px;
    background-image:
      radial-gradient(circle at top right, rgba(197, 160, 89, 0.15), transparent 60%),
      radial-gradient(circle at bottom left, rgba(28, 49, 76, 0.5), transparent 55%);
  }
  .breadcrumbs{
    font-family:var(--font-mono); font-size:12px; color:rgba(248,249,246,0.6);
    margin-bottom:14px; margin-top: 50px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  }
  .breadcrumbs a:hover{ color:var(--gold-300); }
  .crumb-sep{ color:rgba(248,249,246,0.3); }
  .crumb-current{ color:rgba(248,249,246,0.85); }

  /* Full Width Session Panel Card */
  .hero-auth-area {
    margin-bottom: 24px;
    width: 100%;
  }
  .session-card {
    background: var(--paper-0);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    box-shadow: 0 2px 8px rgba(19, 26, 34, 0.04);
  }
  .session-card__user {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--ink-900);
    min-width: 0;
  }
  .session-status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4CAF7D;
    flex-shrink: 0;
    box-shadow: 0 0 8px rgba(76, 175, 125, 0.5);
  }
  .session-status__dot--guest {
    background: var(--ink-450, #8c959f);
    box-shadow: none;
  }
  .session-email {
    font-weight: 500;
    color: var(--ink-900);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .session-card__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    flex-shrink: 0;
  }
  .session-link {
    color: var(--gold-600, #967426);
    text-decoration: none;
    font-weight: 500;
  }
  .session-link:hover {
    text-decoration: underline;
