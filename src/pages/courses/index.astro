---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { listCourses } from '../../lib/courses';
import { getClientSession } from '../../lib/clientAuth';
import Layout from '../../layouts/Layout.astro';

const allCourses = await listCourses(env, { includeDrafts: false });
const sorted = allCourses.sort((a, b) => a.data.order - b.data.order);

const categoryMeta: Record<string, string> = {
  'general': 'General',
  'anxiety': 'Anxiety',
  'depression': 'Depression',
  'adhd': 'ADHD',
  'addiction-recovery': 'Addiction & Recovery',
  'trauma': 'Trauma',
  'relationships': 'Relationships',
  'stress-burnout': 'Stress & Burnout',
};

const session = env?.CLIENT_SESSION_SECRET
  ? await getClientSession(Astro.request.headers.get('cookie'), env.CLIENT_SESSION_SECRET)
  : null;

const categoriesInUse = [...new Set(sorted.map((c) => c.data.category))];

// Stable, non-random gradient placeholder for cards without a cover image —
// same course always gets the same one, no layout shift between reloads.
const placeholderClasses = [
  'bg-placeholder-1', 'bg-placeholder-2', 'bg-placeholder-3', 'bg-placeholder-4',
  'bg-placeholder-5', 'bg-placeholder-6', 'bg-placeholder-7', 'bg-placeholder-8', 'bg-placeholder-9',
];
function placeholderFor(id: string) {
  let hash = 0;
  for (let i = 0; i < id.length; i++) hash = (hash * 31 + id.charCodeAt(i)) >>> 0;
  return placeholderClasses[hash % placeholderClasses.length];
}

const siteOrigin = 'https://thepsychologysquare.com';

// Course schema per listed course, plus a CollectionPage/ItemList wrapper —
// gives search engines rich, structured course data (provider, price,
// format) straight from the listing page, not just the individual pages.
const coursesJson = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Psychology Courses — The Psychology Square',
  description: 'Self-paced psychology courses with a verifiable certificate on completion.',
  numberOfItems: sorted.length,
  itemListElement: sorted.map((course, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Course',
      name: course.data.title,
      description: course.data.description,
      url: `${siteOrigin}/courses/${course.id}`,
      ...(course.data.image ? { image: course.data.image } : {}),
      provider: {
        '@type': 'Organization',
        name: 'The Psychology Square',
        sameAs: siteOrigin,
      },
      ...(course.data.author ? { author: { '@type': 'Person', name: course.data.author } } : {}),
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'Online',
        courseWorkload: `PT${course.data.estimatedHours}H`,
      },
      offers: {
        '@type': 'Offer',
        price: course.data.isPaid ? course.data.pricePkr ?? 0 : 0,
        priceCurrency: 'PKR',
        category: course.data.isPaid ? 'Paid' : 'Free',
      },
    },
  })),
};
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Courses', item: `${siteOrigin}/courses` },
  ],
};

const paidCount = sorted.filter((c) => c.data.isPaid).length;
const freeCount = sorted.length - paidCount;

const coursesFaqs = [
  {
    question: 'Is the certificate really free?',
    answer: "Yes. Every course — free or paid — includes a verifiable digital certificate the moment you pass the quiz. The certificate itself never costs extra, and it's emailed to you immediately.",
  },
  {
    question: 'Do I need an account to browse courses?',
    answer: "No — you can browse the full catalog and read what each course covers without signing in. You'll only need an email to sign in once you're ready to enroll.",
  },
  {
    question: "What if I don't pass the quiz on my first try?",
    answer: 'You can retake it as many times as you need. Review the lesson material and try again — there\'s no penalty and no extra cost.',
  },
  {
    question: 'How are free and paid courses different?',
    answer: "Paid courses go deeper on their topic and unlock after a quick payment review (usually within 24 hours). Free courses unlock instantly. Both include the full lessons and the same free certificate.",
  },
  {
    question: 'Who writes and reviews the courses?',
    answer: 'Courses are written by practicing clinical psychologists at The Psychology Square, drawing on established, peer-reviewed psychological research and clinical practice.',
  },
];
const coursesFaqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: coursesFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<Layout
  title="Courses"
  fullTitle="Psychology Courses Online — Anxiety, CBT, ADHD & More | The Psychology Square"
  description="Self-paced online psychology courses from The Psychology Square — CBT fundamentals, anxiety, ADHD, trauma, and more. Pass the quiz, get a free verifiable certificate by email."
>
  <script type="application/ld+json" set:html={JSON.stringify(coursesJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(coursesFaqJson)} />

  <section class="courses-hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Courses</span>
      </nav>
      <div class="hero-top">
        <h1>Courses</h1>
        {session ? (
          <div class="session-status">
            <span class="session-status__dot" aria-hidden="true"></span>
            <span>Signed in as <strong>{session.email}</strong></span>
            <a href="/my-certificates">My certificates</a>
            <button type="button" id="logoutBtn" class="btn btn--text">Log out</button>
          </div>
        ) : (
          <a href="/login?redirect=/courses" class="icon-login-btn" aria-label="Log In">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
              <polyline points="10 17 15 12 10 7" />
              <line x1="15" y1="12" x2="3" y2="12" />
            </svg>
          </a>
        )}
      </div>

      <p class="lede">Short, practical courses. Pass the quiz at the end and we'll email you a verifiable certificate immediately — free or paid, the certificate never costs extra. Let's do it.</p>
      {sorted.length > 0 && (
        <p class="course-count">
          {sorted.length} {sorted.length === 1 ? 'course' : 'courses'} available
          {freeCount > 0 && <> &middot; {freeCount} free</>}
          {paidCount > 0 && <> &middot; {paidCount} paid</>}
        </p>
      )}

      <ul class="trust-bar">
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M8.7 13.3 7 22l5-3 5 3-1.7-8.7"/></svg>
          </span>
          <div>
            <strong>Free verifiable certificate</strong>
            <span>Emailed instantly on every course, paid or free</span>
          </div>
        </li>
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          </span>
          <div>
            <strong>Self-paced</strong>
            <span>Start, stop, and pick up again anytime</span>
          </div>
        </li>
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 7l9 4 9-4-9-4Z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/></svg>
          </span>
          <div>
            <strong>Written by clinical psychologists</strong>
            <span>Grounded in established, peer-reviewed research</span>
          </div>
        </li>
        <li class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <div>
            <strong>No login to browse</strong>
            <span>Explore every course free — sign in only to enroll</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="courses-grid-section">
    <div class="wrap">
      {sorted.length === 0 && (
        <p class="empty-state">No courses are available yet — check back soon.</p>
      )}

      {sorted.length > 0 && (
        <div class="filter-bar" id="filterBar">
          <div class="filter-group" id="tierFilters">
            <button type="button" class="filter-chip is-active" data-tier="all">All</button>
            <button type="button" class="filter-chip" data-tier="free">Free</button>
            <button type="button" class="filter-chip" data-tier="paid">Paid</button>
          </div>
          <span class="filter-divider" aria-hidden="true"></span>
          <div class="filter-group" id="categoryFilters">
            <button type="button" class="filter-chip is-active" data-category="all">All topics</button>
            {categoriesInUse.map((cat) => (
              <button type="button" class="filter-chip" data-category={cat}>{categoryMeta[cat] ?? cat}</button>
            ))}
          </div>
        </div>
      )}

      <div class="courses-grid" id="coursesGrid">
        {sorted.map((course) => (
          <a
            href={`/courses/${course.id}`}
            class="course-card"
            data-tier={course.data.isPaid ? 'paid' : 'free'}
            data-category={course.data.category}
          >
            <div class={`course-card__media ${course.data.image ? '' : placeholderFor(course.id)}`}>
              {course.data.image ? (
                <img
                  src={course.data.image}
                  alt={course.data.imageAlt || course.data.title}
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="225"
                />
              ) : (
                <span class="course-card__media-fallback" aria-hidden="true">
                  {(categoryMeta[course.data.category] ?? course.data.category).charAt(0)}
                </span>
              )}
              <span class={`tier-badge ${course.data.isPaid ? 'tier-badge--paid' : 'tier-badge--free'}`}>
                {course.data.isPaid ? `Rs. ${course.data.pricePkr?.toLocaleString('en-US') ?? '—'}` : 'Free'}
              </span>
            </div>
            <div class="course-card__body">
              <span class="course-card__category">{categoryMeta[course.data.category] ?? course.data.category}</span>
              <h2>{course.data.title}</h2>
              <p>{course.data.description}</p>
              <div class="course-card__footer">
                <span class="btn btn--primary course-enroll-btn">Enroll</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <p class="filter-empty" id="filterEmptyMsg" hidden>No courses match those filters.</p>
    </div>
  </section>

  <section class="courses-faq-section">
    <div class="wrap wrap--narrow">
      <span class="eyebrow">FAQ</span>
      <h2>Questions about our courses</h2>
      {coursesFaqs.map((f) => (
        <details class="faq-item">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<script>
  const logoutBtn = document.getElementById('logoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      await fetch('/api/certificates/logout', { method: 'POST' });
      window.location.reload();
    });
  }

  const grid = document.getElementById('coursesGrid');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLAnchorElement>('.course-card')) : [];
  const tierFilters = document.getElementById('tierFilters');
  const categoryFilters = document.getElementById('categoryFilters');
  const emptyMsg = document.getElementById('filterEmptyMsg');

  let activeTier = 'all';
  let activeCategory = 'all';

  function applyFilters() {
    let visibleCount = 0;
    for (const card of cards) {
      const matchesTier = activeTier === 'all' || card.dataset.tier === activeTier;
      const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
      const visible = matchesTier && matchesCategory;
      card.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    }
    if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
  }

  tierFilters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
    if (!btn || !btn.dataset.tier) return;
    tierFilters.querySelectorAll('.filter-chip').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    activeTier = btn.dataset.tier;
    applyFilters();
  });

  categoryFilters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
    if (!btn || !btn.dataset.category) return;
    categoryFilters.querySelectorAll('.filter-chip').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    activeCategory = btn.dataset.category;
    applyFilters();
  });
</script>

<style>
  .courses-hero{ padding:72px 0 40px; border-bottom:1px solid var(--line); }
  .breadcrumbs{
    font-family:var(--font-mono); font-size:12px; color:var(--ink-600);
    margin-bottom:18px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  }
  .breadcrumbs a{ color:var(--ink-600); }
  .breadcrumbs a:hover{ color:var(--gold-500); }
  .crumb-sep{ color:var(--line); }
  .crumb-current{ color:var(--ink-900); }
  .hero-top{ display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-top: 50px}
  .hero-top h1{ margin:0; }
  .session-status{ display:flex; align-items:center; gap:10px; font-size:13.5px; color:var(--ink-600); flex-wrap:wrap; }
  .session-status__dot{ width:8px; height:8px; border-radius:50%; background:#2E7D5B; flex-shrink:0; }
  .session-status strong{ color:var(--ink-900); }
  .session-status a{ color:var(--gold-500); text-decoration:none; }
  .session-status a:hover{ text-decoration:underline; }
  .session-status .btn--text{ font-size:13.5px; color:var(--ink-900); text-decoration:underline; padding:0; }

  .icon-login-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;

    background: var(--navy-950);
    color: var(--gold-500);
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(19, 26, 34, 0.06);

    transition: all 0.25s var(--ease);
  }
  .icon-login-btn svg {
    width: 20px;
    height: 20px;
    transition: transform 0.2s var(--ease);
  }
  .icon-login-btn:hover {
    background: var(--navy-800);
    color: var(--gold-300);
  }
  .icon-login-btn:hover svg {
    transform: translateX(2px);
  }
  .icon-login-btn:active {
    background: var(--navy-700);
    transform: scale(0.95);
  }
  .icon-login-btn:focus-visible {
    outline: 3px solid var(--gold-300);
    outline-offset: 2px;
  }

  .courses-hero h1{ font-family:var(--font-display); font-size:clamp(32px,4vw,44px); margin:6px 0 14px; }
  .courses-hero .lede{ max-width:560px; color:var(--ink-600); font-size:17px; line-height:1.6; margin-bottom:6px; }
  .course-count{ font-family:var(--font-mono); font-size:12.5px; color:var(--ink-600); margin-bottom:26px; }
  .eyebrow{ font-family:var(--font-mono); font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--gold-500); }

  .trust-bar{
    list-style:none; margin:0; padding:0;
    display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:1px;
    background:var(--line); border:1px solid var(--line); border-radius:6px; overflow:hidden;
  }
  .trust-item{
    display:flex; align-items:flex-start; gap:12px; padding:20px; background:var(--paper-0);
  }
  .trust-item__icon{
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
    width:38px; height:38px; border-radius:50%; background:rgba(199,164,74,0.12); color:var(--gold-500);
  }
  .trust-item__icon svg{ width:19px; height:19px; }
  .trust-item strong{ display:block; font-size:14px; font-weight:600; color:var(--ink-900); margin-bottom:3px; }
  .trust-item span{ display:block; font-size:12.5px; color:var(--ink-600); line-height:1.4; }

  .courses-grid-section{ padding:56px 0 40px; }
  .empty-state{ color:var(--ink-600); }

  .courses-faq-section{ padding:16px 0 88px; }
  .courses-faq-section .wrap--narrow{ max-width:760px; margin:0 auto; padding:0 24px; box-sizing:border-box; }
  .courses-faq-section h2{ font-family:var(--font-display); font-size:clamp(24px,3vw,30px); margin:8px 0 24px; }
  .faq-item{ border:1px solid var(--line); border-radius:2px; padding:16px 20px; margin-bottom:10px; }
  .faq-item summary{ cursor:pointer; font-weight:600; font-size:15px; list-style:none; }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item summary::before{ content:"+"; display:inline-block; width:18px; color:var(--gold-500); font-weight:700; }
  .faq-item[open] summary::before{ content:"–"; }
  .faq-item p{ margin:12px 0 0 18px; color:var(--ink-600); font-size:14.5px; line-height:1.6; }

  .filter-bar{
    display:flex; flex-wrap:wrap; align-items:center; gap:8px 14px; margin-bottom:32px;
  }
  .filter-group{ display:flex; gap:8px; flex-wrap:wrap; }
  .filter-divider{
    width:1px; align-self:stretch; min-height:20px; background:var(--line);
  }
  .filter-chip{
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.05em; text-transform:uppercase;
    padding:8px 14px; border:1px solid var(--line); border-radius:20px; background:transparent;
    cursor:pointer; color:var(--ink-600); transition:border-color .15s ease, color .15s ease, background .15s ease;
  }
  .filter-chip:hover{ border-color:var(--gold-500); }
  .filter-chip.is-active{ border-color:var(--gold-500); color:var(--ink-900); background:rgba(199,164,74,0.1); }
  .filter-empty{ color:var(--ink-600); padding:32px 0; text-align:center; }

  .courses-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:28px; }
  .course-card{
    display:flex; flex-direction:column;
    border:1px solid var(--line); border-radius:6px; background:var(--paper-0); overflow:hidden;
    text-decoration:none; color:inherit; transition:border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .course-card:hover{ border-color:var(--gold-500); transform:translateY(-3px); box-shadow:0 14px 30px rgba(19,26,34,0.08); }

  .course-card__media{
    position:relative; width:100%; aspect-ratio:16/9; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
  }
  .course-card__media img{ width:100%; height:100%; object-fit:cover; display:block; }
  .course-card__media-fallback{
    font-family:var(--font-display); font-size:52px; color:rgba(255,255,255,0.85);
  }
  .course-card__media .tier-badge{
    position:absolute; top:12px; right:12px;
  }

  .course-card__body{ display:flex; flex-direction:column; gap:8px; padding:22px 24px 26px; flex-grow:1; }
  .course-card__category{
    font-family:var(--font-mono); font-size:11px; letter-spacing:0.06em; text-transform:uppercase; color:var(--gold-500);
  }
  .tier-badge{
    font-family:var(--font-mono); font-size:11px; letter-spacing:0.04em; font-weight:600;
    padding:4px 11px; border-radius:20px; white-space:nowrap; box-shadow:0 2px 8px rgba(19,26,34,0.12);
  }
  .tier-badge--free{ background:#eaf5ef; color:#2E7D5B; }
  .tier-badge--paid{ background:#faf3df; color:#8a6d1f; }
  .course-card h2{
    font-family:var(--font-display); font-size:19px; margin:0; line-height:1.3;
  }
  .course-card p{
    color:var(--ink-600); font-size:14.5px; line-height:1.55; flex-grow:1;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
  }
  .course-card__footer{
    padding-top:14px; margin-top:2px; border-top:1px solid var(--line);
    display:flex; align-items:center;
  }
  .course-enroll-btn{
    padding:8px 20px;
    font-size:13px;
  }
</style>