---
export const prerender = false;
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { getSession } from '../../../lib/adminAuth';
import { listCourses } from '../../../lib/courses';

const session = await getSession(Astro.request.headers.get('cookie'), env?.ADMIN_SESSION_SECRET || '');
if (!session) return Astro.redirect('/dashboard/login');

const courses = (await listCourses(env, { includeDrafts: true })).sort((a, b) => a.data.order - b.data.order);

const counts = new Map<string, number>();
if (env?.DB) {
  const rows = (await env.DB.prepare(`SELECT course_slug, COUNT(*) AS n FROM course_modules GROUP BY course_slug`).all())
    .results as { course_slug: string; n: number }[];
  for (const r of rows) counts.set(r.course_slug, r.n);
}
---
<DashboardLayout title="Courses" backHref="/dashboard" backLabel="Back to dashboard">
  <Fragment slot="header">
    <header class="studio-list-header">
      <div class="wrap">
        <div class="studio-list-header__row">
          <div>
            <span class="eyebrow">Course Builder</span>
            <h1>Courses</h1>
            <p class="studio-list-hint">Everything about a course — title, slug, description, pricing, quiz, and every lesson — is created and edited right here now.</p>
          </div>
          <a href="/dashboard/courses/new" class="btn btn--primary">+ New course</a>
        </div>
      </div>
    </header>
  </Fragment>

  <main class="wrap studio-list-main">
    {courses.length === 0 && (
      <div class="empty-state">
        <p>No courses yet.</p>
        <a href="/dashboard/courses/new" class="btn btn--primary">Create your first course</a>
      </div>
    )}

    <ul class="course-list">
      {courses.map((c) => (
        <li class="course-list__item">
          <a href={`/dashboard/courses/${c.id}`} class="course-list__link">
            <div class="course-list__main">
              <div class="course-list__title-row">
                <span class="course-list__title">{c.data.title}</span>
                <span class={`badge ${c.data.draft ? 'badge--draft' : 'badge--published'}`}>
                  {c.data.draft ? 'Draft' : 'Published'}
                </span>
                {c.data.isPaid && <span class="badge badge--paid">Paid &middot; Rs. {c.data.pricePkr?.toLocaleString('en-US') ?? '—'}</span>}
              </div>
              <p class="course-list__desc">{c.data.description}</p>
            </div>
            <div class="course-list__meta">
              <span>{counts.get(c.id) || 0} module{counts.get(c.id) === 1 ? '' : 's'}</span>
              <span>{c.data.quiz?.length || 0} quiz question{(c.data.quiz?.length || 0) === 1 ? '' : 's'}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</DashboardLayout>

<style>
  .studio-list-header { padding: 20px 0 8px; }
  .studio-list-header__row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .eyebrow { display: block; font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-500); margin-bottom: 4px; }
  h1 { font-family: var(--font-display); font-size: 30px; margin: 0 0 6px; color: var(--navy-950); }
  .studio-list-hint { color: var(--ink-600); max-width: 56ch; margin: 0; font-size: 14.5px; }

  .btn { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14.5px; padding: 11px 20px; border-radius: 8px; text-decoration: none; border: none; cursor: pointer; transition: all 0.15s var(--ease); }
  .btn--primary { background: var(--navy-950); color: #fff; }
  .btn--primary:hover { background: var(--navy-700); }

  .studio-list-main { padding: 24px 0 96px; }
  .empty-state { text-align: center; padding: 64px 24px; color: var(--ink-600); display: grid; gap: 16px; justify-items: center; }

  .course-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .course-list__link {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 18px 22px; background: #fff; border: 1px solid var(--line); border-radius: 12px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .course-list__link:hover { border-color: var(--gold-500); box-shadow: 0 2px 12px rgba(11,20,31,0.06); }
  .course-list__main { min-width: 0; }
  .course-list__title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }
  .course-list__title { font-weight: 700; font-size: 16.5px; font-family: var(--font-display); }
  .course-list__desc { margin: 0; color: var(--ink-600); font-size: 14px; max-width: 60ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .course-list__meta { display: flex; flex-direction: column; gap: 4px; text-align: right; font-size: 12.5px; color: var(--ink-600); flex-shrink: 0; }

  .badge { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 3px 9px; border-radius: 20px; }
  .badge--draft { background: rgba(199,164,74,0.16); color: #8a6d1f; }
  .badge--published { background: rgba(124,152,133,0.18); color: #3d5b46; }
  .badge--paid { background: rgba(28,49,76,0.08); color: var(--navy-700); }
</style>
