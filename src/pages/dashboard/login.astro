---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Staff login" description="The Psychology Square — staff dashboard.">
  <section class="login-section">
    <div class="wrap login-wrap">
      <form id="loginForm" class="login-form">
        <span class="eyebrow">Staff only</span>
        <h1>Sign in</h1>
        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" autocomplete="username" required autofocus placeholder="Username" />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn--primary" id="loginBtn">Sign in</button>
        <p class="login-error" id="loginError" role="alert" hidden></p>
      </form>
    </div>
  </section>
</Layout>

<style>
  .login-section{ padding:96px 0; display:flex; justify-content:center; }
  .login-wrap{ max-width:360px; width:100%; }
  .login-form{ display:flex; flex-direction:column; gap:16px; }
  .login-form h1{ font-size:28px; margin-bottom:2px; }
  .field{ display:flex; flex-direction:column; gap:6px; }
  label{ font-size:14px; font-weight:500; }
  input[type="text"], input[type="password"]{
    font-family:var(--font-body); font-size:15px; padding:12px 14px;
    border:1px solid var(--line); border-radius:2px;
  }
  input:focus-visible{ outline:2px solid var(--gold-500); outline-offset:1px; }
  button{ font-family:var(--font-body); cursor:pointer; }
  .btn{ border:none; margin-top:6px; }
  .login-error{ color:#B4432E; font-size:14px; }

  @media (max-width:480px), (max-height:640px){
    .login-section{ padding:56px 20px; }
  }
</style>

<script>
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const loginBtn = document.getElementById('loginBtn') as HTMLButtonElement;
  const loginError = document.getElementById('loginError') as HTMLParagraphElement;

  function normalizeIdentity(raw: string): 'admin' | 'sohail' | 'sehar' | null {
    const v = raw.trim().toLowerCase();
    if (v.includes('admin')) return 'admin';
    if (v.includes('sohail')) return 'sohail';
    if (v.includes('sehar')) return 'sehar';
    return null;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginError.hidden = true;

    const identity = normalizeIdentity(usernameInput.value);
    if (!identity) {
      loginError.textContent = 'Username or password incorrect.';
      loginError.hidden = false;
      return;
    }

    loginBtn.disabled = true;
    loginBtn.textContent = 'Signing in…';

    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ identity, password: passwordInput.value }),
    });

    if (res.ok) {
      window.location.href = '/dashboard';
    } else {
      loginError.textContent = 'Username or password incorrect.';
      loginError.hidden = false;
      loginBtn.disabled = false;
      loginBtn.textContent = 'Sign in';
    }
  });
</script>
