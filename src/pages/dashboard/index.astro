  bookingsBody.addEventListener('click', async (e) => {
    const shotBtn = e.target.closest('[data-shot]');
    if (shotBtn) {
      // Open the tab synchronously, right on the click, so browsers don't
      // treat it as a blocked popup (that only happens once we're past
      // an `await` and the original click's "user gesture" has expired).
      const win = window.open('', '_blank');
      shotBtn.disabled = true;
      const originalText = shotBtn.textContent;
      shotBtn.textContent = 'Loading…';
      const src = `/api/admin/screenshot/${shotBtn.dataset.shot}`;
      try {
        const res = await fetch(src, { credentials: 'same-origin' });
        if (!res.ok) throw new Error(`Server said ${res.status}`);
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        if (win) win.location.href = blobUrl;
      } catch (err) {
        if (win) win.close();
        window.alert(`Could not load the screenshot: ${err.message || err}`);
      } finally {
        shotBtn.disabled = false;
        shotBtn.textContent = originalText;
      }
      return;
    }
    const deleteBtn = e.target.closest('[data-delete]');
    if (deleteBtn) {
      const id = deleteBtn.dataset.delete;
      const ok = await showConfirm(`Delete booking ${id} permanently? This can't be undone.`);
      if (!ok) return;
      deleteBtn.disabled = true;
      const res = await fetch(`/api/admin/bookings?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
      if (res.ok) {
        allBookings = allBookings.filter((b) => b.id !== id);
        selected.delete(id);
        render();
      }
      return;
    }
    const btn = e.target.closest('.icon-btn.confirm, .icon-btn.decline');
    if (!btn) return;
    const id = btn.dataset.id, status = btn.dataset.status;
    const ok = await showConfirm(`Mark booking ${id} as ${status}?`);
    if (!ok) return;
    btn.disabled = true;
    await fetch('/api/admin/bookings', {
      method: 'PATCH', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id, status }),
    });
    const booking = allBookings.find((b) => b.id === id);
    if (booking) booking.status = status;
    render();
  });

  async function bulkUpdate(status) {
    if (!selected.size) return;
    const ok = await showConfirm(`Mark ${selected.size} booking(s) as ${status}?`);
    if (!ok) return;
    await Promise.all([...selected].map((id) =>
      fetch('/api/admin/bookings', {
        method: 'PATCH', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, status }),
      })
    ));
    for (const id of selected) {
      const booking = allBookings.find((b) => b.id === id);
      if (booking) booking.status = status;
    }
    selected.clear();
    render();
  }
