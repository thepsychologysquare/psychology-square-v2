  exportBtn.addEventListener('click', () => {
    const cols = ['id', 'created_at', 'client_name', 'contact', 'service', 'clinician', 'preferred_time', 'amount_pkr', 'payment_method', 'status', 'notes'];
    const header = ['Reference', 'Submitted', 'Name', 'Contact', 'Service', 'Clinician', 'Time', 'Amount (PKR)', 'Payment Method', 'Status', 'Notes'];
    const rows = filteredSorted().map((b) => cols.map((c) => {
      const v = String(b[c] ?? '').replace(/"/g, '""');
      return `"${v}"`;
    }).join(','));
    const csv = [header.join(','), ...rows].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `bookings-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  logoutBtn.addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    window.location.href = '/dashboard/login';
  });

  loadBookings();
  setInterval(() => loadBookings(true), 30000);

  // ===== Availability =====
  const DAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const availClinicianSelect = document.getElementById('availClinician');
  const dayRows = document.getElementById('dayRows');
  const bufferMinutesSelect = document.getElementById('bufferMinutes');
  const saveTemplateBtn = document.getElementById('saveTemplateBtn');
  const templateSavedMsg = document.getElementById('templateSavedMsg');
  const bookedWarning = document.getElementById('bookedWarning');
  const calPrev = document.getElementById('calPrev');
  const calNext = document.getElementById('calNext');
  const calMonthLabel = document.getElementById('calMonthLabel');
  const calGrid = document.getElementById('calGrid');
  const calDayPanel = document.getElementById('calDayPanel');
  const calDayPanelTitle = document.getElementById('calDayPanelTitle');
  const calDayOffToggle = document.getElementById('calDayOffToggle');
  const calDaySlots = document.getElementById('calDaySlots');
  const undoToast = document.getElementById('undoToast');
  const undoToastText = document.getElementById('undoToastText');
  const undoToastBtn = document.getElementById('undoToastBtn');
  let undoTimeout = null;
  let pendingUndoId = null;
  const calSelectModeBtn = document.getElementById('calSelectModeBtn');
  const calSelectBar = document.getElementById('calSelectBar');
  const calSelectCount = document.getElementById('calSelectCount');
  const calExcludeSelected = document.getElementById('calExcludeSelected');
  const calIncludeSelected = document.getElementById('calIncludeSelected');
  const calClearSelected = document.getElementById('calClearSelected');

  // Build the 7 per-day rows once
  for (let day = 0; day < 7; day++) {
    const row = document.createElement('div');
    row.className = 'day-row';
    row.dataset.day = String(day);
    row.innerHTML = `
      <label class="day-row-toggle">
        <input type="checkbox" class="day-row-checkbox" />
        ${DAY_LABELS[day]}
      </label>
      <div class="day-row-fields">
        <input type="time" class="day-start" value="09:00" />
        <span>to</span>
        <input type="time" class="day-end" value="17:00" />
        <select class="day-slot-len">
          <option value="30">30 min</option>
          <option value="45">45 min</option>
          <option value="60" selected>60 min</option>
          <option value="90">90 min</option>
          <option value="120">120 min</option>
        </select>
      </div>
    `;
    dayRows.appendChild(row);
  }
  dayRows.addEventListener('change', (e) => {
    if (!e.target.classList.contains('day-row-checkbox')) return;
    const row = e.target.closest('.day-row');
    row.classList.toggle('is-on', e.target.checked);
  });

  let availSlots = [];
  let availExceptions = new Set();
  let calMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
  let selectedDate = null;
  let selectMode = false;
  let selectedDates = new Set();

  function currentClinicianForAvail() {
    return role === 'admin' ? availClinicianSelect.value : role;
  }
  function todayStr() { return fmtDate(new Date()); }
  function fmtDate(d) { return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }

  function updateSelectBar() {
    calSelectBar.hidden = selectedDates.size === 0;
    calSelectCount.textContent = `${selectedDates.size} day${selectedDates.size === 1 ? '' : 's'} selected`;
  }

  async function applyBulk(mode, dates) {
    const clinician = currentClinicianForAvail();
    await fetch('/api/admin/availability', {
      method: 'PUT', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ mode, clinician, dates }),
    });
    await loadAvailability();
  }

  calSelectModeBtn.addEventListener('click', () => {
    selectMode = !selectMode;
    calSelectModeBtn.classList.toggle('is-active', selectMode);
    calSelectModeBtn.textContent = selectMode ? 'Done selecting' : 'Select multiple days';
    if (!selectMode) { selectedDates.clear(); updateSelectBar(); }
    renderCalendar();
  });
  calExcludeSelected.addEventListener('click', () => applyBulk('exclude', [...selectedDates]));
  calIncludeSelected.addEventListener('click', () => applyBulk('include', [...selectedDates]));
  calClearSelected.addEventListener('click', () => { selectedDates.clear(); updateSelectBar(); renderCalendar(); });

  calPrev.addEventListener('click', () => { calMonth.setMonth(calMonth.getMonth() - 1); renderCalendar(); });
  calNext.addEventListener('click', () => { calMonth.setMonth(calMonth.getMonth() + 1); renderCalendar(); });

  function renderCalendar() {
    calMonthLabel.textContent = calMonth.toLocaleString('en-US', { month: 'long', year: 'numeric' });
    calGrid.innerHTML = '';
    const firstDay = new Date(calMonth.getFullYear(), calMonth.getMonth(), 1);
    const startOffset = firstDay.getDay();
    const daysInMonth = new Date(calMonth.getFullYear(), calMonth.getMonth() + 1, 0).getDate();
    const today = todayStr();

    const slotsByDate = new Map();
    for (const s of availSlots) {
      if (!slotsByDate.has(s.date)) slotsByDate.set(s.date, { open: 0, booked: 0 });
      slotsByDate.get(s.date)[s.status === 'booked' ? 'booked' : 'open']++;
    }

    let dayCounter = 1 - startOffset;
    for (let week = 0; week < 6 && dayCounter <= daysInMonth; week++) {
      const weekRow = document.createElement('div');
      weekRow.className = 'cal-week-row';
      const weekBtn = document.createElement('button');
      weekBtn.className = 'cal-week-btn'; weekBtn.type = 'button'; weekBtn.textContent = '⊘';
      weekBtn.title = 'Exclude/restore this whole week';
      const weekDates = [];
      weekRow.appendChild(weekBtn);

      for (let i = 0; i < 7; i++, dayCounter++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'cal-cell';
        if (dayCounter < 1 || dayCounter > daysInMonth) { cell.classList.add('is-blank'); weekRow.appendChild(cell); continue; }
        const d = new Date(calMonth.getFullYear(), calMonth.getMonth(), dayCounter);
        const dateStr = fmtDate(d);
        weekDates.push(dateStr);
        if (dateStr < today) cell.classList.add('is-past');
        if (availExceptions.has(dateStr)) cell.classList.add('is-off');
        if (selectMode && selectedDates.has(dateStr)) cell.classList.add('is-picked');
        if (!selectMode && dateStr === selectedDate) cell.classList.add('is-selected');
        cell.dataset.date = dateStr;
        cell.innerHTML = `<span>${dayCounter}</span>`;
        const counts = slotsByDate.get(dateStr);
        if (counts) {
          const dotRow = document.createElement('div');
          dotRow.className = 'cal-dot-row';
          if (counts.open) dotRow.innerHTML += '<span class="cal-dot open"></span>';
          if (counts.booked) dotRow.innerHTML += '<span class="cal-dot booked"></span>';
          cell.appendChild(dotRow);
        }
        cell.addEventListener('click', () => {
          if (selectMode) {
            if (selectedDates.has(dateStr)) selectedDates.delete(dateStr); else selectedDates.add(dateStr);
            updateSelectBar(); renderCalendar();
          } else if (selectedDate === dateStr) {
            selectedDate = null;
            calDayPanel.hidden = true;
            renderCalendar();
          } else {
            openDayPanel(dateStr);
            renderCalendar();
          }
        });
        weekRow.appendChild(cell);
      }
      weekBtn.addEventListener('click', () => {
        const allOff = weekDates.every((d) => availExceptions.has(d));
        applyBulk(allOff ? 'include' : 'exclude', weekDates);
      });
      calGrid.appendChild(weekRow);
    }
  }

  function openDayPanel(dateStr) {
    selectedDate = dateStr;
    calDayPanel.hidden = false;
    const d = new Date(dateStr + 'T00:00:00');
    calDayPanelTitle.textContent = d.toLocaleDateString('en-US', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const isOff = availExceptions.has(dateStr);
    calDayOffToggle.textContent = isOff ? 'Make this a working day' : 'Mark this day off';
    const daySlots = availSlots.filter((s) => s.date === dateStr).sort((a, b) => a.time.localeCompare(b.time));
    calDaySlots.innerHTML = daySlots.length
      ? daySlots.map((s) => `
          <span class="avail-slot-chip ${s.status === 'booked' ? 'booked' : ''}" data-time="${s.time}">
            ${s.time}${s.status === 'booked' ? ' (booked)' : ''}
            ${s.status !== 'booked' ? `<button class="avail-slot-remove" data-id="${s.id}" title="Remove this slot">✕</button>` : ''}
          </span>`).join('')
      : '<span class="avail-hint">No slots on this day.</span>';
  }

  calDayOffToggle.addEventListener('click', async () => {
    if (!selectedDate) return;
    const clinician = currentClinicianForAvail();
    const isOff = availExceptions.has(selectedDate);
    if (isOff) {
      await fetch('/api/admin/availability', {
        method: 'PATCH', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ clinician, date: selectedDate }),
      });
    } else {
      await fetch(`/api/admin/availability?clinician=${encodeURIComponent(clinician)}&date=${encodeURIComponent(selectedDate)}`, { method: 'DELETE' });
    }
    await loadAvailability();
    openDayPanel(selectedDate);
  });

  function showUndoToast(id, timeLabel) {
    if (undoTimeout) clearTimeout(undoTimeout);
    pendingUndoId = id;
    undoToastText.textContent = `Removed ${timeLabel}.`;
    undoToast.hidden = false;
    undoTimeout = setTimeout(() => { undoToast.hidden = true; pendingUndoId = null; }, 8000);
  }

  undoToastBtn.addEventListener('click', async () => {
    if (!pendingUndoId) return;
    if (undoTimeout) clearTimeout(undoTimeout);
    undoToast.hidden = true;
    await fetch('/api/admin/availability', {
      method: 'PATCH', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id: pendingUndoId }),
    });
    pendingUndoId = null;
    await loadAvailability();
    if (selectedDate) openDayPanel(selectedDate);
  });

  calDaySlots.addEventListener('click', async (e) => {
    const btn = e.target.closest('.avail-slot-remove');
    if (!btn) return;
    const removedTime = btn.closest('.avail-slot-chip')?.dataset.time || '';
    await fetch(`/api/admin/availability?id=${btn.dataset.id}`, { method: 'DELETE' });
    showUndoToast(btn.dataset.id, removedTime);
    await loadAvailability();
    openDayPanel(selectedDate);
  });

  saveTemplateBtn.addEventListener('click', async () => {
    const clinician = currentClinicianForAvail();
    const days = [...dayRows.querySelectorAll('.day-row.is-on')].map((row) => ({
      day: Number(row.dataset.day),
      start_time: row.querySelector('.day-start').value,
      end_time: row.querySelector('.day-end').value,
      slot_minutes: Number(row.querySelector('.day-slot-len').value),
    }));
    if (!days.length) {
      templateSavedMsg.hidden = true;
      bookedWarning.hidden = false;
      bookedWarning.textContent = 'Turn on at least one day before saving.';
      return;
    }
    saveTemplateBtn.disabled = true;
    saveTemplateBtn.textContent = 'Saving…';
    await fetch('/api/admin/availability', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ mode: 'generate', clinician, days, buffer_minutes: Number(bufferMinutesSelect.value) }),
    });
    saveTemplateBtn.disabled = false;
    saveTemplateBtn.textContent = 'Save weekly schedule';
    bookedWarning.hidden = true;
    templateSavedMsg.hidden = false;
    setTimeout(() => { templateSavedMsg.hidden = true; }, 4000);
    await loadAvailability();
  });

  async function loadAvailability() {
    const clinician = currentClinicianForAvail();
    const res = await fetch(`/api/admin/availability?clinician=${encodeURIComponent(clinician)}`);
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    availSlots = data.slots || [];
    availExceptions = new Set(data.exceptions || []);

    // Reset all day rows, then populate from the saved per-day template
    dayRows.querySelectorAll('.day-row').forEach((row) => {
      row.classList.remove('is-on');
      row.querySelector('.day-row-checkbox').checked = false;
    });
    for (const t of data.templateDays || []) {
      const row = dayRows.querySelector(`.day-row[data-day="${t.day}"]`);
      if (!row) continue;
      row.classList.add('is-on');
      row.querySelector('.day-row-checkbox').checked = true;
      row.querySelector('.day-start').value = t.start_time;
      row.querySelector('.day-end').value = t.end_time;
      row.querySelector('.day-slot-len').value = String(t.slot_minutes);
    }
    bufferMinutesSelect.value = String(data.bufferMinutes || 0);

    if (data.bookedCountNext7Days > 0) {
      bookedWarning.hidden = false;
      bookedWarning.textContent = `Heads up: ${data.bookedCountNext7Days} session(s) already booked in the next 7 days — saving changes here never affects them.`;
    } else {
      bookedWarning.hidden = true;
    }

    renderCalendar();
    if (selectedDate) openDayPanel(selectedDate);
  }

  if (availClinicianSelect) availClinicianSelect.addEventListener('change', () => { selectedDate = null; calDayPanel.hidden = true; loadAvailability(); });

  if (location.hash === '#availability') loadAvailability();
</script>
