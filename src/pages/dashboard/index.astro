  // ===== Certificates =====
  let allCertificates = [];
  const certBody = document.getElementById('certBody');
  const certTable = document.getElementById('certTable');
  const certLoadingMsg = document.getElementById('certLoadingMsg');
  const certEmptyMsg = document.getElementById('certEmptyMsg');
  const certSearchBox = document.getElementById('certSearchBox');
  const certExportBtn = document.getElementById('certExportBtn');
  const courseStatsEl = document.getElementById('courseStats');

  async function loadCertificates() {
    certLoadingMsg.hidden = false;
    certTable.hidden = true;
    const res = await fetch('/api/admin/certificates');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allCertificates = data.certificates || [];
    certLoadingMsg.hidden = true;
    renderCourseStats(data.courseStats || []);
    renderCertificates();
  }

  function renderCourseStats(stats) {
    if (stats.length === 0) { courseStatsEl.innerHTML = ''; return; }
    courseStatsEl.innerHTML = stats.map((s) => {
      const passRate = s.attempt_count > 0 ? Math.round((s.passed_attempt_count / s.attempt_count) * 100) : 0;
      return `
        <div class="course-stat-card">
          <h3>${escapeHtml(s.course_title)}</h3>
          <div class="course-stat-row"><span>Enrolled</span><strong>${s.enrolled_count}</strong></div>
          <div class="course-stat-row"><span>Quiz attempts</span><strong>${s.attempt_count}</strong></div>
          <div class="course-stat-row"><span>Pass rate</span><strong>${passRate}%</strong></div>
          <div class="course-stat-row"><span>Avg score</span><strong>${s.avg_score_percent ?? '—'}${s.avg_score_percent != null ? '%' : ''}</strong></div>
          <div class="course-stat-row"><span>Certificates issued</span><strong>${s.certificate_count}</strong></div>
        </div>`;
    }).join('');
  }

  function renderCertificates() {
    const term = (certSearchBox.value || '').toLowerCase();
    const items = allCertificates.filter((c) =>
      !term || c.name.toLowerCase().includes(term) || c.email.toLowerCase().includes(term) ||
      c.course_title.toLowerCase().includes(term) || c.id.toLowerCase().includes(term)
    );
    certEmptyMsg.hidden = items.length > 0;
    certTable.hidden = items.length === 0;
    certBody.innerHTML = items.map((c) => `
      <tr>
        <td class="col-check"><input type="checkbox" class="cert-row-check" data-selid="${escapeHtml(c.id)}" /></td>
        <td><code>${escapeHtml(c.id)}</code></td>
        <td>${escapeHtml(c.name)}</td>
        <td>${escapeHtml(c.email)}</td>
        <td>${escapeHtml(c.course_title)}</td>
        <td>${c.score_percent}%</td>
        <td>${c.ce_hours}</td>
        <td>${formatDate(c.issued_at)}</td>
        <td><a href="/certificates/${encodeURIComponent(c.id)}" target="_blank" rel="noopener">View →</a></td>
        <td class="col-actions"><button class="icon-btn delete" data-certdelete="${escapeHtml(c.id)}" title="Delete">🗑</button></td>
      </tr>
    `).join('');
    certBulk.sync();
  }
  certSearchBox.addEventListener('input', renderCertificates);
  const certBulk = makeBulkSelector({
    selectAllEl: document.getElementById('certSelectAll'),
    bulkBarEl: document.getElementById('certBulkBar'),
    bulkCountEl: document.getElementById('certBulkCount'),
    bulkDeleteBtn: document.getElementById('certBulkDelete'),
    rowCheckSelector: '.cert-row-check',
    containerEl: certBody,
    getItems: () => allCertificates,
    setItems: (v) => { allCertificates = v; },
    idOf: (c) => c.id,
    deleteUrl: (id) => `/api/admin/certificates?id=${encodeURIComponent(id)}`,
    confirmMsg: (n) => `Delete ${n} certificate(s) permanently? This cannot be undone and learners will lose access to them.`,
    render: renderCertificates,
  });

  certBody.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-certdelete]');
    if (!btn) return;
    const id = btn.dataset.certdelete;
    const ok = await showConfirm('Delete this certificate permanently? This cannot be undone and the learner will lose access to it.');
    if (!ok) return;
    btn.disabled = true;
    await fetch(`/api/admin/certificates?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    allCertificates = allCertificates.filter((c) => c.id !== id);
