  // ===== Bookings =====
  const searchBox = document.getElementById('searchBox');
  const filters = document.getElementById('dashFilters');
  const dateFrom = document.getElementById('dateFrom');
  const dateTo = document.getElementById('dateTo');
  const loadingSkeleton = document.getElementById('loadingSkeleton');
  const emptyMsg = document.getElementById('emptyMsg');
  const tableScroll = document.getElementById('tableScroll');
  const bookingsBody = document.getElementById('bookingsBody');
  const exportBtn = document.getElementById('exportBtn');
  const logoutBtn = document.getElementById('logoutBtn');
  const selectAll = document.getElementById('selectAll');
  const bulkBar = document.getElementById('bulkBar');
  const bulkCount = document.getElementById('bulkCount');
  const bulkConfirm = document.getElementById('bulkConfirm');
  const bulkDecline = document.getElementById('bulkDecline');
  const bulkDelete = document.getElementById('bulkDelete');
  const paginationEl = document.getElementById('pagination');
  const pagePrev = document.getElementById('pagePrev');
  const pageNext = document.getElementById('pageNext');
  const pageLabel = document.getElementById('pageLabel');
  const newBookingBanner = document.getElementById('newBookingBanner');

  let allBookings = [];
  let activeFilter = 'all';
  let searchTerm = '';
  let sortKey = 'created_at';
  let sortDir = -1; // -1 desc, 1 asc
  let selected = new Set();
  let page = 1;
  const PAGE_SIZE = 25;
  let lastPendingCount = null;

  function matchesSearch(b, term) {
    if (!term) return true;
    const hay = `${b.client_name} ${b.contact} ${b.id}`.toLowerCase();
    return hay.includes(term.toLowerCase());
  }
  function matchesDateRange(b) {
    const d = b.created_at.slice(0, 10);
    if (dateFrom.value && d < dateFrom.value) return false;
    if (dateTo.value && d > dateTo.value) return false;
    return true;
  }

  function filteredSorted() {
    let items = activeFilter === 'all' ? allBookings.slice() : allBookings.filter((b) => b.status === activeFilter);
    items = items.filter((b) => matchesSearch(b, searchTerm) && matchesDateRange(b));
    items.sort((a, b) => {
      const av = a[sortKey], bv = b[sortKey];
      if (av === bv) return 0;
      return av > bv ? sortDir : -sortDir;
    });
    return items;
  }

  function render() {
    const items = filteredSorted();
    const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
    if (page > totalPages) page = totalPages;
    const pageItems = items.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

    emptyMsg.hidden = items.length > 0;
    tableScroll.hidden = items.length === 0;
    paginationEl.hidden = items.length <= PAGE_SIZE;
    pageLabel.textContent = `Page ${page} of ${totalPages} (${items.length} total)`;

    bookingsBody.innerHTML = '';
    for (const b of pageItems) {
      const tr = document.createElement('tr');
      if (b.status === 'pending') tr.className = 'row-pending';
      tr.innerHTML = `
        <td><input type="checkbox" class="row-check" data-id="${b.id}" ${selected.has(b.id) ? 'checked' : ''} /></td>
        <td class="cell-ref">${b.id}</td>
        <td>${escapeHtml(b.client_name)}${b.notes ? ` <span class="cell-notes-flag" title="${escapeHtml(b.notes)}">📝</span>` : ''}</td>
        <td>${escapeHtml(b.contact)}</td>
        <td>${b.service === 'individual' ? 'Individual' : 'Couples'}</td>
        <td>${clinicianName(b.clinician)}</td>
        <td>PKR ${b.amount_pkr.toLocaleString('en-US')}</td>
        <td>${escapeHtml(b.preferred_time)}</td>
        <td>${formatDate(b.created_at)}</td>
        <td><span class="status-badge ${b.status}">${b.status}</span></td>
        <td>
          <div class="table-actions">
            <button class="icon-btn shot" data-shot="${b.id}" type="button" title="View screenshot">🖼</button>
            <button class="icon-btn confirm" data-id="${b.id}" data-status="confirmed" title="Confirm" ${b.status === 'confirmed' ? 'disabled' : ''}>✓</button>
            <button class="icon-btn decline" data-id="${b.id}" data-status="declined" title="Decline" ${b.status === 'declined' ? 'disabled' : ''}>✕</button>
            <button class="icon-btn delete" data-delete="${b.id}" type="button" title="Delete">🗑</button>
          </div>
        </td>
      `;
      bookingsBody.appendChild(tr);
    }
    updateBulkBar();

    const pendingCount = allBookings.filter((b) => b.status === 'pending').length;
    if (lastPendingCount !== null && pendingCount > lastPendingCount) {
      newBookingBanner.hidden = false;
      newBookingBanner.innerHTML = `<span>${pendingCount - lastPendingCount} new booking(s) came in.</span><button id="dismissBanner">Dismiss</button>`;
      document.getElementById('dismissBanner').addEventListener('click', () => { newBookingBanner.hidden = true; });
