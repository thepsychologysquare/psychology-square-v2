          <span>${escapeHtml(q.name)} (${escapeHtml(q.email)})</span>
          <span>&middot; ${escapeHtml(q.course_title)}${q.step_title ? ' &middot; ' + escapeHtml(q.step_title) : ''}</span>
          <span>&middot; ${formatDate(q.created_at)}</span>
        </div>
        <p class="qa-card__question">${escapeHtml(q.question)}</p>
        ${q.status === 'published' ? `<p class="qa-card__answer">${escapeHtml(q.answer)}</p>` : ''}
        ${q.status === 'pending' ? `
          <textarea class="qa-answer-input" placeholder="Write your answer…"></textarea>
          <div class="qa-card__actions">
