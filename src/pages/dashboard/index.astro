---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getSession } from '../../lib/adminAuth';

const session = await getSession(Astro.request.headers.get('cookie'), env?.ADMIN_SESSION_SECRET || '');
if (!session) return Astro.redirect('/dashboard/login');
const role = session.role;
const roleLabel = role === 'admin' ? 'Admin' : role === 'sohail' ? 'Muhammad Sohail' : 'Sehar Waheed';
---
<Layout title="Dashboard" description="The Psychology Square — staff dashboard.">
  <section class="dash-section">
    <div class="wrap">
      <div class="dash-header">
        <div>
          <span class="eyebrow">Signed in as {roleLabel}</span>
          <h1>Dashboard</h1>
        </div>
        <button id="logoutBtn" class="btn btn--text dash-logout">Sign out</button>
      </div>

      <div class="dash-tabs" id="dashTabs">
        <button class="tab-btn is-active" data-tab="bookings">Bookings</button>
        <button class="tab-btn" data-tab="availability">Availability</button>
      </div>

      <!-- ===== BOOKINGS TAB ===== -->
      <div id="tabBookings" class="tab-panel">
        <div class="dash-toolbar">
          <input type="text" id="searchBox" placeholder="Search by name, email, phone, or reference (e.g. TPS-4F9A2)" />
          <div class="dash-filters" id="dashFilters">
            <button class="filter-btn is-active" data-status="all">All</button>
            <button class="filter-btn" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="confirmed">Confirmed</button>
            <button class="filter-btn" data-status="declined">Declined</button>
          </div>
          <button id="exportBtn" class="btn btn--text export-btn">Download as Excel (.csv)</button>
        </div>

        <p id="loadingMsg" class="dash-empty">Loading…</p>
        <p id="emptyMsg" class="dash-empty" hidden>No bookings match.</p>
        <div class="dash-list" id="dashList"></div>
      </div>

      <!-- ===== AVAILABILITY TAB ===== -->
      <div id="tabAvailability" class="tab-panel" hidden>
        {role === 'admin' && (
          <div class="field" style="max-width:280px; margin-bottom:20px;">
            <label for="availClinician">Clinician</label>
            <select id="availClinician">
              <option value="sohail">Muhammad Sohail</option>
              <option value="sehar">Sehar Waheed</option>
            </select>
          </div>
        )}

        <div class="avail-template">
          <h3 class="avail-template-title">Weekly schedule</h3>
          <p class="avail-hint">Set this once — it keeps generating open slots for the weeks ahead automatically, using whatever you pick below. Change it anytime and it updates going forward (already-booked sessions are never touched).</p>

          <div class="avail-days-row" id="availDaysRow">
            <button type="button" class="day-toggle" data-day="1">Mon</button>
            <button type="button" class="day-toggle" data-day="2">Tue</button>
            <button type="button" class="day-toggle" data-day="3">Wed</button>
            <button type="button" class="day-toggle" data-day="4">Thu</button>
            <button type="button" class="day-toggle" data-day="5">Fri</button>
            <button type="button" class="day-toggle" data-day="6">Sat</button>
            <button type="button" class="day-toggle" data-day="0">Sun</button>
          </div>

          <div class="avail-time-row">
            <div class="field">
              <label for="availStart">Start time</label>
              <input type="time" id="availStart" value="09:00" />
            </div>
            <div class="field">
              <label for="availEnd">End time</label>
              <input type="time" id="availEnd" value="17:00" />
            </div>
            <div class="field">
              <label for="availSlotLen">Session length</label>
              <select id="availSlotLen">
                <option value="30">30 min</option>
                <option value="45">45 min</option>
                <option value="60" selected>60 min</option>
                <option value="90">90 min</option>
                <option value="120">120 min</option>
              </select>
            </div>
          </div>

          <button id="saveTemplateBtn" class="btn btn--primary" style="border:none; cursor:pointer; align-self:flex-start;">Save weekly schedule</button>
          <p id="templateSavedMsg" class="avail-saved-msg" hidden>Saved — upcoming weeks updated ✓</p>
        </div>

        <div class="avail-calendar">
          <div class="cal-nav">
            <button id="calPrev" class="cal-nav-btn" type="button">← Prev</button>
            <span id="calMonthLabel" class="cal-month-label"></span>
            <button id="calNext" class="cal-nav-btn" type="button">Next →</button>
          </div>
          <div class="cal-toolbar">
            <button id="calSelectModeBtn" class="btn btn--text cal-select-mode-btn" type="button">Select multiple days</button>
          </div>
          <div class="cal-weekdays">
            <span></span><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
          </div>
          <div class="cal-grid" id="calGrid"></div>
          <div id="calSelectBar" class="cal-select-bar" hidden>
            <span id="calSelectCount"></span>
            <button id="calExcludeSelected" class="btn btn--text" type="button">Exclude selected</button>
            <button id="calIncludeSelected" class="btn btn--text" type="button">Make available</button>
            <button id="calClearSelected" class="btn btn--text" type="button">Clear</button>
          </div>
          <p class="avail-hint" style="margin-top:12px;">Click any date to see or adjust that day's sessions. Click the circle at the start of a week to exclude or restore the whole week in one click — or use "Select multiple days" to exclude a specific set of dates at once.</p>
        </div>

        <div id="calDayPanel" class="cal-day-panel" hidden>
          <div class="cal-day-panel-head">
            <span id="calDayPanelTitle"></span>
            <button id="calDayOffToggle" class="btn btn--text" type="button"></button>
          </div>
          <div id="calDaySlots" class="avail-slots-row"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .dash-section{ padding:48px 0 96px; }
  .dash-header{ display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:24px; }
  .dash-header h1{ font-size:30px; margin-top:6px; }
  .dash-logout{ padding:8px 4px; color:var(--ink-600); }
  .dash-logout:hover{ color:var(--ink-900); }

  .dash-tabs{ display:flex; gap:6px; margin-bottom:28px; border-bottom:1px solid var(--line); }
  .tab-btn{
    font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.06em; text-transform:uppercase;
    padding:10px 4px; margin-right:22px; border:none; border-bottom:2px solid transparent;
    background:transparent; cursor:pointer; color:var(--ink-600);
  }
  .tab-btn.is-active{ color:var(--ink-900); border-bottom-color:var(--gold-500); }

  .dash-toolbar{ display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:24px; }
  #searchBox{
    flex:1; min-width:240px; font-family:var(--font-body); font-size:14.5px;
    padding:10px 14px; border:1px solid var(--line); border-radius:2px;
  }
  #searchBox:focus-visible{ outline:2px solid var(--gold-500); }
  .dash-filters{ display:flex; gap:8px; flex-wrap:wrap; }
  .filter-btn{
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.06em; text-transform:uppercase;
    padding:8px 14px; border:1px solid var(--line); border-radius:2px; background:transparent; cursor:pointer; color:var(--ink-600);
  }
  .filter-btn.is-active{ border-color:var(--gold-500); color:var(--ink-900); background:rgba(199,164,74,0.08); }
  .export-btn{ padding:8px 4px; white-space:nowrap; }

  .dash-empty{ color:var(--ink-600); padding:24px 0; }

  .dash-list{ display:flex; flex-direction:column; gap:14px; }
  .booking-card{
    border:1px solid var(--line); border-radius:2px; padding:20px 22px;
    display:grid; grid-template-columns:1fr auto; gap:16px; align-items:start;
  }
  .booking-main{ display:flex; flex-direction:column; gap:6px; }
  .booking-top{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .booking-ref{ font-family:var(--font-mono); font-size:13px; color:var(--gold-500); }
  .booking-name{ font-weight:600; font-size:16px; }
  .booking-meta{ font-size:14px; color:var(--ink-600); }
  .booking-notes{ font-size:14px; color:var(--ink-900); margin-top:4px; }

  .status-badge{ font-family:var(--font-mono); font-size:11px; letter-spacing:0.06em; text-transform:uppercase; padding:4px 10px; border-radius:20px; }
  .status-badge.pending{ background:rgba(199,164,74,0.15); color:#8a6d1f; }
  .status-badge.confirmed{ background:rgba(124,152,133,0.18); color:#3f5c47; }
  .status-badge.declined{ background:rgba(180,67,46,0.12); color:#B4432E; }

  .booking-actions{ display:flex; flex-direction:column; gap:8px; align-items:flex-end; }
  .view-shot-btn{ font-size:13px; color:var(--ink-900); text-decoration:underline; background:none; border:none; cursor:pointer; padding:0; font-family:var(--font-body); }
  .action-row{ display:flex; gap:8px; }
  .action-btn{ font-family:var(--font-body); font-size:13px; padding:6px 12px; border:1px solid var(--line); border-radius:2px; background:transparent; cursor:pointer; }
  .action-btn.confirm{ border-color:#3f5c47; color:#3f5c47; }
  .action-btn.decline{ border-color:#B4432E; color:#B4432E; }
  .action-btn:hover{ opacity:0.7; }

  @media (max-width:560px){ .booking-card{ grid-template-columns:1fr; } .booking-actions{ align-items:flex-start; } }

  .field{ display:flex; flex-direction:column; gap:6px; }
  label{ font-size:14px; font-weight:500; }
  select, textarea, input[type="time"]{ font-family:var(--font-body); font-size:14.5px; padding:10px 12px; border:1px solid var(--line); border-radius:2px; }
  .avail-hint{ font-size:13px; color:var(--ink-600); }

  .avail-template{ display:flex; flex-direction:column; gap:16px; max-width:560px; margin-bottom:32px; padding:22px; border:1px solid var(--line); border-radius:2px; background:var(--paper-50); }
  .avail-template-title{ font-size:17px; margin:0; }
  .avail-days-row{ display:flex; gap:8px; flex-wrap:wrap; }
  .day-toggle{
    font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.04em; text-transform:uppercase;
    padding:8px 14px; border:1px solid var(--line); border-radius:20px; background:transparent; cursor:pointer; color:var(--ink-600);
  }
  .day-toggle.is-on{ border-color:var(--gold-500); color:var(--ink-900); background:rgba(199,164,74,0.12); }
  .avail-time-row{ display:flex; gap:16px; flex-wrap:wrap; }
  .avail-time-row .field{ flex:1; min-width:130px; }
  .avail-saved-msg{ font-size:13px; color:#3f5c47; }

  .avail-calendar{ max-width:560px; margin-bottom:24px; border:1px solid var(--line); border-radius:2px; padding:20px; }
  .cal-nav{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
  .cal-nav-btn{ font-family:var(--font-mono); font-size:12px; background:none; border:none; color:var(--ink-600); cursor:pointer; padding:4px; }
  .cal-nav-btn:hover{ color:var(--ink-900); }
  .cal-month-label{ font-weight:600; font-size:15px; }
  .cal-weekdays{ display:grid; grid-template-columns:repeat(7,1fr); font-family:var(--font-mono); font-size:11px; color:var(--ink-600); text-align:center; margin-bottom:6px; }
  .cal-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:4px; }
  .cal-cell{
    position:relative; aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    border:1px solid var(--line); border-radius:2px; background:transparent; cursor:pointer; font-size:13px; color:var(--ink-900); padding:2px;
  }
  .cal-cell:hover{ border-color:var(--gold-500); }
  .cal-cell.is-blank{ visibility:hidden; cursor:default; }
  .cal-cell.is-past{ opacity:0.35; cursor:default; }
  .cal-cell.is-past:hover{ border-color:var(--line); }
  .cal-cell.is-off{ background:rgba(180,67,46,0.06); color:var(--ink-600); }
  .cal-cell.is-selected{ border-color:var(--gold-500); border-width:2px; }
  .cal-dot-row{ display:flex; gap:3px; margin-top:3px; }
  .cal-dot{ width:5px; height:5px; border-radius:50%; }
  .cal-dot.open{ background:#3f5c47; }
  .cal-dot.booked{ background:var(--gold-500); }

  .cal-day-panel{ max-width:560px; border:1px solid var(--line); border-radius:2px; padding:18px 20px; margin-bottom:36px; }
  .cal-day-panel-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .cal-day-panel-head span{ font-weight:600; }

  .avail-slots-row{ display:flex; gap:8px; flex-wrap:wrap; }
  .avail-slot-chip{
    display:flex; align-items:center; gap:8px; font-size:13.5px; padding:6px 10px;
    border:1px solid var(--line); border-radius:2px;
  }
  .avail-slot-chip.booked{ opacity:0.55; }
  .avail-slot-remove{ background:none; border:none; color:#B4432E; cursor:pointer; font-size:14px; padding:0; }

  .cal-toolbar{ display:flex; justify-content:flex-end; margin-bottom:10px; }
  .cal-select-mode-btn.is-active{ border-color:var(--gold-500); color:var(--ink-900); background:rgba(199,164,74,0.12); }

  .cal-weekdays{ display:grid; grid-template-columns:30px repeat(7,1fr); }
  .cal-grid{ display:flex; flex-direction:column; gap:4px; }
  .cal-week-row{ display:grid; grid-template-columns:30px repeat(7,1fr); gap:4px; align-items:center; }
  .cal-week-btn{
    font-size:13px; width:26px; height:26px; border:1px solid var(--line); border-radius:50%;
    background:transparent; cursor:pointer; color:var(--ink-600); display:flex; align-items:center; justify-content:center; padding:0;
  }
  .cal-week-btn:hover{ border-color:var(--gold-500); color:var(--ink-900); }
  .cal-cell.is-other-month{ opacity:0.32; }
  .cal-cell.is-picked{ border-color:var(--gold-500); border-width:2px; background:rgba(199,164,74,0.14); }

  .cal-select-bar{
    display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:12px; padding:12px 16px;
    border:1px solid var(--gold-500); border-radius:2px; background:rgba(199,164,74,0.08); font-size:13.5px;
  }
</style>

<script define:vars={{ role }}>
  const dashList = document.getElementById('dashList');
  const loadingMsg = document.getElementById('loadingMsg');
  const emptyMsg = document.getElementById('emptyMsg');
  const filters = document.getElementById('dashFilters');
  const searchBox = document.getElementById('searchBox');
  const logoutBtn = document.getElementById('logoutBtn');
  const exportBtn = document.getElementById('exportBtn');
  const tabs = document.getElementById('dashTabs');
  const tabBookings = document.getElementById('tabBookings');
  const tabAvailability = document.getElementById('tabAvailability');

  let allBookings = [];
  let activeFilter = 'all';
  let searchTerm = '';

  function formatDate(iso) {
    return new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  }
  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }
  function clinicianName(c) {
    return c === 'sohail' ? 'Muhammad Sohail' : c === 'sehar' ? 'Sehar Waheed' : c;
  }

  function matchesSearch(b, term) {
    if (!term) return true;
    const haystack = `${b.id} ${b.client_name} ${b.contact}`.toLowerCase();
    return haystack.includes(term.toLowerCase());
  }

  function render() {
    let items = activeFilter === 'all' ? allBookings : allBookings.filter((b) => b.status === activeFilter);
    items = items.filter((b) => matchesSearch(b, searchTerm));

    dashList.innerHTML = '';
    emptyMsg.hidden = items.length > 0;

    for (const b of items) {
      const card = document.createElement('div');
      card.className = 'booking-card';
      card.innerHTML = `
        <div class="booking-main">
          <div class="booking-top">
            <span class="booking-ref">${b.id}</span>
            <span class="status-badge ${b.status}">${b.status}</span>
          </div>
          <span class="booking-name">${escapeHtml(b.client_name)}</span>
          <span class="booking-meta">
            ${b.service === 'individual' ? 'Individual' : 'Couples'} · PKR ${b.amount_pkr.toLocaleString('en-US')}
            · ${clinicianName(b.clinician)} · ${escapeHtml(b.payment_method)}
          </span>
          <span class="booking-meta">${escapeHtml(b.contact)} · ${escapeHtml(b.preferred_time)}</span>
          <span class="booking-meta">Submitted ${formatDate(b.created_at)}</span>
          ${b.notes ? `<span class="booking-notes">"${escapeHtml(b.notes)}"</span>` : ''}
        </div>
        <div class="booking-actions">
          <a class="view-shot-btn" href="/api/admin/screenshot/${b.id}" target="_blank" rel="noopener">View screenshot →</a>
          <div class="action-row">
            <button class="action-btn confirm" data-id="${b.id}" data-status="confirmed">Confirm</button>
            <button class="action-btn decline" data-id="${b.id}" data-status="declined">Decline</button>
          </div>
        </div>
      `;
      dashList.appendChild(card);
    }
  }

  async function loadBookings() {
    loadingMsg.hidden = false;
    const res = await fetch('/api/admin/bookings');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allBookings = data.bookings || [];
    loadingMsg.hidden = true;
    render();
  }

  filters.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    filters.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    activeFilter = btn.dataset.status || 'all';
    render();
  });

  searchBox.addEventListener('input', () => { searchTerm = searchBox.value; render(); });

  dashList.addEventListener('click', async (e) => {
    const btn = e.target.closest('.action-btn');
    if (!btn) return;
    const id = btn.dataset.id, status = btn.dataset.status;
    btn.disabled = true;
    await fetch('/api/admin/bookings', {
      method: 'PATCH', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id, status }),
    });
    const booking = allBookings.find((b) => b.id === id);
    if (booking) booking.status = status;
    render();
  });

  exportBtn.addEventListener('click', () => {
    const cols = ['id', 'created_at', 'client_name', 'contact', 'service', 'clinician', 'preferred_time', 'amount_pkr', 'payment_method', 'status', 'notes'];
    const header = ['Reference', 'Submitted', 'Name', 'Contact', 'Service', 'Clinician', 'Time', 'Amount (PKR)', 'Payment Method', 'Status', 'Notes'];
    const rows = allBookings.map((b) => cols.map((c) => {
      const v = String(b[c] ?? '').replace(/"/g, '""');
      return `"${v}"`;
    }).join(','));
    const csv = [header.join(','), ...rows].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `bookings-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  logoutBtn.addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    window.location.href = '/dashboard/login';
  });

  // ===== Tabs =====
  tabs.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    tabs.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    const tab = btn.dataset.tab;
    tabBookings.hidden = tab !== 'bookings';
    tabAvailability.hidden = tab !== 'availability';
    if (tab === 'availability') loadAvailability();
  });

  // ===== Availability =====
  const availClinicianSelect = document.getElementById('availClinician');
  const availDaysRow = document.getElementById('availDaysRow');
  const availStart = document.getElementById('availStart');
  const availEnd = document.getElementById('availEnd');
  const availSlotLen = document.getElementById('availSlotLen');
  const saveTemplateBtn = document.getElementById('saveTemplateBtn');
  const templateSavedMsg = document.getElementById('templateSavedMsg');
  const calPrev = document.getElementById('calPrev');
  const calNext = document.getElementById('calNext');
  const calMonthLabel = document.getElementById('calMonthLabel');
  const calGrid = document.getElementById('calGrid');
  const calDayPanel = document.getElementById('calDayPanel');
  const calDayPanelTitle = document.getElementById('calDayPanelTitle');
  const calDayOffToggle = document.getElementById('calDayOffToggle');
  const calDaySlots = document.getElementById('calDaySlots');
  const calSelectModeBtn = document.getElementById('calSelectModeBtn');
  const calSelectBar = document.getElementById('calSelectBar');
  const calSelectCount = document.getElementById('calSelectCount');
  const calExcludeSelected = document.getElementById('calExcludeSelected');
  const calIncludeSelected = document.getElementById('calIncludeSelected');
  const calClearSelected = document.getElementById('calClearSelected');

  let availSlots = [];
  let availExceptions = new Set();
  let calMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
  let selectedDate = null;
  let selectMode = false;
  let selectedDates = new Set();

  function currentClinicianForAvail() {
    return role === 'admin' ? availClinicianSelect.value : role;
  }

  function todayStr() {
    return fmtDate(new Date());
  }

  function fmtDate(d) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  function updateSelectBar() {
    calSelectBar.hidden = selectedDates.size === 0;
    calSelectCount.textContent = `${selectedDates.size} day${selectedDates.size === 1 ? '' : 's'} selected`;
  }

  async function applyBulk(mode, dates) {
    const clinician = currentClinicianForAvail();
    await fetch('/api/admin/availability', {
      method: 'PUT', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ mode, clinician, dates }),
    });
    await loadAvailability();
  }

  calSelectModeBtn.addEventListener('click', () => {
    selectMode = !selectMode;
    calSelectModeBtn.classList.toggle('is-active', selectMode);
    calSelectModeBtn.textContent = selectMode ? 'Done selecting' : 'Select multiple days';
    if (!selectMode) { selectedDates.clear(); updateSelectBar(); }
    calDayPanel.hidden = true;
    selectedDate = null;
    renderCalendar();
  });

  calExcludeSelected.addEventListener('click', async () => {
    await applyBulk('exclude', [...selectedDates]);
    selectedDates.clear();
    updateSelectBar();
  });
  calIncludeSelected.addEventListener('click', async () => {
    await applyBulk('include', [...selectedDates]);
    selectedDates.clear();
    updateSelectBar();
  });
  calClearSelected.addEventListener('click', () => {
    selectedDates.clear();
    updateSelectBar();
    renderCalendar();
  });

  async function loadAvailability() {
    const clinician = currentClinicianForAvail();
    const res = await fetch(`/api/admin/availability?clinician=${clinician}`);
    const data = await res.json();
    availSlots = data.slots || [];
    availExceptions = new Set(data.exceptions || []);

    availDaysRow.querySelectorAll('.day-toggle').forEach((btn) => {
      const on = data.template ? data.template.days.includes(Number(btn.dataset.day)) : false;
      btn.classList.toggle('is-on', on);
    });
    if (data.template) {
      availStart.value = data.template.start_time;
      availEnd.value = data.template.end_time;
      availSlotLen.value = String(data.template.slot_minutes);
    }

    renderCalendar();
    if (selectedDate) renderDayPanel(selectedDate);
  }

  availDaysRow.addEventListener('click', (e) => {
    const btn = e.target.closest('.day-toggle');
    if (!btn) return;
    btn.classList.toggle('is-on');
  });

  saveTemplateBtn.addEventListener('click', async () => {
    const days = [...availDaysRow.querySelectorAll('.day-toggle.is-on')].map((b) => Number(b.dataset.day));
    if (!days.length) { alert('Pick at least one working day.'); return; }
    if (!availStart.value || !availEnd.value || availStart.value >= availEnd.value) {
      alert('Pick a valid start and end time.'); return;
    }
    saveTemplateBtn.disabled = true;
    saveTemplateBtn.textContent = 'Saving…';
    templateSavedMsg.hidden = true;
    await fetch('/api/admin/availability', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        mode: 'generate',
        clinician: currentClinicianForAvail(),
        days,
        start_time: availStart.value,
        end_time: availEnd.value,
        slot_minutes: Number(availSlotLen.value),
      }),
    });
    saveTemplateBtn.disabled = false;
    saveTemplateBtn.textContent = 'Save weekly schedule';
    templateSavedMsg.hidden = false;
    await loadAvailability();
  });

  if (availClinicianSelect) {
    availClinicianSelect.addEventListener('change', () => {
      selectedDate = null;
      calDayPanel.hidden = true;
      loadAvailability();
    });
  }

  function renderCalendar() {
    const year = calMonth.getFullYear();
    const month = calMonth.getMonth();
    calMonthLabel.textContent = calMonth.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

    const byDate = {};
    for (const s of availSlots) { (byDate[s.date] ||= []).push(s); }

    const today = todayStr();
    const firstOfMonth = new Date(year, month, 1);
    const lastOfMonth = new Date(year, month + 1, 0);
    const gridStart = new Date(firstOfMonth);
    gridStart.setDate(gridStart.getDate() - gridStart.getDay());
    const gridEnd = new Date(lastOfMonth);
    gridEnd.setDate(gridEnd.getDate() + (6 - gridEnd.getDay()));

    calGrid.innerHTML = '';
    const cursor = new Date(gridStart);

    while (cursor <= gridEnd) {
      const weekRow = document.createElement('div');
      weekRow.className = 'cal-week-row';

      const weekDates = [];
      for (let i = 0; i < 7; i++) {
        weekDates.push(fmtDate(cursor));
        cursor.setDate(cursor.getDate() + 1);
      }

      const weekBtn = document.createElement('button');
      weekBtn.type = 'button';
      weekBtn.className = 'cal-week-btn';
      const allFuture = weekDates.every((d) => d >= today);
      const allOff = weekDates.every((d) => availExceptions.has(d) || !(byDate[d] && byDate[d].length));
      weekBtn.textContent = allOff ? '↺' : '⊘';
      weekBtn.title = allFuture ? (allOff ? 'Make this week available' : 'Exclude this whole week') : 'This week has already passed';
      weekBtn.disabled = !allFuture;
      weekBtn.addEventListener('click', () => applyBulk(allOff ? 'include' : 'exclude', weekDates));
      weekRow.appendChild(weekBtn);

      for (const dateStr of weekDates) {
        const d = new Date(dateStr + 'T00:00:00');
        const inMonth = d.getMonth() === month;
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'cal-cell';
        if (!inMonth) cell.classList.add('is-other-month');
        const isPast = dateStr < today;
        if (isPast) cell.classList.add('is-past');
        if (dateStr === selectedDate) cell.classList.add('is-selected');
        if (selectedDates.has(dateStr)) cell.classList.add('is-picked');

        const daySlots = byDate[dateStr] || [];
        const hasOpen = daySlots.some((s) => s.status === 'open');
        const hasBooked = daySlots.some((s) => s.status === 'booked');
        if (!daySlots.length) cell.classList.add('is-off');

        cell.innerHTML = `<span>${d.getDate()}</span>`;
        if (hasOpen || hasBooked) {
          const dotRow = document.createElement('div');
          dotRow.className = 'cal-dot-row';
          if (hasOpen) dotRow.innerHTML += '<span class="cal-dot open"></span>';
          if (hasBooked) dotRow.innerHTML += '<span class="cal-dot booked"></span>';
          cell.appendChild(dotRow);
        }

        cell.dataset.date = dateStr;
        if (!isPast) {
          cell.addEventListener('click', () => {
            if (selectMode) {
              if (selectedDates.has(dateStr)) selectedDates.delete(dateStr);
              else selectedDates.add(dateStr);
              renderCalendar();
              updateSelectBar();
            } else {
              selectedDate = dateStr;
              renderCalendar();
              renderDayPanel(dateStr);
            }
          });
        }
        weekRow.appendChild(cell);
      }
      calGrid.appendChild(weekRow);
    }
  }

  function renderDayPanel(dateStr) {
    calDayPanel.hidden = false;
    calDayPanelTitle.textContent = new Date(dateStr + 'T00:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

    const isOff = availExceptions.has(dateStr);
    calDayOffToggle.textContent = isOff ? 'Make this a working day' : 'Mark this day off';
    calDayOffToggle.onclick = async () => {
      const clinician = currentClinicianForAvail();
      if (isOff) {
        await fetch('/api/admin/availability', {
          method: 'PATCH', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ clinician, date: dateStr }),
        });
      } else {
        await fetch(`/api/admin/availability?clinician=${clinician}&date=${dateStr}`, { method: 'DELETE' });
      }
      await loadAvailability();
    };

    const daySlots = availSlots.filter((s) => s.date === dateStr).sort((a, b) => a.time.localeCompare(b.time));
    calDaySlots.innerHTML = '';
    if (!daySlots.length) {
      calDaySlots.innerHTML = '<p class="dash-empty" style="padding:8px 0;">No sessions this day.</p>';
      return;
    }
    for (const s of daySlots) {
      const chip = document.createElement('span');
      chip.className = 'avail-slot-chip' + (s.status === 'booked' ? ' booked' : '');
      chip.innerHTML = `${s.time}${s.status === 'booked' ? ' (booked)' : ''} ${s.status === 'open' ? `<button class="avail-slot-remove" data-id="${s.id}">✕</button>` : ''}`;
      calDaySlots.appendChild(chip);
    }
  }

  calDaySlots.addEventListener('click', async (e) => {
    const btn = e.target.closest('.avail-slot-remove');
    if (!btn) return;
    await fetch(`/api/admin/availability?id=${btn.dataset.id}`, { method: 'DELETE' });
    loadAvailability();
  });

  calPrev.addEventListener('click', () => { calMonth.setMonth(calMonth.getMonth() - 1); renderCalendar(); });
  calNext.addEventListener('click', () => { calMonth.setMonth(calMonth.getMonth() + 1); renderCalendar(); });

  loadBookings();
</script>
