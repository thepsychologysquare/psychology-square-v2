    bulkCountEl: document.getElementById('qaBulkCount'),
    bulkDeleteBtn: document.getElementById('qaBulkDelete'),
    rowCheckSelector: '.qa-row-check',
    containerEl: qaCards,
    getItems: () => allQuestions,
    setItems: (v) => { allQuestions = v; },
    idOf: (q) => q.id,
    deleteUrl: (id) => `/api/admin/questions?id=${encodeURIComponent(id)}`,
    confirmMsg: (n) => `Delete ${n} question(s) permanently?`,
