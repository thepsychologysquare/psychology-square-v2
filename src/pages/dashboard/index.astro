---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getSession } from '../../lib/adminAuth';

const session = await getSession(Astro.request.headers.get('cookie'), env?.ADMIN_SESSION_SECRET || '');
if (!session) return Astro.redirect('/dashboard/login');
const role = session.role;
const roleLabel = role === 'admin' ? 'Admin' : role === 'sohail' ? 'Muhammad Sohail' : 'Sehar Waheed';
---
<Layout title="Dashboard" description="The Psychology Square — staff dashboard.">
  <section class="dash-section">
    <div class="wrap">
      <div class="dash-header">
        <div>
          <span class="eyebrow">Signed in as {roleLabel}</span>
          <h1>Dashboard</h1>
        </div>
        <div class="dash-header-actions">
          <a href="/dashboard/courses" class="btn btn--ghost">Course Builder</a>
          <button id="logoutBtn" class="btn btn--ghost dash-logout">Sign out</button>
        </div>
      </div>

      <div id="newBookingBanner" class="new-booking-banner" hidden></div>

      <div class="dash-tabs" id="dashTabs">
        <button class="tab-btn is-active" data-tab="bookings">Bookings</button>
        <button class="tab-btn" data-tab="availability">Availability</button>
        <button class="tab-btn" data-tab="coursePayments">Course Payment Requests</button>
        <button class="tab-btn" data-tab="enrollments">Course Enrollments</button>
        <button class="tab-btn" data-tab="qa">Q&amp;A</button>
        <button class="tab-btn" data-tab="certificates">Certificates</button>
      </div>

      <!-- ===== BOOKINGS TAB ===== -->
      <div id="tabBookings" class="tab-panel">
        <div class="dash-toolbar">
          <input type="text" id="searchBox" placeholder="Search by name, email, phone, or reference (e.g. TPS-4F9A2)" />
          <div class="dash-filters" id="dashFilters">
            <button class="filter-btn is-active" data-status="all">All</button>
            <button class="filter-btn" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="confirmed">Confirmed</button>
            <button class="filter-btn" data-status="declined">Declined</button>
          </div>
          <div class="date-range">
            <input type="date" id="dateFrom" aria-label="From date" />
            <span>–</span>
            <input type="date" id="dateTo" aria-label="To date" />
          </div>
          <button id="exportBtn" class="btn btn--ghost export-btn">Download as Excel (.csv)</button>
        </div>

        <div id="bulkBar" class="bulk-bar" hidden>
          <span id="bulkCount"></span>
          <button id="bulkConfirm" class="btn btn--ghost">Confirm selected</button>
          <button id="bulkDecline" class="btn btn--ghost">Decline selected</button>
          <button id="bulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>

        <div id="loadingSkeleton" class="skeleton-rows">
          <div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div>
        </div>
        <p id="emptyMsg" class="dash-empty" hidden>No bookings match.</p>

        <div class="table-scroll" id="tableScroll" hidden>
          <table class="bookings-table" id="bookingsTable">
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="selectAll" /></th>
                <th data-sort="id">Reference</th>
                <th data-sort="client_name">Client</th>
                <th data-sort="contact">Contact</th>
                <th data-sort="service">Service</th>
                <th data-sort="clinician">Clinician</th>
                <th data-sort="amount_pkr">Amount</th>
                <th data-sort="preferred_time">Time</th>
                <th data-sort="created_at">Submitted</th>
                <th data-sort="status">Status</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="bookingsBody"></tbody>
          </table>
        </div>

        <div class="pagination" id="pagination" hidden>
          <button id="pagePrev" class="cal-nav-btn">← Prev</button>
          <span id="pageLabel"></span>
          <button id="pageNext" class="cal-nav-btn">Next →</button>
        </div>
      </div>

      <!-- ===== AVAILABILITY TAB ===== -->
      <div id="tabAvailability" class="tab-panel" hidden>
        {role === 'admin' && (
          <div class="field" style="max-width:280px; margin-bottom:20px;">
            <label for="availClinician">Clinician</label>
            <select id="availClinician">
              <option value="sohail">Muhammad Sohail</option>
              <option value="sehar">Sehar Waheed</option>
            </select>
          </div>
        )}

        <div class="avail-template">
          <h3 class="avail-template-title">Weekly schedule</h3>
          <p class="avail-hint">
            Give each day its own hours — e.g. evenings on weekdays, afternoons on weekends. Set this once and it
            keeps generating open slots automatically going forward (already-booked sessions are never touched).
            All times are in Pakistan Standard Time (PKT).
          </p>

          <div class="day-rows" id="dayRows"></div>

          <div class="field buffer-field">
            <label for="bufferMinutes">Gap between sessions</label>
            <select id="bufferMinutes">
              <option value="0">No gap (back-to-back)</option>
              <option value="5">5 min</option>
              <option value="10">10 min</option>
              <option value="15">15 min</option>
              <option value="20">20 min</option>
              <option value="30">30 min</option>
              <option value="45">45 min</option>
              <option value="60">60 min</option>
            </select>
          </div>

          <button id="saveTemplateBtn" class="btn btn--primary" style="border:none; cursor:pointer; align-self:flex-start;">Save weekly schedule</button>
          <p id="templateSavedMsg" class="avail-saved-msg" hidden>Saved — upcoming weeks updated ✓</p>
          <p id="bookedWarning" class="avail-warning" hidden></p>
        </div>

        <div class="avail-calendar">
          <div class="cal-nav">
            <button id="calPrev" class="cal-nav-btn" type="button">← Prev</button>
            <span id="calMonthLabel" class="cal-month-label"></span>
            <button id="calNext" class="cal-nav-btn" type="button">Next →</button>
          </div>
          <div class="cal-toolbar">
            <button id="calSelectModeBtn" class="btn btn--ghost cal-select-mode-btn" type="button">Select multiple days</button>
          </div>
          <div class="cal-legend">
            <span><i class="dot open"></i> Open slots</span>
            <span><i class="dot booked"></i> Booked slots</span>
            <span><i class="swatch off"></i> Day off</span>
          </div>
          <div class="cal-weekdays">
            <span></span><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
          </div>
          <div class="cal-grid" id="calGrid"></div>
          <div id="calSelectBar" class="cal-select-bar" hidden>
            <span id="calSelectCount"></span>
            <button id="calExcludeSelected" class="btn btn--ghost" type="button">Exclude selected</button>
            <button id="calIncludeSelected" class="btn btn--ghost" type="button">Make available</button>
            <button id="calClearSelected" class="btn btn--ghost" type="button">Clear</button>
          </div>
          <p class="avail-hint" style="margin-top:12px;">Click any date to see or adjust that day's sessions. Click the circle at the start of a week to exclude or restore the whole week in one click — or use "Select multiple days" to exclude a specific set of dates at once.</p>
        </div>

        <div id="calDayPanel" class="cal-day-panel" hidden>
          <div class="cal-day-panel-head">
            <span id="calDayPanelTitle"></span>
            <button id="calDayOffToggle" class="btn btn--ghost" type="button"></button>
          </div>
          <div id="calDaySlots" class="avail-slots-row"></div>
          <div id="undoToast" class="undo-toast" hidden>
            <span id="undoToastText"></span>
            <button id="undoToastBtn" class="undo-toast-btn" type="button">Undo</button>
          </div>
        </div>
      </div>

      <div id="tabCoursePayments" class="tab-panel" hidden>
        <div class="dash-toolbar">
          <input type="text" id="payReqSearchBox" placeholder="Search by name, email, or course" />
          <div class="dash-filters" id="payReqFilters">
            <button class="filter-btn is-active" data-status="all">All</button>
            <button class="filter-btn" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="active">Confirmed</button>
            <button class="filter-btn" data-status="declined">Declined</button>
          </div>
        </div>
        <div id="payReqBulkBar" class="bulk-bar" hidden>
          <span id="payReqBulkCount"></span>
          <button id="payReqBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="payReqLoadingMsg" class="dash-empty">Loading…</p>
        <p id="payReqEmptyMsg" class="dash-empty" hidden>No course payment requests yet.</p>
        <div class="table-scroll">
          <table class="bookings-table" id="payReqTable" hidden>
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="payReqSelectAll" /></th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Submitted</th>
                <th>Status</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="payReqBody"></tbody>
          </table>
        </div>
      </div>

      <div id="tabEnrollments" class="tab-panel" hidden>
        <div class="dash-toolbar">
          <input type="text" id="enrollSearchBox" placeholder="Search by name, email, or course" />
          <button id="enrollExportBtn" class="btn btn--ghost export-btn">Download as Excel (.csv)</button>
        </div>
        <div id="enrollBulkBar" class="bulk-bar" hidden>
          <span id="enrollBulkCount"></span>
          <button id="enrollBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="enrollLoadingMsg" class="dash-empty">Loading…</p>
        <p id="enrollEmptyMsg" class="dash-empty" hidden>No enrollments yet.</p>
        <div class="table-scroll">
          <table class="bookings-table" id="enrollTable" hidden>
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="enrollSelectAll" /></th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Enrolled</th>
                <th>Completed</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="enrollBody"></tbody>
          </table>
        </div>
      </div>

      <!-- ===== CERTIFICATES TAB ===== -->
      <div id="tabQa" class="tab-panel" hidden>
        <div class="dash-toolbar">
          <input type="text" id="qaSearchBox" placeholder="Search by name, email, course, or question" />
          <div class="dash-filters" id="qaFilters">
            <button class="filter-btn is-active" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="published">Published</button>
            <button class="filter-btn" data-status="declined">Declined</button>
            <button class="filter-btn" data-status="all">All</button>
          </div>
        </div>
        <div class="qa-select-all"><label><input type="checkbox" id="qaSelectAll" /> Select all</label></div>
        <div id="qaBulkBar" class="bulk-bar" hidden>
          <span id="qaBulkCount"></span>
          <button id="qaBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="qaLoadingMsg" class="dash-empty">Loading…</p>
        <p id="qaEmptyMsg" class="dash-empty" hidden>No questions here.</p>
        <div id="qaCards" class="qa-cards"></div>
      </div>

      <div id="tabCertificates" class="tab-panel" hidden>
        <div class="course-stats" id="courseStats"></div>

        <div class="dash-toolbar">
          <input type="text" id="certSearchBox" placeholder="Search by name, email, course, or certificate ID" />
          <button id="certExportBtn" class="btn btn--ghost export-btn">Download as Excel (.csv)</button>
        </div>
        <div id="certBulkBar" class="bulk-bar" hidden>
          <span id="certBulkCount"></span>
          <button id="certBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="certLoadingMsg" class="dash-empty">Loading…</p>
        <p id="certEmptyMsg" class="dash-empty" hidden>No certificates issued yet.</p>
        <div class="table-scroll">
          <table class="bookings-table" id="certTable" hidden>
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="certSelectAll" /></th>
                <th>Certificate ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Score</th>
                <th>Hours</th>
                <th>Issued</th>
                <th class="col-actions">Verify</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="certBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Screenshot preview modal -->
  <div id="shotModal" class="modal-overlay" hidden>
    <div class="modal-box">
      <button id="shotModalClose" class="modal-close" type="button">✕</button>
      <img id="shotModalImg" alt="Payment screenshot" />
      <a id="shotModalOpen" href="#" target="_blank" rel="noopener" class="modal-open-link">Open in new tab →</a>
    </div>
  </div>

  <!-- Confirm dialog -->
  <div id="confirmModal" class="modal-overlay" hidden>
    <div class="modal-box modal-box--sm">
      <p id="confirmMessage"></p>
      <div class="modal-actions">
        <button id="confirmCancel" class="btn btn--ghost">Cancel</button>
        <button id="confirmOk" class="btn btn--primary" style="border:none;">Confirm</button>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .dash-section{ padding:48px 0 96px; overflow-x:hidden; }
  .dash-header{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:20px; }
  .dash-header h1{ font-size:clamp(22px, 5.5vw, 30px); margin-top:6px; }
  .dash-header-actions{ display:flex; gap:0.5rem; flex-wrap:wrap; }
  .dash-logout{ padding:8px 14px; }

  .new-booking-banner{
    background:rgba(199,164,74,0.14); border:1px solid var(--gold-500); border-radius:2px;
    padding:10px 16px; font-size:14px; color:var(--ink-900); margin-bottom:18px;
    display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
  }
  .new-booking-banner button{ background:none; border:none; color:var(--ink-600); cursor:pointer; font-size:13px; }

  .dash-tabs{
    display:flex; gap:6px; margin-bottom:28px; border-bottom:1px solid var(--line);
    overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; scrollbar-width:thin;
  }
  .tab-btn{
    font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.06em; text-transform:uppercase;
    padding:10px 4px; margin-right:22px; border:none; border-bottom:2px solid transparent;
    background:transparent; cursor:pointer; color:var(--ink-600); white-space:nowrap; flex:none;
  }
  .tab-btn.is-active{ color:var(--ink-900); border-bottom-color:var(--gold-500); }

  /* Ghost buttons: visible dark text + border, for use on light backgrounds
     (the .btn--text variant is near-white and meant for dark hero/nav only) */
  .btn--ghost{
    color:var(--ink-900); background:transparent; border:1px solid var(--line);
    padding:9px 16px; border-radius:2px;
  }
  .btn--ghost:hover{ border-color:var(--gold-500); background:rgba(199,164,74,0.08); }
  .btn--ghost.is-active{ border-color:var(--gold-500); background:rgba(199,164,74,0.12); }

  .dash-toolbar{ display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:16px; }
  #searchBox, #payReqSearchBox, #enrollSearchBox, #qaSearchBox, #certSearchBox{
    flex:1 1 200px; min-width:0; box-sizing:border-box; font-family:var(--font-body); font-size:14.5px;
    padding:10px 14px; border:1px solid var(--line); border-radius:2px; color:var(--ink-900); background:#fff;
  }
  #searchBox:focus-visible, #payReqSearchBox:focus-visible, #enrollSearchBox:focus-visible, #qaSearchBox:focus-visible, #certSearchBox:focus-visible{ outline:2px solid var(--gold-500); }
  .dash-filters{ display:flex; gap:8px; flex-wrap:wrap; }
  .filter-btn{
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.06em; text-transform:uppercase;
    padding:8px 14px; border:1px solid var(--line); border-radius:2px; background:transparent; cursor:pointer; color:var(--ink-600);
  }
  .filter-btn.is-active{ border-color:var(--gold-500); color:var(--ink-900); background:rgba(199,164,74,0.08); }
  .export-btn{ white-space:nowrap; color:var(--ink-900); background:transparent; border:1px solid var(--line); padding:9px 16px; border-radius:2px; }
  .export-btn:hover{ border-color:var(--gold-500); background:rgba(199,164,74,0.08); }
  .date-range{ display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .date-range input{ font-family:var(--font-body); font-size:13.5px; padding:8px 10px; border:1px solid var(--line); border-radius:2px; max-width:100%; }

  .qa-select-all{ font-size:13px; color:var(--ink-600); margin-bottom:10px; }
  .qa-select-all label{ display:flex; align-items:center; gap:6px; cursor:pointer; }
  .qa-row-check{ margin-right:8px; }
  .bulk-bar{
    display:flex; align-items:center; gap:10px 12px; flex-wrap:wrap; margin-bottom:16px; padding:10px 14px;
    border:1px solid var(--gold-500); border-radius:2px; background:rgba(199,164,74,0.08); font-size:13.5px;
  }

  .dash-empty{ color:var(--ink-600); padding:24px 0; }

  .skeleton-rows{ display:flex; flex-direction:column; gap:10px; }
  .skeleton-row{ height:52px; border-radius:2px; background:linear-gradient(90deg, var(--paper-50) 25%, rgba(19,26,34,0.06) 37%, var(--paper-50) 63%); background-size:400% 100%; animation:shimmer 1.4s ease infinite; }
  @keyframes shimmer{ 0%{background-position:100% 0;} 100%{background-position:0 0;} }

  .course-stats{ display:grid; grid-template-columns:repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap:14px; margin-bottom:24px; }
  .course-stat-card{ border:1px solid var(--line); border-radius:2px; padding:16px 18px; background:var(--paper-50); }
  .course-stat-card h3{ font-family:var(--font-display); font-size:15px; margin-bottom:10px; }
  .course-stat-row{ display:flex; justify-content:space-between; font-size:13px; padding:3px 0; color:var(--ink-600); }
  .course-stat-row strong{ color:var(--ink-900); }

  .table-scroll{ overflow-x:auto; -webkit-overflow-scrolling:touch; border:1px solid var(--line); border-radius:2px; max-height:640px; overflow-y:auto; }
  .bookings-table{ width:100%; border-collapse:collapse; font-size:13.5px; white-space:nowrap; }
  .bookings-table thead th{
    position:sticky; top:0; background:var(--paper-0); text-align:left; font-family:var(--font-mono);
    font-size:11px; letter-spacing:0.05em; text-transform:uppercase; color:var(--ink-600);
    padding:12px 14px; border-bottom:1px solid var(--line); cursor:pointer; user-select:none; z-index:1;
  }
  .bookings-table thead th:hover{ color:var(--ink-900); }
  .bookings-table thead th.sorted::after{ content:attr(data-dir); margin-left:4px; color:var(--gold-500); }
  .bookings-table td{ padding:12px 14px; border-bottom:1px solid var(--line); vertical-align:top; }
  .bookings-table tbody tr:hover{ background:rgba(199,164,74,0.05); }
  .bookings-table tbody tr.row-pending{ background:rgba(199,164,74,0.09); font-weight:600; }
  .bookings-table tbody tr.row-pending:hover{ background:rgba(199,164,74,0.14); }
  .bookings-table tbody tr.row-pending td{ border-left:3px solid var(--gold-500); }
  .bookings-table tbody tr.row-pending td:first-child{ border-left:none; }
  .col-check{ width:36px; }
  .col-actions{ width:150px; }
  .cell-ref{ font-family:var(--font-mono); color:var(--gold-500); }
  .cell-notes-flag{ color:var(--ink-600); cursor:help; }
  .table-actions{ display:flex; gap:6px; align-items:center; }
  .icon-btn{
    width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center;
    font-size:14px; border:1px solid var(--line); border-radius:2px; background:var(--paper-0);
    cursor:pointer; padding:0; line-height:1;
  }
  .icon-btn:hover{ background:rgba(199,164,74,0.08); }
  .icon-btn:disabled{ opacity:0.35; cursor:not-allowed; }
  .icon-btn.confirm{ border-color:#3f5c47; color:#3f5c47; }
  .icon-btn.decline{ border-color:#B4432E; color:#B4432E; }
  .icon-btn.delete{ border-color:var(--ink-600); color:var(--ink-600); }
  .icon-btn.delete:hover{ border-color:#B4432E; color:#B4432E; }

  .status-badge{ font-family:var(--font-mono); font-size:11px; letter-spacing:0.06em; text-transform:uppercase; padding:4px 10px; border-radius:20px; white-space:nowrap; }
  .status-badge.pending{ background:rgba(199,164,74,0.15); color:#8a6d1f; }
  .status-badge.confirmed{ background:rgba(124,152,133,0.18); color:#3f5c47; }
  .status-badge.declined{ background:rgba(180,67,46,0.12); color:#B4432E; }


  .pagination{ display:flex; align-items:center; justify-content:center; gap:16px; margin-top:18px; font-size:13.5px; color:var(--ink-600); }

  .field{ display:flex; flex-direction:column; gap:6px; }
  label{ font-size:14px; font-weight:500; }
  select, textarea, input[type="time"]{ font-family:var(--font-body); font-size:14.5px; padding:10px 12px; border:1px solid var(--line); border-radius:2px; }
  .avail-hint{ font-size:13px; color:var(--ink-600); }

  .avail-template{ display:flex; flex-direction:column; gap:16px; max-width:640px; margin-bottom:32px; padding:22px; border:1px solid var(--line); border-radius:2px; background:var(--paper-50); box-sizing:border-box; }
  .avail-template-title{ font-size:17px; margin:0; }

  .day-rows{ display:flex; flex-direction:column; gap:8px; }
  .day-row{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:8px 0; border-bottom:1px solid var(--line); }
  .day-row:last-child{ border-bottom:none; }
  .day-row-toggle{
    display:flex; align-items:center; gap:8px; width:96px; flex:none; font-family:var(--font-mono); font-size:12.5px;
    letter-spacing:0.04em; text-transform:uppercase; cursor:pointer; color:var(--ink-600);
  }
  .day-row.is-on .day-row-toggle{ color:var(--ink-900); }
  .day-row-fields{ display:flex; gap:10px; flex-wrap:wrap; opacity:0.35; pointer-events:none; align-items:center; flex:1; min-width:0; }
  .day-row.is-on .day-row-fields{ opacity:1; pointer-events:auto; }
  .day-row-fields input[type="time"], .day-row-fields select{ padding:8px 10px; font-size:13.5px; min-width:0; }
  .buffer-field{ max-width:260px; }
  .avail-saved-msg{ font-size:13px; color:#3f5c47; }
  .avail-warning{ font-size:13px; color:#8a6d1f; }

  .avail-calendar{ max-width:640px; margin-bottom:24px; border:1px solid var(--line); border-radius:2px; padding:20px; box-sizing:border-box; }
  .cal-nav{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
  .cal-nav-btn{ font-family:var(--font-mono); font-size:12px; background:none; border:none; color:var(--ink-600); cursor:pointer; padding:4px; }
  .cal-nav-btn:hover{ color:var(--ink-900); }
  .cal-month-label{ font-weight:600; font-size:15px; }
  .cal-legend{ display:flex; gap:16px; flex-wrap:wrap; font-size:12px; color:var(--ink-600); margin-bottom:10px; }
  .cal-legend .dot{ display:inline-block; width:7px; height:7px; border-radius:50%; margin-right:5px; }
  .cal-legend .dot.open{ background:#3f5c47; }
  .cal-legend .dot.booked{ background:var(--gold-500); }
  .cal-legend .swatch{ display:inline-block; width:10px; height:10px; margin-right:5px; background:rgba(180,67,46,0.2); border:1px solid rgba(180,67,46,0.4); }
  .cal-weekdays{ display:grid; grid-template-columns:30px repeat(7,1fr); font-family:var(--font-mono); font-size:11px; color:var(--ink-600); text-align:center; margin-bottom:6px; }
  .cal-grid{ display:flex; flex-direction:column; gap:4px; }
  .cal-cell{
    position:relative; aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    border:1px solid var(--line); border-radius:2px; background:transparent; cursor:pointer; font-size:13px; color:var(--ink-900); padding:2px;
  }
  .cal-cell:hover{ border-color:var(--gold-500); }
  .cal-cell.is-blank{ visibility:hidden; cursor:default; }
  .cal-cell.is-past{ opacity:0.35; cursor:default; }
  .cal-cell.is-past:hover{ border-color:var(--line); }
  .cal-cell.is-off{ background:rgba(180,67,46,0.06); color:var(--ink-600); }
  .cal-cell.is-selected{ border-color:var(--gold-500); border-width:2px; background:var(--gold-500); color:var(--navy-950); font-weight:700; }
  .cal-dot-row{ display:flex; gap:3px; margin-top:3px; }
  .cal-dot{ width:5px; height:5px; border-radius:50%; }
  .cal-dot.open{ background:#3f5c47; }
  .cal-dot.booked{ background:var(--gold-500); }

  .cal-day-panel{ max-width:640px; border:1px solid var(--line); border-radius:2px; padding:18px 20px; margin-bottom:36px; }
  .cal-day-panel-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .cal-day-panel-head span{ font-weight:600; }

  .avail-slots-row{ display:flex; gap:8px; flex-wrap:wrap; }
  .avail-slot-chip{ display:flex; align-items:center; gap:8px; font-size:13.5px; padding:6px 10px; border:1px solid var(--line); border-radius:2px; }
  .avail-slot-chip.booked{ opacity:0.55; }
  .avail-slot-remove{ background:none; border:none; color:#B4432E; cursor:pointer; font-size:14px; padding:0; }
  .undo-toast{
    display:flex; align-items:center; gap:14px; justify-content:space-between;
    margin-top:14px; padding:10px 14px; background:var(--navy-950); color:var(--paper-0);
    border-radius:3px; font-size:13.5px;
  }
  .undo-toast-btn{
    background:none; border:1px solid rgba(248,249,246,0.4); color:var(--gold-300);
    font-size:12.5px; font-weight:600; padding:5px 12px; border-radius:2px; cursor:pointer; flex:none;
  }
  .undo-toast-btn:hover{ border-color: var(--gold-300); }

  .cal-toolbar{ display:flex; justify-content:flex-end; margin-bottom:10px; }

  .cal-week-row{ display:grid; grid-template-columns:30px repeat(7,1fr); gap:4px; align-items:center; }
  .cal-week-btn{
    font-size:13px; width:26px; height:26px; border:1px solid var(--line); border-radius:50%;
    background:transparent; cursor:pointer; color:var(--ink-600); display:flex; align-items:center; justify-content:center; padding:0;
  }
  .cal-week-btn:hover{ border-color:var(--gold-500); color:var(--ink-900); }
  .cal-cell.is-other-month{ opacity:0.32; }
  .cal-cell.is-picked{ border-color:var(--gold-500); border-width:2px; background:rgba(199,164,74,0.14); }

  .cal-select-bar{
    display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:12px; padding:12px 16px;
    border:1px solid var(--gold-500); border-radius:2px; background:rgba(199,164,74,0.08); font-size:13.5px;
  }

  .modal-overlay{
    position:fixed; inset:0; background:rgba(11,20,31,0.6); display:flex; align-items:center; justify-content:center;
    z-index:50; padding:24px;
  }
  .modal-box{ background:var(--paper-0); border-radius:2px; padding:24px; max-width:min(90vw, 640px); max-height:85vh; overflow:auto; position:relative; }
  .modal-box--sm{ max-width:360px; }
  .modal-box img{ max-width:100%; min-width:280px; min-height:80px; display:block; border:1px solid var(--line); color:var(--ink-600); font-size:13.5px; padding:16px; }
  .modal-close{ position:absolute; top:10px; right:10px; background:none; border:none; font-size:16px; cursor:pointer; color:var(--ink-600); }
  .modal-close:hover{ color:var(--ink-900); }
  .modal-open-link{ display:inline-block; margin-top:12px; font-size:13.5px; color:var(--ink-900); text-decoration:underline; }
  .modal-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:16px; }

  .qa-cards{ display:grid; gap:16px; }
  .qa-card{ border:1px solid var(--line); border-radius:2px; padding:18px 20px; background:var(--paper-0); }
  .qa-card__meta{ font-family:var(--font-mono); font-size:12px; color:var(--ink-600); margin-bottom:8px; display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .qa-card__question{ font-size:15px; margin:0 0 12px; }
  .qa-card textarea{ width:100%; min-height:70px; font:inherit; padding:10px; border:1px solid var(--line); border-radius:2px; resize:vertical; margin-bottom:10px; }
  .qa-card__actions{ display:flex; gap:8px; flex-wrap:wrap; }
  .qa-card__answer{ font-size:14px; color:var(--ink-900); background:var(--paper-50); padding:10px 12px; border-radius:2px; margin-bottom:10px; }

  @media (max-width:840px){
    .col-check, .col-actions{ position:static; }
  }

  /* ===== Tablet ===== */
  @media (max-width:720px){
    .dash-section{ padding:32px 0 64px; }
    .avail-template, .avail-calendar, .cal-day-panel{ max-width:100%; }
    .course-stats{ grid-template-columns:repeat(auto-fill, minmax(min(180px, 100%), 1fr)); }
  }

  /* ===== Phone ===== */
  @media (max-width:560px){
    .dash-header{ flex-direction:column; align-items:stretch; gap:12px; }
    .dash-header-actions{ width:100%; }
    .dash-header-actions .btn{ flex:1; text-align:center; }

    .dash-tabs{ margin-bottom:20px; padding-bottom:2px; }
    .tab-btn{ margin-right:16px; padding:10px 2px; }

    .dash-toolbar{ gap:10px; }
    #searchBox, #payReqSearchBox, #enrollSearchBox, #qaSearchBox, #certSearchBox{ flex-basis:100%; }
    .dash-filters{ width:100%; }
    .filter-btn{ flex:1; text-align:center; padding:8px 6px; }
    .date-range{ width:100%; }
    .date-range input{ flex:1; min-width:0; }
    .export-btn{ width:100%; text-align:center; }

    .bulk-bar{ flex-direction:column; align-items:stretch; }
    .bulk-bar .btn{ width:100%; text-align:center; }

    .table-scroll{ max-height:70vh; }
    .bookings-table{ font-size:12.5px; }
    .bookings-table td, .bookings-table thead th{ padding:10px 10px; }

    .course-stats{ grid-template-columns:1fr; }

    .avail-template{ padding:16px; gap:14px; }
    .day-row{ align-items:flex-start; }
    .day-row-toggle{ width:auto; }
    .day-row-fields{ width:100%; }
    .day-row-fields input[type="time"], .day-row-fields select{ flex:1 1 100px; }

    .avail-calendar{ padding:14px; }
    .cal-weekdays, .cal-week-row{ grid-template-columns:22px repeat(7,1fr); gap:3px; }
    .cal-cell{ font-size:11.5px; padding:1px; }
    .cal-legend{ gap:10px 14px; font-size:11px; }

    .qa-card{ padding:14px 16px; }
    .qa-card__actions .btn, .qa-card__actions button{ flex:1; }

    .modal-box{ padding:18px; max-width:94vw; }
    .modal-actions{ flex-direction:column-reverse; }
    .modal-actions .btn{ width:100%; text-align:center; }

    .pagination{ flex-wrap:wrap; gap:10px; }
  }

  /* ===== Very small phones ===== */
  @media (max-width:380px){
    .cal-weekdays, .cal-week-row{ grid-template-columns:18px repeat(7,1fr); }
    .cal-week-btn{ width:18px; height:18px; font-size:11px; }
    .dash-header h1{ font-size:20px; }
  }
</style>

<script define:vars={{ role }}>
  // ===== Shared helpers =====
  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function clinicianName(c) { return c === 'sohail' ? 'Muhammad Sohail' : c === 'sehar' ? 'Sehar Waheed' : 'No preference'; }
  function formatDate(iso) {
    const d = new Date(iso);
    return d.toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  }

  function showConfirm(message) {
    return Promise.resolve(window.confirm(message));
  }

  // ===== Tabs (persisted via URL hash) =====
  const tabs = document.getElementById('dashTabs');
  const tabBookings = document.getElementById('tabBookings');
  const tabAvailability = document.getElementById('tabAvailability');
  const tabCoursePayments = document.getElementById('tabCoursePayments');
  const tabEnrollments = document.getElementById('tabEnrollments');
  const tabQa = document.getElementById('tabQa');
  const tabCertificates = document.getElementById('tabCertificates');

  function activateTab(tab) {
    tabs.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.tab === tab));
    tabBookings.hidden = tab !== 'bookings';
    tabAvailability.hidden = tab !== 'availability';
    tabCoursePayments.hidden = tab !== 'coursePayments';
    tabEnrollments.hidden = tab !== 'enrollments';
    tabQa.hidden = tab !== 'qa';
    tabCertificates.hidden = tab !== 'certificates';
    if (tab === 'availability') loadAvailability();
    if (tab === 'coursePayments') loadCoursePaymentRequests();
    if (tab === 'enrollments') loadEnrollments();
    if (tab === 'qa') loadQuestions();
    if (tab === 'certificates') loadCertificates();
    history.replaceState(null, '', `#${tab}`);
  }
  tabs.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    activateTab(btn.dataset.tab);
  });
  const initialTab = ['availability', 'coursePayments', 'enrollments', 'qa', 'certificates'].includes(location.hash.slice(1))
    ? location.hash.slice(1) : 'bookings';
  activateTab(initialTab);

  // ===== Generic bulk-select helper (checkboxes + bulk delete bar) =====
  function makeBulkSelector({ selectAllEl, bulkBarEl, bulkCountEl, bulkDeleteBtn, rowCheckSelector, containerEl, getItems, setItems, idOf, deleteUrl, confirmMsg, render }) {
    const selected = new Set();
    function sync() {
      bulkBarEl.hidden = selected.size === 0;
      bulkCountEl.textContent = `${selected.size} selected`;
      const boxes = containerEl.querySelectorAll(rowCheckSelector);
      selectAllEl.checked = boxes.length > 0 && [...boxes].every((c) => c.checked);
    }
    containerEl.addEventListener('change', (e) => {
      const c = e.target.closest(rowCheckSelector);
      if (!c) return;
      if (c.checked) selected.add(c.dataset.selid); else selected.delete(c.dataset.selid);
      sync();
    });
    selectAllEl.addEventListener('change', () => {
      containerEl.querySelectorAll(rowCheckSelector).forEach((c) => {
        c.checked = selectAllEl.checked;
        if (selectAllEl.checked) selected.add(c.dataset.selid); else selected.delete(c.dataset.selid);
      });
      sync();
    });
    bulkDeleteBtn.addEventListener('click', async () => {
      if (!selected.size) return;
      const ok = await showConfirm(confirmMsg(selected.size));
      if (!ok) return;
      await Promise.all([...selected].map((id) => fetch(deleteUrl(id), { method: 'DELETE' })));
      setItems(getItems().filter((item) => !selected.has(String(idOf(item)))));
      selected.clear();
      render();
    });
    return { resetSelection: () => { selected.clear(); sync(); }, sync };
  }

  // ===== Course Enrollments =====
  let allEnrollments = [];
  const enrollBody = document.getElementById('enrollBody');
  const enrollTable = document.getElementById('enrollTable');
  const enrollLoadingMsg = document.getElementById('enrollLoadingMsg');
  const enrollEmptyMsg = document.getElementById('enrollEmptyMsg');
  const enrollSearchBox = document.getElementById('enrollSearchBox');
  const enrollExportBtn = document.getElementById('enrollExportBtn');

  async function loadEnrollments() {
    enrollLoadingMsg.hidden = false;
    enrollTable.hidden = true;
    const res = await fetch('/api/admin/enrollments');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allEnrollments = data.enrollments || [];
    enrollLoadingMsg.hidden = true;
    renderEnrollments();
  }

  function renderEnrollments() {
    const term = (enrollSearchBox.value || '').toLowerCase();
    const items = allEnrollments.filter((e) =>
      !term || e.name.toLowerCase().includes(term) || e.email.toLowerCase().includes(term) || e.course_title.toLowerCase().includes(term)
    );
    enrollEmptyMsg.hidden = items.length > 0;
    enrollTable.hidden = items.length === 0;
    enrollBody.innerHTML = items.map((e) => `
      <tr>
        <td class="col-check"><input type="checkbox" class="enroll-row-check" data-selid="${e.id}" /></td>
        <td>${escapeHtml(e.name)}</td>
        <td>${escapeHtml(e.email)}</td>
        <td>${escapeHtml(e.course_title)}</td>
        <td>${formatDate(e.enrolled_at)}</td>
        <td>${e.completed > 0 ? '✓ Completed' : '—'}</td>
        <td class="col-actions"><button class="icon-btn delete" data-enrollid="${e.id}" title="Delete">🗑</button></td>
      </tr>
    `).join('');
    enrollBulk.sync();
  }
  enrollSearchBox.addEventListener('input', renderEnrollments);
  const enrollBulk = makeBulkSelector({
    selectAllEl: document.getElementById('enrollSelectAll'),
    bulkBarEl: document.getElementById('enrollBulkBar'),
    bulkCountEl: document.getElementById('enrollBulkCount'),
    bulkDeleteBtn: document.getElementById('enrollBulkDelete'),
    rowCheckSelector: '.enroll-row-check',
    containerEl: enrollBody,
    getItems: () => allEnrollments,
    setItems: (v) => { allEnrollments = v; },
    idOf: (e) => e.id,
    deleteUrl: (id) => `/api/admin/enrollments?id=${id}`,
    confirmMsg: (n) => `Delete ${n} enrollment(s) permanently? This does not affect any certificate already issued.`,
    render: renderEnrollments,
  });

  enrollBody.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-enrollid]');
    if (!btn) return;
    const id = Number(btn.dataset.enrollid);
    const ok = await showConfirm('Delete this enrollment permanently? This does not affect any certificate already issued.');
    if (!ok) return;
    btn.disabled = true;
    await fetch(`/api/admin/enrollments?id=${id}`, { method: 'DELETE' });
    allEnrollments = allEnrollments.filter((x) => x.id !== id);
    renderEnrollments();
  });

  enrollExportBtn.addEventListener('click', () => {
    const header = ['Name', 'Email', 'Course', 'Enrolled At', 'Completed'];
    const rows = allEnrollments.map((e) => [e.name, e.email, e.course_title, e.enrolled_at, e.completed > 0 ? 'Yes' : 'No']
      .map((v) => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','));
    const csv = [header.join(','), ...rows].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `course-enrollments-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // ===== Course Payment Requests =====
  let allPayReqs = [];
  let payReqFilter = 'all';
  const payReqBody = document.getElementById('payReqBody');
  const payReqTable = document.getElementById('payReqTable');
  const payReqLoadingMsg = document.getElementById('payReqLoadingMsg');
  const payReqEmptyMsg = document.getElementById('payReqEmptyMsg');
  const payReqSearchBox = document.getElementById('payReqSearchBox');
  const payReqFilters = document.getElementById('payReqFilters');

  async function loadCoursePaymentRequests() {
    payReqLoadingMsg.hidden = false;
    payReqTable.hidden = true;
    const res = await fetch('/api/admin/course-enrollments');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allPayReqs = data.requests || [];
    payReqLoadingMsg.hidden = true;
    renderPayReqs();
  }

  function statusBadgeClass(status) {
    return status === 'active' ? 'confirmed' : status;
  }

  function renderPayReqs() {
    const term = (payReqSearchBox.value || '').toLowerCase();
    const items = allPayReqs.filter((r) =>
      (payReqFilter === 'all' || r.status === payReqFilter) &&
      (!term || r.name.toLowerCase().includes(term) || r.email.toLowerCase().includes(term) || r.course_title.toLowerCase().includes(term))
    );
    payReqEmptyMsg.hidden = items.length > 0;
    payReqTable.hidden = items.length === 0;
    payReqBody.innerHTML = items.map((r) => `
      <tr>
        <td class="col-check"><input type="checkbox" class="payreq-row-check" data-selid="${r.id}" /></td>
        <td>${escapeHtml(r.name)}</td>
        <td>${escapeHtml(r.email)}</td>
        <td>${escapeHtml(r.course_title)}</td>
        <td>PKR ${escapeHtml(r.amount_pkr)}</td>
        <td>${escapeHtml(r.payment_method)}</td>
        <td>${formatDate(r.payment_submitted_at)}</td>
        <td><span class="status-badge ${statusBadgeClass(r.status)}">${r.status === 'active' ? 'confirmed' : r.status}</span></td>
        <td class="col-actions">
          <button class="icon-btn" data-shot="${r.id}" title="View screenshot">View</button>
          ${r.status !== 'active' ? `<button class="icon-btn confirm" data-payid="${r.id}" data-paystatus="active" title="Confirm">✓</button>` : ''}
          ${r.status !== 'declined' ? `<button class="icon-btn decline" data-payid="${r.id}" data-paystatus="declined" title="Decline">✕</button>` : ''}
          <button class="icon-btn delete" data-paydelete="${r.id}" title="Delete">🗑</button>
        </td>
      </tr>
    `).join('');
    payReqBulk.sync();
  }
  payReqSearchBox.addEventListener('input', renderPayReqs);
  const payReqBulk = makeBulkSelector({
    selectAllEl: document.getElementById('payReqSelectAll'),
    bulkBarEl: document.getElementById('payReqBulkBar'),
    bulkCountEl: document.getElementById('payReqBulkCount'),
    bulkDeleteBtn: document.getElementById('payReqBulkDelete'),
    rowCheckSelector: '.payreq-row-check',
    containerEl: payReqBody,
    getItems: () => allPayReqs,
    setItems: (v) => { allPayReqs = v; },
    idOf: (r) => r.id,
    deleteUrl: (id) => `/api/admin/enrollments?id=${id}`,
    confirmMsg: (n) => `Delete ${n} payment request(s) permanently? This does not affect any certificate already issued.`,
    render: renderPayReqs,
  });
  payReqFilters.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    payReqFilters.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    payReqFilter = btn.dataset.status || 'all';
    renderPayReqs();
  });

  payReqBody.addEventListener('click', async (e) => {
    const shotBtn = e.target.closest('[data-shot]');
    if (shotBtn) {
      const win = window.open('', '_blank');
      shotBtn.disabled = true;
      const originalText = shotBtn.textContent;
      shotBtn.textContent = 'Loading…';
      try {
        const res = await fetch(`/api/admin/course-screenshot/${shotBtn.dataset.shot}`, { credentials: 'same-origin' });
        if (!res.ok) throw new Error(`Server said ${res.status}`);
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        if (win) win.location.href = blobUrl;
      } catch (err) {
        if (win) win.close();
        window.alert(`Could not load the screenshot: ${err.message || err}`);
      } finally {
        shotBtn.disabled = false;
        shotBtn.textContent = originalText;
      }
      return;
    }
    const btn = e.target.closest('.icon-btn.confirm, .icon-btn.decline');
    if (!btn) {
      const delBtn = e.target.closest('[data-paydelete]');
      if (!delBtn) return;
      const delId = Number(delBtn.dataset.paydelete);
      const ok = await showConfirm('Delete this payment request permanently? This does not affect any certificate already issued.');
      if (!ok) return;
      delBtn.disabled = true;
      await fetch(`/api/admin/enrollments?id=${delId}`, { method: 'DELETE' });
      allPayReqs = allPayReqs.filter((r) => r.id !== delId);
      renderPayReqs();
      return;
    }
    const id = Number(btn.dataset.payid), status = btn.dataset.paystatus;
    const ok = await showConfirm(`Mark this course payment as ${status === 'active' ? 'confirmed' : status}?`);
    if (!ok) return;
    btn.disabled = true;
    await fetch('/api/admin/course-enrollments', {
      method: 'PATCH', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id, status }),
    });
    const reqItem = allPayReqs.find((r) => r.id === id);
    if (reqItem) reqItem.status = status;
    renderPayReqs();
  });

  // ===== Q&A =====
  let allQuestions = [];
  let qaFilter = 'pending';
  const qaCards = document.getElementById('qaCards');
  const qaLoadingMsg = document.getElementById('qaLoadingMsg');
  const qaEmptyMsg = document.getElementById('qaEmptyMsg');
  const qaSearchBox = document.getElementById('qaSearchBox');
  const qaFilters = document.getElementById('qaFilters');

  async function loadQuestions() {
    qaLoadingMsg.hidden = false;
    qaCards.hidden = true;
    const res = await fetch('/api/admin/questions');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allQuestions = data.questions || [];
    qaLoadingMsg.hidden = true;
    renderQuestions();
  }

  function renderQuestions() {
    const term = (qaSearchBox.value || '').toLowerCase();
    const items = allQuestions.filter((q) =>
      (qaFilter === 'all' || q.status === qaFilter) &&
      (!term || q.name.toLowerCase().includes(term) || q.email.toLowerCase().includes(term) ||
        q.course_title.toLowerCase().includes(term) || q.question.toLowerCase().includes(term))
    );
    qaEmptyMsg.hidden = items.length > 0;
    qaCards.hidden = items.length === 0;
    qaCards.innerHTML = items.map((q) => `
      <div class="qa-card" data-id="${escapeHtml(q.id)}">
        <div class="qa-card__meta">
          <input type="checkbox" class="qa-row-check" data-selid="${escapeHtml(q.id)}" />
