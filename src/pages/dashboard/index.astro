  certExportBtn.addEventListener('click', () => {
    const header = ['Certificate ID', 'Name', 'Email', 'Course', 'Score %', 'Hours', 'Issued At'];
    const rows = allCertificates.map((c) => [c.id, c.name, c.email, c.course_title, c.score_percent, c.ce_hours, c.issued_at]
      .map((v) => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','));
    const csv = [header.join(','), ...rows].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `certificates-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
