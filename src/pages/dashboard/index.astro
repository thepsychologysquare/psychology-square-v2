---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getSession } from '../../lib/adminAuth';

const session = await getSession(Astro.request.headers.get('cookie'), env?.ADMIN_SESSION_SECRET || '');
if (!session) return Astro.redirect('/dashboard/login');
const role = session.role;
const roleLabel = role === 'admin' ? 'Admin' : role === 'sohail' ? 'Muhammad Sohail' : 'Sehar Waheed';
---
<Layout title="Dashboard" description="The Psychology Square — staff dashboard.">
  <section class="dash-section">
    <div class="wrap">
      <div class="dash-header">
        <div>
          <span class="eyebrow">Signed in as {roleLabel}</span>
          <h1>Dashboard</h1>
        </div>
        <div style="display:flex; gap:0.5rem;">
          <a href="/dashboard/courses" class="btn btn--ghost">Course Builder</a>
          <a href="/dashboard/workshops" class="btn btn--ghost">Workshops</a>
          <button id="logoutBtn" class="btn btn--ghost dash-logout">Sign out</button>
        </div>
      </div>

      <div id="newBookingBanner" class="new-booking-banner" hidden></div>

      <div class="dash-tabs" id="dashTabs">
        <button class="tab-btn is-active" data-tab="bookings">Bookings</button>
        <button class="tab-btn" data-tab="availability">Availability</button>
        <button class="tab-btn" data-tab="coursePayments">Course Payment Requests</button>
        <button class="tab-btn" data-tab="enrollments">Course Enrollments</button>
        <button class="tab-btn" data-tab="workshopEnroll">Workshop Signups</button>
        <button class="tab-btn" data-tab="qa">Q&amp;A</button>
        <button class="tab-btn" data-tab="certificates">Certificates</button>
      </div>

      <!-- ===== BOOKINGS TAB ===== -->
      <div id="tabBookings" class="tab-panel">
        <div class="dash-toolbar">
          <input type="text" id="searchBox" placeholder="Search by name, email, phone, or reference (e.g. TPS-4F9A2)" />
          <div class="dash-filters" id="dashFilters">
            <button class="filter-btn is-active" data-status="all">All</button>
            <button class="filter-btn" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="confirmed">Confirmed</button>
            <button class="filter-btn" data-status="declined">Declined</button>
          </div>
          <div class="date-range">
            <input type="date" id="dateFrom" aria-label="From date" />
            <span>–</span>
            <input type="date" id="dateTo" aria-label="To date" />
          </div>
          <button id="exportBtn" class="btn btn--ghost export-btn">Download as Excel (.csv)</button>
        </div>

        <div id="bulkBar" class="bulk-bar" hidden>
          <span id="bulkCount"></span>
          <button id="bulkConfirm" class="btn btn--ghost">Confirm selected</button>
          <button id="bulkDecline" class="btn btn--ghost">Decline selected</button>
          <button id="bulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>

        <div id="loadingSkeleton" class="skeleton-rows">
          <div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div>
        </div>
        <p id="emptyMsg" class="dash-empty" hidden>No bookings match.</p>

        <div class="table-scroll" id="tableScroll" hidden>
          <table class="bookings-table" id="bookingsTable">
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="selectAll" /></th>
                <th data-sort="id">Reference</th>
                <th data-sort="client_name">Client</th>
                <th data-sort="contact">Contact</th>
                <th data-sort="service">Service</th>
                <th data-sort="clinician">Clinician</th>
                <th data-sort="amount_pkr">Amount</th>
                <th data-sort="preferred_time">Time</th>
                <th data-sort="created_at">Submitted</th>
                <th data-sort="status">Status</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="bookingsBody"></tbody>
          </table>
        </div>

        <div class="pagination" id="pagination" hidden>
          <button id="pagePrev" class="cal-nav-btn">← Prev</button>
          <span id="pageLabel"></span>
          <button id="pageNext" class="cal-nav-btn">Next →</button>
        </div>
      </div>

      <!-- ===== AVAILABILITY TAB ===== -->
      <div id="tabAvailability" class="tab-panel" hidden>
        {role === 'admin' && (
          <div class="field" style="max-width:280px; margin-bottom:20px;">
            <label for="availClinician">Clinician</label>
            <select id="availClinician">
              <option value="sohail">Muhammad Sohail</option>
              <option value="sehar">Sehar Waheed</option>
            </select>
          </div>
        )}

        <div class="avail-template">
          <h3 class="avail-template-title">Weekly schedule</h3>
          <p class="avail-hint">
            Give each day its own hours — e.g. evenings on weekdays, afternoons on weekends. Set this once and it
            keeps generating open slots automatically going forward (already-booked sessions are never touched).
            All times are in Pakistan Standard Time (PKT).
          </p>

          <div class="day-rows" id="dayRows"></div>

          <div class="field buffer-field">
            <label for="bufferMinutes">Gap between sessions</label>
            <select id="bufferMinutes">
              <option value="0">No gap (back-to-back)</option>
              <option value="5">5 min</option>
              <option value="10">10 min</option>
              <option value="15">15 min</option>
              <option value="20">20 min</option>
              <option value="30">30 min</option>
              <option value="45">45 min</option>
              <option value="60">60 min</option>
            </select>
          </div>

          <button id="saveTemplateBtn" class="btn btn--primary" style="border:none; cursor:pointer; align-self:flex-start;">Save weekly schedule</button>
          <p id="templateSavedMsg" class="avail-saved-msg" hidden>Saved — upcoming weeks updated ✓</p>
          <p id="bookedWarning" class="avail-warning" hidden></p>
        </div>

        <div class="avail-calendar">
          <div class="cal-nav">
            <button id="calPrev" class="cal-nav-btn" type="button">← Prev</button>
            <span id="calMonthLabel" class="cal-month-label"></span>
            <button id="calNext" class="cal-nav-btn" type="button">Next →</button>
          </div>
          <div class="cal-toolbar">
            <button id="calSelectModeBtn" class="btn btn--ghost cal-select-mode-btn" type="button">Select multiple days</button>
          </div>
          <div class="cal-legend">
            <span><i class="dot open"></i> Open slots</span>
            <span><i class="dot booked"></i> Booked slots</span>
            <span><i class="swatch off"></i> Day off</span>
          </div>
          <div class="cal-weekdays">
            <span></span><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
          </div>
          <div class="cal-grid" id="calGrid"></div>
          <div id="calSelectBar" class="cal-select-bar" hidden>
            <span id="calSelectCount"></span>
            <button id="calExcludeSelected" class="btn btn--ghost" type="button">Exclude selected</button>
            <button id="calIncludeSelected" class="btn btn--ghost" type="button">Make available</button>
            <button id="calClearSelected" class="btn btn--ghost" type="button">Clear</button>
          </div>
          <p class="avail-hint" style="margin-top:12px;">Click any date to see or adjust that day's sessions. Click the circle at the start of a week to exclude or restore the whole week in one click — or use "Select multiple days" to exclude a specific set of dates at once.</p>
        </div>

        <div id="calDayPanel" class="cal-day-panel" hidden>
          <div class="cal-day-panel-head">
            <span id="calDayPanelTitle"></span>
            <button id="calDayOffToggle" class="btn btn--ghost" type="button"></button>
          </div>
          <div id="calDaySlots" class="avail-slots-row"></div>
          <div id="undoToast" class="undo-toast" hidden>
            <span id="undoToastText"></span>
            <button id="undoToastBtn" class="undo-toast-btn" type="button">Undo</button>
          </div>
        </div>
      </div>

      <div id="tabCoursePayments" class="tab-panel" hidden>
        <div class="dash-toolbar">
          <input type="text" id="payReqSearchBox" placeholder="Search by name, email, or course" />
          <div class="dash-filters" id="payReqFilters">
            <button class="filter-btn is-active" data-status="all">All</button>
            <button class="filter-btn" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="active">Confirmed</button>
            <button class="filter-btn" data-status="declined">Declined</button>
          </div>
        </div>
        <div id="payReqBulkBar" class="bulk-bar" hidden>
          <span id="payReqBulkCount"></span>
          <button id="payReqBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="payReqLoadingMsg" class="dash-empty">Loading…</p>
        <p id="payReqEmptyMsg" class="dash-empty" hidden>No course payment requests yet.</p>
        <div class="table-scroll">
          <table class="bookings-table" id="payReqTable" hidden>
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="payReqSelectAll" /></th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Submitted</th>
                <th>Status</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="payReqBody"></tbody>
          </table>
        </div>
      </div>

      <div id="tabEnrollments" class="tab-panel" hidden>
        <div class="dash-toolbar">
          <input type="text" id="enrollSearchBox" placeholder="Search by name, email, or course" />
          <div class="dash-filters" id="enrollTypeFilters">
            <button class="filter-btn is-active" data-type="all">All</button>
            <button class="filter-btn" data-type="free">Free</button>
            <button class="filter-btn" data-type="paid">Paid</button>
          </div>
          <button id="enrollExportBtn" class="btn btn--ghost export-btn">Download as Excel (.csv)</button>
        </div>
        <div id="enrollBulkBar" class="bulk-bar" hidden>
          <span id="enrollBulkCount"></span>
          <button id="enrollBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="enrollLoadingMsg" class="dash-empty">Loading…</p>
        <p id="enrollEmptyMsg" class="dash-empty" hidden>No enrollments yet.</p>
        <div class="table-scroll">
          <table class="bookings-table" id="enrollTable" hidden>
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="enrollSelectAll" /></th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Enrolled</th>
                <th>Completed</th>
                <th>Unenrolled</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="enrollBody"></tbody>
          </table>
        </div>
      </div>

      <!-- ===== WORKSHOP SIGNUPS TAB ===== -->
      <div id="tabWorkshopEnroll" class="tab-panel" hidden>
        <div class="dash-toolbar">
          <input type="text" id="wkEnrollSearchBox" placeholder="Search by name, email, or workshop" />
          <div class="dash-filters" id="wkEnrollFilters">
            <button class="filter-btn is-active" data-status="all">All</button>
            <button class="filter-btn" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="active">Confirmed</button>
            <button class="filter-btn" data-status="declined">Declined</button>
          </div>
          <button id="wkEnrollExportBtn" class="btn btn--ghost export-btn">Download as Excel (.csv)</button>
        </div>
        <div id="wkEnrollBulkBar" class="bulk-bar" hidden>
          <span id="wkEnrollBulkCount"></span>
          <button id="wkEnrollBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="wkEnrollLoadingMsg" class="dash-empty">Loading…</p>
        <p id="wkEnrollEmptyMsg" class="dash-empty" hidden>No workshop signups yet.</p>
        <div class="table-scroll">
          <table class="bookings-table" id="wkEnrollTable" hidden>
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="wkEnrollSelectAll" /></th>
                <th>Name</th>
                <th>Contact</th>
                <th>Workshop</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Submitted</th>
                <th>Status</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="wkEnrollBody"></tbody>
          </table>
        </div>
      </div>

      <!-- ===== CERTIFICATES TAB ===== -->
      <div id="tabQa" class="tab-panel" hidden>
        <div class="dash-toolbar">
          <input type="text" id="qaSearchBox" placeholder="Search by name, email, course, or question" />
          <div class="dash-filters" id="qaFilters">
            <button class="filter-btn is-active" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="published">Published</button>
            <button class="filter-btn" data-status="declined">Declined</button>
            <button class="filter-btn" data-status="all">All</button>
          </div>
        </div>
        <div class="qa-select-all"><label><input type="checkbox" id="qaSelectAll" /> Select all</label></div>
        <div id="qaBulkBar" class="bulk-bar" hidden>
          <span id="qaBulkCount"></span>
          <button id="qaBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="qaLoadingMsg" class="dash-empty">Loading…</p>
        <p id="qaEmptyMsg" class="dash-empty" hidden>No questions here.</p>
        <div id="qaCards" class="qa-cards"></div>
      </div>

      <div id="tabCertificates" class="tab-panel" hidden>
        <div class="perf-section">
          <h2 class="perf-heading">Course Performance</h2>
          <div class="course-kpis" id="perfKpis"></div>

          <div class="perf-toolbar">
            <input type="text" id="perfSearchBox" placeholder="Search courses by name" />
            <select id="perfCategoryFilter"><option value="all">All categories</option></select>
            <div class="dash-filters" id="perfTypeFilters">
              <button class="filter-btn is-active" data-type="all">All</button>
              <button class="filter-btn" data-type="free">Free</button>
              <button class="filter-btn" data-type="paid">Paid</button>
            </div>
          </div>

          <div class="perf-hist-wrap">
            <div class="perf-hist-head">
              <h3>Pass Rate Distribution</h3>
              <span class="perf-hist-hint"><i class="perf-dot perf-dot--free"></i>Free&nbsp;&nbsp;<i class="perf-dot perf-dot--paid"></i>Paid&nbsp;&nbsp;· bar height = number of courses</span>
            </div>
            <div id="perfHistogram" class="perf-histogram"></div>
          </div>

          <div class="perf-layout">
            <div class="table-scroll perf-table-scroll" id="perfTableScroll">
              <table class="perf-table" id="perfTable">
                <thead>
                  <tr>
                    <th data-psort="course_title">Course</th>
                    <th data-psort="category_label">Category</th>
                    <th data-psort="type">Type</th>
                    <th data-psort="enrolled_count">Enrolled</th>
                    <th data-psort="started_quiz_count">Started quiz</th>
                    <th data-psort="passed_count">Passed</th>
                    <th data-psort="pass_rate">Pass rate</th>
                    <th data-psort="avg_score_percent">Avg score</th>
                    <th data-psort="certificate_count">Certificates</th>
                    <th data-psort="dropped_count">Dropped</th>
                    <th data-psort="revenue_pkr">Revenue</th>
                    <th data-psort="avg_satisfaction">Satisfaction</th>
                  </tr>
                </thead>
                <tbody id="perfBody"></tbody>
              </table>
            </div>

            <div class="perf-leaderboard-wrap">
              <div class="perf-leaderboard-head">
                <div class="dash-filters" id="perfBoardType">
                  <button class="filter-btn is-active" data-board="free">Top 50 Free</button>
                  <button class="filter-btn" data-board="paid">Top 50 Paid</button>
                </div>
                <select id="perfBoardMetric">
                  <option value="enrolled_count">By enrolled</option>
                  <option value="pass_rate">By pass rate</option>
                  <option value="certificate_count">By certificates</option>
                  <option value="revenue_pkr">By revenue</option>
                </select>
              </div>
              <div class="table-scroll perf-leaderboard-scroll" id="perfLeaderboardScroll">
                <div id="perfLeaderboard" class="perf-leaderboard"></div>
              </div>
            </div>
          </div>
          <p id="perfEmptyMsg" class="dash-empty" hidden>No courses match.</p>

          <div class="perf-trends-wrap">
            <div class="perf-trends-head">
              <h3>Trends Over Time</h3>
              <div class="perf-trends-controls">
                <select id="trendCourseFilter"><option value="all">All courses (combined)</option></select>
                <div class="dash-filters" id="trendMetricFilters">
                  <button class="filter-btn is-active" data-metric="enrollments">Enrollments</button>
                  <button class="filter-btn" data-metric="certificates">Certificates</button>
                  <button class="filter-btn" data-metric="revenue">Revenue</button>
                </div>
                <div class="dash-filters" id="trendGranFilters">
                  <button class="filter-btn" data-gran="day">Day</button>
                  <button class="filter-btn is-active" data-gran="month">Month</button>
                  <button class="filter-btn" data-gran="year">Year</button>
                </div>
              </div>
            </div>
            <div id="trendChart" class="perf-trend-chart"></div>
            <p id="trendEmptyMsg" class="dash-empty" hidden>No data yet for this selection.</p>
          </div>
        </div>

        <div class="dash-toolbar">
          <input type="text" id="certSearchBox" placeholder="Search by name, email, course, or certificate ID" />
          <button id="certExportBtn" class="btn btn--ghost export-btn">Download as Excel (.csv)</button>
        </div>
        <div id="certBulkBar" class="bulk-bar" hidden>
          <span id="certBulkCount"></span>
          <button id="certBulkDelete" class="btn btn--ghost bulk-delete-btn">Delete selected</button>
        </div>
        <p id="certLoadingMsg" class="dash-empty">Loading…</p>
        <p id="certEmptyMsg" class="dash-empty" hidden>No certificates issued yet.</p>
        <div class="table-scroll">
          <table class="bookings-table" id="certTable" hidden>
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="certSelectAll" /></th>
                <th>Certificate ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Score</th>
                <th>Hours</th>
                <th>Issued</th>
                <th class="col-actions">Verify</th>
                <th class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="certBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Screenshot preview modal -->
  <div id="shotModal" class="modal-overlay" hidden>
    <div class="modal-box">
      <button id="shotModalClose" class="modal-close" type="button">✕</button>
      <img id="shotModalImg" alt="Payment screenshot" />
      <a id="shotModalOpen" href="#" target="_blank" rel="noopener" class="modal-open-link">Open in new tab →</a>
    </div>
  </div>

  <!-- Confirm dialog -->
  <div id="confirmModal" class="modal-overlay" hidden>
    <div class="modal-box modal-box--sm">
      <p id="confirmMessage"></p>
      <div class="modal-actions">
        <button id="confirmCancel" class="btn btn--ghost">Cancel</button>
        <button id="confirmOk" class="btn btn--primary" style="border:none;">Confirm</button>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .dash-section{ padding:48px 0 96px; }
  .dash-header{ display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:20px; margin-top:70px; }
  .dash-header h1{ font-size:30px; margin-top:6px; }
  .dash-logout{ padding:8px 14px; }

  .new-booking-banner{
    background:rgba(199,164,74,0.14); border:1px solid var(--gold-500); border-radius:2px;
    padding:10px 16px; font-size:14px; color:var(--ink-900); margin-bottom:18px;
    display:flex; align-items:center; justify-content:space-between; gap:12px;
  }
  .new-booking-banner button{ background:none; border:none; color:var(--ink-600); cursor:pointer; font-size:13px; }

  .dash-tabs{
    display:flex; gap:6px; margin-bottom:28px; border-bottom:1px solid var(--line);
    overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; scrollbar-width:thin;
  }
  .tab-btn{
    font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.06em; text-transform:uppercase;
    padding:10px 4px; margin-right:22px; border:none; border-bottom:2px solid transparent;
    background:transparent; cursor:pointer; color:var(--ink-600);
    flex:none; white-space:nowrap;
  }
  .tab-btn.is-active{ color:var(--ink-900); border-bottom-color:var(--gold-500); }

  /* Mobile: the tab row can now scroll sideways instead of being clipped by
     the page's overflow-x:hidden safety net. Bleed it to the screen edges
     and fade the edges a touch so it reads as "more here", not just cut off. */
  @media (max-width:900px){
    .dash-tabs{
      margin-left:-20px; margin-right:-20px; padding-left:20px; padding-right:20px;
      -webkit-mask-image:linear-gradient(to right, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
      mask-image:linear-gradient(to right, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
    }
  }

  /* Ghost buttons: visible dark text + border, for use on light backgrounds
     (the .btn--text variant is near-white and meant for dark hero/nav only) */
  .btn--ghost{
    color:var(--ink-900); background:transparent; border:1px solid var(--line);
    padding:9px 16px; border-radius:2px; cursor: pointer;
  }
  .btn--ghost:hover{ border-color:var(--gold-500); background:rgba(199,164,74,0.08); }
  .btn--ghost.is-active{ border-color:var(--gold-500); background:rgba(199,164,74,0.12); }

  .dash-toolbar{ display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:16px; }
  #searchBox, #payReqSearchBox, #enrollSearchBox, #qaSearchBox, #certSearchBox{
    flex:1; min-width:240px; font-family:var(--font-body); font-size:14.5px;
    padding:10px 14px; border:1px solid var(--line); border-radius:2px; color:var(--ink-900); background:#fff;
  }
  #searchBox:focus-visible, #payReqSearchBox:focus-visible, #enrollSearchBox:focus-visible, #qaSearchBox:focus-visible, #certSearchBox:focus-visible{ outline:2px solid var(--gold-500); }
  .dash-filters{ display:flex; gap:8px; flex-wrap:wrap; }
  .filter-btn{
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.06em; text-transform:uppercase;
    padding:8px 14px; border:1px solid var(--line); border-radius:2px; background:transparent; cursor:pointer; color:var(--ink-600);
  }
  .filter-btn.is-active{ border-color:var(--gold-500); color:var(--ink-900); background:rgba(199,164,74,0.08); }
  .export-btn{ white-space:nowrap; color:var(--ink-900); background:transparent; border:1px solid var(--line); padding:9px 16px; border-radius:2px; }
  .export-btn:hover{ border-color:var(--gold-500); background:rgba(199,164,74,0.08); }
  .date-range{ display:flex; align-items:center; gap:6px; }
  .date-range input{ font-family:var(--font-body); font-size:13.5px; padding:8px 10px; border:1px solid var(--line); border-radius:2px; }

  .qa-select-all{ font-size:13px; color:var(--ink-600); margin-bottom:10px; }
  .qa-select-all label{ display:flex; align-items:center; gap:6px; cursor:pointer; }
  .qa-row-check{ margin-right:8px; }
  .bulk-bar{
    display:flex; align-items:center; gap:12px; margin-bottom:16px; padding:10px 14px;
    border:1px solid var(--gold-500); border-radius:2px; background:rgba(199,164,74,0.08); font-size:13.5px;
  }

  .dash-empty{ color:var(--ink-600); padding:24px 0; }

  .skeleton-rows{ display:flex; flex-direction:column; gap:10px; }
  .skeleton-row{ height:52px; border-radius:2px; background:linear-gradient(90deg, var(--paper-50) 25%, rgba(19,26,34,0.06) 37%, var(--paper-50) 63%); background-size:400% 100%; animation:shimmer 1.4s ease infinite; }
  @keyframes shimmer{ 0%{background-position:100% 0;} 100%{background-position:0 0;} }

  /* ===== Course Performance (Certificates tab) ===== */
  .perf-section{ margin-bottom:36px; padding-bottom:28px; border-bottom:1px solid var(--line); }
  .perf-heading{ font-family:var(--font-display); font-size:19px; margin:0 0 14px; }

  .course-kpis{ display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:12px; margin-bottom:18px; }
  .course-kpi-card{ border:1px solid var(--line); border-radius:2px; padding:14px 16px; background:var(--paper-50); }
  .course-kpi-card .kpi-value{ font-family:var(--font-display); font-size:24px; color:var(--ink-900); line-height:1.15; }
  .course-kpi-card .kpi-label{ font-family:var(--font-mono); font-size:11px; letter-spacing:0.05em; text-transform:uppercase; color:var(--ink-600); margin-top:4px; display:block; }

  .perf-toolbar{ display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:16px; }
  #perfSearchBox{
    flex:1; min-width:200px; font-family:var(--font-body); font-size:14.5px;
    padding:10px 14px; border:1px solid var(--line); border-radius:2px; color:var(--ink-900); background:#fff;
  }
  #perfSearchBox:focus-visible{ outline:2px solid var(--gold-500); }
  #perfCategoryFilter{
    font-family:var(--font-body); font-size:13.5px; padding:9px 12px; border:1px solid var(--line);
    border-radius:2px; background:#fff; color:var(--ink-900);
  }

  /* Histogram: fixed number of buckets no matter how many courses exist —
     only bar HEIGHT changes as the catalog grows, so it stays readable at
     any scale. A sqrt scale keeps smaller buckets visibly present even when
     one bucket dominates, and the exact count is always printed above the
     bar so nothing is lost to the visual compression. */
  .perf-hist-wrap{ border:1px solid var(--line); border-radius:2px; padding:18px 20px 14px; background:var(--paper-50); margin-bottom:22px; }
  .perf-hist-head{ display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:14px; }
  .perf-hist-head h3{ font-family:var(--font-display); font-size:15.5px; margin:0; }
  .perf-hist-hint{ font-size:11.5px; color:var(--ink-600); }
  .perf-histogram{ display:flex; align-items:flex-end; gap:10px; height:260px; padding:0 4px; }
  .perf-hist-col{ flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; height:100%; }
  .perf-hist-count{ font-family:var(--font-mono); font-size:11px; color:var(--ink-600); margin-bottom:4px; white-space:nowrap; }
  .perf-hist-track{ flex:1; width:100%; display:flex; align-items:flex-end; }
  .perf-hist-bar{ width:100%; min-height:0; display:flex; flex-direction:column-reverse; border-radius:2px 2px 0 0; overflow:hidden; }
  .perf-hist-seg--free{ background:var(--navy-700, #1C314C); }
  .perf-hist-seg--paid{ background:var(--gold-500); }
  .perf-hist-label{ font-family:var(--font-mono); font-size:10px; color:var(--ink-600); margin-top:8px; text-align:center; white-space:nowrap; }

  .perf-layout{ display:grid; grid-template-columns:minmax(0, 1.5fr) minmax(0, 1fr); gap:20px; align-items:start; }
  @media (max-width:980px){ .perf-layout{ grid-template-columns:1fr; } }

  .perf-table-scroll{ max-height:420px; }
  .perf-table{ width:100%; border-collapse:collapse; font-size:13px; white-space:nowrap; }
  .perf-table thead th{
    position:sticky; top:0; background:var(--paper-0); text-align:left; font-family:var(--font-mono);
    font-size:10.5px; letter-spacing:0.05em; text-transform:uppercase; color:var(--ink-600);
    padding:10px 12px; border-bottom:1px solid var(--line); cursor:pointer; user-select:none; z-index:1;
  }
  .perf-table thead th:hover{ color:var(--ink-900); }
  .perf-table thead th.sorted::after{ content:attr(data-dir); margin-left:4px; color:var(--gold-500); }
  .perf-table td{ padding:10px 12px; border-bottom:1px solid var(--line); vertical-align:top; }
  .perf-table tbody tr:hover{ background:rgba(199,164,74,0.05); }
  .perf-table tbody tr.is-flash{ background:rgba(199,164,74,0.22); }
  .perf-table td:first-child, .perf-table th:first-child{
    position:sticky; left:0; background:var(--paper-0); z-index:2; box-shadow:1px 0 0 var(--line);
  }
  .perf-table tbody tr:hover td:first-child{ background:#F6F5ED; }
  .perf-table tbody tr.is-flash td:first-child{ background:rgba(199,164,74,0.22); }

  .type-badge{
    font-family:var(--font-mono); font-size:10.5px; letter-spacing:0.05em; text-transform:uppercase;
    padding:3px 8px; border-radius:20px; white-space:nowrap;
  }
  .type-badge--free{ background:rgba(19,26,34,0.07); color:var(--ink-600); }
  .type-badge--paid{ background:rgba(199,164,74,0.15); color:#8a6d1f; }
  .draft-badge{
    font-family:var(--font-mono); font-size:10px; letter-spacing:0.05em; text-transform:uppercase;
    color:var(--ink-600); border:1px solid var(--line); border-radius:2px; padding:1px 6px; margin-left:6px;
  }
  .perf-rate{ font-weight:600; }
  .perf-rate--low{ color:#B4432E; }
  .perf-rate--mid{ color:#8a6d1f; }
  .perf-rate--high{ color:#3f5c47; }

  .perf-dot{ display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:4px; vertical-align:middle; }
  .perf-dot--free{ background:var(--navy-700, #1C314C); }
  .perf-dot--paid{ background:var(--gold-500); }

  /* Leaderboard: fixed row height per course, capped at 50 rows and scrolled
     rather than compressed — so it's exactly as readable with 1000 courses
     in the catalog as it is with 10. */
  .perf-leaderboard-wrap{ border:1px solid var(--line); border-radius:2px; padding:14px 16px; background:var(--paper-50); }
  .perf-leaderboard-head{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:12px; }
  #perfBoardMetric{
    font-family:var(--font-body); font-size:12.5px; padding:7px 10px; border:1px solid var(--line);
    border-radius:2px; background:#fff; color:var(--ink-900);
  }
  .perf-leaderboard-scroll{ max-height:420px; border:none; cursor:default; }
  .perf-leaderboard{ display:flex; flex-direction:column; }
  .perf-lb-row{ display:flex; align-items:center; gap:10px; padding:6px 2px; border-bottom:1px solid rgba(19,26,34,0.06); cursor:pointer; }
  .perf-lb-row:hover{ background:rgba(199,164,74,0.06); }
  .perf-lb-row:hover .perf-lb-name{ color:var(--ink-900); }
  .perf-lb-rank{ font-family:var(--font-mono); font-size:11px; color:var(--ink-600); width:20px; flex:none; text-align:right; }
  .perf-lb-name{ font-size:12.5px; color:var(--ink-700, var(--ink-600)); width:34%; flex:none; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .perf-lb-bar-track{ flex:1; background:rgba(19,26,34,0.06); border-radius:2px; height:8px; overflow:hidden; }
  .perf-lb-bar{ height:100%; border-radius:2px; }
  .perf-lb-bar--free{ background:var(--navy-700, #1C314C); }
  .perf-lb-bar--paid{ background:var(--gold-500); }
  .perf-lb-value{ font-family:var(--font-mono); font-size:11.5px; color:var(--ink-600); width:64px; flex:none; text-align:right; }

  /* Trends: a continuous time axis, so 2 weeks or 3 years of history draw
     at the same width — only point density changes, never readability. */
  .perf-trends-wrap{ border:1px solid var(--line); border-radius:2px; padding:16px 18px; background:var(--paper-50); margin-top:22px; }
  .perf-trends-head{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:12px; }
  .perf-trends-head h3{ font-family:var(--font-display); font-size:15.5px; margin:0; }
  .perf-trends-controls{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  #trendCourseFilter{
    font-family:var(--font-body); font-size:12.5px; padding:7px 10px; border:1px solid var(--line);
    border-radius:2px; background:#fff; color:var(--ink-900); max-width:220px;
  }
  .perf-trend-chart{ width:100%; }
  .perf-trend-chart svg{ width:100%; height:auto; display:block; overflow:visible; }

  .perf-tooltip{
    position:fixed; z-index:60; pointer-events:none; background:var(--navy-950, #0B141F); color:#fff;
    font-size:12.5px; line-height:1.5; padding:8px 11px; border-radius:2px; max-width:220px;
    box-shadow:0 4px 14px rgba(11,20,31,0.3); opacity:0; transition:opacity .1s ease;
  }
  .perf-tooltip.is-visible{ opacity:1; }
  .perf-tooltip strong{ display:block; margin-bottom:2px; }

  .table-scroll{
    overflow-x:auto; border:1px solid var(--line); border-radius:2px; max-height:640px; overflow-y:auto;
    -webkit-overflow-scrolling:touch; overscroll-behavior:contain; cursor:grab;
  }
  .table-scroll.is-panning{ cursor:grabbing; user-select:none; }
  .bookings-table{ width:100%; border-collapse:collapse; font-size:13.5px; white-space:nowrap; }

  /* Freeze the checkbox + name/reference column so you always know which
     row you're looking at while panning right on a wide table. */
  .bookings-table td.col-check, .bookings-table th.col-check,
  .bookings-table td:nth-child(2), .bookings-table th:nth-child(2){
    position:sticky; left:var(--col1-w, 36px); background:var(--paper-0); z-index:2;
  }
  .bookings-table td.col-check, .bookings-table th.col-check{ left:0; }
  .bookings-table td:nth-child(2), .bookings-table th:nth-child(2){ box-shadow:1px 0 0 var(--line); }
  .bookings-table thead th.col-check, .bookings-table thead th:nth-child(2){ z-index:3; }
  .bookings-table tbody tr:hover td.col-check, .bookings-table tbody tr:hover td:nth-child(2){ background:#F6F5ED; }
  .bookings-table tbody tr.row-pending td.col-check, .bookings-table tbody tr.row-pending td:nth-child(2){ background:#F4F1E7; }
  .bookings-table tbody tr.row-pending:hover td.col-check, .bookings-table tbody tr.row-pending:hover td:nth-child(2){ background:#F1EDDE; }
  .bookings-table thead th{
    position:sticky; top:0; background:var(--paper-0); text-align:left; font-family:var(--font-mono);
    font-size:11px; letter-spacing:0.05em; text-transform:uppercase; color:var(--ink-600);
    padding:12px 14px; border-bottom:1px solid var(--line); cursor:pointer; user-select:none; z-index:1;
  }
  .bookings-table thead th:hover{ color:var(--ink-900); }
  .bookings-table thead th.sorted::after{ content:attr(data-dir); margin-left:4px; color:var(--gold-500); }
  .bookings-table td{ padding:12px 14px; border-bottom:1px solid var(--line); vertical-align:top; }
  .bookings-table tbody tr:hover{ background:rgba(199,164,74,0.05); }
  .bookings-table tbody tr.row-pending{ background:rgba(199,164,74,0.09); font-weight:600; }
  .bookings-table tbody tr.row-pending:hover{ background:rgba(199,164,74,0.14); }
  .bookings-table tbody tr.row-pending td{ border-left:3px solid var(--gold-500); }
  .bookings-table tbody tr.row-pending td:first-child{ border-left:none; }
  .bookings-table tbody tr.is-unenrolled{ opacity:0.55; }
  .col-check{ width:36px; }
  .col-actions{ width:150px; }
  .cell-ref{ font-family:var(--font-mono); color:var(--gold-500); }
  .cell-notes-flag{ color:var(--ink-600); cursor:help; }
  .table-actions{ display:flex; gap:6px; align-items:center; }
  .icon-btn{
    width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center;
    font-size:14px; border:1px solid var(--line); border-radius:2px; background:var(--paper-0);
    cursor:pointer; padding:0; line-height:1;
  }
  .icon-btn:hover{ background:rgba(199,164,74,0.08); }
  .icon-btn:disabled{ opacity:0.35; cursor:not-allowed; }
  .icon-btn.confirm{ border-color:#3f5c47; color:#3f5c47; }
  .icon-btn.decline{ border-color:#B4432E; color:#B4432E; }
  .icon-btn.delete{ border-color:var(--ink-600); color:var(--ink-600); }
  .icon-btn.delete:hover{ border-color:#B4432E; color:#B4432E; }

  .status-badge{ font-family:var(--font-mono); font-size:11px; letter-spacing:0.06em; text-transform:uppercase; padding:4px 10px; border-radius:20px; white-space:nowrap; }
  .status-badge.pending{ background:rgba(199,164,74,0.15); color:#8a6d1f; }
  .status-badge.confirmed{ background:rgba(124,152,133,0.18); color:#3f5c47; }
  .status-badge.declined{ background:rgba(180,67,46,0.12); color:#B4432E; }


  .pagination{ display:flex; align-items:center; justify-content:center; gap:16px; margin-top:18px; font-size:13.5px; color:var(--ink-600); }

  /* Floating horizontal scrollbar: pinned to the bottom of the screen
     (not the bottom of the table) whenever a wide table that needs it is
     in view, so you never have to scroll down to find it. */
  .floating-hscroll{
    position:fixed; left:0; right:0; bottom:max(6px, env(safe-area-inset-bottom));
    height:20px; padding:0 12px; box-sizing:border-box; z-index:40;
    opacity:0; pointer-events:none; transition:opacity .15s ease;
  }
  .floating-hscroll.is-visible{ opacity:1; pointer-events:auto; }
  .floating-hscroll::before{
    content:''; position:absolute; left:12px; right:12px; top:50%; transform:translateY(-50%);
    height:4px; border-radius:2px; background:rgba(19,26,34,0.10);
  }
  .floating-hscroll-thumb{
    position:absolute; top:50%; left:12px; transform:translateY(-50%);
    height:6px; min-width:40px; border-radius:3px; background:var(--gold-500);
    cursor:grab; touch-action:none; box-shadow:0 1px 3px rgba(19,26,34,0.3);
  }
  .floating-hscroll-thumb:active{ cursor:grabbing; }

  .field{ display:flex; flex-direction:column; gap:6px; }
  label{ font-size:14px; font-weight:500; }
  select, textarea, input[type="time"]{ font-family:var(--font-body); font-size:14.5px; padding:10px 12px; border:1px solid var(--line); border-radius:2px; }
  .avail-hint{ font-size:13px; color:var(--ink-600); }

  .avail-template{ display:flex; flex-direction:column; gap:16px; max-width:640px; margin-bottom:32px; padding:22px; border:1px solid var(--line); border-radius:2px; background:var(--paper-50); }
  .avail-template-title{ font-size:17px; margin:0; }

  .day-rows{ display:flex; flex-direction:column; gap:8px; }
  .day-row{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:8px 0; border-bottom:1px solid var(--line); }
  .day-row:last-child{ border-bottom:none; }
  .day-row-toggle{
    display:flex; align-items:center; gap:8px; width:96px; font-family:var(--font-mono); font-size:12.5px;
    letter-spacing:0.04em; text-transform:uppercase; cursor:pointer; color:var(--ink-600);
  }
  .day-row.is-on .day-row-toggle{ color:var(--ink-900); }
  .day-row-fields{ display:flex; gap:10px; flex-wrap:wrap; opacity:0.35; pointer-events:none; align-items:center; }
  .day-row.is-on .day-row-fields{ opacity:1; pointer-events:auto; }
  .day-row-fields input[type="time"], .day-row-fields select{ padding:8px 10px; font-size:13.5px; }
  .buffer-field{ max-width:260px; }
  .avail-saved-msg{ font-size:13px; color:#3f5c47; }
  .avail-warning{ font-size:13px; color:#8a6d1f; }

  .avail-calendar{ max-width:640px; margin-bottom:24px; border:1px solid var(--line); border-radius:2px; padding:20px; }
  .cal-nav{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
  .cal-nav-btn{ font-family:var(--font-mono); font-size:12px; background:none; border:none; color:var(--ink-600); cursor:pointer; padding:4px; }
  .cal-nav-btn:hover{ color:var(--ink-900); }
  .cal-month-label{ font-weight:600; font-size:15px; }
  .cal-legend{ display:flex; gap:16px; flex-wrap:wrap; font-size:12px; color:var(--ink-600); margin-bottom:10px; }
  .cal-legend .dot{ display:inline-block; width:7px; height:7px; border-radius:50%; margin-right:5px; }
  .cal-legend .dot.open{ background:#3f5c47; }
  .cal-legend .dot.booked{ background:var(--gold-500); }
  .cal-legend .swatch{ display:inline-block; width:10px; height:10px; margin-right:5px; background:rgba(180,67,46,0.2); border:1px solid rgba(180,67,46,0.4); }
  .cal-weekdays{ display:grid; grid-template-columns:30px repeat(7,1fr); font-family:var(--font-mono); font-size:11px; color:var(--ink-600); text-align:center; margin-bottom:6px; }
  .cal-grid{ display:flex; flex-direction:column; gap:4px; }
  .cal-cell{
    position:relative; aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    border:1px solid var(--line); border-radius:2px; background:transparent; cursor:pointer; font-size:13px; color:var(--ink-900); padding:2px;
  }
  .cal-cell:hover{ border-color:var(--gold-500); }
  .cal-cell.is-blank{ visibility:hidden; cursor:default; }
  .cal-cell.is-past{ opacity:0.35; cursor:default; }
  .cal-cell.is-past:hover{ border-color:var(--line); }
  .cal-cell.is-off{ background:rgba(180,67,46,0.06); color:var(--ink-600); }
  .cal-cell.is-selected{ border-color:var(--gold-500); border-width:2px; background:var(--gold-500); color:var(--navy-950); font-weight:700; }
  .cal-dot-row{ display:flex; gap:3px; margin-top:3px; }
  .cal-dot{ width:5px; height:5px; border-radius:50%; }
  .cal-dot.open{ background:#3f5c47; }
  .cal-dot.booked{ background:var(--gold-500); }

  .cal-day-panel{ max-width:640px; border:1px solid var(--line); border-radius:2px; padding:18px 20px; margin-bottom:36px; }
  .cal-day-panel-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .cal-day-panel-head span{ font-weight:600; }

  .avail-slots-row{ display:flex; gap:8px; flex-wrap:wrap; }
  .avail-slot-chip{ display:flex; align-items:center; gap:8px; font-size:13.5px; padding:6px 10px; border:1px solid var(--line); border-radius:2px; }
  .avail-slot-chip.booked{ opacity:0.55; }
  .avail-slot-remove{ background:none; border:none; color:#B4432E; cursor:pointer; font-size:14px; padding:0; }
  .undo-toast{
    display:flex; align-items:center; gap:14px; justify-content:space-between;
    margin-top:14px; padding:10px 14px; background:var(--navy-950); color:var(--paper-0);
    border-radius:3px; font-size:13.5px;
  }
  .undo-toast-btn{
    background:none; border:1px solid rgba(248,249,246,0.4); color:var(--gold-300);
    font-size:12.5px; font-weight:600; padding:5px 12px; border-radius:2px; cursor:pointer; flex:none;
  }
  .undo-toast-btn:hover{ border-color: var(--gold-300); }

  .cal-toolbar{ display:flex; justify-content:flex-end; margin-bottom:10px; }

  .cal-week-row{ display:grid; grid-template-columns:30px repeat(7,1fr); gap:4px; align-items:center; }
  .cal-week-btn{
    font-size:13px; width:26px; height:26px; border:1px solid var(--line); border-radius:50%;
    background:transparent; cursor:pointer; color:var(--ink-600); display:flex; align-items:center; justify-content:center; padding:0;
  }
  .cal-week-btn:hover{ border-color:var(--gold-500); color:var(--ink-900); }
  .cal-cell.is-other-month{ opacity:0.32; }
  .cal-cell.is-picked{ border-color:var(--gold-500); border-width:2px; background:rgba(199,164,74,0.14); }

  .cal-select-bar{
    display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:12px; padding:12px 16px;
    border:1px solid var(--gold-500); border-radius:2px; background:rgba(199,164,74,0.08); font-size:13.5px;
  }

  .modal-overlay{
    position:fixed; inset:0; background:rgba(11,20,31,0.6); display:flex; align-items:center; justify-content:center;
    z-index:50; padding:24px;
  }
  .modal-box{ background:var(--paper-0); border-radius:2px; padding:24px; max-width:min(90vw, 640px); max-height:85vh; overflow:auto; position:relative; }
  .modal-box--sm{ max-width:360px; }
  .modal-box img{ max-width:100%; min-width:280px; min-height:80px; display:block; border:1px solid var(--line); color:var(--ink-600); font-size:13.5px; padding:16px; }
  .modal-close{ position:absolute; top:10px; right:10px; background:none; border:none; font-size:16px; cursor:pointer; color:var(--ink-600); }
  .modal-close:hover{ color:var(--ink-900); }
  .modal-open-link{ display:inline-block; margin-top:12px; font-size:13.5px; color:var(--ink-900); text-decoration:underline; }
  .modal-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:16px; }

  .qa-cards{ display:grid; gap:16px; }
  .qa-card{ border:1px solid var(--line); border-radius:2px; padding:18px 20px; background:var(--paper-0); }
  .qa-card__meta{ font-family:var(--font-mono); font-size:12px; color:var(--ink-600); margin-bottom:8px; display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .qa-card__question{ font-size:15px; margin:0 0 12px; }
  .qa-card textarea{ width:100%; min-height:70px; font:inherit; padding:10px; border:1px solid var(--line); border-radius:2px; resize:vertical; margin-bottom:10px; }
  .qa-card__actions{ display:flex; gap:8px; flex-wrap:wrap; }
  .qa-card__answer{ font-size:14px; color:var(--ink-900); background:var(--paper-50); padding:10px 12px; border-radius:2px; margin-bottom:10px; }

  @media (max-width:560px){
    .dash-header{ flex-direction:column; gap:12px; }
  }
</style>

<script define:vars={{ role }}>
  // ===== Shared helpers =====
  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function clinicianName(c) { return c === 'sohail' ? 'Muhammad Sohail' : c === 'sehar' ? 'Sehar Waheed' : 'No preference'; }
  function formatPkr(n) { return 'Rs. ' + Math.round(n || 0).toLocaleString(); }
  function formatPkrShort(n) {
    if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
    if (n >= 1000) return Math.round(n / 1000) + 'k';
    return String(Math.round(n));
  }
  function formatDate(iso) {
    const d = new Date(iso);
    return d.toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  }

  function showConfirm(message) {
    return Promise.resolve(window.confirm(message));
  }

  // ===== Tabs (persisted via URL hash) =====
  const tabs = document.getElementById('dashTabs');
  const tabBookings = document.getElementById('tabBookings');
  const tabAvailability = document.getElementById('tabAvailability');
  const tabCoursePayments = document.getElementById('tabCoursePayments');
  const tabEnrollments = document.getElementById('tabEnrollments');
  const tabWorkshopEnroll = document.getElementById('tabWorkshopEnroll');
  const tabQa = document.getElementById('tabQa');
  const tabCertificates = document.getElementById('tabCertificates');
  let scheduleTableUXRefresh = () => {};

  function activateTab(tab) {
    tabs.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.tab === tab));
    tabBookings.hidden = tab !== 'bookings';
    tabAvailability.hidden = tab !== 'availability';
    tabCoursePayments.hidden = tab !== 'coursePayments';
    tabEnrollments.hidden = tab !== 'enrollments';
    tabWorkshopEnroll.hidden = tab !== 'workshopEnroll';
    tabQa.hidden = tab !== 'qa';
    tabCertificates.hidden = tab !== 'certificates';
    if (tab === 'availability') loadAvailability();
    if (tab === 'coursePayments') loadCoursePaymentRequests();
    if (tab === 'enrollments') loadEnrollments();
    if (tab === 'workshopEnroll') loadWorkshopEnrollments();
    if (tab === 'qa') loadQuestions();
    if (tab === 'certificates') loadCertificates();
    history.replaceState(null, '', `#${tab}`);
    if (typeof scheduleTableUXRefresh === 'function') scheduleTableUXRefresh();
  }
  tabs.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    activateTab(btn.dataset.tab);
    // Bring the tapped tab fully into view on the scrollable mobile tab bar.
    btn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
  });
  const initialTab = ['availability', 'coursePayments', 'enrollments', 'workshopEnroll', 'qa', 'certificates'].includes(location.hash.slice(1))
    ? location.hash.slice(1) : 'bookings';
  activateTab(initialTab);

  // ===== Wide table UX: click/drag-to-pan, frozen first columns, and a
  // floating bottom scrollbar so you never have to hunt for one. Applies
  // to every .table-scroll on the page (desktop and mobile alike). =====
  (function setupTableScrollUX() {
    const scrollers = Array.from(document.querySelectorAll('.table-scroll'));
    if (!scrollers.length) return;

    const bar = document.createElement('div');
    bar.className = 'floating-hscroll';
    bar.innerHTML = '<div class="floating-hscroll-thumb"></div>';
    document.body.appendChild(bar);
    const thumb = bar.querySelector('.floating-hscroll-thumb');
    const TRACK_PAD = 12;

    let activeScroller = null;

    function isShown(el) {
      return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
    }
    function needsScroll(el) {
      return el.scrollWidth > el.clientWidth + 2;
    }
    function inViewport(el) {
      const r = el.getBoundingClientRect();
      return r.bottom > 0 && r.top < window.innerHeight && r.width > 0;
    }
    function pickVisibleScroller() {
      for (const el of scrollers) {
        if (isShown(el) && needsScroll(el) && inViewport(el)) return el;
      }
      return null;
    }

    function alignFrozenColumns() {
      scrollers.forEach((el) => {
        const table = el.querySelector('.bookings-table');
        const firstTh = table && table.querySelector('thead th.col-check');
        if (!firstTh) return;
        table.style.setProperty('--col1-w', firstTh.getBoundingClientRect().width + 'px');
      });
    }

    function syncBar() {
      const el = pickVisibleScroller();
      activeScroller = el;
      if (!el) { bar.classList.remove('is-visible'); return; }
      bar.classList.add('is-visible');
      const trackWidth = Math.max(1, bar.clientWidth - TRACK_PAD * 2);
      const thumbWidth = Math.min(trackWidth, Math.max(40, (el.clientWidth / el.scrollWidth) * trackWidth));
      const maxThumbLeft = trackWidth - thumbWidth;
      const maxScroll = el.scrollWidth - el.clientWidth || 1;
      const ratio = el.scrollLeft / maxScroll;
      thumb.style.width = thumbWidth + 'px';
      thumb.style.transform = `translateY(-50%) translateX(${ratio * maxThumbLeft}px)`;
    }

    let rafPending = false;
    function refresh() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => { rafPending = false; alignFrozenColumns(); syncBar(); });
    }
    scheduleTableUXRefresh = refresh;

    document.addEventListener('scroll', syncBar, { passive: true, capture: true });
    window.addEventListener('resize', refresh);
    scrollers.forEach((el) => el.addEventListener('scroll', syncBar, { passive: true }));

    // Table bodies get re-rendered async after data loads; catch that too.
    const dashSection = document.querySelector('.dash-section');
    if (dashSection) {
      new MutationObserver(refresh).observe(dashSection, {
        childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'],
      });
    }

    // Dragging the floating thumb scrolls the active table.
    let draggingThumb = false, dragStartX = 0, dragStartScroll = 0;
    thumb.addEventListener('pointerdown', (e) => {
      if (!activeScroller) return;
      draggingThumb = true;
      dragStartX = e.clientX;
      dragStartScroll = activeScroller.scrollLeft;
      thumb.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    thumb.addEventListener('pointermove', (e) => {
      if (!draggingThumb || !activeScroller) return;
      const trackWidth = Math.max(1, bar.clientWidth - TRACK_PAD * 2);
      const thumbWidth = thumb.offsetWidth;
      const maxThumbLeft = Math.max(1, trackWidth - thumbWidth);
      const maxScroll = activeScroller.scrollWidth - activeScroller.clientWidth;
      const dx = e.clientX - dragStartX;
      activeScroller.scrollLeft = dragStartScroll + (dx / maxThumbLeft) * maxScroll;
      syncBar();
    });
    ['pointerup', 'pointercancel'].forEach((evt) => thumb.addEventListener(evt, () => { draggingThumb = false; }));

    // Clicking the track (not the thumb) jumps the scroll to that spot.
    bar.addEventListener('pointerdown', (e) => {
      if (e.target === thumb || !activeScroller) return;
      const rect = bar.getBoundingClientRect();
      const trackWidth = Math.max(1, bar.clientWidth - TRACK_PAD * 2);
      const thumbWidth = thumb.offsetWidth;
      const maxThumbLeft = Math.max(1, trackWidth - thumbWidth);
      const maxScroll = activeScroller.scrollWidth - activeScroller.clientWidth;
      const clickX = e.clientX - rect.left - TRACK_PAD - thumbWidth / 2;
      const targetLeft = Math.min(Math.max(clickX, 0), maxThumbLeft);
      activeScroller.scrollLeft = (targetLeft / maxThumbLeft) * maxScroll;
      syncBar();
    });

    // Click-and-drag to pan each table (mouse/pen). Touch keeps native
    // momentum scrolling. Sort clicks and row action buttons are excluded
    // so panning never hijacks a real click.
    scrollers.forEach((el) => {
      let panning = false, moved = false, startX = 0, startScroll = 0;
      el.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'touch') return;
        if (e.target.closest('button, a, input, th, textarea, select')) return;
        panning = true; moved = false;
        startX = e.clientX; startScroll = el.scrollLeft;
        el.classList.add('is-panning');
      });
      el.addEventListener('pointermove', (e) => {
        if (!panning) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 3) moved = true;
        el.scrollLeft = startScroll - dx;
      });
      function endPan() { panning = false; el.classList.remove('is-panning'); }
      el.addEventListener('pointerup', endPan);
      el.addEventListener('pointerleave', endPan);
      el.addEventListener('click', (e) => {
        if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; }
      }, true);
    });

    refresh();
  })();

  // ===== Generic bulk-select helper (checkboxes + bulk delete bar) =====
  function makeBulkSelector({ selectAllEl, bulkBarEl, bulkCountEl, bulkDeleteBtn, rowCheckSelector, containerEl, getItems, setItems, idOf, deleteUrl, confirmMsg, render }) {
    const selected = new Set();
    function sync() {
      bulkBarEl.hidden = selected.size === 0;
      bulkCountEl.textContent = `${selected.size} selected`;
      const boxes = containerEl.querySelectorAll(rowCheckSelector);
      selectAllEl.checked = boxes.length > 0 && [...boxes].every((c) => c.checked);
    }
    containerEl.addEventListener('change', (e) => {
      const c = e.target.closest(rowCheckSelector);
      if (!c) return;
      if (c.checked) selected.add(c.dataset.selid); else selected.delete(c.dataset.selid);
      sync();
    });
    selectAllEl.addEventListener('change', () => {
      containerEl.querySelectorAll(rowCheckSelector).forEach((c) => {
        c.checked = selectAllEl.checked;
        if (selectAllEl.checked) selected.add(c.dataset.selid); else selected.delete(c.dataset.selid);
      });
      sync();
    });
    bulkDeleteBtn.addEventListener('click', async () => {
      if (!selected.size) return;
      const ok = await showConfirm(confirmMsg(selected.size));
      if (!ok) return;
      await Promise.all([...selected].map((id) => fetch(deleteUrl(id), { method: 'DELETE' })));
      setItems(getItems().filter((item) => !selected.has(String(idOf(item)))));
      selected.clear();
      render();
    });
    return { resetSelection: () => { selected.clear(); sync(); }, sync };
  }

  // ===== Course Enrollments =====
  let allEnrollments = [];
  const enrollBody = document.getElementById('enrollBody');
  const enrollTable = document.getElementById('enrollTable');
  const enrollLoadingMsg = document.getElementById('enrollLoadingMsg');
  const enrollEmptyMsg = document.getElementById('enrollEmptyMsg');
  const enrollSearchBox = document.getElementById('enrollSearchBox');
  const enrollExportBtn = document.getElementById('enrollExportBtn');
  const enrollTypeFiltersEl = document.getElementById('enrollTypeFilters');
  let enrollTypeFilter = 'all';
  enrollTypeFiltersEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    enrollTypeFiltersEl.querySelectorAll('.filter-btn').forEach((b) => b.classList.toggle('is-active', b === btn));
    enrollTypeFilter = btn.dataset.type;
    renderEnrollments();
  });

  async function loadEnrollments() {
    enrollLoadingMsg.hidden = false;
    enrollTable.hidden = true;
    const res = await fetch('/api/admin/enrollments');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allEnrollments = data.enrollments || [];
    enrollLoadingMsg.hidden = true;
    renderEnrollments();
  }

  function renderEnrollments() {
    const term = (enrollSearchBox.value || '').toLowerCase();
    const items = allEnrollments.filter((e) => {
      if (!(!term || e.name.toLowerCase().includes(term) || e.email.toLowerCase().includes(term) || e.course_title.toLowerCase().includes(term))) return false;
      const type = e.amount_pkr != null ? 'paid' : 'free';
      if (enrollTypeFilter !== 'all' && type !== enrollTypeFilter) return false;
      return true;
    });
    enrollEmptyMsg.hidden = items.length > 0;
    enrollTable.hidden = items.length === 0;
    enrollBody.innerHTML = items.map((e) => {
      const isPaid = e.amount_pkr != null;
      return `
      <tr${e.status === 'unenrolled' ? ' class="is-unenrolled"' : ''}>
        <td class="col-check"><input type="checkbox" class="enroll-row-check" data-selid="${e.id}" /></td>
        <td>${escapeHtml(e.name)}</td>
        <td>${escapeHtml(e.email)}</td>
        <td>${escapeHtml(e.course_title)}</td>
        <td><span class="type-badge type-badge--${isPaid ? 'paid' : 'free'}">${isPaid ? 'Paid' : 'Free'}</span></td>
        <td>${isPaid ? formatPkr(e.amount_pkr) : '—'}</td>
        <td>${formatDate(e.enrolled_at)}</td>
        <td>${e.completed > 0 ? '✓ Completed' : '—'}</td>
        <td>${e.unenrolled_at ? formatDate(e.unenrolled_at) : '—'}</td>
        <td class="col-actions"><button class="icon-btn delete" data-enrollid="${e.id}" title="Delete">🗑</button></td>
      </tr>
    `;
    }).join('');
    enrollBulk.sync();
  }
  enrollSearchBox.addEventListener('input', renderEnrollments);
  const enrollBulk = makeBulkSelector({
    selectAllEl: document.getElementById('enrollSelectAll'),
    bulkBarEl: document.getElementById('enrollBulkBar'),
    bulkCountEl: document.getElementById('enrollBulkCount'),
    bulkDeleteBtn: document.getElementById('enrollBulkDelete'),
    rowCheckSelector: '.enroll-row-check',
    containerEl: enrollBody,
    getItems: () => allEnrollments,
    setItems: (v) => { allEnrollments = v; },
    idOf: (e) => e.id,
    deleteUrl: (id) => `/api/admin/enrollments?id=${id}`,
    confirmMsg: (n) => `Delete ${n} enrollment(s) permanently? This does not affect any certificate already issued.`,
    render: renderEnrollments,
  });

  enrollBody.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-enrollid]');
    if (!btn) return;
    const id = Number(btn.dataset.enrollid);
    const ok = await showConfirm('Delete this enrollment permanently? This does not affect any certificate already issued.');
    if (!ok) return;
    btn.disabled = true;
    await fetch(`/api/admin/enrollments?id=${id}`, { method: 'DELETE' });
    allEnrollments = allEnrollments.filter((x) => x.id !== id);
    renderEnrollments();
  });

  enrollExportBtn.addEventListener('click', () => {
    const header = ['Name', 'Email', 'Course', 'Type', 'Amount (PKR)', 'Enrolled At', 'Completed', 'Unenrolled At'];
    const rows = allEnrollments.map((e) => [e.name, e.email, e.course_title, e.amount_pkr != null ? 'Paid' : 'Free', e.amount_pkr ?? '', e.enrolled_at, e.completed > 0 ? 'Yes' : 'No', e.unenrolled_at || '']
      .map((v) => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','));
    const csv = [header.join(','), ...rows].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `course-enrollments-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // ===== Workshop Signups =====
  let allWkEnrollments = [];
  let wkEnrollFilter = 'all';
  const wkEnrollBody = document.getElementById('wkEnrollBody');
  const wkEnrollTable = document.getElementById('wkEnrollTable');
  const wkEnrollLoadingMsg = document.getElementById('wkEnrollLoadingMsg');
  const wkEnrollEmptyMsg = document.getElementById('wkEnrollEmptyMsg');
  const wkEnrollSearchBox = document.getElementById('wkEnrollSearchBox');
  const wkEnrollFilters = document.getElementById('wkEnrollFilters');
  const wkEnrollExportBtn = document.getElementById('wkEnrollExportBtn');

  async function loadWorkshopEnrollments() {
    wkEnrollLoadingMsg.hidden = false;
    wkEnrollTable.hidden = true;
    const res = await fetch('/api/admin/workshop-enrollments');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allWkEnrollments = data.requests || [];
    wkEnrollLoadingMsg.hidden = true;
    renderWkEnrollments();
  }

  function renderWkEnrollments() {
    const term = (wkEnrollSearchBox.value || '').toLowerCase();
    const items = allWkEnrollments.filter((e) =>
      (wkEnrollFilter === 'all' || e.status === wkEnrollFilter) &&
      (!term || e.name.toLowerCase().includes(term) || e.email.toLowerCase().includes(term) || e.workshop_title.toLowerCase().includes(term))
    );
    wkEnrollEmptyMsg.hidden = items.length > 0;
    wkEnrollTable.hidden = items.length === 0;
    wkEnrollBody.innerHTML = items.map((e) => `
      <tr>
        <td class="col-check"><input type="checkbox" class="wkenroll-row-check" data-selid="${e.id}" /></td>
        <td>${escapeHtml(e.name)}${e.notes ? `<br/><span class="row-note">${escapeHtml(e.notes)}</span>` : ''}</td>
        <td>${escapeHtml(e.email)}<br/><span class="row-note">${escapeHtml(e.phone)}</span></td>
        <td>${escapeHtml(e.workshop_title)}</td>
        <td>PKR ${escapeHtml(String(e.amount_pkr))}</td>
        <td>${escapeHtml(e.payment_method)}</td>
        <td>${formatDate(e.created_at)}</td>
        <td><span class="status-badge ${statusBadgeClass(e.status)}">${e.status === 'active' ? 'confirmed' : e.status}</span></td>
        <td class="col-actions">
          <button class="icon-btn" data-wkshot="${e.id}" title="View screenshot">View</button>
          ${e.status !== 'active' ? `<button class="icon-btn confirm" data-wkid="${e.id}" data-wkstatus="active" title="Approve">✓</button>` : ''}
          ${e.status !== 'declined' ? `<button class="icon-btn decline" data-wkid="${e.id}" data-wkstatus="declined" title="Decline">✕</button>` : ''}
          <button class="icon-btn delete" data-wkdelete="${e.id}" title="Delete">🗑</button>
        </td>
      </tr>
    `).join('');
    wkEnrollBulk.sync();
  }
  wkEnrollSearchBox.addEventListener('input', renderWkEnrollments);
  const wkEnrollBulk = makeBulkSelector({
    selectAllEl: document.getElementById('wkEnrollSelectAll'),
    bulkBarEl: document.getElementById('wkEnrollBulkBar'),
    bulkCountEl: document.getElementById('wkEnrollBulkCount'),
    bulkDeleteBtn: document.getElementById('wkEnrollBulkDelete'),
    rowCheckSelector: '.wkenroll-row-check',
    containerEl: wkEnrollBody,
    getItems: () => allWkEnrollments,
    setItems: (v) => { allWkEnrollments = v; },
    idOf: (e) => e.id,
    deleteUrl: (id) => `/api/admin/workshop-enrollments?id=${id}`,
    confirmMsg: (n) => `Delete ${n} workshop signup(s) permanently?`,
    render: renderWkEnrollments,
  });
  wkEnrollFilters.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    wkEnrollFilters.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    wkEnrollFilter = btn.dataset.status || 'all';
    renderWkEnrollments();
  });

  wkEnrollBody.addEventListener('click', async (e) => {
    const shotBtn = e.target.closest('[data-wkshot]');
    if (shotBtn) {
      const win = window.open('', '_blank');
      shotBtn.disabled = true;
      const originalText = shotBtn.textContent;
      shotBtn.textContent = 'Loading…';
      try {
        const res = await fetch(`/api/admin/workshop-screenshot/${shotBtn.dataset.wkshot}`, { credentials: 'same-origin' });
        if (!res.ok) throw new Error(`Server said ${res.status}`);
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        if (win) win.location.href = blobUrl;
      } catch (err) {
        if (win) win.close();
        window.alert(`Could not load the screenshot: ${err.message || err}`);
      } finally {
        shotBtn.disabled = false;
        shotBtn.textContent = originalText;
      }
      return;
    }
    const btn = e.target.closest('.icon-btn.confirm, .icon-btn.decline');
    if (!btn) {
      const delBtn = e.target.closest('[data-wkdelete]');
      if (!delBtn) return;
      const delId = delBtn.dataset.wkdelete;
      const ok = await showConfirm('Delete this workshop signup permanently?');
      if (!ok) return;
      delBtn.disabled = true;
      await fetch(`/api/admin/workshop-enrollments?id=${delId}`, { method: 'DELETE' });
      allWkEnrollments = allWkEnrollments.filter((x) => x.id !== delId);
      renderWkEnrollments();
      return;
    }
    const id = btn.dataset.wkid, status = btn.dataset.wkstatus;
    const ok = await showConfirm(`Mark this workshop signup as ${status === 'active' ? 'approved' : status}?`);
    if (!ok) return;
    btn.disabled = true;
    await fetch('/api/admin/workshop-enrollments', {
      method: 'PATCH', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id, status }),
    });
    const item = allWkEnrollments.find((x) => x.id === id);
    if (item) item.status = status;
    renderWkEnrollments();
  });

  wkEnrollExportBtn.addEventListener('click', () => {
    const header = ['Name', 'Email', 'Phone', 'Workshop', 'Amount (PKR)', 'Method', 'Submitted', 'Status'];
    const rows = allWkEnrollments.map((e) => [
      e.name, e.email, e.phone, e.workshop_title, e.amount_pkr, e.payment_method, e.created_at,
      e.status === 'active' ? 'confirmed' : e.status,
    ].map((v) => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','));
    const csv = [header.join(','), ...rows].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `workshop-signups-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // ===== Course Payment Requests =====
  let allPayReqs = [];
  let payReqFilter = 'all';
  const payReqBody = document.getElementById('payReqBody');
  const payReqTable = document.getElementById('payReqTable');
  const payReqLoadingMsg = document.getElementById('payReqLoadingMsg');
  const payReqEmptyMsg = document.getElementById('payReqEmptyMsg');
  const payReqSearchBox = document.getElementById('payReqSearchBox');
  const payReqFilters = document.getElementById('payReqFilters');

  async function loadCoursePaymentRequests() {
    payReqLoadingMsg.hidden = false;
    payReqTable.hidden = true;
    const res = await fetch('/api/admin/course-enrollments');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allPayReqs = data.requests || [];
    payReqLoadingMsg.hidden = true;
    renderPayReqs();
  }

  function statusBadgeClass(status) {
    return status === 'active' ? 'confirmed' : status;
  }

  function renderPayReqs() {
    const term = (payReqSearchBox.value || '').toLowerCase();
    const items = allPayReqs.filter((r) =>
      (payReqFilter === 'all' || r.status === payReqFilter) &&
      (!term || r.name.toLowerCase().includes(term) || r.email.toLowerCase().includes(term) || r.course_title.toLowerCase().includes(term))
    );
    payReqEmptyMsg.hidden = items.length > 0;
    payReqTable.hidden = items.length === 0;
    payReqBody.innerHTML = items.map((r) => `
      <tr>
        <td class="col-check"><input type="checkbox" class="payreq-row-check" data-selid="${r.id}" /></td>
        <td>${escapeHtml(r.name)}</td>
        <td>${escapeHtml(r.email)}</td>
        <td>${escapeHtml(r.course_title)}</td>
        <td>PKR ${escapeHtml(r.amount_pkr)}</td>
        <td>${escapeHtml(r.payment_method)}</td>
        <td>${formatDate(r.payment_submitted_at)}</td>
        <td><span class="status-badge ${statusBadgeClass(r.status)}">${r.status === 'active' ? 'confirmed' : r.status}</span></td>
        <td class="col-actions">
          <button class="icon-btn" data-shot="${r.id}" title="View screenshot">View</button>
          ${r.status !== 'active' ? `<button class="icon-btn confirm" data-payid="${r.id}" data-paystatus="active" title="Confirm">✓</button>` : ''}
          ${r.status !== 'declined' ? `<button class="icon-btn decline" data-payid="${r.id}" data-paystatus="declined" title="Decline">✕</button>` : ''}
          <button class="icon-btn delete" data-paydelete="${r.id}" title="Delete">🗑</button>
        </td>
      </tr>
    `).join('');
    payReqBulk.sync();
  }
  payReqSearchBox.addEventListener('input', renderPayReqs);
  const payReqBulk = makeBulkSelector({
    selectAllEl: document.getElementById('payReqSelectAll'),
    bulkBarEl: document.getElementById('payReqBulkBar'),
    bulkCountEl: document.getElementById('payReqBulkCount'),
    bulkDeleteBtn: document.getElementById('payReqBulkDelete'),
    rowCheckSelector: '.payreq-row-check',
    containerEl: payReqBody,
    getItems: () => allPayReqs,
    setItems: (v) => { allPayReqs = v; },
    idOf: (r) => r.id,
    deleteUrl: (id) => `/api/admin/enrollments?id=${id}`,
    confirmMsg: (n) => `Delete ${n} payment request(s) permanently? This does not affect any certificate already issued.`,
    render: renderPayReqs,
  });
  payReqFilters.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    payReqFilters.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    payReqFilter = btn.dataset.status || 'all';
    renderPayReqs();
  });

  payReqBody.addEventListener('click', async (e) => {
    const shotBtn = e.target.closest('[data-shot]');
    if (shotBtn) {
      const win = window.open('', '_blank');
      shotBtn.disabled = true;
      const originalText = shotBtn.textContent;
      shotBtn.textContent = 'Loading…';
      try {
        const res = await fetch(`/api/admin/course-screenshot/${shotBtn.dataset.shot}`, { credentials: 'same-origin' });
        if (!res.ok) throw new Error(`Server said ${res.status}`);
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        if (win) win.location.href = blobUrl;
      } catch (err) {
        if (win) win.close();
        window.alert(`Could not load the screenshot: ${err.message || err}`);
      } finally {
        shotBtn.disabled = false;
        shotBtn.textContent = originalText;
      }
      return;
    }
    const btn = e.target.closest('.icon-btn.confirm, .icon-btn.decline');
    if (!btn) {
      const delBtn = e.target.closest('[data-paydelete]');
      if (!delBtn) return;
      const delId = Number(delBtn.dataset.paydelete);
      const ok = await showConfirm('Delete this payment request permanently? This does not affect any certificate already issued.');
      if (!ok) return;
      delBtn.disabled = true;
      await fetch(`/api/admin/enrollments?id=${delId}`, { method: 'DELETE' });
      allPayReqs = allPayReqs.filter((r) => r.id !== delId);
      renderPayReqs();
      return;
    }
    const id = Number(btn.dataset.payid), status = btn.dataset.paystatus;
    const ok = await showConfirm(`Mark this course payment as ${status === 'active' ? 'confirmed' : status}?`);
    if (!ok) return;
    btn.disabled = true;
    await fetch('/api/admin/course-enrollments', {
      method: 'PATCH', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id, status }),
    });
    const reqItem = allPayReqs.find((r) => r.id === id);
    if (reqItem) reqItem.status = status;
    renderPayReqs();
  });

  // ===== Q&A =====
  let allQuestions = [];
  let qaFilter = 'pending';
  const qaCards = document.getElementById('qaCards');
  const qaLoadingMsg = document.getElementById('qaLoadingMsg');
  const qaEmptyMsg = document.getElementById('qaEmptyMsg');
  const qaSearchBox = document.getElementById('qaSearchBox');
  const qaFilters = document.getElementById('qaFilters');

  async function loadQuestions() {
    qaLoadingMsg.hidden = false;
    qaCards.hidden = true;
    const res = await fetch('/api/admin/questions');
    if (res.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await res.json();
    allQuestions = data.questions || [];
    qaLoadingMsg.hidden = true;
    renderQuestions();
  }

  function renderQuestions() {
    const term = (qaSearchBox.value || '').toLowerCase();
    const items = allQuestions.filter((q) =>
      (qaFilter === 'all' || q.status === qaFilter) &&
      (!term || q.name.toLowerCase().includes(term) || q.email.toLowerCase().includes(term) ||
        q.course_title.toLowerCase().includes(term) || q.question.toLowerCase().includes(term))
    );
    qaEmptyMsg.hidden = items.length > 0;
    qaCards.hidden = items.length === 0;
    qaCards.innerHTML = items.map((q) => `
      <div class="qa-card" data-id="${escapeHtml(q.id)}">
        <div class="qa-card__meta">
          <input type="checkbox" class="qa-row-check" data-selid="${escapeHtml(q.id)}" />
          <span class="status-badge ${q.status === 'published' ? 'confirmed' : q.status}">${q.status}</span>
          <span>${escapeHtml(q.name)} (${escapeHtml(q.email)})</span>
          <span>&middot; ${escapeHtml(q.course_title)}${q.step_title ? ' &middot; ' + escapeHtml(q.step_title) : ''}</span>
          <span>&middot; ${formatDate(q.created_at)}</span>
        </div>
        <p class="qa-card__question">${escapeHtml(q.question)}</p>
        ${q.status === 'published' ? `<p class="qa-card__answer">${escapeHtml(q.answer)}</p>` : ''}
        ${q.status === 'pending' ? `
          <textarea class="qa-answer-input" placeholder="Write your answer…"></textarea>
          <div class="qa-card__actions">
            <button class="btn btn--primary btn--small qa-publish">Publish answer</button>
            <button class="btn btn--text btn--small qa-decline">Decline</button>
            <button class="btn btn--text btn--small qa-delete">Delete</button>
          </div>
        ` : `
          <div class="qa-card__actions">
            <button class="btn btn--text btn--small qa-delete">Delete</button>
          </div>
        `}
      </div>
    `).join('');
    qaBulk.sync();
  }
  qaSearchBox.addEventListener('input', renderQuestions);
  const qaBulk = makeBulkSelector({
    selectAllEl: document.getElementById('qaSelectAll'),
    bulkBarEl: document.getElementById('qaBulkBar'),
    bulkCountEl: document.getElementById('qaBulkCount'),
    bulkDeleteBtn: document.getElementById('qaBulkDelete'),
    rowCheckSelector: '.qa-row-check',
    containerEl: qaCards,
    getItems: () => allQuestions,
    setItems: (v) => { allQuestions = v; },
    idOf: (q) => q.id,
    deleteUrl: (id) => `/api/admin/questions?id=${encodeURIComponent(id)}`,
    confirmMsg: (n) => `Delete ${n} question(s) permanently?`,
    render: renderQuestions,
  });
  qaFilters.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    qaFilters.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    qaFilter = btn.dataset.status || 'pending';
    renderQuestions();
  });

  qaCards.addEventListener('click', async (e) => {
    const card = e.target.closest('.qa-card');
    if (!card) return;
    const id = card.dataset.id;

    if (e.target.closest('.qa-publish')) {
      const answer = card.querySelector('.qa-answer-input').value.trim();
      if (!answer) { window.alert('Please write an answer before publishing.'); return; }
      await fetch('/api/admin/questions', {
        method: 'PATCH', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, status: 'published', answer }),
      });
      const q = allQuestions.find((x) => x.id === id);
      if (q) { q.status = 'published'; q.answer = answer; }
      renderQuestions();
      return;
    }
    if (e.target.closest('.qa-decline')) {
      const ok = await showConfirm('Decline this question without publishing it?');
      if (!ok) return;
      await fetch('/api/admin/questions', {
        method: 'PATCH', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, status: 'declined' }),
      });
      const q = allQuestions.find((x) => x.id === id);
      if (q) q.status = 'declined';
      renderQuestions();
      return;
    }
    if (e.target.closest('.qa-delete')) {
      const ok = await showConfirm('Delete this question permanently?');
      if (!ok) return;
      await fetch(`/api/admin/questions?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
      allQuestions = allQuestions.filter((x) => x.id !== id);
      renderQuestions();
    }
  });

  // ===== Certificates =====
  let allCertificates = [];
  const certBody = document.getElementById('certBody');
  const certTable = document.getElementById('certTable');
  const certLoadingMsg = document.getElementById('certLoadingMsg');
  const certEmptyMsg = document.getElementById('certEmptyMsg');
  const certSearchBox = document.getElementById('certSearchBox');
  const certExportBtn = document.getElementById('certExportBtn');

  // ---- Course Performance (table + chart above the certificates list) ----
  let allCourseStats = [];
  const perfState = { search: '', category: 'all', type: 'all', sortKey: 'enrolled_count', sortDir: 'desc' };
  const perfKpisEl = document.getElementById('perfKpis');
  const perfSearchBox = document.getElementById('perfSearchBox');
  const perfCategoryFilter = document.getElementById('perfCategoryFilter');
  const perfTypeFilters = document.getElementById('perfTypeFilters');
  const perfTable = document.getElementById('perfTable');
  const perfBody = document.getElementById('perfBody');
  const perfEmptyMsg = document.getElementById('perfEmptyMsg');
  const perfHistogramEl = document.getElementById('perfHistogram');
  const perfBoardTypeEl = document.getElementById('perfBoardType');
  const perfBoardMetricEl = document.getElementById('perfBoardMetric');
  const perfLeaderboardEl = document.getElementById('perfLeaderboard');
  let perfBoardType = 'free';
  let perfTooltipEl = null;

  // ---- Trends (Enrollments/Certificates/Revenue over time) ----
  const trendState = { metric: 'enrollments', granularity: 'month' };
  const trendCourseFilter = document.getElementById('trendCourseFilter');
  const trendMetricFilters = document.getElementById('trendMetricFilters');
  const trendGranFilters = document.getElementById('trendGranFilters');
  const trendChartEl = document.getElementById('trendChart');
  const trendEmptyMsg = document.getElementById('trendEmptyMsg');

  async function loadCertificates() {
    certLoadingMsg.hidden = false;
    certTable.hidden = true;
    // Enrollments are fetched alongside certificates (not just when the
    // Enrollments tab is visited) because the Trends chart below needs raw
    // enrolled_at/amount_pkr rows to plot time series, regardless of which
    // tab the admin opened first.
    const [certRes, enrollRes] = await Promise.all([
      fetch('/api/admin/certificates'),
      fetch('/api/admin/enrollments'),
    ]);
    if (certRes.status === 401 || enrollRes.status === 401) { window.location.href = '/dashboard/login'; return; }
    const data = await certRes.json();
    const enrollData = await enrollRes.json();
    allCertificates = data.certificates || [];
    allCourseStats = data.courseStats || [];
    allEnrollments = enrollData.enrollments || [];
    certLoadingMsg.hidden = true;
    populatePerfCategoryFilter();
    populateTrendCourseFilter();
    renderCoursePerf();
    renderCertificates();
  }

  function populateTrendCourseFilter() {
    const current = trendCourseFilter.value || 'all';
    const options = [...allCourseStats]
      .filter((s) => !s.draft)
      .sort((a, b) => a.course_title.localeCompare(b.course_title))
      .map((s) => `<option value="${escapeHtml(s.course_slug)}">${escapeHtml(s.course_title)}</option>`).join('');
    trendCourseFilter.innerHTML = '<option value="all">All courses (combined)</option>' + options;
    trendCourseFilter.value = [...trendCourseFilter.options].some((o) => o.value === current) ? current : 'all';
  }

  function populatePerfCategoryFilter() {
    const cats = Array.from(new Set(allCourseStats.map((s) => s.category_label || s.category).filter(Boolean))).sort();
    const current = perfCategoryFilter.value || 'all';
    perfCategoryFilter.innerHTML = '<option value="all">All categories</option>' +
      cats.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
    perfCategoryFilter.value = cats.includes(current) ? current : 'all';
    perfState.category = perfCategoryFilter.value;
  }

  function perfSortValue(s, key) {
    if (key === 'type') return s.is_paid ? 'paid' : 'free';
    if (key === 'pass_rate') return s.started_quiz_count > 0 ? s.passed_count / s.started_quiz_count : -1;
    if (key === 'course_title' || key === 'category_label') return (s[key] || '').toLowerCase();
    return s[key] ?? 0;
  }

  // Base filters (draft excluded, category + search) shared by the table,
  // histogram, and leaderboard. Type ("Free"/"Paid") is layered on top
  // differently by each: the table/histogram use the main toolbar's Type
  // filter, while the leaderboard has its own independent Free/Paid toggle.
  function getBaseFilteredCourses() {
    const term = (perfSearchBox.value || '').toLowerCase().trim();
    return allCourseStats.filter((s) => {
      if (s.draft) return false;
      if (perfState.category !== 'all' && (s.category_label || s.category) !== perfState.category) return false;
      if (term && !s.course_title.toLowerCase().includes(term)) return false;
      return true;
    });
  }

  function getFilteredCourses() {
    return getBaseFilteredCourses().filter((s) => {
      if (perfState.type === 'all') return true;
      return (s.is_paid ? 'paid' : 'free') === perfState.type;
    });
  }

  function sortCourseRows(rows) {
    const key = perfState.sortKey;
    const dir = perfState.sortDir === 'asc' ? 1 : -1;
    return [...rows].sort((a, b) => {
      const av = perfSortValue(a, key);
      const bv = perfSortValue(b, key);
      if (typeof av === 'string') return av.localeCompare(bv) * dir;
      return ((av ?? -Infinity) - (bv ?? -Infinity)) * dir;
    });
  }

  function kpiCard(label, value) {
    return `<div class="course-kpi-card"><div class="kpi-value">${value}</div><span class="kpi-label">${escapeHtml(label)}</span></div>`;
  }

  function renderPerfKpis(rows) {
    const totalEnrolled = rows.reduce((sum, s) => sum + s.enrolled_count, 0);
    const totalStarted = rows.reduce((sum, s) => sum + s.started_quiz_count, 0);
    const totalPassed = rows.reduce((sum, s) => sum + s.passed_count, 0);
    const overallPassRate = totalStarted > 0 ? Math.round((totalPassed / totalStarted) * 100) : null;
    const totalCerts = rows.reduce((sum, s) => sum + s.certificate_count, 0);
    const totalRevenue = rows.reduce((sum, s) => sum + (s.revenue_pkr || 0), 0);
    perfKpisEl.innerHTML = [
      kpiCard('Courses', rows.length),
      kpiCard('Enrolled', totalEnrolled),
      kpiCard('Pass rate', overallPassRate == null ? '—' : overallPassRate + '%'),
      kpiCard('Certificates', totalCerts),
      kpiCard('Revenue', formatPkr(totalRevenue)),
    ].join('');
  }

  function perfRowHtml(s) {
    const type = s.is_paid ? 'paid' : 'free';
    const passRate = s.started_quiz_count > 0 ? Math.round((s.passed_count / s.started_quiz_count) * 100) : null;
    const rateClass = passRate == null ? '' : passRate >= 80 ? 'perf-rate--high' : passRate >= 50 ? 'perf-rate--mid' : 'perf-rate--low';
    return `
      <tr data-course-slug="${escapeHtml(s.course_slug)}">
        <td>${escapeHtml(s.course_title)}${s.draft ? '<span class="draft-badge">Draft</span>' : ''}</td>
        <td>${escapeHtml(s.category_label || s.category || '—')}</td>
        <td><span class="type-badge type-badge--${type}">${type === 'paid' ? 'Paid' : 'Free'}</span></td>
        <td>${s.enrolled_count}</td>
        <td>${s.started_quiz_count}</td>
        <td>${s.passed_count}</td>
        <td>${passRate == null ? '—' : `<span class="perf-rate ${rateClass}">${passRate}%</span>`}</td>
        <td>${s.avg_score_percent != null ? s.avg_score_percent + '%' : '—'}</td>
        <td>${s.certificate_count}</td>
        <td>${s.dropped_count}</td>
        <td>${s.is_paid ? formatPkr(s.revenue_pkr) : '—'}</td>
        <td>${s.avg_satisfaction != null ? `${s.avg_satisfaction} / 5 <span style="color:var(--ink-600);">(${s.feedback_count})</span>` : '—'}</td>
      </tr>`;
  }

  function getPerfTooltip() {
    if (!perfTooltipEl) {
      perfTooltipEl = document.createElement('div');
      perfTooltipEl.className = 'perf-tooltip';
      document.body.appendChild(perfTooltipEl);
    }
    return perfTooltipEl;
  }
  function movePerfTooltip(e) {
    const el = getPerfTooltip();
    el.style.left = (e.clientX + 14) + 'px';
    el.style.top = (e.clientY + 14) + 'px';
  }
  function showPerfTooltip(e, r) {
    const rate = r.started_quiz_count > 0 ? Math.round((r.passed_count / r.started_quiz_count) * 100) : null;
    const el = getPerfTooltip();
    el.innerHTML = `<strong>${escapeHtml(r.course_title)}</strong>${r.enrolled_count} enrolled · ${rate == null ? '—' : rate + '%'} pass rate<br>${r.certificate_count} certificate(s)${r.is_paid ? ' · ' + formatPkr(r.revenue_pkr) : ''}`;
    el.classList.add('is-visible');
    movePerfTooltip(e);
  }
  function hidePerfTooltip() { if (perfTooltipEl) perfTooltipEl.classList.remove('is-visible'); }

  function highlightPerfRow(slug) {
    const row = perfBody.querySelector(`tr[data-course-slug="${CSS.escape(slug)}"]`);
    if (!row) return;
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
    row.classList.add('is-flash');
    setTimeout(() => row.classList.remove('is-flash'), 1200);
  }

  // ---- Histogram: fixed 11 buckets (no data + ten 10%-wide pass-rate
  // bands) no matter how many courses exist — only bar height changes as
  // the catalog grows. Height uses a sqrt scale so one dominant bucket
  // can't visually erase the smaller ones, and the exact count is always
  // printed above the bar regardless of how the height is compressed. ----
  function renderPerfHistogram(rows) {
    const buckets = [{ label: 'No attempts', free: 0, paid: 0 }];
    for (let i = 0; i < 10; i++) {
      buckets.push({ label: i === 9 ? '90–100%' : `${i * 10}–${i * 10 + 9}%`, free: 0, paid: 0 });
    }
    rows.forEach((s) => {
      const key = s.is_paid ? 'paid' : 'free';
      if (s.started_quiz_count === 0) { buckets[0][key]++; return; }
      const rate = Math.round((s.passed_count / s.started_quiz_count) * 100);
      const idx = Math.min(9, Math.floor(rate / 10));
      buckets[idx + 1][key]++;
    });
    const maxCount = Math.max(1, ...buckets.map((b) => b.free + b.paid));
    perfHistogramEl.innerHTML = buckets.map((b) => {
      const total = b.free + b.paid;
      const heightPct = total > 0 ? Math.max(3, Math.round((Math.sqrt(total) / Math.sqrt(maxCount)) * 100)) : 0;
      const freeShare = total > 0 ? (b.free / total) * 100 : 0;
      const paidShare = total > 0 ? (b.paid / total) * 100 : 0;
      return `
        <div class="perf-hist-col">
          <div class="perf-hist-count">${total || ''}</div>
          <div class="perf-hist-track">
            <div class="perf-hist-bar" style="height:${heightPct}%">
              ${b.paid > 0 ? `<div class="perf-hist-seg--paid" style="height:${paidShare}%"></div>` : ''}
              ${b.free > 0 ? `<div class="perf-hist-seg--free" style="height:${freeShare}%"></div>` : ''}
            </div>
          </div>
          <div class="perf-hist-label">${b.label}</div>
        </div>`;
    }).join('');
  }

  // ---- Leaderboard: always capped at 50 rows and scrolled, so it never
  // gets more cramped no matter how many courses exist. ----
  function getLeaderboardRows() {
    const base = getBaseFilteredCourses().filter((s) => (s.is_paid ? 'paid' : 'free') === perfBoardType);
    const metric = perfBoardMetricEl.value;
    const ranked = metric === 'pass_rate' ? base.filter((s) => s.started_quiz_count > 0) : base;
    const valueOf = (s) => metric === 'pass_rate' ? (s.passed_count / s.started_quiz_count) * 100 : (s[metric] || 0);
    return [...ranked].sort((a, b) => valueOf(b) - valueOf(a)).slice(0, 50).map((s) => ({ course: s, value: valueOf(s) }));
  }

  function formatBoardValue(metric, value) {
    if (metric === 'pass_rate') return Math.round(value) + '%';
    if (metric === 'revenue_pkr') return formatPkr(value);
    return Math.round(value).toLocaleString();
  }

  function renderPerfLeaderboard() {
    const metric = perfBoardMetricEl.value;
    const entries = getLeaderboardRows();
    if (entries.length === 0) {
      perfLeaderboardEl.innerHTML = `<p class="dash-empty" style="padding:20px 0;">No ${perfBoardType} courses match.</p>`;
      return;
    }
    const maxValue = Math.max(1, ...entries.map((e) => e.value));
    perfLeaderboardEl.innerHTML = entries.map((e, i) => {
      const s = e.course;
      const widthPct = Math.max(2, Math.round((e.value / maxValue) * 100));
      return `
        <div class="perf-lb-row" data-course-slug="${escapeHtml(s.course_slug)}">
          <div class="perf-lb-rank">${i + 1}</div>
          <div class="perf-lb-name" title="${escapeHtml(s.course_title)}">${escapeHtml(s.course_title)}</div>
          <div class="perf-lb-bar-track"><div class="perf-lb-bar perf-lb-bar--${perfBoardType}" style="width:${widthPct}%"></div></div>
          <div class="perf-lb-value">${formatBoardValue(metric, e.value)}</div>
        </div>`;
    }).join('');
    perfLeaderboardEl.querySelectorAll('.perf-lb-row').forEach((row) => {
      row.addEventListener('mouseenter', (e) => {
        const s = allCourseStats.find((c) => c.course_slug === row.dataset.courseSlug);
        if (s) showPerfTooltip(e, s);
      });
      row.addEventListener('mousemove', movePerfTooltip);
      row.addEventListener('mouseleave', hidePerfTooltip);
      row.addEventListener('click', () => highlightPerfRow(row.dataset.courseSlug));
    });
  }

  function updateBoardMetricOptions() {
    const revenueOpt = perfBoardMetricEl.querySelector('option[value="revenue_pkr"]');
    if (perfBoardType === 'free') {
      if (revenueOpt) revenueOpt.disabled = true;
      if (perfBoardMetricEl.value === 'revenue_pkr') perfBoardMetricEl.value = 'enrolled_count';
    } else if (revenueOpt) {
      revenueOpt.disabled = false;
    }
  }

  // ---- Trends: continuous time axis (equal spacing per bucket, gaps
  // filled with zero) so the line stays accurate and readable whether it
  // spans two weeks or several years — only point density changes. ----
  function trendBucketKey(dateStr, gran) {
    const d = (dateStr || '').slice(0, 10);
    if (gran === 'day') return d;
    if (gran === 'year') return d.slice(0, 4);
    return d.slice(0, 7);
  }
  function trendBucketLabel(key, gran) {
    if (gran === 'year') return key;
    if (gran === 'month') {
      const [y, m] = key.split('-');
      const names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      return `${names[Number(m) - 1]} ${y}`;
    }
    const dt = new Date(key + 'T00:00:00Z');
    return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: '2-digit', timeZone: 'UTC' });
  }
  function nextTrendKey(key, gran) {
    if (gran === 'year') return String(Number(key) + 1);
    if (gran === 'month') {
      const [y, m] = key.split('-').map(Number);
      const d = new Date(Date.UTC(y, m - 1 + 1, 1));
      return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
    }
    const d = new Date(key + 'T00:00:00Z');
    d.setUTCDate(d.getUTCDate() + 1);
    return d.toISOString().slice(0, 10);
  }

  function getTrendScopeSlugs() {
    const inScope = new Set(getFilteredCourses().map((s) => s.course_slug));
    const picked = trendCourseFilter.value;
    return picked !== 'all' ? new Set([picked]) : inScope;
  }

  function buildTrendSeries() {
    const scope = getTrendScopeSlugs();
    const gran = trendState.granularity;
    const buckets = new Map();
    if (trendState.metric === 'enrollments') {
      allEnrollments.forEach((e) => {
        if (!scope.has(e.course_slug) || !e.enrolled_at) return;
        const key = trendBucketKey(e.enrolled_at, gran);
        buckets.set(key, (buckets.get(key) || 0) + 1);
      });
    } else if (trendState.metric === 'certificates') {
      allCertificates.forEach((c) => {
        if (!scope.has(c.course_slug) || !c.issued_at) return;
        const key = trendBucketKey(c.issued_at, gran);
        buckets.set(key, (buckets.get(key) || 0) + 1);
      });
    } else {
      allEnrollments.forEach((e) => {
        if (!scope.has(e.course_slug) || e.amount_pkr == null || e.status !== 'active') return;
        const dateSrc = e.reviewed_at || e.enrolled_at;
        if (!dateSrc) return;
        const key = trendBucketKey(dateSrc, gran);
        buckets.set(key, (buckets.get(key) || 0) + e.amount_pkr);
      });
    }
    const keys = [...buckets.keys()].sort();
    if (keys.length === 0) return [];
    const filled = [];
    let cursor = keys[0];
    const end = keys[keys.length - 1];
    let guard = 0;
    while (cursor <= end && guard < 20000) {
      filled.push({ key: cursor, label: trendBucketLabel(cursor, gran), value: buckets.get(cursor) || 0 });
      cursor = nextTrendKey(cursor, gran);
      guard++;
    }
    return filled;
  }

  function renderTrendChart() {
    const points = buildTrendSeries();
    trendEmptyMsg.hidden = points.length > 0;
    if (points.length === 0) { trendChartEl.innerHTML = ''; return; }

    const W = 900, H = 260, ML = 52, MR = 16, MT = 16, MB = 34;
    const PW = W - ML - MR, PH = H - MT - MB;
    const maxVal = Math.max(1, ...points.map((p) => p.value));
    const n = points.length;
    const xPos = (i) => (n === 1 ? ML + PW / 2 : ML + (i / (n - 1)) * PW);
    const yPos = (v) => MT + (1 - v / maxVal) * PH;
    const color = trendState.metric === 'revenue' ? '#C7A44A' : trendState.metric === 'certificates' ? '#3f5c47' : '#1C314C';

    let svg = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img" aria-label="Trend over time">`;
    const yTickCount = 4;
    for (let t = 0; t <= yTickCount; t++) {
      const val = (maxVal / yTickCount) * t;
      const y = yPos(val);
      svg += `<line x1="${ML}" y1="${y.toFixed(1)}" x2="${W - MR}" y2="${y.toFixed(1)}" stroke="rgba(19,26,34,0.08)" stroke-width="1" />`;
      const label = trendState.metric === 'revenue' ? formatPkrShort(val) : Math.round(val);
      svg += `<text x="${ML - 8}" y="${(y + 3).toFixed(1)}" text-anchor="end" font-size="9.5" fill="#5d6b78" font-family="var(--font-mono)">${label}</text>`;
    }
    const labelCount = Math.min(6, n);
    for (let i = 0; i < labelCount; i++) {
      const idx = Math.round((i / Math.max(1, labelCount - 1)) * (n - 1));
      const x = xPos(idx);
      svg += `<text x="${x.toFixed(1)}" y="${H - MB + 16}" text-anchor="middle" font-size="9.5" fill="#5d6b78" font-family="var(--font-mono)">${escapeHtml(points[idx].label)}</text>`;
    }
    const pathD = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${xPos(i).toFixed(1)} ${yPos(p.value).toFixed(1)}`).join(' ');
    const areaD = `${pathD} L ${xPos(n - 1).toFixed(1)} ${(MT + PH).toFixed(1)} L ${xPos(0).toFixed(1)} ${(MT + PH).toFixed(1)} Z`;
    svg += `<path d="${areaD}" fill="${color}" fill-opacity="0.08" stroke="none" />`;
    svg += `<path d="${pathD}" fill="none" stroke="${color}" stroke-width="2" />`;
    svg += `<circle id="trendHoverDot" cx="-10" cy="-10" r="4" fill="${color}" stroke="#fff" stroke-width="1.5" style="display:none" />`;
    svg += `<rect x="${ML}" y="${MT}" width="${PW}" height="${PH}" fill="transparent" id="trendHoverRect" style="cursor:crosshair" />`;
    svg += `</svg>`;
    trendChartEl.innerHTML = svg;

    const svgEl = trendChartEl.querySelector('svg');
    const hoverRect = trendChartEl.querySelector('#trendHoverRect');
    const hoverDot = trendChartEl.querySelector('#trendHoverDot');
    hoverRect.addEventListener('mousemove', (e) => {
      const rect = svgEl.getBoundingClientRect();
      const localX = (e.clientX - rect.left) * (W / rect.width);
      const idx = Math.max(0, Math.min(n - 1, Math.round(((localX - ML) / PW) * (n - 1))));
      const p = points[idx];
      hoverDot.setAttribute('cx', xPos(idx).toFixed(1));
      hoverDot.setAttribute('cy', yPos(p.value).toFixed(1));
      hoverDot.style.display = '';
      const el = getPerfTooltip();
      const valueLabel = trendState.metric === 'revenue' ? formatPkr(p.value) : `${p.value} ${trendState.metric === 'certificates' ? 'certificate(s)' : 'enrollment(s)'}`;
      el.innerHTML = `<strong>${escapeHtml(p.label)}</strong>${valueLabel}`;
      el.classList.add('is-visible');
      movePerfTooltip(e);
    });
    hoverRect.addEventListener('mouseleave', () => { hoverDot.style.display = 'none'; hidePerfTooltip(); });
  }

