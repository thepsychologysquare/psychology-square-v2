---
export const prerender = false;
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { getSession } from '../../../lib/adminAuth';
import { getWorkshopBySlug } from '../../../lib/workshops';
import { listWorkshopCategories } from '../../../lib/workshopCategories';

const session = await getSession(Astro.request.headers.get('cookie'), env?.ADMIN_SESSION_SECRET || '');
if (!session) return Astro.redirect('/dashboard/login');

const { slug } = Astro.params;
const workshop = slug ? await getWorkshopBySlug(env, slug) : undefined;
if (!workshop) return Astro.redirect('/dashboard/workshops');

const categories = await listWorkshopCategories(env);

const { results: enrollments } = await env.DB.prepare(
  `SELECT id, name, email, phone, notes, status, amount_pkr, payment_method, screenshot_type, created_at, reviewed_at
   FROM workshop_enrollments WHERE workshop_slug = ? ORDER BY created_at DESC`
).bind(workshop.slug).all();
---
<DashboardLayout title={workshop.title} backHref="/dashboard/workshops" backLabel="All workshops">
  <Fragment slot="header">
    <header class="studio-header">
      <div class="studio-header__row">
        <div class="studio-header__title">
          <span class="eyebrow">Workshop</span>
          <h1>{workshop.title}</h1>
          <span class={`badge ${workshop.draft ? 'badge--draft' : 'badge--published'}`} id="statusBadge">
            {workshop.draft ? 'Draft' : 'Published'}
          </span>
        </div>
        <div class="studio-header__actions">
          <button type="button" class="btn btn--primary" id="togglePublishBtn">
            {workshop.draft ? 'Publish' : 'Unpublish'}
          </button>
          <button type="button" class="btn btn--danger" id="deleteWorkshopBtn">Delete workshop</button>
        </div>
      </div>
    </header>
  </Fragment>

  <main class="wrap edit-main">
    <section class="panel">
      <h2>Details</h2>
      <form id="editForm" class="edit-form">
        <div class="field">
          <label for="title">Title</label>
          <input type="text" id="title" value={workshop.title} required />
        </div>
        <div class="field">
          <label for="description">Description</label>
          <textarea id="description" rows="3">{workshop.description}</textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="category">Topic</label>
            <select id="category">
              {categories.map((c) => (
                <option value={c.value} selected={c.value === workshop.category}>{c.label}</option>
              ))}
            </select>
            <button type="button" class="add-topic-link" id="addTopicLink">+ Add a new topic</button>
            <div class="add-topic-row" id="addTopicRow" hidden>
              <input type="text" id="newTopicInput" placeholder="e.g. Grief" />
              <button type="button" class="btn btn--ghost btn--small" id="addTopicBtn">Add</button>
              <button type="button" class="btn btn--ghost btn--small" id="cancelTopicBtn">Cancel</button>
            </div>
            <p class="field-error" id="addTopicError" role="alert" hidden></p>
          </div>
          <div class="field">
            <label for="instructor">Instructor</label>
            <select id="instructor">
              <option value="sohail" selected={workshop.instructor === 'sohail'}>Muhammad Sohail</option>
              <option value="sehar" selected={workshop.instructor === 'sehar'}>Sehar Waheed</option>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field field--narrow">
            <label for="pricePkr">Price (PKR)</label>
            <input type="number" id="pricePkr" min="0" value={workshop.price_pkr} />
          </div>
          <div class="field field--narrow">
            <label for="minSeats">Min. seats</label>
            <input type="number" id="minSeats" min="1" value={workshop.min_seats} />
          </div>
          <div class="field field--narrow">
            <label for="maxSeats">Max. seats</label>
            <input type="number" id="maxSeats" min="1" value={workshop.max_seats ?? ''} placeholder="No cap" />
          </div>
        </div>
        <div class="field">
          <label for="scheduledAt">Tentative date &amp; time <span class="field-optional">(optional — shown to visitors as tentative; message enrollees the exact plan and Meet link yourself once it's settled)</span></label>
          <input type="text" id="scheduledAt" value={workshop.scheduled_at ?? ''} placeholder="e.g. Sat, 6 Sep 2026, 7:00 PM PKT (tentative)" />
        </div>
        <p class="form-error" id="editError" role="alert" hidden></p>
        <p class="form-success" id="editSuccess" hidden>Saved ✓</p>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary" id="saveBtn">Save changes</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <h2>Enrollments ({enrollments.length})</h2>
      {enrollments.length === 0 ? (
        <p class="empty-note">No signups yet.</p>
      ) : (
        <table class="enroll-table">
          <thead>
            <tr><th>Name</th><th>Contact</th><th>Amount</th><th>Method</th><th>Status</th><th>Receipt</th><th>Action</th></tr>
          </thead>
          <tbody id="enrollTableBody">
            {enrollments.map((e: any) => (
              <tr data-id={e.id}>
                <td>{e.name}{e.notes && <><br/><span class="row-note">{e.notes}</span></>}</td>
                <td>{e.email}<br/><span class="row-note">{e.phone}</span></td>
                <td>Rs. {e.amount_pkr}</td>
                <td>{e.payment_method}</td>
                <td><span class={`status-pill status-pill--${e.status}`}>{e.status}</span></td>
                <td><a href={`/api/admin/workshop-screenshot/${e.id}`} target="_blank" rel="noopener">View</a></td>
                <td class="row-actions">
                  {e.status === 'pending' && (
                    <>
                      <button type="button" class="btn-mini btn-mini--approve" data-action="active" data-id={e.id}>Approve</button>
                      <button type="button" class="btn-mini btn-mini--decline" data-action="declined" data-id={e.id}>Decline</button>
                    </>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  </main>
</DashboardLayout>

<style>
  .studio-header { background: var(--navy-950); color: #fff; padding: 18px 0; }
  .studio-header__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 0 24px; }
  .studio-header__title { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .eyebrow { display: none; }
  h1 { font-family: var(--font-display); font-size: 21px; margin: 0; color: #fff; }
  .studio-header__actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .autosave-status { font-size: 12.5px; color: rgba(255,255,255,0.55); }

  .badge { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 3px 9px; border-radius: 20px; }
  .badge--draft { background: rgba(199,164,74,0.24); color: #e3c469; }
  .badge--published { background: rgba(124,152,133,0.28); color: #b7d6bf; }

  .btn { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 13.5px; padding: 8px 16px; border-radius: 7px; text-decoration: none; border: none; cursor: pointer; transition: all 0.15s; }
  .btn--primary { background: var(--gold-500); color: var(--navy-950); }
  .btn--primary:hover { background: var(--gold-300); }
  .btn--ghost { background: rgba(255,255,255,0.08); color: #fff; }
  .btn--ghost:hover { background: rgba(255,255,255,0.16); }
  .btn--danger { background: rgba(211,90,90,0.18); color: #f2a8a8; }
  .btn--danger:hover { background: rgba(211,90,90,0.3); }
  .btn--small { padding: 6px 12px; font-size: 12.5px; }

  .edit-main { padding: 24px 0 96px; max-width: 820px; display: grid; gap: 24px; }

  .panel { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 24px 28px; }
  .panel h2 { font-family: var(--font-display); font-size: 18px; margin: 0 0 16px; color: var(--navy-950); }

  .edit-form { display: grid; gap: 16px; }
  .field { display: grid; gap: 6px; min-width: 0; }
  .field-row { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-start; }
  .field-row .field { flex: 1; min-width: 140px; }
  .field--narrow { flex: 1 1 160px; max-width: 200px; }
  label { font-size: 13.5px; font-weight: 600; color: var(--navy-950); }
  .field-optional { font-weight: 400; color: var(--ink-600); }
  input[type="text"], input[type="number"], input[type="url"], select, textarea {
    padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; font-size: 14.5px;
    width: 100%; box-sizing: border-box;
  }
  textarea { resize: vertical; }

  .add-topic-link { background: none; border: none; padding: 0; margin-top: 2px; font-size: 12.5px; color: var(--navy-700); font-weight: 600; cursor: pointer; text-align: left; }
  .add-topic-link:hover { text-decoration: underline; }
  .add-topic-row { display: flex; gap: 8px; margin-top: 4px; }
  .add-topic-row input { flex: 1; min-width: 0; }
  .field-error { color: #B3261E; font-size: 12.5px; margin: 2px 0 0; }

  .form-error { color: #B3261E; font-size: 13.5px; margin: 0; }
  .form-success { color: #3d5b46; font-size: 13.5px; margin: 0; }
  .form-actions { display: flex; justify-content: flex-end; gap: 10px; }
  .form-actions .btn { font-size: 14.5px; padding: 11px 20px; }
  .form-actions .btn--primary { background: var(--navy-950); color: #fff; }
  .form-actions .btn--primary:hover { background: var(--navy-700); }

  .empty-note { color: var(--ink-600); font-size: 14px; }
  .enroll-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .enroll-table th { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); color: var(--ink-600); font-weight: 600; }
  .enroll-table td { padding: 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .row-note { color: var(--ink-600); font-size: 12px; }
  .row-actions { white-space: nowrap; }
  .btn-mini { font-size: 12px; font-weight: 600; padding: 6px 10px; border-radius: 6px; border: none; cursor: pointer; margin-right: 6px; }
  .btn-mini--approve { background: rgba(124,152,133,0.18); color: #3d5b46; }
  .btn-mini--decline { background: rgba(163,51,51,0.12); color: #a33; }

  .status-pill { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 3px 10px; border-radius: 20px; }
  .status-pill--active { background: rgba(124,152,133,0.18); color: #3d5b46; }
  .status-pill--declined { background: rgba(163,51,51,0.12); color: #a33; }
  .status-pill--pending { background: rgba(199,164,74,0.2); color: #8a6d1f; }

  @media (max-width: 640px) {
    .studio-header__row { align-items: stretch; }
    .studio-header__actions { width: 100%; }
    .studio-header__actions .btn { flex: 1; justify-content: center; }
    .panel { padding: 18px; }
    .field-row { flex-direction: column; align-items: stretch; }
    .field--narrow { max-width: none; }
    .enroll-table { display: block; overflow-x: auto; }
  }
</style>

<script define:vars={{ slug: workshop.slug, initialDraft: !!workshop.draft, workshopTitle: workshop.title }}>
  const editForm = document.getElementById('editForm');
  const editError = document.getElementById('editError');
  const editSuccess = document.getElementById('editSuccess');
  const saveBtn = document.getElementById('saveBtn');
  const categorySelect = document.getElementById('category');

  editForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    editError.hidden = true;
    editSuccess.hidden = true;
    saveBtn.disabled = true;
    const get = (id) => document.getElementById(id).value;
    try {
      const res = await fetch('/api/admin/workshops', {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          slug,
          title: get('title'),
          description: get('description'),
          category: get('category'),
          instructor: get('instructor'),
          pricePkr: parseFloat(get('pricePkr')) || 0,
          minSeats: parseInt(get('minSeats'), 10) || undefined,
          maxSeats: get('maxSeats') ? parseInt(get('maxSeats'), 10) : null,
          scheduledAt: get('scheduledAt').trim() || null,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong.');
      editSuccess.hidden = false;
      setTimeout(() => { editSuccess.hidden = true; }, 2000);
    } catch (err) {
      editError.textContent = err.message || 'Something went wrong.';
      editError.hidden = false;
    } finally {
      saveBtn.disabled = false;
    }
  });

  // ---------- Add a new topic inline ----------
  const addTopicLink = document.getElementById('addTopicLink');
  const addTopicRow = document.getElementById('addTopicRow');
  const newTopicInput = document.getElementById('newTopicInput');
  const addTopicBtn = document.getElementById('addTopicBtn');
  const cancelTopicBtn = document.getElementById('cancelTopicBtn');
  const addTopicError = document.getElementById('addTopicError');

  addTopicLink.addEventListener('click', () => {
    addTopicLink.hidden = true;
    addTopicRow.hidden = false;
    newTopicInput.focus();
  });
  cancelTopicBtn.addEventListener('click', () => {
    addTopicRow.hidden = true;
    addTopicLink.hidden = false;
    addTopicError.hidden = true;
    newTopicInput.value = '';
  });
  addTopicBtn.addEventListener('click', async () => {
    const label = newTopicInput.value.trim();
    addTopicError.hidden = true;
    if (!label) { addTopicError.textContent = 'Please enter a topic name.'; addTopicError.hidden = false; return; }
    addTopicBtn.disabled = true;
    try {
      const res = await fetch('/api/admin/workshop-categories', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ label }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not add that topic.');
      const opt = document.createElement('option');
      opt.value = data.category.value;
      opt.textContent = data.category.label;
      categorySelect.appendChild(opt);
      categorySelect.value = data.category.value;
      addTopicRow.hidden = true;
      addTopicLink.hidden = false;
      newTopicInput.value = '';
    } catch (err) {
      addTopicError.textContent = err.message || 'Could not add that topic.';
      addTopicError.hidden = false;
    } finally {
      addTopicBtn.disabled = false;
    }
  });

  // ---------- Publish toggle ----------
  let draft = initialDraft;
  const togglePublishBtn = document.getElementById('togglePublishBtn');
  const statusBadgeEl = document.getElementById('statusBadge');
  togglePublishBtn.addEventListener('click', async () => {
    const nextDraft = !draft;
    togglePublishBtn.disabled = true;
    const res = await fetch('/api/admin/workshops', {
      method: 'PATCH', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug, draft: nextDraft }),
    });
    if (res.ok) {
      draft = nextDraft;
      togglePublishBtn.textContent = nextDraft ? 'Publish' : 'Unpublish';
      statusBadgeEl.textContent = nextDraft ? 'Draft' : 'Published';
      statusBadgeEl.className = `badge ${nextDraft ? 'badge--draft' : 'badge--published'}`;
    } else {
      window.alert('Could not update the publish status. Please try again.');
    }
    togglePublishBtn.disabled = false;
  });

  // ---------- Delete workshop (cascades: enrollments + their screenshots) ----------
  const deleteWorkshopBtn = document.getElementById('deleteWorkshopBtn');
  deleteWorkshopBtn.addEventListener('click', async () => {
    const typed = window.prompt(
      `This permanently deletes "${workshopTitle}" and everything tied to it — every signup and receipt. This cannot be undone.\n\nType the workshop title to confirm:`
    );
    if (typed === null) return;
    if (typed.trim() !== workshopTitle) {
      window.alert('That didn\'t match the workshop title — nothing was deleted.');
      return;
    }
    deleteWorkshopBtn.disabled = true;
    deleteWorkshopBtn.textContent = 'Deleting…';
    try {
      const res = await fetch(`/api/admin/workshops?slug=${encodeURIComponent(slug)}`, { method: 'DELETE' });
      if (!res.ok) throw new Error('Delete failed');
      window.location.href = '/dashboard/workshops';
    } catch {
      window.alert('Could not delete the workshop. Please try again.');
      deleteWorkshopBtn.disabled = false;
      deleteWorkshopBtn.textContent = 'Delete workshop';
    }
  });

  document.getElementById('enrollTableBody')?.addEventListener('click', async (e) => {
    const btn = e.target.closest('.btn-mini');
    if (!btn) return;
    const id = btn.dataset.id;
    const status = btn.dataset.action;
    btn.closest('tr').style.opacity = '0.5';
    const res = await fetch('/api/admin/workshop-enrollments', {
      method: 'PATCH',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id, status }),
    });
    if (res.ok) location.reload();
    else btn.closest('tr').style.opacity = '1';
  });
</script>
