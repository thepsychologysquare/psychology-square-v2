---
export const prerender = false;
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { getSession } from '../../../lib/adminAuth';
import { WORKSHOP_MIN_SEATS_DEFAULT } from '../../../lib/workshops';
import { listWorkshopCategories } from '../../../lib/workshopCategories';

const session = await getSession(Astro.request.headers.get('cookie'), env?.ADMIN_SESSION_SECRET || '');
if (!session) return Astro.redirect('/dashboard/login');

const categories = await listWorkshopCategories(env);
---
<DashboardLayout title="New workshop" backHref="/dashboard/workshops" backLabel="All workshops">
  <Fragment slot="header">
    <header class="new-header">
      <div class="wrap">
        <span class="eyebrow">Workshops</span>
        <h1>New workshop</h1>
        <p class="new-hint">Fill in the basics. It saves as a draft — flip "Published" once you're ready for people to sign up.</p>
      </div>
    </header>
  </Fragment>

  <main class="wrap new-main">
    <form id="newWorkshopForm" class="new-form">
      <div class="field">
        <label for="title">Title</label>
        <input type="text" id="title" required placeholder="e.g. Managing Anxiety at Work" autofocus />
      </div>

      <div class="field">
        <label for="description">Description <span class="field-optional">(shows on the workshop card and detail page)</span></label>
        <textarea id="description" rows="3" placeholder="One or two sentences describing what this workshop covers." required></textarea>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="category">Topic</label>
          <select id="category">
            {categories.map((c) => (
              <option value={c.value}>{c.label}</option>
            ))}
          </select>
          <button type="button" class="add-topic-link" id="addTopicLink">+ Add a new topic</button>
          <div class="add-topic-row" id="addTopicRow" hidden>
            <input type="text" id="newTopicInput" placeholder="e.g. Grief" />
            <button type="button" class="btn btn--ghost btn--small" id="addTopicBtn">Add</button>
            <button type="button" class="btn btn--ghost btn--small" id="cancelTopicBtn">Cancel</button>
          </div>
          <p class="field-error" id="addTopicError" role="alert" hidden></p>
        </div>
        <div class="field">
          <label for="instructor">Instructor</label>
          <select id="instructor">
            <option value="sohail">Muhammad Sohail</option>
            <option value="sehar">Sehar Waheed</option>
          </select>
        </div>
      </div>

      <div class="field-row">
        <div class="field field--narrow">
          <label for="pricePkr">Price (PKR)</label>
          <input type="number" id="pricePkr" min="0" required />
        </div>
        <div class="field field--narrow">
          <label for="minSeats">Min. seats to run</label>
          <input type="number" id="minSeats" min="1" value={WORKSHOP_MIN_SEATS_DEFAULT} />
        </div>
        <div class="field field--narrow">
          <label for="maxSeats">Max. seats <span class="field-optional">(optional)</span></label>
          <input type="number" id="maxSeats" min="1" placeholder="No cap" />
        </div>
      </div>

      <div class="field">
        <label for="scheduledAt">Tentative date &amp; time <span class="field-optional">(optional — shown to visitors as tentative; message enrollees the exact plan and Meet link yourself once it's settled)</span></label>
        <input type="text" id="scheduledAt" placeholder="e.g. Sat, 6 Sep 2026, 7:00 PM PKT (tentative)" />
      </div>

      <div class="field">
        <label>Cover image <span class="field-optional">(optional)</span></label>
        <div class="image-upload">
          <img class="cover-preview" id="imagePreview" alt="" hidden />
          <div class="image-upload__controls">
            <input type="file" id="imageFile" accept="image/*" />
            <button type="button" class="remove-image-link" id="removeImageBtn" hidden>Remove image</button>
          </div>
        </div>
        <p class="field-hint" id="imageStatus"></p>
      </div>

      <p class="form-error" id="formError" role="alert" hidden></p>

      <div class="form-actions">
        <a href="/dashboard/workshops" class="btn btn--ghost">Cancel</a>
        <button type="submit" class="btn btn--primary" id="createBtn">Create workshop &rarr;</button>
      </div>
    </form>
  </main>
</DashboardLayout>

<style>
  .new-header { padding: 20px 0 8px; }
  .eyebrow { display: block; font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-500); margin-bottom: 4px; }
  h1 { font-family: var(--font-display); font-size: 28px; margin: 0 0 6px; color: var(--navy-950); }
  .new-hint { color: var(--ink-600); margin: 0; font-size: 14.5px; max-width: 60ch; }
  .new-main { padding: 24px 0 96px; max-width: 720px; }

  .new-form { display: grid; gap: 20px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 28px; }
  .field { display: grid; gap: 6px; min-width: 0; align-content: start; }
  .field-row { display: flex; gap: 16px; flex-wrap: wrap; align-items: start; }
  .field-row .field { flex: 1; min-width: 160px; }
  .field--narrow { flex: 1 1 180px; max-width: 220px; }
  label { font-size: 13.5px; font-weight: 600; color: var(--navy-950); }
  .field-optional { font-weight: 400; color: var(--ink-600); }
  .field-hint { margin: 2px 0 0; font-size: 12.5px; color: var(--ink-600); }

  .image-upload { display: grid; gap: 10px; }
  .cover-preview { max-width: 220px; max-height: 160px; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); display: block; }
  .image-upload__controls { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .remove-image-link { background: none; border: none; padding: 0; font-size: 12.5px; color: #B3261E; font-weight: 600; cursor: pointer; text-align: left; }
  .remove-image-link:hover { text-decoration: underline; }

  .add-topic-link { background: none; border: none; padding: 0; margin-top: 2px; font-size: 12.5px; color: var(--navy-700); font-weight: 600; cursor: pointer; text-align: left; }
  .add-topic-link:hover { text-decoration: underline; }
  .add-topic-row { display: flex; gap: 8px; margin-top: 4px; }
  .add-topic-row input { flex: 1; min-width: 0; }
  .field-error { color: #B3261E; font-size: 12.5px; margin: 2px 0 0; }

  input[type="text"], input[type="number"], select, textarea {
    padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; font-size: 14.5px;
    background: var(--paper-0); color: var(--ink-900); width: 100%; box-sizing: border-box;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--navy-950); background: #fff; }
  textarea { resize: vertical; font-family: var(--font-body); }
  input[type="file"] { font-size: 13.5px; }

  .form-error { color: #B3261E; font-size: 13.5px; margin: 0; }
  .form-actions { display: flex; justify-content: flex-end; gap: 10px; }
  .btn { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14.5px; padding: 11px 20px; border-radius: 8px; text-decoration: none; border: none; cursor: pointer; transition: all 0.15s; }
  .btn--primary { background: var(--navy-950); color: #fff; }
  .btn--primary:hover { background: var(--navy-700); }
  .btn--primary:disabled { opacity: 0.6; cursor: wait; }
  .btn--ghost { background: transparent; color: var(--ink-600); border: 1px solid var(--line); }
  .btn--ghost:hover { border-color: var(--navy-950); color: var(--navy-950); }
  .btn--small { padding: 6px 12px; font-size: 12.5px; }

  @media (max-width: 640px) {
    .new-main { padding: 16px 0 64px; }
    .new-form { padding: 18px; border-radius: 10px; gap: 16px; }
    .field-row { flex-direction: column; }
    .field--narrow { max-width: none; }
    .form-actions { flex-direction: column-reverse; }
    .form-actions .btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  const imageFile = document.getElementById('imageFile') as HTMLInputElement;
  const imageStatus = document.getElementById('imageStatus') as HTMLElement;
  const imagePreview = document.getElementById('imagePreview') as HTMLImageElement;
  const removeImageBtn = document.getElementById('removeImageBtn') as HTMLButtonElement;
  const form = document.getElementById('newWorkshopForm') as HTMLFormElement;
  const errorEl = document.getElementById('formError') as HTMLElement;
  const createBtn = document.getElementById('createBtn') as HTMLButtonElement;
  const categorySelect = document.getElementById('category') as HTMLSelectElement;

  // ---------- Add a new topic inline ----------
  const addTopicLink = document.getElementById('addTopicLink') as HTMLButtonElement;
  const addTopicRow = document.getElementById('addTopicRow') as HTMLElement;
  const newTopicInput = document.getElementById('newTopicInput') as HTMLInputElement;
  const addTopicBtn = document.getElementById('addTopicBtn') as HTMLButtonElement;
  const cancelTopicBtn = document.getElementById('cancelTopicBtn') as HTMLButtonElement;
  const addTopicError = document.getElementById('addTopicError') as HTMLElement;

  addTopicLink.addEventListener('click', () => {
    addTopicLink.hidden = true;
    addTopicRow.hidden = false;
    newTopicInput.focus();
  });
  cancelTopicBtn.addEventListener('click', () => {
    addTopicRow.hidden = true;
    addTopicLink.hidden = false;
    addTopicError.hidden = true;
    newTopicInput.value = '';
  });
  addTopicBtn.addEventListener('click', async () => {
    const label = newTopicInput.value.trim();
    addTopicError.hidden = true;
    if (!label) { addTopicError.textContent = 'Please enter a topic name.'; addTopicError.hidden = false; return; }
    addTopicBtn.disabled = true;
    try {
      const res = await fetch('/api/admin/workshop-categories', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ label }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not add that topic.');
      const opt = document.createElement('option');
      opt.value = data.category.value;
      opt.textContent = data.category.label;
      categorySelect.appendChild(opt);
      categorySelect.value = data.category.value;
      addTopicRow.hidden = true;
      addTopicLink.hidden = false;
      newTopicInput.value = '';
    } catch (err: any) {
      addTopicError.textContent = err.message || 'Could not add that topic.';
      addTopicError.hidden = false;
    } finally {
      addTopicBtn.disabled = false;
    }
  });

  const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
  const ALLOWED_IMAGE_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/gif']);

  let uploadedImageUrl = '';
  imageFile.addEventListener('change', async () => {
    const file = imageFile.files?.[0];
    if (!file) return;
    uploadedImageUrl = '';
    if (!ALLOWED_IMAGE_TYPES.has(file.type)) {
      imageStatus.textContent = `"${file.name}" isn't a supported image type. Please use JPG, PNG, WebP, or GIF.`;
      imageFile.value = '';
      return;
    }
    if (file.size > MAX_IMAGE_BYTES) {
      imageStatus.textContent = `"${file.name}" is too large (${(file.size / (1024 * 1024)).toFixed(1)}MB). Please use an image under 5MB.`;
      imageFile.value = '';
      return;
    }
    imageStatus.textContent = 'Uploading...';
    const fd = new FormData();
    fd.append('image', file);
    try {
      const res = await fetch('/api/admin/course-image', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Upload failed');
      uploadedImageUrl = data.url;
      imagePreview.src = data.url;
      imagePreview.hidden = false;
      removeImageBtn.hidden = false;
      imageStatus.textContent = 'Image uploaded ✓';
    } catch (err: any) {
      imageStatus.textContent = err.message || 'Upload failed — you can still save without an image.';
    }
  });

  removeImageBtn.addEventListener('click', () => {
    uploadedImageUrl = '';
    imageFile.value = '';
    imagePreview.src = '';
    imagePreview.hidden = true;
    removeImageBtn.hidden = true;
    imageStatus.textContent = '';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    createBtn.disabled = true;
    createBtn.textContent = 'Creating...';

    const get = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
    try {
      const res = await fetch('/api/admin/workshops', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          title: get('title'),
          description: get('description'),
          category: get('category'),
          instructor: get('instructor'),
          pricePkr: parseFloat(get('pricePkr')) || 0,
          minSeats: parseInt(get('minSeats'), 10) || undefined,
          maxSeats: get('maxSeats') ? parseInt(get('maxSeats'), 10) : null,
          scheduledAt: get('scheduledAt').trim() || null,
          image: uploadedImageUrl || undefined,
          draft: true,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong.');
      window.location.href = `/dashboard/workshops/${data.slug}`;
    } catch (err: any) {
      errorEl.textContent = err.message || 'Something went wrong.';
      errorEl.hidden = false;
      createBtn.disabled = false;
      createBtn.textContent = 'Create workshop →';
    }
  });
</script>
