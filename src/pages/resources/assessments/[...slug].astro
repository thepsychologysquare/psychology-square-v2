---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const categoryMeta: Record<string, string> = {
  'general': 'General',
  'anxiety': 'Anxiety',
  'depression': 'Depression',
  'adhd': 'ADHD',
  'addiction-recovery': 'Addiction & Recovery',
  'trauma': 'Trauma',
  'relationships': 'Relationships',
  'stress-burnout': 'Stress & Burnout',
};
const ageMeta: Record<string, string> = { 'children': 'Children', 'adults': 'Adults' };
function categoryLabel(slug: string) {
  return categoryMeta[slug] || slug.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

export async function getStaticPaths() {
  const assessments = await getCollection('assessments', ({ data }) => !data.draft);
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment, allAssessments: assessments },
  }));
}

const { assessment, allAssessments } = Astro.props;
const { Content } = await render(assessment);
const hasOverview = Boolean(assessment.body && assessment.body.trim().length > 0);

const related = allAssessments
  .filter((a) => a.id !== assessment.id && a.data.category === assessment.data.category)
  .slice(0, 3);

const siteOrigin = 'https://thepsychologysquare.com';
const canonicalPath = `/resources/assessments/${assessment.id}`;

const creativeWorkJson = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": assessment.data.title,
  "description": assessment.data.description,
  "url": `${siteOrigin}${canonicalPath}`,
  "isAccessibleForFree": true,
  "associatedMedia": { "@type": "MediaObject", "contentUrl": assessment.data.pdfUrl },
  "publisher": {
    "@type": "Organization",
    "name": "The Psychology Square",
    "url": siteOrigin,
  },
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": `${siteOrigin}/resources` },
    { "@type": "ListItem", "position": 3, "name": "Assessments", "item": `${siteOrigin}/resources/assessments` },
    { "@type": "ListItem", "position": 4, "name": assessment.data.title, "item": `${siteOrigin}${canonicalPath}` },
  ],
};
---

<Layout
  title={assessment.data.title}
  description={assessment.data.description}
  fullTitle={assessment.data.seoTitle ?? `${assessment.data.title} — The Psychology Square`}
>
  <script type="application/ld+json" set:html={JSON.stringify(creativeWorkJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <article class="assessment-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/resources">Resources</a>
        <span class="crumb-sep">/</span>
        <a href="/resources/assessments">Assessments</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">{assessment.data.title}</span>
      </nav>

      <span class="article-meta" style="display:block; margin-bottom: 14px;">
        {categoryLabel(assessment.data.category)} · {assessment.data.age.map((a: string) => ageMeta[a]).join(' & ')}
      </span>
      <h1 class="assessment-title">{assessment.data.title}</h1>
      <p class="assessment-lede">{assessment.data.description}</p>
      {assessment.data.sourceNote && <p class="assessment-source">{assessment.data.sourceNote}</p>}

      {hasOverview && (
        <section class="overview-section">
          <h2 class="overview-heading">Overview</h2>
          <div class="prose">
            <Content />
          </div>
        </section>
      )}

      <div class="scoring-block">
        <span class="scoring-label">How to score</span>
        <p>{assessment.data.scoringSummary}</p>
      </div>

      <p class="assessment-disclaimer">This is a screening tool, not a diagnosis — interpret alongside a clinician.</p>

      <div class="assessment-cta">
        <a class="worksheet-btn worksheet-btn--download" href={assessment.data.pdfUrl} target="_blank" rel="noopener noreferrer" aria-label={`Download ${assessment.data.title} PDF`}>
          Download →
        </a>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="wrap">
        <div class="section-head">
          <h2 class="section-title">More {categoryLabel(assessment.data.category)} assessments</h2>
        </div>
        <div class="related-list">
          {related.map((a) => (
            <a class="related-card" href={`/resources/assessments/${a.id}`}>
              <span class="article-meta">{categoryLabel(a.data.category)}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .assessment-page{ padding: 56px 0 80px; max-width: 100%; }
  .assessment-page .wrap{ max-width: 760px; }

  .breadcrumbs{
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-600);
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    align-items:center;
    margin-top: 65px;
    margin-bottom: 10px;
  }
  .breadcrumbs a:hover{ color: var(--gold-500); }
  .crumb-sep{ color: var(--line); }
  .crumb-current{ color: var(--ink-900); }

  @media (max-width: 768px) {
    .breadcrumbs { margin-top: 50px; }
  }

  .assessment-title{
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
    margin-bottom: 14px;
  }
  .assessment-lede{
    font-size: 17px;
    color: var(--ink-600);
    line-height: 1.6;
    margin-bottom: 4px;
  }
  .assessment-source{
    font-size: 12.5px;
    color: var(--sage-500);
    margin-bottom: 32px;
  }

  .overview-section{ margin-top: 32px; }
  .overview-heading{
    font-size: 20px;
    margin-bottom: 14px;
  }

  .scoring-block{
    margin: 32px 0 0;
    padding: 18px 22px;
    background: var(--paper-50);
    border-left: 3px solid var(--sage-500);
    border-radius: 2px;
  }
  .scoring-label{
    display:block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sage-500);
    margin-bottom: 6px;
  }
  .scoring-block p{ font-size: 14.5px; color: var(--ink-700); line-height: 1.65; }

  .prose{
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-900);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .prose :global(h2){ font-size: 24px; margin: 40px 0 16px; }
  .prose :global(p){ margin-bottom: 18px; }
  .prose :global(ul), .prose :global(ol){ margin: 0 0 18px; padding-left: 22px; }
  .prose :global(li){ margin-bottom: 8px; }
  .prose :global(img){ max-width: 100%; height: auto; display: block; margin: 24px 0; border-radius: 4px; }
  .prose :global(pre){ max-width: 100%; overflow-x: auto; }
  .prose :global(table){ display: block; max-width: 100%; overflow-x: auto; }
  .prose :global(a){ overflow-wrap: anywhere; word-break: break-word; }

  .assessment-disclaimer{
    font-size: 13px;
    color: var(--ink-600);
    font-style: italic;
    margin-top: 8px;
  }

  .assessment-cta{
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .assessment-cta .worksheet-btn{ font-size: 14px; }

  .related-list{ display:flex; flex-direction:column; gap:16px; }
  .related-card{
    display:flex;
    flex-direction: column;
    background: var(--paper-0);
    border: 1px solid var(--line);
    padding: 22px 26px;
    transition: border-color .25s var(--ease);
  }
  .related-card:hover{ border-color: var(--gold-500); }
  .related-card h3{ font-size: 18px; margin: 6px 0 6px; }
  .related-card p{ color: var(--ink-600); font-size: 14px; }
</style>
