---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Sehar Waheed — Clinical Psychologist">

  <section class="profile-hero">
    <div class="wrap">
      <a href="/team" class="back-link">← Back to team</a>
      <div class="profile-hero-inner">
        <div class="profile-avatar">
          <img src="/images/sehar.jpg" alt="Sehar Waheed" onerror="this.classList.add('img-error')">
          <span class="avatar-fallback">SW</span>
        </div>
        <div class="profile-info">
          <h1>Sehar Waheed</h1>
          <span class="profile-role">Co-CEO — The Psychology Square</span>
          <span class="profile-role">Clinical Psychologist, MS · Campus Counselor</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Summary</h2>
      <p>Clinical Psychologist (MS) with over three years of direct counseling experience and seven years of overall clinical work, including campus counseling, individual and group therapy, crisis intervention, and addiction treatment. Specializes in anxiety, depression, trauma, and relationship issues with a collaborative, evidence-based approach.</p>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Education &amp; Affiliations</h2>
      <ul class="cv-list">
        <li>
          <span class="cv-when">MS · CGPA 3.69</span>
          <div class="cv-what">
            <strong>Clinical Psychology</strong>
            <p>University of Central Punjab</p>
          </div>
        </li>
        <li>
          <span class="cv-when">BS · CGPA 3.68</span>
          <div class="cv-what">
            <strong>Psychology — Gold Medalist</strong>
            <p>COMSATS University</p>
          </div>
        </li>
        <li>
          <span class="cv-when">Since 2026</span>
          <div class="cv-what">
            <strong>Member, American Psychological Association (APA)</strong>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Clinical &amp; Counseling Experience</h2>
      <ul class="cv-list">
        <li>
          <span class="cv-when">Feb 2026 – Present</span>
          <div class="cv-what">
            <strong>Clinical Psychologist / Clinical Counsellor — Happiness Center, University of Management and Technology (UMT)</strong>
            <p>Provides individual counseling to students and staff on emotional, psychological, relational, and behavioral concerns. Conducts initial assessments, develops individualized care plans, and delivers brief evidence-based interventions.</p>
          </div>
        </li>
        <li>
          <span class="cv-when">Oct 2023 – Feb 2026</span>
          <div class="cv-what">
            <strong>Research Associate &amp; Campus Counsellor — University of Central Punjab (UCP)</strong>
            <p>Delivered one-on-one campus counseling to students on academic stress, adjustment difficulties, and personal challenges. Facilitated psychoeducational workshops on substance use, mental health, and well-being.</p>
          </div>
        </li>
        <li>
          <span class="cv-when">2019 – Present</span>
          <div class="cv-what">
            <strong>Clinical Psychologist — The Psychology Square</strong>
            <p>Provides ongoing individual therapy alongside clinical operations oversight as Co-CEO.</p>
          </div>
        </li>
        <li>
          <span class="cv-when">Feb 2023 – Jul 2023</span>
          <div class="cv-what">
            <strong>Trainee Clinical Psychologist — Focus Rehab: Addiction and Psychological Treatment Centre</strong>
            <p>Delivered supervised individual and group treatment sessions using CBT-based interventions in an addiction treatment setting.</p>
          </div>
        </li>
        <li>
          <span class="cv-when">Oct 2022 – Feb 2023</span>
          <div class="cv-what">
            <strong>Trainee Clinical Psychologist — Lahore Institute of Special Care and Attention (LISCA)</strong>
            <p>Conducted clinical assessments and supervised interventions for individuals with diverse psychological needs.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Teaching Experience</h2>
      <ul class="cv-list">
        <li>
          <span class="cv-when">Spring 2025 – Present</span>
          <div class="cv-what"><strong>Visiting Lecturer, Psychology</strong><p>COMSATS University</p></div>
        </li>
        <li>
          <span class="cv-when">Fall 2024</span>
          <div class="cv-what"><strong>Visiting Lecturer, Psychology</strong><p>FAST University</p></div>
        </li>
        <li>
          <span class="cv-when">Spring 2024</span>
          <div class="cv-what"><strong>Visiting Lecturer, Psychology</strong><p>Lahore Leads University</p></div>
        </li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Selected Certifications</h2>
      <ul class="cv-list">
        <li><span class="cv-when">Johns Hopkins University</span><div class="cv-what"><strong>Psychological First Aid Course</strong></div></li>
        <li><span class="cv-when">University of Central Punjab</span><div class="cv-what"><strong>Cognitive Behaviour Therapy for Substance Use Disorders</strong></div></li>
        <li><span class="cv-when">University of Central Punjab</span><div class="cv-what"><strong>Treatment of Substance Use Disorder Workshop</strong></div></li>
        <li><span class="cv-when">Alzheimer's Pakistan</span><div class="cv-what"><strong>Dementia Friends Certificate</strong></div></li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Publications</h2>
      <ul class="cv-list">
        <li>
          <span class="cv-when">2022</span>
          <div class="cv-what">
            <p>Fatima, S., Waheed, S., Daud, S., Daud, S., &amp; Aslam, S. Gratitude, Self-Regulation, and Academic Motivation During COVID-19 in University Students. <em>Webology, 19</em>(2).</p>
          </div>
        </li>
        <li>
          <span class="cv-when">2023</span>
          <div class="cv-what">
            <p>Waheed, S. Unspecified Somatic Symptom and Related Disorder: Case Study and Treatment. Insight Medical Publishing.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Approach to Therapy</h2>
      <p>Sehar brings a warm, collaborative approach to clinical work. Sessions are structured around evidence-based frameworks—particularly CBT, psychoeducation, and trauma-informed care—but always grounded in genuine listening. She believes therapy works best when both people's experience is heard fully before solutions are introduced.</p>
    </div>
  </section>

  <section class="cv-section booking-cta">
    <div class="wrap">
      <h2>Ready to start?</h2>
      <div class="cta-buttons">
        <a href="https://calendly.com/shs-counseling1-umt/30min" target="_blank" rel="noopener" class="btn btn--primary">Book with Sehar</a>
        <a href="/contact" class="btn btn--secondary">Questions first</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .profile-hero {
    padding: 60px 0;
    background: linear-gradient(135deg, var(--sage-50) 0%, transparent 100%);
    border-bottom: 1px solid var(--sage-200);
  }

  .back-link {
    display: inline-block;
    color: var(--gold-600);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 32px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .profile-hero-inner {
    display: flex;
    align-items: flex-start;
    gap: 40px;
  }

  .profile-avatar {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--sage-100);
    flex-shrink: 0;
  }

  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-info h1 {
    font-size: 40px;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0 0 16px;
  }

  .profile-role {
    display: block;
    font-size: 15px;
    color: var(--ink-600);
    margin: 8px 0;
    font-weight: 500;
  }

  .cv-section {
    padding: 60px 0;
    border-bottom: 1px solid var(--sage-200);
  }

  .cv-section h2 {
    font-size: 22px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 32px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cv-section p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-600);
    margin: 0;
    max-width: 800px;
  }

  .cv-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cv-list li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 40px;
    margin-bottom: 36px;
    align-items: start;
  }

  .cv-when {
    font-size: 13px;
    font-weight: 600;
    color: var(--gold-600);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cv-what strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 6px;
  }

  .cv-what p {
    font-size: 14px;
    color: var(--ink-600);
    margin: 6px 0 0;
  }

  .booking-cta {
    text-align: center;
    border-bottom: none;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .profile-hero-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 32px;
    }

    .profile-avatar {
      width: 120px;
      height: 120px;
    }

    .profile-info h1 {
      font-size: 28px;
    }

    .cv-list li {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>