---
import Layout from '../../layouts/Layout.astro';
import TeamProfile from '../../components/TeamProfile.astro';

const siteOrigin = 'https://thepsychologysquare.com';
// Update this whenever the profile text is edited (shown on the page and in schema).
const reviewed = 'October 2026';
const reviewedISO = '2026-10-05';

const specialties = ['Depression', 'Anxiety', 'Trauma', 'Counseling', 'Crisis Intervention', 'Couples Therapy', 'Psychoeducation',];
const umtPage = 'https://spp.umt.edu.pk/happinesscenter/Meet-Our-Team.aspx';

const personJson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteOrigin}/team/sehar#person`,
  "name": "Sehar Waheed",
  "jobTitle": "Clinical Psychologist & Counselor",
  "description": "Co-CEO of The Psychology Square, Clinical Psychologist at the Happiness Center, University of Management and Technology (UMT), Lahore.",
  "worksFor": { "@type": "Organization", "name": "The Psychology Square", "url": siteOrigin },
  "affiliation": [
    { "@type": "CollegeOrUniversity", "name": "University of Management and Technology (UMT)" },
  ],
  "url": `${siteOrigin}/team/sehar`,
  "image": `${siteOrigin}/images/sehar.jpg`,
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "University of Central Punjab" },
    { "@type": "CollegeOrUniversity", "name": "COMSATS University" },
  ],
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "credentialCategory": "degree", "name": "M.S. Clinical Psychology", "recognizedBy": { "@type": "CollegeOrUniversity", "name": "University of Central Punjab" } },
    { "@type": "EducationalOccupationalCredential", "credentialCategory": "degree", "name": "B.S. Psychology (Gold Medalist)", "recognizedBy": { "@type": "CollegeOrUniversity", "name": "COMSATS University" } },
  ],
  "memberOf": { "@type": "Organization", "name": "American Psychological Association" },
  "knowsAbout": specialties,
  "sameAs": [
    "https://www.instagram.com/seharthepsychologist",
    "https://www.tiktok.com/@seharthepsychologist",
    "https://www.youtube.com/@SeharThePsychologist",
    "https://www.linkedin.com/in/sehar-waheed",
    umtPage,
  ],
};
const profilePageJson = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "url": `${siteOrigin}/team/sehar`,
  "dateModified": reviewedISO,
  "mainEntity": { "@id": `${siteOrigin}/team/sehar#person` },
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Team", "item": `${siteOrigin}/team` },
    { "@type": "ListItem", "position": 3, "name": "Sehar Waheed", "item": `${siteOrigin}/team/sehar` },
  ],
};

const facts = [
  { label: 'Education', value: 'M.S. Clinical Psychology', sub: 'University of Central Punjab' },
  { label: 'Distinction', value: 'Gold Medalist', sub: 'B.S. Psychology, COMSATS University' },
  { label: 'Current role', value: 'Clinical Psychologist / Counsellor', },
  { label: 'Membership', value: 'APA Member', sub: 'American Psychological Association' },
];

const services = [
  { label: 'Therapy', href: '/services/therapy' },
  { label: 'Corporate wellbeing', href: '/services/corporate' },
  { label: 'Psychology tutoring', href: '/services/tutoring' },
];

const more = [
  {
    title: 'Clinical training & experience',
    items: [
      'Research Associate &amp; Campus Counsellor — University of Central Punjab',
      'Trainee Clinical Psychologist — Focus Rehab (supervised addiction treatment) and LISCA',
    ],
  },
  {
    title: 'Teaching',
    items: ['Visiting Lecturer — COMSATS, FAST, and Lahore Leads University'],
  },
  {
    title: 'Publications',
    items: [
      'Waheed, S. (2023). Unspecified Somatic Symptom and Related Disorder: Case Study and Treatment. Insight Medical Publishing.',
      'Fatima, S., Waheed, S., Daud, S., Daud, S., &amp; Aslam, S. (2022). Gratitude, Self-Regulation, and Academic Motivation During COVID-19 in University Students. <em>Webology</em>.',
    ],
  },
];
---
<Layout
  title="Sehar Waheed"
  fullTitle="Sehar Waheed, Clinical Psychologist | The Psychology Square"
  description="Meet Sehar Waheed, Co-CEO of The Psychology Square and Clinical Psychologist in Lahore, specializing in campus counseling, group therapy, and substance use."
  image="/images/sehar.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(personJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(profilePageJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <TeamProfile
    name="Sehar Waheed"
    firstName="Sehar"
    initials="SW"
    image="/images/sehar.jpg"
    role="Co-CEO · Clinical Psychologist & Counselor"
    emails={['sehar@thepsychologysquare.com']}
    socials={[
      { name: 'instagram', url: 'https://www.instagram.com/seharthepsychologist' },
      { name: 'tiktok', url: 'https://www.tiktok.com/@seharthepsychologist' },
      { name: 'youtube', url: 'https://www.youtube.com/@SeharThePsychologist' },
      { name: 'linkedin', url: 'https://www.linkedin.com/in/sehar-waheed' },
    ]}
    facts={facts}
    lede="Sehar Waheed's work sits at the intersection of clinical care and community — from the therapy room to campus counseling programs and crisis-response training."
    about="She has campus counseling and research experience at the University of Central Punjab, completed supervised addiction-treatment training, and teaches psychology as a visiting lecturer."
    focus={specialties}
    services={services}
    more={more}
    reviewed={reviewed}
  />
</Layout>
