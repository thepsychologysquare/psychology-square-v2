---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Muhammad Sohail — Clinical Psychologist">

  <section class="profile-hero">
    <div class="wrap">
      <a href="/team" class="back-link">← Back to team</a>
      <div class="profile-hero-inner">
        <div class="profile-avatar">
          <img src="/images/sohail.jpg" alt="Muhammad Sohail" onerror="this.classList.add('img-error')">
          <span class="avatar-fallback">MS</span>
        </div>
        <div class="profile-info">
          <h1>Muhammad Sohail</h1>
          <span class="profile-role">Founder &amp; CEO — The Psychology Square</span>
          <span class="profile-role">Lecturer of Psychology &amp; Clinical Psychologist</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Summary</h2>
      <p>Clinical Psychologist and Lecturer with expertise in psychological assessment, CBT, addiction treatment, academic teaching, and psychometric research. Published researcher with conference presentations spanning clinical practice, ADHD research, and emotion regulation in children. Currently Lecturer of Psychology at RLKU and CEO of The Psychology Square.</p>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Education</h2>
      <ul class="cv-list">
        <li>
          <span class="cv-when">2021 – 2023 · CGPA 3.71</span>
          <div class="cv-what">
            <strong>M.S. in Clinical Psychology</strong>
            <p>University of Central Punjab</p>
          </div>
        </li>
        <li>
          <span class="cv-when">2017 – 2021 · CGPA 3.34</span>
          <div class="cv-what">
            <strong>B.S. in Psychology</strong>
            <p>University of Peshawar</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Work Experience</h2>
      <ul class="cv-list">
        <li>
          <span class="cv-when">May 2024 – Present</span>
          <div class="cv-what">
            <strong>Lecturer, Psychology — Rashid Latif Khan University (RLKU), Lahore</strong>
          </div>
        </li>
        <li>
          <span class="cv-when">2019 – Present</span>
          <div class="cv-what">
            <strong>Founder &amp; CEO | Clinical Psychologist — The Psychology Square</strong>
            <p>Founded and lead a thriving private practice providing individual and couples therapy, plus educational content and resources grounded in clinical training.</p>
          </div>
        </li>
        <li>
          <span class="cv-when">Feb – Jul 2022</span>
          <div class="cv-what">
            <strong>Trainee Clinical Psychologist — SIMS / Services Hospital</strong>
          </div>
        </li>
        <li>
          <span class="cv-when">Oct 2022 – Feb 2023</span>
          <div class="cv-what">
            <strong>Trainee Clinical Psychologist — Lahore Institute of Special Care and Attention (LISCA)</strong>
          </div>
        </li>
        <li>
          <span class="cv-when">Feb – Jul 2023</span>
          <div class="cv-what">
            <strong>Trainee Clinical Psychologist — Ehsas Clinic: Addiction and Psychological Treatment Center</strong>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Clinical Skills</h2>
      <div class="tag-row">
        <span class="tag-row-label">Assessment &amp; Treatment</span>
        <span class="skill-tag">Psychological Assessment</span>
        <span class="skill-tag">CBT</span>
        <span class="skill-tag">Crisis Intervention</span>
        <span class="skill-tag">Case Formulation</span>
        <span class="skill-tag">Psychotherapy</span>
        <span class="skill-tag">Psychometric Testing</span>
        <span class="skill-tag">DSM-5 Diagnostic Assessment</span>
        <span class="skill-tag">Addiction Treatment</span>
      </div>
      <div class="tag-row">
        <span class="tag-row-label">Research &amp; Analysis</span>
        <span class="skill-tag">SPSS</span>
        <span class="skill-tag">SmartPLS</span>
        <span class="skill-tag">R</span>
        <span class="skill-tag">Psychometrics</span>
        <span class="skill-tag">Quantitative Analysis</span>
      </div>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Research Interests</h2>
      <div class="tag-row">
        <span class="skill-tag">Psychometrics</span>
        <span class="skill-tag">ADHD &amp; Emotion Regulation</span>
        <span class="skill-tag">Artificial Intelligence</span>
      </div>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Selected Publications &amp; Presentations</h2>
      <ul class="cv-list">
        <li>
          <span class="cv-when">2026</span>
          <div class="cv-what">
            <p>Tayyaba, M., Ayaz, A., &amp; Sohail, M. Emotional Intelligence as a Predictor of Career Decision Self-Efficacy among Pakistani University Students. <em>Social Science Review Archive</em>.</p>
          </div>
        </li>
        <li>
          <span class="cv-when">2025</span>
          <div class="cv-what">
            <p>Sohail, M., Waheed, S., &amp; Farooqi, R. Early clinical intervention in a preschool child with autism spectrum disorder level 3: a case study. 2nd National Stucon, RLKU.</p>
          </div>
        </li>
        <li>
          <span class="cv-when">2024</span>
          <div class="cv-what">
            <p>Sohail, M., Waheed, S., &amp; Farooqi, R. Understanding emotion regulation in Pakistani children with ADHD: Implications for child adjustment and parent self-efficacy. International Conference, RLKU.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Memberships</h2>
      <ul class="plain-list">
        <li>Member, American Psychological Association (APA)</li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <div class="wrap">
      <h2>Approach to Therapy &amp; Leadership</h2>
      <p>Muhammad brings rigorous clinical training and research expertise to therapy work and practice leadership. He believes in building bridges between evidence and real-world application — whether that's crafting interventions for addiction treatment, designing classroom teaching, or conducting research that informs clinical understanding of ADHD and child development.</p>
    </div>
  </section>

  <section class="cv-section booking-cta">
    <div class="wrap">
      <h2>Ready to start?</h2>
      <div class="cta-buttons">
        <a href="https://calendly.com/mohdsohail0399/online-session" target="_blank" rel="noopener" class="btn btn--primary">Book with Muhammad</a>
        <a href="/contact" class="btn btn--secondary">Questions first</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .profile-hero {
    padding: 60px 0;
    background: linear-gradient(135deg, var(--sage-50) 0%, transparent 100%);
    border-bottom: 1px solid var(--sage-200);
  }

  .back-link {
    display: inline-block;
    color: var(--gold-600);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 32px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .profile-hero-inner {
    display: flex;
    align-items: flex-start;
    gap: 40px;
  }

  .profile-avatar {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--sage-100);
    flex-shrink: 0;
  }

  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-info h1 {
    font-size: 40px;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0 0 16px;
  }

  .profile-role {
    display: block;
    font-size: 15px;
    color: var(--ink-600);
    margin: 8px 0;
    font-weight: 500;
  }

  .cv-section {
    padding: 60px 0;
    border-bottom: 1px solid var(--sage-200);
  }

  .cv-section h2 {
    font-size: 22px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 32px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cv-section p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-600);
    margin: 0;
    max-width: 800px;
  }

  .cv-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cv-list li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 40px;
    margin-bottom: 36px;
    align-items: start;
  }

  .cv-when {
    font-size: 13px;
    font-weight: 600;
    color: var(--gold-600);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cv-what strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 6px;
  }

  .cv-what p {
    font-size: 14px;
    color: var(--ink-600);
    margin: 6px 0 0;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0 32px;
    align-items: center;
  }

  .tag-row-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0 12px 0 0;
  }

  .skill-tag {
    background-color: var(--sage-100);
    color: var(--ink-700);
    padding: 8px 12px;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 500;
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .plain-list li {
    font-size: 15px;
    color: var(--ink-600);
    margin: 10px 0;
    line-height: 1.6;
  }

  .booking-cta {
    text-align: center;
    border-bottom: none;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .profile-hero-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 32px;
    }

    .profile-avatar {
      width: 120px;
      height: 120px;
    }

    .profile-info h1 {
      font-size: 28px;
    }

    .cv-list li {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>