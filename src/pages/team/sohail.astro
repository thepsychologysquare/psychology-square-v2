---
import Layout from '../../layouts/Layout.astro';
import TeamProfile from '../../components/TeamProfile.astro';

const siteOrigin = 'https://thepsychologysquare.com';
// Update this whenever the profile text is edited (shown on the page and in schema).
const reviewed = 'October 2026';
const reviewedISO = '2026-10-05';

const specialties = ['Depression', 'Anxiety', 'Trauma', 'Substance Use', 'ADHD', 'Crisis Intervention', 'Psychometrics', 'Tutoring'];
const rlkuPage = 'https://rlku.edu.pk/faculty-of-social-sciences/muhammad-sohail.php';

const personJson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteOrigin}/team/sohail#person`,
  "name": "Muhammad Sohail",
  "jobTitle": "Clinical Psychologist & Lecturer of Psychology",
  "description": "Founder of The Psychology Square, Clinical Psychologist, and Lecturer of Psychology at Rashid Latif Khan University, Lahore.",
  "worksFor": { "@type": "Organization", "name": "The Psychology Square", "url": siteOrigin },
  "affiliation": [
    { "@type": "CollegeOrUniversity", "name": "Rashid Latif Khan University (RLKU)" },
  ],
  "url": `${siteOrigin}/team/sohail`,
  "image": `${siteOrigin}/images/sohail.jpg`,
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "University of Central Punjab" },
    { "@type": "CollegeOrUniversity", "name": "University of Peshawar" },
  ],
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "credentialCategory": "degree", "name": "M.S. Clinical Psychology", "recognizedBy": { "@type": "CollegeOrUniversity", "name": "University of Central Punjab" } },
    { "@type": "EducationalOccupationalCredential", "credentialCategory": "degree", "name": "B.S. Psychology", "recognizedBy": { "@type": "CollegeOrUniversity", "name": "University of Peshawar" } },
  ],
  "memberOf": { "@type": "Organization", "name": "American Psychological Association" },
  "knowsAbout": specialties,
  "sameAs": [
    "https://www.instagram.com/sohailpsych",
    "https://www.tiktok.com/@sohailpsych",
    "https://www.youtube.com/@sohailpsych",
    "https://web.facebook.com/sohailpsychologist",
    rlkuPage,
  ],
};
const profilePageJson = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "url": `${siteOrigin}/team/sohail`,
  "dateModified": reviewedISO,
  "mainEntity": { "@id": `${siteOrigin}/team/sohail#person` },
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Team", "item": `${siteOrigin}/team` },
    { "@type": "ListItem", "position": 3, "name": "Muhammad Sohail", "item": `${siteOrigin}/team/sohail` },
  ],
};

const facts = [
  { label: 'Education', value: 'M.S. Clinical Psychology', sub: 'University of Central Punjab, 2023' },
  { label: 'Teaching', value: 'Lecturer of Psychology', sub: 'Rashid Latif Khan University', href: rlkuPage },
  { label: 'Membership', value: 'APA Member', sub: 'American Psychological Association' },
  { label: 'Practice', value: 'Founder, 2019', sub: 'The Psychology Square' },
];

const services = [
  { label: 'Therapy', href: '/services/therapy' },
  { label: 'Psychology tutoring', href: '/services/tutoring' },
  { label: 'Corporate wellbeing', href: '/services/corporate' },
  { label: 'Research analysis', href: '/services/research-analysis' },
];

const more = [
  {
    title: 'Clinical training',
    items: [
      'Services Hospital',
      'Lahore Institute of Special Care and Attention (LISCA)',
      'Ehsas Clinic — addiction and psychological treatment program',
    ],
  },
  {
    title: 'Education & teaching',
    items: [
      'B.S. Psychology — University of Peshawar (2021)',
      'Visiting Lecturer — FAST National University of Computer and Emerging Sciences',
    ],
  },
  {
    title: 'Research & presentations',
    items: [
      'Tayyaba, M., Ayaz, A., &amp; Sohail, M. (2026). Emotional Intelligence as a Predictor of Career Decision Self-Efficacy among Pakistani University Students. <em>Social Science Review Archives</em>.',
      'Sohail, M., Waheed, S., &amp; Farooqi, R. (2024). Understanding emotion regulation in Pakistani children with ADHD. International Conference on Mental Wellbeing.',
      'Sohail, M. (2023). The Development and Validation of an Emotion Regulation Scale for Children with ADHD. University of Central Punjab.',
      'Conference presentations on ADHD, autism, and addiction recovery, national and international.',
    ],
  },
];
---
<Layout
  title="Muhammad Sohail"
  fullTitle="Muhammad Sohail | Clinical Psychologist, Lahore"
  description="Meet Muhammad Sohail, Founder of The Psychology Square — Clinical Psychologist and Lecturer at RLKU, Lahore, specializing in CBT, ADHD & addiction recovery."
  image="/images/sohail.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(personJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(profilePageJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <TeamProfile
    name="Muhammad Sohail"
    firstName="Sohail"
    initials="MS"
    image="/images/sohail.jpg"
    role="Founder & CEO · Clinical Psychologist · Lecturer"
    emails={['sohail@thepsychologysquare.com', 'muhammad.sohail@rlku.edu.pk']}
    socials={[
      { name: 'instagram', url: 'https://www.instagram.com/sohailpsych' },
      { name: 'tiktok', url: 'https://www.tiktok.com/@sohailpsych' },
      { name: 'youtube', url: 'https://www.youtube.com/@sohailpsych' },
      { name: 'facebook', url: 'https://web.facebook.com/sohailpsychologist' },
    ]}
    facts={facts}
    lede="Muhammad Sohail believes therapy works best when it's collaborative — a space to think things through, not a lecture."
    about="His clinical training spans hospital, disability-care, and addiction-treatment settings, and he has published and presented research on ADHD, autism, emotion regulation, and substance use."
    focus={specialties}
    services={services}
    more={more}
    reviewed={reviewed}
  />
</Layout>
