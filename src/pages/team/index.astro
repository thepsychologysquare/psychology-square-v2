---
import Layout from '../../layouts/Layout.astro';

const siteOrigin = 'https://thepsychologysquare.com';

const team = [
  {
    slug: 'sohail',
    name: 'Muhammad Sohail',
    initials: 'MS',
    role: 'Founder & CEO · Clinical Psychologist',
    bio: 'Lecturer of Psychology at RLKU. Works with individuals and couples, steadily and without the jargon.',
    tags: ['CBT', 'ADHD', 'Addiction Recovery'],
    creds: ['M.S. Clinical Psychology', 'APA Member'],
  },
  {
    slug: 'sehar',
    name: 'Sehar Waheed',
    initials: 'SW',
    role: 'Co-CEO · Clinical Psychologist & Counselor',
    bio: 'Clinical psychologist at the Happiness Center, UMT, focused on campus counseling, group therapy, and psychoeducation.',
    tags: ['Group Therapy', 'Campus Counseling', 'Substance Use'],
    creds: ['M.S. Clinical Psychology', 'APA Member'],
  },
];

const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": team.map((p, i) => ({
    "@type": "ListItem", "position": i + 1, "name": p.name, "url": `${siteOrigin}/team/${p.slug}`,
  })),
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Team", "item": `${siteOrigin}/team` },
  ],
};
---
<Layout
  title="Team"
  fullTitle="Top Clinical Psychologists in Lahore - The Psychology Square"
  description="Meet the clinical psychologists at The Psychology Square in Lahore, dedicated to therapy, counselling, mental health advocacy, and evidence-based care."
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />

  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Team</span>
      </nav>
      <p class="eyebrow">Who you'll work with</p>
      <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px;">Step into the Square</h1>
      <p class="hero-sub">Trained clinical psychologists, working individually and together out of the same practice.</p>
    </div>
  </section>

  <section class="section tp-cards-section">
    <div class="wrap">
      <div class="team-columns">
        {team.map((p) => (
          <article class="team-card">
            <div class="team-card-top">
              <div class="avatar">
                <img src={`/images/${p.slug}.jpg`} alt={`${p.name}, Clinical Psychologist at The Psychology Square`} width="88" height="88" loading="lazy" onerror="this.classList.add('img-error')">
                <span class="avatar-fallback">{p.initials}</span>
              </div>
              <div>
                <h2 class="team-col-name">{p.name}</h2>
                <span class="team-col-role">{p.role}</span>
              </div>
            </div>

            <p class="team-col-bio">{p.bio}</p>

            <div class="team-tags">
              {p.tags.map((t) => <span class="team-tag">{t}</span>)}
            </div>

            <div class="team-card-foot">
              <span class="team-creds">{p.creds.join(' · ')}</span>
              <a href={`/team/${p.slug}`} class="profile-link team-stretch">View profile <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2 style="font-size: 22px; margin-bottom: 20px;">How we work together</h2>
      <div class="approach-grid" style="margin-bottom: 40px;">
        <div class="approach-item">
          <span class="approach-num">01</span>
          <h3>Same practice, individual care</h3>
          <p>You work with either Sohail or Sehar for your sessions, not passed between clinicians partway through.</p>
        </div>
        <div class="approach-item">
          <span class="approach-num">02</span>
          <h3>Shared clinical grounding</h3>
          <p>Both hold an M.S. in Clinical Psychology and are members of the American Psychological Association.</p>
        </div>
        <div class="approach-item">
          <span class="approach-num">03</span>
          <h3>Conversation first</h3>
          <p>CBT and ACT inform the work, but every session starts with listening.</p>
        </div>
      </div>

      <p class="team-note">
        Sessions are scheduled, outpatient therapy and not an emergency service.
        If you're in crisis in Punjab, call <strong>Rescue 1122</strong> or go to your nearest emergency department.
        <br> <a href="/disclaimer">Disclaimer</a>.
      </p>

      <div class="request-cta-banner">
        <p>Ready to have a meeting?</p>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a href="/book" class="btn btn--primary">Book Now</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .breadcrumbs{
    font-family: var(--font-mono); font-size: 12px; color: rgba(248,249,246,0.6);
    margin-bottom: 20px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  }
  .breadcrumbs a:hover{ color: var(--gold-300); }
  .crumb-sep{ color: rgba(248,249,246,0.3); }
  .crumb-current{ color: rgba(248,249,246,0.85); }

  .tp-cards-section{ padding: 40px 0; }
  .team-columns{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  /* ---- Cards ---- */
  .team-card{
    position: relative;
    display: flex; flex-direction: column; gap: 18px;
    padding: 28px;
    background: var(--paper-0);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold-500);
    border-radius: 14px;
    box-shadow: 0 18px 36px -24px rgba(11,20,31,0.35);
    transition: transform .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease);
  }
  .team-card:hover{
    transform: translateY(-4px);
    border-color: var(--gold-500);
    box-shadow: 0 24px 44px -22px rgba(11,20,31,0.4);
  }
  .team-card-top{ display:flex; align-items:center; gap: 18px; }
  .team-card .avatar{
    width: 88px; height: 88px; margin: 0;
    box-shadow: 0 0 0 3px var(--paper-0), 0 0 0 5px var(--gold-500);
  }
  .team-col-name{
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink-900);
    margin: 0 0 4px;
  }
  .team-col-role{
    display: block;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--sage-500);
  }
  .team-col-bio{
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-600);
  }
  .team-tags{ display:flex; flex-wrap:wrap; gap: 8px; }
  .team-tag{
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--navy-700); border: 1px solid var(--line); padding: 6px 12px; border-radius: 999px;
    background: var(--paper-50);
  }
  .team-card-foot{
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display:flex; justify-content:space-between; align-items:center; gap: 12px; flex-wrap: wrap;
  }
  .team-creds{ font-size: 13px; color: var(--ink-600); }
  /* Whole card is clickable via the profile link */
  .team-stretch::after{ content:''; position:absolute; inset:0; border-radius: 14px; }

  /* ---- How we work ---- */
  .approach-grid{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .approach-item{ display:flex; flex-direction:column; gap:8px; }
  .approach-num{
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gold-500);
  }
  .approach-item h3{ font-size: 17px; }
  .approach-item p{ color: var(--ink-600); font-size: 14.5px; }

  .team-note{
    font-size: 13.5px; line-height: 1.6; color: var(--ink-600);
    padding-left: 14px; border-left: 3px solid var(--sage-500);
  }
  .team-note a{ text-decoration: underline; text-underline-offset: 2px; }
  .team-note a:hover{ color: var(--gold-500); }

  @media (max-width: 860px){
    .team-columns{ grid-template-columns: 1fr; }
    .approach-grid{ grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 480px){
    .team-card{ padding: 22px; }
    .team-card-top{ flex-direction: column; align-items: flex-start; }
  }
</style>
