---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { listPublicWorkshops } from '../../lib/workshops';
import { categoryLabelMap } from '../../lib/workshopCategories';

const workshops = await listPublicWorkshops(env);
const CATEGORY_LABELS = await categoryLabelMap(env);

const categoriesInUse = [...new Set(workshops.map((w) => w.category))];
const hasFree = workshops.some((w) => !w.price_pkr);
const hasPaid = workshops.some((w) => w.price_pkr > 0);

const INSTRUCTOR_NAMES: Record<string, string> = { sohail: 'Muhammad Sohail', sehar: 'Sehar Waheed' };
---
<Layout
  title="Best Psychology Health Workshops in Lahore for Students and Therapists"
  description="Live, small-group online psychology workshops on Google Meet. Learn in real time with a clinical psychologist and earn a certificate of completion."
  image="/images/workshops-cover.jpg"
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Live &amp; Interactive</span>
      <h1>Workshops.</h1>
      <p class="hero-sub">Join live, small-group online psychology workshops led by a clinical psychologist and university lecturer. Every session runs live on Google Meet, never pre-recorded, so you can ask questions and interact directly with your instructor and a small group of students and mental health professionals. Sessions typically run within one week of your submission, and you receive a certificate of completion when you finish. Join from anywhere in Pakistan and beyond.</p>
    </div>
  </section>

  <section class="wk-section">
    <div class="wrap">
      {workshops.length === 0 && (
        <p class="empty-state">No workshops are open right now — check back soon, or request one below.</p>
      )}

      {workshops.length > 0 && (
        <>
          <div class="toolbar">
            <input type="text" id="search-input" class="search-input" placeholder="Search workshops…" autocomplete="off" aria-label="Search workshops" />

            <details class="filter-dropdown" id="filter-dropdown">
              <summary class="filter-toggle">
                Filters <span class="filter-badge" id="filter-badge" hidden>0</span>
              </summary>
              <div class="filter-panel">
                {hasFree && hasPaid && (
                  <div class="filter-group">
                    <h3 class="filter-heading">Price</h3>
                    <div class="checkbox-list" id="tier-filters">
                      <label class="checkbox-row">
                        <input type="checkbox" value="free" class="tier-checkbox" data-label="Free" />
                        <span>Free</span>
                      </label>
                      <label class="checkbox-row">
                        <input type="checkbox" value="paid" class="tier-checkbox" data-label="Paid" />
                        <span>Paid</span>
                      </label>
                    </div>
                  </div>
                )}

                <div class="filter-group">
                  <h3 class="filter-heading">Topic</h3>
                  <div class="checkbox-list" id="category-filters">
                    {categoriesInUse.map((cat) => (
                      <label class="checkbox-row">
                        <input type="checkbox" value={cat} class="category-checkbox" data-label={CATEGORY_LABELS[cat] || cat} />
                        <span>{CATEGORY_LABELS[cat] || cat}</span>
                      </label>
                    ))}
                  </div>
                </div>

                <div class="filter-panel-actions">
                  <button type="button" id="clear-filters" class="clear-filters-btn">Clear all</button>
                  <button type="button" class="btn btn--primary filter-done-btn" id="filter-done">Show results</button>
                </div>
              </div>
            </details>
          </div>

          <div class="active-chips" id="active-chips"></div>
          <p class="results-count" id="results-count"></p>
        </>
      )}

      <div class="wk-grid" id="workshopGrid">
        {workshops.map((w) => (
            <a
              href={`/workshops/${w.slug}`}
              class="wk-card"
              data-title={w.title.toLowerCase()}
              data-description={(w.description || '').toLowerCase()}
              data-topic={(CATEGORY_LABELS[w.category] || w.category).toLowerCase()}
              data-category={w.category}
              data-tier={w.price_pkr > 0 ? 'paid' : 'free'}
            >
              {w.image && <img src={w.image} alt={w.image_alt || w.title} class="wk-card__image" loading="lazy" />}
              <div class="wk-card__body">
                <div class="wk-card__top">
                  <span class="badge">{CATEGORY_LABELS[w.category] || w.category}</span>
                </div>
                <h2 class="wk-card__title">{w.title}</h2>
                <p class="wk-card__desc">{w.description}</p>
                <div class="wk-card__meta">
                  <span class="wk-card__price">PKR {w.price_pkr.toLocaleString('en-US')}</span>
                </div>
                {w.scheduled_at && <span class="wk-card__tentative">Tentative: {w.scheduled_at}</span>}
                {w.instructor && <span class="wk-card__instructor">With {INSTRUCTOR_NAMES[w.instructor] || w.instructor}</span>}
              </div>
            </a>
        ))}
      </div>

      <p class="no-results" id="no-results" hidden>No workshops match your search or filters. Try clearing some, or search a different term.</p>

      <div class="request-cta-banner">
        <p>Don't see a workshop on the topic you need?</p>
        <button type="button" class="btn btn--primary" id="openWorkshopRequest">Request a workshop →</button>
      </div>
    </div>
  </section>

  <div class="modal-overlay" id="requestModalOverlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <button class="modal-close" id="modalClose" aria-label="Close">✕</button>
      <h2 id="modalTitle" class="section-title" style="font-size:22px; margin-bottom:8px;">Request a workshop</h2>
      <p style="color: var(--ink-600); margin-bottom: 24px; font-size:14px;">Tell us what topic you're looking for — we'll email you once we've got a group forming.</p>

      <form action="https://formspree.io/f/mdaqlngp" method="POST" class="request-form">
        <label>
          Topic
          <input type="text" name="workshop_topic" placeholder="e.g. Managing anxiety at work" />
        </label>
        <label>
          Your name
          <input type="text" name="name" required />
        </label>
        <label>
          Your email
          <input type="email" name="email" required />
        </label>
        <label>
          Message (optional)
          <textarea name="message" rows="3"></textarea>
        </label>
        <button type="submit" class="btn btn--primary">Send request</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .wk-section{ padding:56px 0 96px; }
  .empty-state{ text-align:center; padding:48px 24px; color:var(--ink-600); }

  .toolbar{ display:flex; gap:12px; position:relative; z-index:20; }
  .search-input{
    flex:1; font-family:var(--font-body); font-size:14.5px; padding:12px 16px;
    border:1px solid var(--line); border-radius:3px; background:var(--paper-0); color:var(--ink-900);
  }
  .search-input:focus{ outline:2px solid var(--gold-500); outline-offset:1px; }

  .filter-dropdown{ position:relative; }
  .filter-toggle{
    display:flex; align-items:center; gap:8px; font-family:var(--font-mono); font-size:13px;
    letter-spacing:0.04em; text-transform:uppercase; color:var(--navy-950); background:var(--paper-0);
    border:1px solid var(--line); padding:12px 20px; border-radius:3px; cursor:pointer;
    white-space:nowrap; list-style:none; user-select:none; height:100%; box-sizing:border-box;
  }
  .filter-toggle::-webkit-details-marker{ display:none; }
  .filter-toggle:hover{ border-color:var(--gold-500); }
  .filter-dropdown[open] .filter-toggle{ border-color:var(--navy-950); background:var(--navy-950); color:var(--paper-0); }
  .filter-badge{
    background:var(--gold-500); color:var(--navy-950); font-size:11px; font-weight:700;
    border-radius:999px; padding:1px 7px; min-width:18px; text-align:center;
  }
  .filter-panel{
    position:absolute; top:calc(100% + 8px); right:0; width:min(360px, calc(100vw - 64px));
    max-height:60vh; overflow-y:auto; background:var(--paper-0); border:1px solid var(--line);
    border-radius:4px; box-shadow:0 12px 32px rgba(19,26,34,0.14); padding:22px;
    display:flex; flex-direction:column; gap:22px;
  }
  .filter-group{ display:flex; flex-direction:column; gap:10px; }
  .filter-heading{
    font-family:var(--font-mono); font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-600);
  }
  .checkbox-list{ display:flex; flex-direction:column; gap:10px; }
  .checkbox-row{ display:flex; align-items:center; gap:9px; font-size:14px; color:var(--ink-900); cursor:pointer; }
  .checkbox-row input{ accent-color:var(--gold-500); width:15px; height:15px; flex:none; }
  .checkbox-row.is-extra{ display:none; }
  .checkbox-row.is-extra.is-shown{ display:flex; }
  :global(.show-more-btn){
    font-family:var(--font-mono); font-size:12px; color:var(--sage-500); background:none; border:none;
    text-align:left; padding:0; cursor:pointer; text-decoration:underline; text-underline-offset:3px;
  }
  .filter-panel-actions{
    display:flex; justify-content:space-between; align-items:center; padding-top:6px; border-top:1px solid var(--line);
  }
  .clear-filters-btn{
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.04em; text-transform:uppercase;
    color:var(--ink-600); background:none; border:none; text-decoration:underline; text-underline-offset:3px;
    cursor:pointer; padding:0;
  }
  .clear-filters-btn:hover{ color:var(--gold-500); }
  .filter-done-btn{ font-size:13px; padding:10px 20px; }

  .active-chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:18px; }
  .active-chips:empty{ margin-top:0; }
  :global(.active-chip){
    display:flex; align-items:center; gap:7px; font-family:var(--font-mono); font-size:12px; letter-spacing:0.02em;
    color:var(--navy-950); background:var(--paper-50); border:1px solid var(--line);
    padding:6px 10px 6px 14px; border-radius:999px;
  }
  :global(.active-chip button){
    background:none; border:none; color:var(--ink-600); cursor:pointer; font-size:14px; line-height:1; padding:2px;
  }
  :global(.active-chip button:hover){ color:var(--gold-500); }
  .results-count{ font-family:var(--font-mono); font-size:12.5px; color:var(--ink-600); margin:24px 0; }
  .no-results{ color:var(--ink-600); padding:32px 0; text-align:center; }
  .wk-card.is-hidden{ display:none; }

  .wk-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:24px; }
  .wk-card{
    display:flex; flex-direction:column; background:#fff; border:1px solid var(--line);
    border-radius:12px; overflow:hidden; text-decoration:none; color:inherit;
    transition:border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .wk-card:hover{ border-color:var(--gold-500); box-shadow:0 4px 18px rgba(11,20,31,0.08); transform:translateY(-2px); }
  .wk-card__image{ width:100%; height:160px; object-fit:cover; }
  .wk-card__body{ padding:18px 20px; display:flex; flex-direction:column; gap:8px; }
  .wk-card__top{ display:flex; gap:8px; flex-wrap:wrap; }
  .badge{ font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; padding:3px 9px; border-radius:20px; background:rgba(28,49,76,0.08); color:var(--navy-700); }
  .wk-card__title{ font-family:var(--font-display); font-size:19px; margin:0; color:var(--navy-950); }
  .wk-card__desc{ margin:0; color:var(--ink-600); font-size:14px; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .wk-card__meta{ display:flex; align-items:center; font-size:13px; margin-top:4px; }
  .wk-card__price{ font-weight:700; color:var(--navy-950); }
  .wk-card__tentative{ font-size:12px; color:var(--ink-600); }
  .wk-card__instructor{ font-size:12.5px; color:var(--ink-600); }

  .request-cta-banner{
    margin-top:48px; padding:24px 28px; background:var(--paper-1, #f4f4f0); border-radius:12px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
  }
  .request-cta-banner p{ margin:0; font-weight:600; color:var(--navy-950); }

  .btn{ display:inline-flex; align-items:center; gap:8px; font-weight:600; font-size:14.5px; padding:11px 20px; border-radius:8px; text-decoration:none; border:none; cursor:pointer; }
  .btn--primary{ background:var(--navy-950); color:#fff; }
  .btn--primary:hover{ background:var(--navy-700); }

  .modal-overlay{ display:none; position:fixed; inset:0; background:rgba(11,20,31,0.5); z-index:100; align-items:center; justify-content:center; padding:20px; }
  .modal-overlay.is-open{ display:flex; }
  .modal{ background:#fff; border-radius:14px; padding:32px; max-width:440px; width:100%; position:relative; max-height:90vh; overflow-y:auto; }
  .modal-close{ position:absolute; top:16px; right:16px; background:none; border:none; font-size:16px; cursor:pointer; color:var(--ink-600); }
  .request-form{ display:flex; flex-direction:column; gap:18px; }
  .request-form label{ display:flex; flex-direction:column; gap:6px; font-size:14px; color:var(--ink-600); font-weight:500; }
  .request-form input, .request-form textarea{ padding:10px 12px; border:1px solid var(--line); border-radius:8px; font-size:14px; font-family:inherit; }
  .request-form input:focus, .request-form textarea:focus{ outline:2px solid var(--gold-500); outline-offset:1px; }
  .request-form button{ align-self:flex-start; border:none; cursor:pointer; }

  @media (max-width:640px){
    .request-cta-banner{ flex-direction:column; align-items:flex-start; }
    .toolbar{ flex-direction:column; }
    .filter-panel{ right:0; left:0; width:auto; }
  }
</style>

<script>
  const overlay = document.getElementById('requestModalOverlay');
  const openBtn = document.getElementById('openWorkshopRequest');
  const closeBtn = document.getElementById('modalClose');
  openBtn?.addEventListener('click', () => overlay?.classList.add('is-open'));
  closeBtn?.addEventListener('click', () => overlay?.classList.remove('is-open'));
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('is-open'); });

  type FilterEntry = { kind: 'tier' | 'category'; value: string; label: string };

  const cards = Array.from(document.querySelectorAll<HTMLElement>('#workshopGrid .wk-card'));
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const filterDropdown = document.getElementById('filter-dropdown') as HTMLDetailsElement | null;
  const filterBadge = document.getElementById('filter-badge');
  const tierCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.tier-checkbox'));
  const categoryCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.category-checkbox'));
  const clearBtn = document.getElementById('clear-filters');
  const doneBtn = document.getElementById('filter-done');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const activeChipsContainer = document.getElementById('active-chips');

  function setupShowMore(containerId: string, threshold = 8) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const rows = Array.from(container.querySelectorAll('.checkbox-row'));
    if (rows.length <= threshold) return;
    rows.slice(threshold).forEach((row) => row.classList.add('is-extra'));
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'show-more-btn';
    btn.textContent = `+ Show ${rows.length - threshold} more`;
    btn.addEventListener('click', () => {
      const nowShown = container.querySelectorAll('.checkbox-row.is-extra.is-shown').length === 0;
      rows.slice(threshold).forEach((row) => row.classList.toggle('is-shown', nowShown));
      btn.textContent = nowShown ? 'Show less' : `+ Show ${rows.length - threshold} more`;
    });
    container.after(btn);
  }
  setupShowMore('category-filters');

  function getActiveFilters(): FilterEntry[] {
    const out: FilterEntry[] = [];
    tierCheckboxes.filter((c) => c.checked).forEach((c) => out.push({ kind: 'tier', value: c.value, label: c.dataset.label || c.value }));
    categoryCheckboxes.filter((c) => c.checked).forEach((c) => out.push({ kind: 'category', value: c.value, label: c.dataset.label || c.value }));
    return out;
  }

  function uncheck(f: FilterEntry) {
    const list = f.kind === 'tier' ? tierCheckboxes : categoryCheckboxes;
    list.forEach((c) => { if (c.value === f.value) c.checked = false; });
  }

  function renderChips() {
    const active = getActiveFilters();
    if (activeChipsContainer) {
      activeChipsContainer.innerHTML = '';
      active.forEach((f) => {
        const chip = document.createElement('span');
        chip.className = 'active-chip';
        chip.append(document.createTextNode(`${f.label} `));
        const x = document.createElement('button');
        x.type = 'button';
        x.setAttribute('aria-label', `Remove filter: ${f.label}`);
        x.textContent = '✕';
        x.addEventListener('click', () => { uncheck(f); applyFilters(); });
        chip.appendChild(x);
        activeChipsContainer.appendChild(chip);
      });
    }
    if (filterBadge) {
      filterBadge.hidden = active.length === 0;
      filterBadge.textContent = String(active.length);
    }
  }

  function applyFilters() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    const tiers = tierCheckboxes.filter((c) => c.checked).map((c) => c.value);
    const categories = categoryCheckboxes.filter((c) => c.checked).map((c) => c.value);

    let visibleCount = 0;
    for (const card of cards) {
      const haystack = `${card.dataset.title || ''} ${card.dataset.description || ''} ${card.dataset.topic || ''}`;
      const show =
        (!query || haystack.includes(query)) &&
        (tiers.length === 0 || tiers.includes(card.dataset.tier || '')) &&
        (categories.length === 0 || categories.includes(card.dataset.category || ''));
      card.classList.toggle('is-hidden', !show);
      if (show) visibleCount++;
    }

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} workshop${cards.length === 1 ? '' : 's'}`;
    }
    if (noResults) noResults.hidden = cards.length === 0 || visibleCount > 0;
    renderChips();
  }

  searchInput?.addEventListener('input', applyFilters);
  tierCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));
  categoryCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));

  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    tierCheckboxes.forEach((cb) => (cb.checked = false));
    categoryCheckboxes.forEach((cb) => (cb.checked = false));
    applyFilters();
  });

  doneBtn?.addEventListener('click', () => { if (filterDropdown) filterDropdown.open = false; });

  document.addEventListener('click', (e) => {
    if (filterDropdown?.open && !filterDropdown.contains(e.target as Node)) {
      filterDropdown.open = false;
    }
  });

  // Deep link from the nav menu: /workshops/?category=anxiety pre-selects that topic.
  const presetCategory = new URLSearchParams(window.location.search).get('category');
  if (presetCategory) {
    categoryCheckboxes.forEach((cb) => { if (cb.value === presetCategory) cb.checked = true; });
  }

  applyFilters();
</script>
