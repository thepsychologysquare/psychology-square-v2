---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const topicImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/topics/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getTopicImage(slug: string) {
  const entry = Object.entries(topicImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

const topics = [
  { name: 'Anxiety', slug: 'anxiety', href: '/articles/category/anxiety', bg: 'var(--sage-500)' },
  { name: 'Depression', slug: 'depression', href: '/articles/category/depression', bg: 'var(--navy-700)' },
  { name: 'ADHD', slug: 'adhd', href: '/articles/category/adhd', bg: 'var(--gold-500)' },
  { name: 'Addiction & Recovery', slug: 'addiction-recovery', href: '/articles/category/addiction-recovery', bg: 'var(--navy-950)' },
  { name: 'Trauma', slug: 'trauma', href: '/articles/category/trauma', bg: 'var(--ink-600)' },
  { name: 'Relationships', slug: 'relationships', href: '/articles/category/relationships', bg: 'var(--gold-300)' },
  { name: 'Stress & Burnout', slug: 'stress-burnout', href: '/articles/category/stress-burnout', bg: 'var(--navy-800)' },
];

const serviceImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/services/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getServiceImage(slug: string) {
  const entry = Object.entries(serviceImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

const therapyServices = [
  {
    name: 'Individual Therapy',
    slug: 'individual-therapy',
    bg: 'var(--sage-500)',
    description: "One-to-one sessions for working through what's weighing on you — patterns, symptoms, or a season that feels heavier than it should.",
    meta: 'PKR 5,000 / session · Online & In-Person',
  },
  {
    name: 'Couples Therapy',
    slug: 'couples-therapy',
    bg: 'var(--navy-700)',
    description: "Joint sessions for partners working through communication, conflict, or disconnection — with both people's experience given equal room.",
    meta: 'PKR 7,000 / session · Online & In-Person',
  },
];

const faqs = [
  {
    q: 'What exactly is The Psychology Square, and what services do you provide?',
    a: 'The Psychology Square is an online mental health platform offering professional virtual therapy, psychological assessments, and evidence-based mental health resources. We connect individuals directly with qualified psychologists for individual counseling, clinical evaluations, and structured psychoeducation.',
  },
  {
    q: 'Are your services restricted to a specific region, or can I book from anywhere?',
    a: 'Our telehealth services are accessible internationally to anyone with a stable internet connection. We accommodate different time zones, allowing clients globally to receive confidential psychological support from the comfort of their homes.',
  },
  {
    q: 'What clinical qualifications do the therapists on your platform hold?',
    a: 'All practitioners associated with The Psychology Square are credentialed mental health professionals holding advanced degrees in clinical or professional psychology. Every clinician possesses documented training in evidence-based therapeutic modalities and practical clinical experience.',
  },
  {
    q: 'Which therapeutic frameworks and techniques do your psychologists utilize?',
    a: 'Our clinicians apply tailored, science-backed modalities including Cognitive Behavioral Therapy (CBT), Psychodynamic Therapy, Interpersonal Therapy (IPT), and Acceptance and Commitment Therapy (ACT). Treatment plans are tailored specifically to individual case conceptualizations and empirical research.',
  },
  {
    q: 'How does the virtual consultation process work from booking to session?',
    a: 'After selecting a practitioner and scheduling a time slot through our platform, you will receive an instant booking confirmation containing a secure, end-to-end encrypted video meeting link. At your scheduled time, simply click the link to enter your private virtual therapy room—no extra software downloads required.',
  },
  {
    q: 'What happens during the initial intake session?',
    a: 'The first session serves as a clinical intake where your therapist gathers background information, assesses your primary concerns, and discusses your specific therapeutic goals. Together, you will formulate a clear roadmap and frequency structure for future treatment.',
  },
  {
    q: 'How is my personal data and session privacy protected?',
    a: 'We strictly adhere to clinical confidentiality protocols and data protection standards. All video calls and written communications utilize encrypted infrastructure, and clinical notes are stored securely, ensuring your data is never shared without explicit written consent unless required by law.',
  },
  {
    q: 'What is your cancellation, rescheduling, and no-show policy?',
    a: 'You can reschedule a session with at least 24 hours\' prior notice, subject to available slots. No refunds will be provided for booked sessions, and cancellations remain non-refundable in all cases. Last-minute rescheduling or cancellations are not permitted, and no-shows or missed appointments forfeit the full session fee.',
  },
  {
    q: 'Can I use The Psychology Square for immediate psychiatric emergencies or crisis intervention?',
    a: 'No, our platform provides scheduled outpatient therapy and is not designed for crisis management. If you are experiencing acute suicidal ideation, severe self-harm urges, or a medical emergency, please contact your local emergency response service or visit the nearest hospital emergency department immediately.',
  },
  {
    q: 'Can I get a formal psychological report or diagnosis through your platform?',
    a: 'Yes, formal diagnostic evaluations and clinical assessments can be conducted by our qualified psychologists during designated intake and assessment sessions. However, standard informative articles or self-assessment screeners on our website serve purely educational purposes and do not constitute a formal diagnosis.',
  },
];
---
<Layout
  title="Home"
  fullTitle="The Psychology Square — Online &amp; In-Person Therapy in Lahore"
  description="Individual and couples therapy in Johar Town, Lahore — online or in person. Licensed clinical psychologists, evidence-based, unhurried. Book a session today."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  })} />

  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="since-badge">Since 2019</span>
        <p class="eyebrow">Online &amp; In-Person — Johar Town, Lahore, Pakistan</p>
        <h1 class="hero-title">A steady space<br>to think things<br>through.</h1>
        <p class="hero-sub">Individual and couples therapy, held online over video call or in person in Johar Town, Lahore. Evidence-based, unhurried, and built around what you're actually carrying.</p>
        <div class="hero-actions">
          <a href="/book" class="btn btn--primary">Book Now</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="grid-signature" id="gridSignature"></div>
        <p class="visual-caption">Let's Get You a Slot</p>
      </div>
    </div>
  </section>

  <section class="meet" id="team">
    <div class="wrap">
      <div class="meet-row">
        <div class="meet-photo">
          <img src="/images/sohail.jpg" alt="Muhammad Sohail" loading="lazy" onerror="this.classList.add('img-error')">
          <span class="meet-photo-fallback">MS</span>
        </div>
        <div class="meet-copy">
        <p class="eyebrow">Founder and CEO</p>
          <h2 class="meet-title">Muhammad Sohail</h2>
          <p class="meet-sub">He lectures on psychology at Rashid Latif Khan University (RLKU), holds an M.S. in Clinical Psychology, and is a member of the American Psychological Association (APA). Through individual and couples sessions, he's helped clients navigate what they're actually carrying — steadily, and without the jargon.</p>
          <a href="/team/sohail" class="btn btn--primary">View Profile</a>
        </div>
      </div>

      <div class="meet-row meet-row--reverse">
        <div class="meet-photo">
          <img src="/images/sehar.jpg" alt="Sehar Waheed" loading="lazy" onerror="this.classList.add('img-error')">
          <span class="meet-photo-fallback">SW</span>
        </div>
        <div class="meet-copy">
          <p class="eyebrow">Co-CEO</p>
          <h2 class="meet-title">Sehar Waheed</h2>
          <p class="meet-sub">She counsels at the University of Management and Technology (UMT), holds an M.S. in Clinical Psychology, and is a member of the American Psychological Association (APA). Her sessions stay collaborative — conversation first, framework second.</p>
          <a href="/team/sehar" class="btn btn--primary">View Profile</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section therapy-section" id="therapy-services">
    <div class="wrap therapy-grid">
      <div class="therapy-left">
        <div class="therapy-portrait" style={!getServiceImage('therapy-hero') ? 'background:var(--navy-800);' : undefined}>
          {getServiceImage('therapy-hero') && (
            <Image src={getServiceImage('therapy-hero')!} alt="Therapy at The Psychology Square" width={760} format="webp" quality={65} loading="lazy" class="therapy-portrait-photo" />
          )}
          <span class="therapy-portrait-mark">TPS</span>
          <div class="therapy-portrait-caption">
            <span class="therapy-portrait-kicker">Individual &amp; Couples Therapy</span>
            <span class="therapy-portrait-names">Sohail &amp; Sehar</span>
          </div>
        </div>
        <h2 class="therapy-title">Therapy, Held Steadily</h2>
        <p class="therapy-sub">Join us in session, online or in person in Johar Town, Lahore, for evidence-based therapy that stays unhurried and grounded in what you're actually carrying.</p>
      </div>

      <div class="therapy-right">
        <h3 class="therapy-title">Our Services</h3>
        <div class="therapy-list">
          {therapyServices.map((s) => {
            const img = getServiceImage(s.slug);
            return (
              <div class="therapy-card">
                <div class="therapy-card-thumb" style={img ? undefined : `background:${s.bg};`}>
                  {img && (
                    <Image src={img} alt={s.name} width={220} format="webp" quality={60} loading="lazy" class="therapy-card-photo" />
                  )}
                </div>
                <div class="therapy-card-body">
                  <h4>{s.name}</h4>
                  <p>{s.description}</p>
                  <span class="therapy-card-meta">{s.meta}</span>
                </div>
              </div>
            );
          })}
        </div>
        
        <div class="therapy-action-block">
          <a href="/book" class="btn btn--primary contact-btn">Book Now</a>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-block">
    <div class="wrap quote-inner">
      <p class="quote-text">"Therapy works best when it stays collaborative — you're not handed a worksheet before you've been heard."</p>
      <p class="quote-attribution">Muhammad Sohail, Clinical Psychologist</p>
    </div>
  </section>

  <section class="practice" id="practice">
    <div class="wrap practice-inner">
      <h2 class="section-title">Therapy that stays grounded in evidence, not slogans.</h2>
      <div class="practice-grid">
        <div class="practice-block">
          <h3>1. Structured, not clinical-cold</h3>
          <p>Sessions follow an evidence-based framework, but conversation comes first. You won't be handed a worksheet before you've been heard.</p>
        </div>
        <div class="practice-block">
          <h3>2. Online or in person, your choice</h3>
          <p>Join over video call from anywhere, or come in person to the Johar Town, Lahore office. Either way — a quiet, confidential hour.</p>
        </div>
        <div class="practice-block">
          <h3>3. Rooted in real training</h3>
          <p>Grounded in supervised clinical experience across hospital and addiction-treatment settings, not theory alone.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="book-section" id="contact">
    <div class="wrap book-grid">
      <div class="book-left">
        <h2 class="book-title">Book a session.</h2>
        <p class="book-sub">Available online over video call, or in person in Johar Town, Lahore. Reach out and we'll sort the details together.</p>
        <div class="book-actions">
          <a href="/contact" class="btn btn--outline">Send a message →</a>
          <a href="/book" class="btn btn--primary book-btn-badge">
            <span class="book-badge">Book Now</span>
          </a>
        </div>

        <div class="book-card">
          <span class="book-card-tag">Before you book</span>
          <h3>What to know</h3>
          <p>Sessions are confidential, with standard legal exceptions like risk of serious harm. Join online from a quiet, private space. Payment is arranged and confirmed by email ahead of your slot.</p>
          <div class="book-card-actions">
            <a href="mailto:info@thepsychologysquare.com" class="btn btn--text-onlight">Email us →</a>
          </div>
        </div>
      </div>

      <div class="book-visual">
  <div class="book-visual-panel">
    {getServiceImage('booking-hero') ? (
      <Image
        src={getServiceImage('booking-hero')!}
        alt="A person booking an online therapy session"
        width={640}
        format="webp"
        quality={65}
        loading="lazy"
        class="book-visual-photo"
      />
    ) : (
      <div class="grid-signature" id="gridSignatureContact"></div>
    )}
  </div>
  <p class="visual-caption visual-caption--dark">Confidential &amp; Unhurried</p>
</div>
    </div>
  </section>

  <section class="section topics-section" id="explore-topics">
    <div class="wrap">
      <h2 class="section-title topics-title">Explore Topics</h2>
      <div class="topics-scroll" id="topicsScroll">
        {topics.map((t) => {
          const img = getTopicImage(t.slug);
          return (
            <a class="topic-card topic-card-explore" href={t.href}>
              <div class="topic-card-img" style={img ? undefined : `background:${t.bg};`}>
                {img && (
                  <Image src={img} alt={t.name} width={760} format="webp" quality={60} loading="lazy" class="topic-card-photo" />
                )}
              </div>
              <span class="topic-card-label">{t.name}</span>
            </a>
          );
        })}
      </div>
      <div class="topics-nav">
        <button type="button" class="topics-arrow" data-dir="-1" aria-label="Previous topics">←</button>
        <button type="button" class="topics-arrow" data-dir="1" aria-label="Next topics">→</button>
      </div>
    </div>
  </section>

  <section class="section faq-section" id="faq">
    <div class="wrap" style="max-width: 960px;">
      <div class="section-head faq-head">
        <div>
          <h2 class="section-title">Frequently asked questions</h2>
        </div>
      </div>

      <div class="faq-columns">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .meet{ padding:96px 0; border-bottom:1px solid var(--line); }
  .meet-row{
    display:grid;
    grid-template-columns:0.85fr 1fr;
    gap:64px;
    align-items:center;
  }
  .meet-row + .meet-row{ margin-top:96px; }
  .meet-row--reverse{ grid-template-columns:1fr 0.85fr; }
  .meet-row--reverse .meet-photo{ order:2; }
  .meet-row--reverse .meet-copy{ order:1; }

  .meet-photo{
    position:relative;
    aspect-ratio:4/4;
    border-radius:6px;
    overflow:hidden;
    background:var(--navy-800);
    max-width: 375px;
  }
  .meet-photo img{ display:block; width:100%; height:100%; object-fit:cover; }
  .meet-photo img.img-error{ display:none; }
  .meet-photo-fallback{
    position:absolute; inset:0; display:none; align-items:center; justify-content:center;
    font-family:var(--font-display); font-size:56px; color:var(--gold-300);
  }
  .meet-photo img.img-error + .meet-photo-fallback{ display:flex; }

  .meet-title{
    font-size:clamp(24px, 2.4vw, 32px);
    line-height:1.28;
    font-weight:600;
    margin-bottom:20px;
  }
  .meet-sub{
    font-size:16px;
    line-height:1.7;
    color:var(--ink-600);
    margin-bottom:28px;
    max-width:46ch;
  }

  @media (max-width:840px){
    .meet{ padding:24px 0; }
    .meet-row, .meet-row--reverse{ grid-template-columns:1fr; gap:24px; }
    .meet-row--reverse .meet-photo{ order:0; }
    .meet-row--reverse .meet-copy{ order:0; }
    .meet-row + .meet-row{ margin-top:24px; }
    .meet-photo{ aspect-ratio:4/4; max-width: 250px; }
  }
  .issues { margin:20px;}
  .since-badge{
    display:inline-flex; align-items:center; gap:8px;
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--gold-300); border:1px solid rgba(199,164,74,0.4); background:rgba(199,164,74,0.08);
    padding:6px 14px; border-radius:20px; margin-bottom:18px;
  }
  .since-badge::before{ content:''; width:6px; height:6px; border-radius:50%; background:var(--gold-500); }

  .topics-title{ margin-bottom:24px; }
  .topics-scroll{
    display:flex; gap:20px; overflow-x:auto; scroll-snap-type:x proximity;
    padding-bottom:4px; scrollbar-width:none;
  }
  .topics-scroll::-webkit-scrollbar{ display:none; }
  .topic-card{
    flex:0 0 auto; width:190px; scroll-snap-align:start;
    background:var(--paper-0); border:1px solid var(--line);
    overflow:hidden; transition:transform .25s var(--ease), border-color .25s var(--ease) ;
    padding: 0px;
  }
  .topic-card:hover{ transform:translateY(-3px); border-color:var(--gold-500); }
  .topic-card-img{
    aspect-ratio:1/1; overflow:hidden; background:var(--paper-50);
  }
  .topic-card-img img{ width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
  .topic-card-label{
    display:block; padding:16px 12px; text-align:center;
    font-weight:600; font-size:14.5px; color:var(--ink-900);
    background: white;
  }
  .topics-nav{ display:flex; justify-content:flex-end; gap:12px; margin-top:24px; }
  .topics-arrow{
    width:44px; height:44px; border-radius:50%; border:1px solid var(--line);
    background:#ffffff; color:var(--ink-900); font-size:16px;
    display:flex; align-items:center; justify-content:center;
    transition:border-color .25s var(--ease), background .25s var(--ease), color .25s var(--ease);
  }
  .topics-arrow:hover{ border-color:var(--gold-500); background:var(--gold-500); color:var(--navy-950); }

  /* Therapy services spotlight */
  .therapy-grid{ display:grid; grid-template-columns: 320px 1fr; gap:48px; align-items:start; }
  .therapy-left{ display:flex; flex-direction:column; }
  .therapy-portrait{
    position:relative; width:75%; aspect-ratio:1/1; overflow:hidden;
    border-radius:4px; margin-bottom:24px; background:var(--paper-50);
  }
  .therapy-portrait-photo{ width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
  .therapy-portrait-mark{
    position:absolute; top:14px; right:16px; font-family:var(--font-mono); font-size:11px;
    letter-spacing:0.1em; color:rgba(248,249,246,0.85);
  }
  .therapy-portrait-caption{
    position:absolute; left:0; right:0; bottom:0; padding:20px 18px 18px;
    display:flex; flex-direction:column; gap:4px;
    background:linear-gradient(to top, rgba(11,20,31,0.88), rgba(11,20,31,0.05) 70%);
  }
  .therapy-portrait-kicker{ font-size:13px; color:rgba(248,249,246,0.85); }
  .therapy-portrait-names{ font-family:var(--font-display); font-size:24px; font-weight:600; color:var(--paper-0); }
  .therapy-title{ font-size:clamp(22px,2.4vw,28px); margin-bottom:12px; }
  .therapy-sub{ color:var(--ink-600); font-size:15px; margin-bottom:22px; }

  .therapy-right{ display:flex; flex-direction:column; }
  .therapy-list-title{ font-size:18px; margin-bottom:18px; }
  .therapy-list{ display:flex; flex-direction:column; gap:16px; }
  .therapy-card{
    display:flex; gap:18px; background:white; border:1px solid var(--line);
    border-radius:4px; padding:16px; transition:border-color .25s var(--ease), transform .25s var(--ease);
  }
  .therapy-card:hover{ border-color:var(--gold-500); transform:translateY(-2px); }
  .therapy-card-thumb{
    flex:none; width:96px; height:96px; border-radius:3px; overflow:hidden; background:var(--paper-50);
  }
  .therapy-card-photo{ width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
  .therapy-card-body{ display:flex; flex-direction:column; gap:6px; min-width:0; }
  .therapy-card-body h4{ font-family:var(--font-display); font-size:17px; font-weight:600; margin:0; }
  .therapy-card-body p{ color:var(--ink-600); font-size:14px; line-height:1.5; }
  .therapy-card-meta{ font-size:13px; color:var(--navy-700); font-weight:600; }
  .therapy-list-cta{ display:flex; justify-content:flex-end; margin-top:20px; }

  .therapy-action-block {
    margin-top: 2rem;
    display: flex;
  }

  /* Desktop Styles: Force parallel alignment and custom positioning */
  @media (min-width: 769px) {
    .therapy-grid {
      display: grid;
      gap: 3rem;
      align-items: stretch;
    }

    .therapy-left, .therapy-right {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
    }

    /* Keeps baseline execution buttons horizontally parallel */
    .therapy-action-block {
      margin-top: auto; 
      width: 100%;
    }

    /* Left column: Aligns 'Book Now' to the far right */
    .therapy-left .therapy-action-block {
      justify-content: flex-start;
    }

    /* Right column: Aligns 'Meet the Team' to the far left */
    .therapy-right .therapy-action-block {
      justify-content: flex-end;
    }
  }

  /* Mobile Styles: Normal stacked execution layout */
  @media (max-width: 768px) {
    .therapy-grid {
      display: flex;
      flex-direction: column;
      gap: 4rem;
    }

    .therapy-action-block {
      justify-content: flex-start;
      margin-top: 1.5rem;
    }
  }

  @media (max-width:860px){
    .therapy-grid{ grid-template-columns:1fr; gap:10px; }
    .therapy-portrait{ max-width:320px; }
  }
  @media (max-width:520px){
    .therapy-card{ flex-direction:column; }
    .therapy-card-thumb{ width:100%; height:160px; }
  }

  .explore-grid{ display:grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items:stretch; }
  .featured-article-box{
    background: var(--paper-0); border: 1px solid var(--line); border-left: 3px solid var(--gold-500);
    padding: 32px; display:flex; flex-direction:column; gap:12px;
    transition: border-color .25s var(--ease), transform .25s var(--ease);
  }
  .featured-article-box:hover{ transform: translateY(-3px); }
  .featured-article-box h3{ font-size: 22px; }
  .featured-article-box p{ color: var(--ink-600); font-size: 14.5px; flex:1; }
  .explore-side{ display:flex; flex-direction:column; gap:16px; }
  .explore-teaser{
    background: var(--paper-0); border: 1px solid var(--line); padding: 22px; flex:1;
    display:flex; flex-direction:column; gap:8px; transition: border-color .25s var(--ease);
  }
  .explore-teaser:hover { border-color: var(--gold-500); }
  .explore-teaser h3{ font-size: 16px; }
  .explore-teaser p{ color: var(--ink-600); font-size: 13.5px; flex:1; }

  /* FAQ — compact two-column accordion */
  .faq-section{ padding: 24px 0; }
  .faq-head{
    display:flex; justify-content:space-between; align-items:flex-end; gap:16px;
    margin-bottom: 22px;
  }
  .faq-count{
    font-family: var(--font-mono); font-size:11.5px; letter-spacing:0.06em; text-transform:uppercase;
    color: var(--sage-500); background: rgba(124,152,133,0.1); border:1px solid rgba(124,152,133,0.3);
    padding: 6px 12px; border-radius:999px; white-space:nowrap;
