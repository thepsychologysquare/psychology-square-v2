<script>
  const topicsScroll = document.getElementById('topicsScroll');
  if (topicsScroll) {
    document.querySelectorAll('.topics-arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir'));
        const card = topicsScroll.querySelector('.topic-card');
        const step = card ? card.getBoundingClientRect().width + 20 : 210;
        topicsScroll.scrollBy({ left: dir * step * 2, behavior: 'smooth' });
      });
    });
  }

  function paintSignature(id, filledGoldArr, filledSageArr) {
    const grid = document.getElementById(id);
    if (!grid) return;
    const filledGold = new Set(filledGoldArr);
    const filledSage = new Set(filledSageArr);
    for (let i = 0; i < 36; i++) {
      const cell = document.createElement('span');
      if (filledGold.has(i)) cell.classList.add('filled');
      if (filledSage.has(i)) cell.classList.add('filled-sage');
      grid.appendChild(cell);
    }
  }
  paintSignature('gridSignature', [2, 9, 14, 21, 27, 30], [7, 16, 24]);
  paintSignature('gridSignatureContact', [4, 11, 17, 22, 29], [8, 15, 26, 31]);
</script>
