---
import Layout from '../layouts/Layout.astro';

const siteOrigin = 'https://thepsychologysquare.com';
const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Individual & Couples Therapy", "url": `${siteOrigin}/services/therapy` },
    { "@type": "ListItem", "position": 2, "name": "Statistical & Psychometric Support", "url": `${siteOrigin}/services/research-analysis` },
    { "@type": "ListItem", "position": 3, "name": "Psychology Tutoring", "url": `${siteOrigin}/services/tutoring` },
    { "@type": "ListItem", "position": 4, "name": "Corporate & Workplace Wellbeing", "url": `${siteOrigin}/services/corporate` },
  ],
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteOrigin}/services` },
  ],
};

const faqs = [
  {
    q: 'Which Psychology Square service is right for me?',
    a: 'Therapy is for anyone working through anxiety, depression, trauma, or relationship difficulties. Research analysis is for students and researchers who need statistical or psychometric support for a thesis, dissertation, or publication. Tutoring is for students studying psychology at any level, from O Level to MPhil. If you\u2019re not sure which fits, send us a message and we\u2019ll point you in the right direction.',
  },
  {
    q: 'Are sessions available online or only in person?',
    a: 'Every service — therapy, research analysis, tutoring, and corporate wellbeing — is available both online by video call and in person at our office in Johar Town, Lahore. Most clients mix both depending on the week.',
  },
  {
    q: 'Who actually delivers the sessions?',
    a: 'Every service is delivered directly by one of our two clinical psychologists, Muhammad Sohail or Sehar Waheed, both holding M.S. degrees in Clinical Psychology — never handed off to a third party or a call center partway through.',
  },
  {
    q: 'How much do your services cost?',
    a: 'Individual therapy is PKR 5,000 per session and couples therapy is PKR 7,000 per session. Tutoring is PKR 35,000 per month, per subject. Research analysis and corporate wellbeing pricing depends on project scope — get in touch for a free quote.',
  },
];
---
<Layout
  title="Services"
  fullTitle="Best Therapy & Psychology Services in Lahore"
  description="Top-rated therapy, psychology tutoring & statistical research services in Johar Town, Lahore — online or in-person, from licensed clinical psychologists."
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  })} />

  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Services</span>
      </nav>
      <p class="eyebrow">What We Offer</p>
      <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px;">Services</h1>
      <p class="hero-sub">Three ways to work with us in Johar Town, Lahore: individual and couples therapy, statistical and psychometric research support, and one-to-one psychology tutoring — online or in person.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card-grid">
        <a class="article-card" href="/services/therapy">
          <span class="article-meta">Therapy</span>
          <h3>Individual &amp; Couples Sessions</h3>
          <p>Online or in person, in Johar Town, Lahore. Evidence-based, unhurried, and built around what you're actually carrying.</p>
        </a>
        <a class="article-card" href="/services/research-analysis">
          <span class="article-meta">Research Analysis</span>
          <h3>Statistical &amp; Psychometric Support</h3>
          <p>R and SPSS help for students and researchers — from a first analysis to advanced scale validation work.</p>
        </a>
        <a class="article-card" href="/services/tutoring">
          <span class="article-meta">Tutoring</span>
          <h3>Psychology Tutoring — O Level to MPhil</h3>
          <p>One-to-one tutoring across every psychology subject, for students in Pakistan. Evenings and weekends, three classes a week.</p>
        </a>
        <a class="article-card" href="/services/corporate">
          <span class="article-meta">Corporate</span>
          <h3>Corporate and Workplace Wellbeing</h3>
          <p>Employee assistance, workplace mental health training, manager support, and organizational assessments for companies in Lahore, delivered directly by clinical psychologists.</p>
        </a>
      </div>

      <h2 style="font-size: 22px; margin: 64px 0 16px;">How each service works</h2>
      <div class="approach-grid" style="margin-bottom: 56px;">
        <div class="approach-item">
          <span class="approach-num">01</span>
          <h3>Pick a service, then a slot</h3>
          <p>Therapy, research support, or tutoring — each has its own booking flow. Choose a time that works and confirm online.</p>
        </div>
        <div class="approach-item">
          <span class="approach-num">02</span>
          <h3>Online or in person</h3>
          <p>Join by video call from anywhere, or come in person to the Johar Town office. Most clients mix both depending on the week.</p>
        </div>
        <div class="approach-item">
          <span class="approach-num">03</span>
          <h3>Led by the same two clinicians</h3>
          <p>Every service is delivered directly by <a href="/team/sohail">Muhammad Sohail</a> or <a href="/team/sehar">Sehar Waheed</a> — no hand-off to a third party partway through.</p>
        </div>
      </div>

      <p style="color: var(--ink-600); font-size:15px; line-height:1.7; margin-bottom:40px;">
        We built The Psychology Square around three things people in Lahore kept asking us for in one place: a steady space for therapy, hands-on statistical help for thesis and research work, and psychology tutoring that actually explains the reasoning instead of just the answer. If you're not sure which one fits, <a href="/contact">send us a message</a> and we'll point you in the right direction.
      </p>

      <div style="max-width: 960px; margin: 0 auto;">
        <div class="section-head faq-head">
          <div>
            <h2 class="section-title">Frequently asked questions</h2>
          </div>
        </div>
        <div class="faq-columns">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.q}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="request-cta-banner">
        <p>Not sure which service is right for you?</p>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a href="/contact" class="btn btn--primary">contact Us</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .breadcrumbs{
    font-family: var(--font-mono); font-size: 12px; color: rgba(248,249,246,0.6);
    margin-bottom: 20px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  }
  .breadcrumbs a:hover{ color: var(--gold-300); }
  .crumb-sep{ color: rgba(248,249,246,0.3); }
  .crumb-current{ color: rgba(248,249,246,0.85); }

  .approach-grid{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .approach-item{ display:flex; flex-direction:column; gap:10px; }
  .approach-num{
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gold-500);
  }
  .approach-item h3{ font-size: 17px; }
  .approach-item p{ color: var(--ink-600); font-size: 14.5px; }

  @media (max-width: 860px){
    .approach-grid{ grid-template-columns: 1fr; }
  }
</style>
