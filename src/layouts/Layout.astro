      e.stopPropagation();
      mobileDrawer.classList.add('is-active');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('nav-menu-locked');
    });

    menuCloseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileDrawer.classList.remove('is-active');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-menu-locked');
    });

    const mobileAccoTriggers = document.querySelectorAll('.mobile-accordion-trigger');
    mobileAccoTriggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const parentItem = trigger.parentElement;
        const stateActive = parentItem.classList.contains('mobile-expanded');
        
        document.querySelectorAll('.mobile-accordion-item').forEach(el => el.classList.remove('mobile-expanded'));
        
        if (!stateActive) {
          parentItem.classList.add('mobile-expanded');
        }
      });
    });
  }

  document.querySelectorAll('.topic-slider').forEach((slider) => {
    const track = slider.querySelector('[data-slider-track]');
    const prevBtn = slider.querySelector('[data-slider-prev]');
    const nextBtn = slider.querySelector('[data-slider-next]');
    if (!track || !prevBtn || !nextBtn) return;

    const step = () => Math.max(track.clientWidth * 0.8, 180);
    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
      prevBtn.blur();
    });
    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
      nextBtn.blur();
    });
  });
</script>

