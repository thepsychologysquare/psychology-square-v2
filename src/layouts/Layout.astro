---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  title: string;
  description?: string;
  fullTitle?: string;
}
const {
  title,
  description = "The Psychology Square — individual and couples therapy, online and in person in Johar Town, Lahore.",
  fullTitle,
} = Astro.props;
const pageTitle = fullTitle ?? `${title} — The Psychology Square`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.thepsychologysquare.com');

// Resolve the OG cover image regardless of its actual extension/case,
// so a mismatch (e.g. og-cover.png vs the hardcoded .jpg) can't break link previews.
function resolveOgImagePath(): string {
  const dir = path.join(process.cwd(), 'public', 'images');
  const candidates = ['og-cover.jpg', 'og-cover.jpeg', 'og-cover.png', 'og-cover.webp'];
  try {
    const filesInDir = fs.readdirSync(dir);
    const match = filesInDir.find((f) => candidates.includes(f.toLowerCase()) || /^og-cover\.(jpg|jpeg|png|webp)$/i.test(f));
    if (match) return `/images/${match}`;
  } catch {
    // public/images not readable at build time — fall through to default
  }
  return '/images/og-cover.jpg';
}
const ogImage = new URL(resolveOgImagePath(), canonicalURL.origin);

// --- Glob loaders for dynamic images across categories ---
const topicImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/topics/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getTopicImage(slug: string) {
  const entry = Object.entries(topicImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

const resourceImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/resources/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getResourceImage(slug: string) {
  const entry = Object.entries(resourceImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

const serviceImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/services/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getServiceImage(slug: string) {
  const entry = Object.entries(serviceImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

const teamImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/team/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getTeamImage(slug: string) {
  const entry = Object.entries(teamImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

const courseImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/courses/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
function getCourseImage(slug: string) {
  const entry = Object.entries(courseImages).find(([path]) => path.includes(`/${slug}.`));
  return entry?.[1].default;
}

// --- Nav content metadata ---
const navCategoryMeta: Record<string, string> = {
  'anxiety': 'Anxiety',
  'depression': 'Depression',
  'adhd': 'ADHD',
  'addiction-recovery': 'Addiction & Recovery',
  'trauma': 'Trauma',
  'relationships': 'Relationships',
  'stress-burnout': 'Stress & Burnout',
};
const navAllArticleCategories = Object.keys(navCategoryMeta).map((slug, i) => ({
  slug,
  label: navCategoryMeta[slug],
  img: getTopicImage(slug),
  graphic: `bg-placeholder-${(i % 9) + 1}`,
}));
