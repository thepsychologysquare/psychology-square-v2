{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "psychology-square-v2",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "psychology-square-bookings",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
		}
	],
	"r2_buckets": [
		{
			"binding": "SCREENSHOTS",
			"bucket_name": "psychology-square-payment-proofs"
		}
	],
	"vars": {
		"BOOKING_ADMIN_EMAIL": "thepsychologysquare@gmail.com"
	}
}